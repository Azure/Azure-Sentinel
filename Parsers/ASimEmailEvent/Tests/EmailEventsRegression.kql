let _GetWatchlist = (name:string) { datatable(SearchKey:string, SourceSpecificParser:string)[] };
// source-sha256 ASimEmailEvent: 073b4518fa24eb77fec1fb7d9289ad68ff7d0517d3911943abcbcd6904ce0498
let ASimEmailEvent = (pack:bool=false) {
let DisabledParsers=materialize(_GetWatchlist('ASimDisabledParsers') | where SearchKey in ('Any', 'ExcludeASimEmailEvent') | extend SourceSpecificParser=column_ifexists('SourceSpecificParser','') | distinct SourceSpecificParser| where isnotempty(SourceSpecificParser));
let ASimBuiltInDisabled=toscalar('ExcludeASimEmailEvent' in (DisabledParsers) or 'Any' in (DisabledParsers));
let parser=(pack:bool=false){
union isfuzzy=true
  vimEmailEventEmpty,
  ASimEmailEventMicrosoftDefenderOffice365(
    disabled=(ASimBuiltInDisabled or ('ExcludeASimEmailEventMicrosoftDefenderOffice365' in (DisabledParsers))),
    pack=pack)
};
parser (pack=pack)
};
// source-sha256 imEmailEvent: e2f44d3ee408fbccc8bf679950e374e7fb08d2f9e0b7d45471c905fccaa27cf1
let imEmailEvent = (starttime:datetime=datetime(null), endtime:datetime=datetime(null), ipaddr_has_any_prefix:dynamic=dynamic([]), emailfromaddress_has_any:dynamic=dynamic([]), emailrecipient_has_any:dynamic=dynamic([]), emailsubject_has_any:dynamic=dynamic([]), emaildirection_in:dynamic=dynamic([]), emaildeliverylocation_in:dynamic=dynamic([]), eventresult:string="*", pack:bool=false) {
let DisabledParsers=materialize(_GetWatchlist('ASimDisabledParsers') | where SearchKey in ('Any', 'ExcludeimEmailEvent') | extend SourceSpecificParser=column_ifexists('SourceSpecificParser','') | distinct SourceSpecificParser | where isnotempty(SourceSpecificParser));
let imBuiltInDisabled=toscalar('ExcludeimEmailEvent' in (DisabledParsers) or 'Any' in (DisabledParsers));
let parser=(
  starttime: datetime=datetime(null),
  endtime: datetime=datetime(null),
  ipaddr_has_any_prefix: dynamic=dynamic([]),
  emailfromaddress_has_any: dynamic=dynamic([]),
  emailrecipient_has_any: dynamic=dynamic([]),
  emailsubject_has_any: dynamic=dynamic([]),
  emaildirection_in: dynamic=dynamic([]),
  emaildeliverylocation_in: dynamic=dynamic([]),
  eventresult: string='*',
  pack:bool=false)
{
union isfuzzy=true
  vimEmailEventEmpty,
  vimEmailEventMicrosoftDefenderOffice365(
    starttime=starttime, endtime=endtime,
    ipaddr_has_any_prefix=ipaddr_has_any_prefix,
    emailfromaddress_has_any=emailfromaddress_has_any,
    emailrecipient_has_any=emailrecipient_has_any,
    emailsubject_has_any=emailsubject_has_any,
    emaildirection_in=emaildirection_in,
    emaildeliverylocation_in=emaildeliverylocation_in,
    eventresult=eventresult,
    disabled=(imBuiltInDisabled or ('ExcludevimEmailEventMicrosoftDefenderOffice365' in (DisabledParsers))),
    pack=pack)
};
parser (starttime=starttime, endtime=endtime, ipaddr_has_any_prefix=ipaddr_has_any_prefix, emailfromaddress_has_any=emailfromaddress_has_any, emailrecipient_has_any=emailrecipient_has_any, emailsubject_has_any=emailsubject_has_any, emaildirection_in=emaildirection_in, emaildeliverylocation_in=emaildeliverylocation_in, eventresult=eventresult, pack=pack)
};
let ExpectedMappings = datatable(CaseName:string, Expected:dynamic)[
"delivered", dynamic({"EventResult": "Success", "DvcAction": "Delivered", "EmailDeliveryLocation": "Inbox", "EmailDirection": "Inbound"}),
"quarantined-phish", dynamic({"EventResult": "Failure", "DvcAction": "Quarantined", "EmailDeliveryLocation": "Quarantine", "EventResultDetails": "PhishingDetected"}),
"junked-spam", dynamic({"EventResult": "Success", "DvcAction": "Delivered", "EmailDeliveryLocation": "Junk", "EventResultDetails": ""}),
"replaced-malware", dynamic({"EventResult": "Success", "DvcAction": "Modified", "EventResultDetails": "MalwareDetected"}),
"outbound-external", dynamic({"EventResult": "Success", "EmailDeliveryLocation": "", "EmailDirection": "Outbound"}),
"failed-delivery", dynamic({"EventResult": "Failure", "DvcAction": "Blocked", "EmailDeliveryLocation": "", "EventResultDetails": "Other"}),
"unknown-values", dynamic({"EventResult": "NA", "DvcAction": "NA", "EmailDirection": "Unknown", "EmailSpfResult": "", "EmailDkimResult": "", "EmailDmarcResult": ""}),
"ipv6-fallback", dynamic({"SrcIpAddr": "2001:db8::10", "EmailDirection": "Internal"}),
"both-ips", dynamic({"SrcIpAddr": "192.0.2.10"}),
"missing-optional", dynamic({"EmailToRecipients": [], "EmailCCRecipients": [], "EmailSizeBytes": null, "EmailSpfResult": ""}),
"malformed-dynamic", dynamic({"EmailToRecipients": [], "EmailCCRecipients": [], "EmailFileCount": null, "EmailUrlCount": null, "EmailSizeBytes": null, "EmailDkimResult": ""}),
"invalid-source-ip", dynamic({"SrcIpAddr": "", "IpAddr": ""}),
"missing-required-recipient", dynamic({"Dst": "", "EventMessage": "Source EmailEvents record has no recipient identity"}),
"missing-required-time", dynamic({"EventMessage": "Source EmailEvents record has no event timestamp"})
];
let Results = materialize(union (ASimEmailEventMicrosoftDefenderOffice365(pack=true) | extend Variant="regular"), (vimEmailEventMicrosoftDefenderOffice365(pack=true) | extend Variant="filtering"));
let MappingFailures = Results
| extend Actual = pack_all()
| lookup ExpectedMappings on $left.EventOriginalUid == $right.CaseName
| mv-expand Field = bag_keys(Expected)
| extend Field = tostring(Field)
| where tostring(Actual[Field]) != tostring(Expected[Field])
| project Test = strcat(Variant, ":", EventOriginalUid), Field, Expected=tostring(Expected[Field]), Actual=tostring(Actual[Field]);
let ControlFailures = union
(print Test="regular-cardinality", Field="RowCount", Expected="14", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365() | count))),
(print Test="filtering-cardinality", Field="RowCount", Expected="14", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365() | count))),
(print Test="disabled-regular", Field="RowCount", Expected="0", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365(disabled=true) | count))),
(print Test="disabled-filtering", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(disabled=true) | count))),
(print Test="time-inclusive", Field="RowCount", Expected="13", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(starttime=datetime(2026-10-15T12:00:00Z), endtime=datetime(2026-10-15T12:00:00Z)) | count))),
(print Test="time-excludes", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(starttime=datetime(2026-10-16)) | count))),
(print Test="sender-positive", Field="RowCount", Expected="14", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailfromaddress_has_any=dynamic(["example.com"])) | count))),
(print Test="sender-negative", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailfromaddress_has_any=dynamic(["missing.invalid"])) | count))),
(print Test="subject-positive", Field="RowCount", Expected="14", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailsubject_has_any=dynamic(["Synthetic"])) | count))),
(print Test="subject-negative", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailsubject_has_any=dynamic(["absentword"])) | count))),
(print Test="recipient-header", Field="RowCount", Expected="12", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailrecipient_has_any=dynamic(["bob@contoso.example"])) | count))),
(print Test="recipient-negative", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emailrecipient_has_any=dynamic(["nobody@absent.invalid"])) | count))),
(print Test="ipv4-prefix", Field="RowCount", Expected="12", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(ipaddr_has_any_prefix=dynamic(["192.0.2."])) | count))),
(print Test="ipv6-prefix", Field="RowCount", Expected="1", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(ipaddr_has_any_prefix=dynamic(["2001:db8:"])) | count))),
(print Test="ipv6-prefix-case", Field="RowCount", Expected="1", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(ipaddr_has_any_prefix=dynamic(["2001:DB8:"])) | count))),
(print Test="literal-not-regex-prefix", Field="RowCount", Expected="0", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(ipaddr_has_any_prefix=dynamic(["192x0x2x"])) | count))),
(print Test="normalized-direction", Field="RowCount", Expected="1", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emaildirection_in=dynamic(["Internal"])) | count))),
(print Test="normalized-location", Field="RowCount", Expected="1", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(emaildeliverylocation_in=dynamic(["Quarantine"])) | count))),
(print Test="result-failure", Field="RowCount", Expected="2", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(eventresult="Failure") | count))),
(print Test="result-na", Field="RowCount", Expected="1", Actual=tostring(toscalar(vimEmailEventMicrosoftDefenderOffice365(eventresult="NA") | count))),
(print Test="packing-off", Field="RowCount", Expected="0", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365() | where array_length(bag_keys(AdditionalFields)) != 0 | count))),
(print Test="packing-on", Field="RowCount", Expected="0", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365(pack=true) | where isempty(tostring(AdditionalFields.NetworkMessageId)) | count))),
(print Test="missing-required-diagnostics", Field="RowCount", Expected="2", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365() | where isnotempty(EventMessage) | count))),
(print Test="valid-required-fields", Field="RowCount", Expected="12", Actual=tostring(toscalar(ASimEmailEventMicrosoftDefenderOffice365() | where isnotnull(TimeGenerated) and isnotempty(Dst) | count))),
(print Test="regular-unified-workflow", Field="RowCount", Expected="14", Actual=tostring(toscalar(ASimEmailEvent() | count))),
(print Test="filtering-unified-workflow", Field="RowCount", Expected="2", Actual=tostring(toscalar(imEmailEvent(eventresult="Failure", emaildirection_in=dynamic(["Inbound"])) | count)))
| where Expected != Actual;
union MappingFailures, ControlFailures | order by Test asc, Field asc
