{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "\n# Theom Alert Statistics\n\nDisplays legacy and CCF alerts through the **Theom_Alerts** parser installed with the Theom solution. Configure either Theom data connector and select a time range to view alert trends, priorities, assets, and financial exposure. Asset and rule details require the corresponding properties in the source table. CCF records without those properties cannot supply missing asset details or financial values.\n"
            },
            "customWidth": "50",
            "name": "text - 1"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "b75df6e9-5ef1-4d93-862c-02c2b020e0ad",
                  "version": "KqlParameterItem/1.0",
                  "name": "TimeRange",
                  "type": 4,
                  "description": "Select Time range",
                  "isRequired": true,
                  "isGlobal": true,
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 1800000
                      },
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 43200000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 172800000
                      },
                      {
                        "durationMs": 259200000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 1209600000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 5184000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ]
                  },
                  "timeContext": {
                    "durationMs": 86400000
                  },
                  "value": {
                    "durationMs": 7776000000
                  }
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "customWidth": "50",
            "name": "parameters - 0"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts\n| where AlertType == \"Issue\" and TimeGenerated {TimeRange}\n| summarize Alerts = count() by Region\n",
              "size": 0,
              "title": "Alerts by Location",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart"
            },
            "customWidth": "25",
            "name": "query - 10 - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts\n| where AlertType == \"Issue\" and TimeGenerated {TimeRange}\n| summarize Rules = count() by AssetType",
              "size": 0,
              "title": "Alerts by Asset Type",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart"
            },
            "customWidth": "25",
            "name": "query - 10 - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts\n| where AlertType == \"Issue\" and TimeGenerated {TimeRange}\n| summarize Assets = count(), FinancialValue = iff(countif(isnotnull(AssetNERValue)) > 0, sum(AssetNERValue), real(null)) by AssetType",
              "size": 0,
              "title": "Financial Value by Asset Type",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart"
            },
            "customWidth": "50",
            "name": "query - 10 - Copy - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts |\nmake-series Count = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
              "size": 0,
              "title": "Theom Alerts Over time",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart",
              "graphSettings": {
                "type": 0
              }
            },
            "name": "query - 2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts | where Priority == \"P1\" |make-series CritialAlerts = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
              "size": 0,
              "title": "Critical Risk Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "customWidth": "25",
            "name": "query - 1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts | where Priority == \"P2\" |make-series HighAlerts = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
              "size": 0,
              "title": "High Risk Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "customWidth": "25",
            "name": "query - 1 - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts | where Priority == \"P3\" |make-series MediumAlerts = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
              "size": 0,
              "title": "Medium Risk Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "customWidth": "25",
            "name": "query - 1 - Copy - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts | where Priority == \"P4\" |make-series LowAlerts = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
              "size": 0,
              "title": "Low Risk Alerts",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "customWidth": "25",
            "name": "query - 1 - Copy - Copy - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts\n| where AlertType == \"Issue\" and TimeGenerated {TimeRange}\n| summarize Count = count() by SecurityRule = strcat(RuleId,\" \",tostring(split(Summary,\"-\",0)))\n| sort by Count\n| take 10",
              "size": 0,
              "title": "Number of Alerts per Security Rule",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "sortBy": []
            },
            "name": "query - 10"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts \n| where Priority == \"P1\" \n  and TimeGenerated {TimeRange}\n| sort by TimeGenerated desc\n| project AlertID = Id,Asset = AssetName, TheomURL = DeepLink,TimeGenerated\n| take 10",
              "size": 0,
              "title": "Latest 10 Critical Risk Alerts: Information",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "rowLimit": 10
              },
              "tileSettings": {
                "showBorder": false
              },
              "mapSettings": {
                "locInfo": "LatLong"
              }
            },
            "name": "query - 1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts \n| where Priority == \"P2\" \n  and TimeGenerated {TimeRange}\n| sort by TimeGenerated desc\n| project AlertID = Id,Asset = AssetName, TheomURL = DeepLink,TimeGenerated\n| take 10",
              "size": 0,
              "title": "Latest 10 High Risk Alerts: Information",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "rowLimit": 10
              },
              "tileSettings": {
                "showBorder": false
              },
              "mapSettings": {
                "locInfo": "LatLong"
              }
            },
            "name": "query - 1 - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Theom_Alerts \n| where Priority == \"P3\" \n  and TimeGenerated {TimeRange}\n| sort by TimeGenerated desc\n| project AlertID = Id,Asset = AssetName, TheomURL = DeepLink,TimeGenerated\n| take 10",
              "size": 0,
              "title": "Latest 10 Medium Risk Alerts: Information",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "rowLimit": 10
