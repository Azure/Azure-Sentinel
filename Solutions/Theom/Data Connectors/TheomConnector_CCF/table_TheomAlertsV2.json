{
  "name": "TheomAlertsV2_CL",
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "apiVersion": "2022-10-01",
  "tags": {
    "StreamName": "Custom-TheomAlertsV2_CL",
    "DataSource": "Theom",
    "Category": "SecurityEvents",
    "Vendor": "Theom",
    "Domain": "Security - Cloud Security"
  },
  "properties": {
    "retentionInDays": 90,
    "schema": {
      "name": "TheomAlertsV2_CL",
      "description": "Theom alerts on data security risks including critical alerts on data exposure, encryption issues, access anomalies, and compliance violations from cloud environments.",
      "columns": [
        {
          "name": "TimeGenerated",
          "type": "datetime",
          "description": "Time the alert was last triggered"
        },
        {
          "name": "AccountId",
          "type": "string",
          "description": "Theom account identifier"
        },
        {
          "name": "CloudProvider",
          "type": "string",
          "description": "Cloud provider associated with the alert"
        },
        {
          "name": "DeepLink",
          "type": "string",
          "description": "Deep link to Theom UI"
        },
        {
          "name": "Details",
          "type": "string",
          "description": "Alert details"
        },
        {
          "name": "Id",
          "type": "string",
          "description": "Alert identifier"
        },
        {
          "name": "Priority",
          "type": "string",
          "description": "Alert priority (P1-P5)"
        },
        {
          "name": "LastTriggered",
          "type": "datetime",
          "description": "Time the alert was last triggered"
        },
        {
          "name": "NumTriggered",
          "type": "string",
          "description": "Number of times the alert was triggered"
        },
        {
          "name": "Risk",
          "type": "string",
          "description": "Risk category associated with the alert"
        },
        {
          "name": "RuleName",
          "type": "string",
          "description": "Name of the rule that triggered the alert"
        },
        {
          "name": "Region",
          "type": "string",
          "description": "Region associated with the alert"
        },
        {
          "name": "RemediationSteps",
          "type": "dynamic",
          "description": "Recommended remediation steps"
        },
        {
          "name": "Scopes",
          "type": "dynamic",
          "description": "Scopes associated with the alert"
        },
        {
          "name": "Summary",
          "type": "string",
          "description": "Alert summary"
        },
        {
          "name": "Tags",
          "type": "dynamic",
          "description": "Tags associated with the alert"
        },
        {
          "name": "AlertType",
          "type": "string",
          "description": "Alert type (e.g., Issue)"
        }
      ]
    }
  }
}