[
    {
        "name": "GoogleApigeeXDCR",
        "apiVersion": "2021-09-01-preview",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "properties": {
            "streamDeclarations": {
                "Custom-GCPApigee": {
                    "columns": [
                        { "name": "httpRequest", "type": "dynamic" },
                        { "name": "insertId", "type": "string" },
                        { "name": "jsonPayload", "type": "dynamic" },
                        { "name": "labels", "type": "dynamic" },
                        { "name": "logName", "type": "string" },
                        { "name": "operation", "type": "dynamic" },
                        { "name": "protoPayload", "type": "dynamic" },
                        { "name": "receiveTimestamp", "type": "datetime" },
                        { "name": "resource", "type": "dynamic" },
                        { "name": "severity", "type": "string" },
                        { "name": "sourceLocation", "type": "dynamic" },
                        { "name": "spanId", "type": "string" },
                        { "name": "split", "type": "dynamic" },
                        { "name": "textPayload", "type": "string" },
                        { "name": "timestamp", "type": "datetime" },
                        { "name": "trace", "type": "string" },
                        { "name": "traceSampled", "type": "boolean" }
                    ]
                }
            },
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "clv2ws1"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [
                        "Custom-GCPApigee"
                    ],
                    "transformKql": "source | extend TimeGenerated = timestamp, InsertId = tostring(insertId), LogName = tostring(logName), GCPResource = resource, Operation = iff(isnotempty(operation), operation, todynamic('')), ProtoPayload = iff(isnotempty(jsonPayload), jsonPayload, iff(isnotempty(protoPayload), protoPayload, todynamic(''))), ReceiveTimestamp = receiveTimestamp, Severity = tostring(severity), Timestamp = timestamp | project TimeGenerated, InsertId, LogName, GCPResource, Operation, ProtoPayload, ReceiveTimestamp, Severity, Timestamp",
                    "destinations": [
                        "clv2ws1"
                    ],
                    "outputStream": "Microsoft-GCPApigee"
                }
            ],
            "dataCollectionEndpointId": "{{dataCollectionEndpointId}}"
        }
    }
]