[
    {
        "name": "GoogleApigeeXDCR",
        "apiVersion": "2021-09-01-preview",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "properties": {
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "clv2ws1"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [
                        "Microsoft-GCPApigee"
                    ],
                    "transformKql": "source | extend ProtoPayload = iff(isnotempty(tostring(column_ifexists('jsonPayload', todynamic('')))), column_ifexists('jsonPayload', todynamic('')), column_ifexists('ProtoPayload', todynamic('')))",
                    "destinations": [
                        "clv2ws1"
                    ]
                }
            ],
            "dataCollectionEndpointId": "{{dataCollectionEndpointId}}"
        }
    }
]