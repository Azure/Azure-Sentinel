[
    {
        "name": "CybleVisionIOCPoller",
        "apiVersion": "2023-02-01-preview",
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "properties": {
            "connectorDefinitionName": "CybleVisionIOC",
            "dataType": "ThreatIntelIndicators",
            "dcrConfig": {
                "streamName": "Custom-CybleVisionIOC",
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
            },
            "auth": {
                "type": "APIKey",
                "ApiKey": "{{ApiToken}}",
                "ApiKeyName": "Authorization",
                "ApiKeyIdentifier": "Bearer"
            },
            "request": {
                "apiEndpoint": "https://api.cyble.ai/engine/api/v4/y/iocs",
                "httpMethod": "POST",
                "queryWindowInMin": "[[parameters('querywindow')]",
                "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
                "rateLimitQps": 1,
                "retryCount": 3,
                "timeoutInSeconds": 60,
                "headers": {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                "isPostPayloadJson": true,
                "queryParametersTemplate": "{\"startDate\": \"{_QueryWindowStartTime}\", \"endDate\": \"{_QueryWindowEndTime}\", \"dateFilterBy\": \"last_seen\", \"sortBy\": \"last_seen\", \"order\": \"desc\", \"iocType\": \"{{iocType}}\", \"riskRating\": {\"gte\": \"{{riskRatinglow}}\", \"lte\": \"{{riskRatinghigh}}\"}, \"confidentRating\": \"{{confidenceRating}}\", \"countOnly\": false, \"page\": 1, \"limit\": 100}"
            },
            "response": {
                "format": "json",
                "eventsJsonPaths": [
                    "$.data.iocs[*]"
                ]
            },
            "paging": {
                "pagingType": "CountBasedPaging",
                "pageNumberParaName": "page",
                "pageSizeParameterName": "limit",
                "pageSize": 100,
                "zeroBasedIndexing": false,
                "pageNumberJsonPath": "$.data.pagination.page"
            }
        }
    }
]
