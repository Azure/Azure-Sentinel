{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "3.0.0.0",
    "metadata": {
        "title": "RecordedFuture-Sandbox_StorageAccount",
        "description": "This playbook will trigger on files in a Storage Account and send them to Recorded Future Sandbox. The result will be written to a custom log (RecordedFutureSandboxResults_CL). To create Microsoft Defender incidents from sandbox results, use a Analytics Rule that queries the RecordedFutureSandboxResults_CL table. Direct incident creation via Logic Apps is no longer supported in the unified Microsoft Defender portal.",
        "prerequisites": [
            "Deploy the Data Connectors infrastructure (DCE, DCR, Log Analytics table) by deploying the azuredeploy.json template from the Data Connectors folder before deploying this playbook. This playbook must be deployed into the same resource group as the Data Connectors infrastructure.",
            "To use the Recorded Future Sandbox connector, you will need a valid API token from Recorded Future as described in the documentation https://learn.microsoft.com/en-us/connectors/recordedfuturesandbo/#how-to-get-credentials"
        ],
        "postDeployment": [
            "After deployment you have to open the playbook and configure and authorize all connections and press save."
        ],
        "prerequisitesDeployTemplateFile": "../../../Data Connectors/azuredeploy.json",
        "lastUpdateTime": "2026-08-04T00:00:00.000Z",
        "entities": [],
        "tags": [ "Enrichment" ],
        "support": {
            "tier": "Partner",
            "armtemplate": "Generated from https://github.com/Azure/Azure-Sentinel/tree/master/Tools/Playbook-ARM-Template-Generator"
        },
        "author": {
            "name": "Recorded Future"
        },
        "releaseNotes": [
            {
                "version": "1.0",
                "title": "RecordedFuture-Sandbox_StorageAccount",
                "notes": [ "Initial version" ]
            },
            {
                "version": "1.1",
                "title": "API Connectors",
                "notes": [ "API connection rename." ]
            },
            {
                "version": "1.2",
                "notes": [
                    "Adding Sandbox region parameter to allow users to select the appropriate region for their use."
                ],
                "title": "Sandbox region"
            },
            {
                "version": "2.0",
                "title": "RecordedFuture-Sandbox_StorageAccount",
                "notes": [
                    "BREAKING CHANGE: Removed direct incident creation due to Microsoft Defender unified portal migration.",
                    "Sandbox results are now written to RecordedFutureSandboxResults_CL custom log table.",
                    "To create incidents, deploy a Analytics Rule that queries RecordedFutureSandboxResults_CL."
                ]
            },
            {
                "version": "3.0",
                "title": "RecordedFuture-Sandbox_StorageAccount",
                "notes": [
                    "BREAKING CHANGE: Migrated from deprecated HTTP Data Collector API (azureloganalyticsdatacollector connector) to the Log Ingestion API (DCE/DCR with MSI authentication).",
                    "Data now ingested into RecordedFutureSandboxResults_V2_CL (new table). RecordedFutureSandboxResults_CL will no longer receive data after this update.",
                    "Deploy the Data Connectors infrastructure template (azuredeploy.json) before deploying this playbook.",
                    "Automatically assigns Monitoring Metrics Publisher role on the DCR to the Logic App managed identity."
                ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "defaultValue": "RecordedFuture-Sandbox_StorageAccount",
            "type": "string"
        },
        "Enterprise Sandbox API Key": {
            "defaultValue": "",
            "metadata": {
                "description": "Optional token for the Enterprise Sandbox API. Only provide if you are using the Enterprise Sandbox. Retrieve from [Recorded Future Portal](https://sandbox.recordedfuture.com/account)"
            },
            "type": "string"
        },
        "SandboxRegion": {
            "defaultValue": "eu",
            "metadata": {
                "description": "Sandbox region to use. Allowed values are 'eu', 'us' or 'apj'."
            },
            "type": "string",
            "allowedValues": [
                "eu",
                "us",
                "apj"
            ]
        },
        "create_role_assignment": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "If true, automatically assigns the Monitoring Metrics Publisher role on the shared DCR to the Logic App managed identity."
            }
        }
    },
    "variables": {
        "AzureblobConnectionName": "[concat('Azureblob-', parameters('PlaybookName'))]",
        "RecordedfuturesandboConnectionName": "Recordedfuture-SandboConnection",
        "MonitoringMetricsPublisherRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]",
        "DceName": "recorded-future-dce",
        "DcrName": "recorded-future-dcr-sandbox-results",
        "StreamName": "Custom-RecordedFutureSandboxResults_V2_CL",
        "dceResourceId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
        "dcrResourceId": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('DcrName'))]"
    },
    "resources": [
        {
            "properties": {
                "provisioningState": "Succeeded",
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "Enterprise Sandbox API Key": {
                            "defaultValue": "[parameters('Enterprise Sandbox API Key')]",
                            "type": "string"
                        },
                        "SandboxRegion": {
                            "defaultValue": "[parameters('SandboxRegion')]",
                            "type": "string"
                        },
                        "DceEndpoint": {
                            "type": "String"
                        },
                        "DcrImmutableId": {
                            "type": "String"
                        },
                        "StreamName": {
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "recurrence": {
                                "frequency": "Week",
                                "interval": 1
                            },
                            "evaluatedRecurrence": {
                                "frequency": "Week",
                                "interval": 1
                            },
                            "type": "Recurrence"
                        }
                    },
                    "actions": {
                        "Get_Blob_Metadata_(V2)": {
                            "runAfter": {
                                "Get_blob_content_(V2)": [
                                    "Succeeded"
                                ]
                            },
                            "metadata": {
                                "JTJmdGVzdGluZyUyZmNhbGMuZXhl": "/testing/calc.exe"
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azureblob']['connectionId']"
                                    }
                                },
                                "method": "get",
                                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files/@{encodeURIComponent(encodeURIComponent('JTJmdGVzdGluZyUyZmNhbGMuZXhl'))}"
                            }
                        },
                        "Get_blob_content_(V2)": {
                            "runAfter": {},
                            "metadata": {
                                "JTJmdGVzdGluZyUyZmNhbGMuZXhl": "/testing/calc.exe"
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azureblob']['connectionId']"
                                    }
                                },
                                "method": "get",
                                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files/@{encodeURIComponent(encodeURIComponent('JTJmdGVzdGluZyUyZmNhbGMuZXhl'))}/content",
                                "queries": {
                                    "inferContentType": true
                                }
                            }
                        },
                        "Get_the_full_report": {
                            "runAfter": {
                                "Until": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "headers": {
                                    "SandboxToken": "@parameters('Enterprise Sandbox API Key')",
                                    "Region": "@parameters('SandboxRegion')"
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['recordedfuturesandbo']['connectionId']"
                                    }
                                },
                                "method": "get",
                                "path": "/samples/@{encodeURIComponent(body('Get_the_full_summary')?['id'])}/overview.json"
                            }
                        },
                        "Initialize_sandbox_status": {
                            "runAfter": {
                                "Submit_file_samples": [
                                    "Succeeded"
                                ]
                            },
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "sandbox_status",
                                        "type": "string"
                                    }
                                ]
                            }
                        },
                        "Submit_file_samples": {
                            "runAfter": {
                                "Get_Blob_Metadata_(V2)": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "body": {
                                    "$content-type": "multipart/form-data",
                                    "$multipart": [
                                        {
                                            "body": "@body('Get_blob_content_(V2)')",
                                            "headers": {
                                                "Content-Disposition": "form-data; name=\"file\"; filename=\"@{body('Get_Blob_Metadata_(V2)')?['DisplayName']}\""
                                            }
                                        }
                                    ]
                                },
                                "headers": {
                                    "SandboxToken": "@parameters('Enterprise Sandbox API Key')",
                                    "Region": "@parameters('SandboxRegion')"
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['recordedfuturesandbo']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "path": "/samples/file"
                            }
                        },
                        "Until": {
                            "actions": {
                                "Delay": {
                                    "runAfter": {
                                        "Set_sandbox_status": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Wait",
                                    "inputs": {
                                        "interval": {
                                            "count": 2,
                                            "unit": "Minute"
                                        }
                                    }
                                },
                                "Get_the_full_summary": {
                                    "runAfter": {},
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "headers": {
                                            "SandboxToken": "@parameters('Enterprise Sandbox API Key')",
                                            "Region": "@parameters('SandboxRegion')"
                                        },
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['recordedfuturesandbo']['connectionId']"
                                            }
                                        },
                                        "method": "get",
                                        "path": "/samples/@{encodeURIComponent(body('Submit_file_samples')?['id'])}"
                                    }
                                },
                                "Set_sandbox_status": {
                                    "runAfter": {
                                        "Get_the_full_summary": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "sandbox_status",
                                        "value": "@body('Get_the_full_summary')?['status']"
                                    }
                                }
                            },
                            "runAfter": {
                                "Initialize_sandbox_status": [
                                    "Succeeded"
                                ]
                            },
                            "expression": "@equals(variables('sandbox_status'), 'reported')",
                            "limit": {
                                "count": 60,
                                "timeout": "PT1H"
                            },
                            "type": "Until"
                        },
                        "Compose_Record": {
                            "runAfter": {
                                "Get_the_full_report": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": {
                                "FileName": "@{body('Get_Blob_Metadata_(V2)')?['DisplayName']}",
                                "SandboxScore": "@{body('Get_the_full_report')?['analysis']?['score']}",
                                "SandboxVerdict": "@{body('Get_the_full_report')?['analysis']?['verdict']}",
                                "SampleId": "@{body('Get_the_full_report')?['id']}",
                                "HtmlReport": "@{body('Get_the_full_report')?['html_report']}",
                                "Source": "StorageAccount",
                                "ScanTime": "@{utcNow()}"
                            }
                        },
                        "Send_Data": {
                            "runAfter": {
                                "Compose_Record": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "method": "POST",
                                "uri": "@{parameters('DceEndpoint')}/dataCollectionRules/@{parameters('DcrImmutableId')}/streams/@{parameters('StreamName')}?api-version=2023-01-01",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": "@createArray(outputs('Compose_Record'))",
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://monitor.azure.com"
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azureblob": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureblobConnectionName'))]",
                                "connectionName": "[variables('AzureblobConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azureblob')]"
                            },
                            "recordedfuturesandbo": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('RecordedfuturesandboConnectionName'))]",
                                "connectionName": "[variables('RecordedfuturesandboConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Recordedfuturesandbo')]"
                            }
                        }
                    },
                    "DceEndpoint": {
                        "value": "[reference(variables('dceResourceId'), '2024-03-11').logsIngestion.endpoint]"
                    },
                    "DcrImmutableId": {
                        "value": "[reference(variables('dcrResourceId'), '2024-03-11').immutableId]"
                    },
                    "StreamName": {
                        "value": "[variables('StreamName')]"
                    }
                }
            },
            "name": "[parameters('PlaybookName')]",
            "type": "Microsoft.Logic/workflows",
            "location": "[resourceGroup().location]",
            "tags": {
                "hidden-SentinelTemplateName": "RecordedFuture-Sandbox_StorageAccount",
                "hidden-SentinelTemplateVersion": "3.0"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "apiVersion": "2017-07-01",
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureblobConnectionName'))]",
                "[resourceId('Microsoft.Web/connections', variables('RecordedfuturesandboConnectionName'))]"
            ]
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureblobConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureblobConnectionName')]",
                "customParameterValues": {},
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azureblob')]"
                }
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('RecordedfuturesandboConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('RecordedfuturesandboConnectionName')]",
                "customParameterValues": {},
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Recordedfuturesandbo')]"
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(variables('dcrResourceId'), parameters('PlaybookName'), variables('MonitoringMetricsPublisherRoleId'))]",
            "scope": "[variables('dcrResourceId')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('MonitoringMetricsPublisherRoleId')]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            },
            "condition": "[parameters('create_role_assignment')]"
        }
    ]
}