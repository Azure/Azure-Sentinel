  {
    "name": "Idira EPM Feature Adoption",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "condition": "[[not(contains(parameters('DisableUsageReporting'), 'true'))]",
    "properties": {
      "connectorDefinitionName": "CyberArkEPMCCPDefinition",
      "dataType": "CyberArkEPM_Events_CL",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-CyberArkEPM"
      },
      "auth": {
        "type": "OAuth2",
        "ClientSecret": "{{clientSecret}}",
        "ClientId": "{{clientId}}",
        "TokenEndpoint": "https://{{IdentityEndpoint}}/oauth2/platformtoken",
        "tokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "TokenEndpointQueryParameters": {},
        "grantType": "client_credentials"
      },
      "request": {
        "apiEndpoint": "[[concat('https://us-east-1-featureadopt.featureadopt.', last(split(parameters('IdentityEndpoint'), '.id.')), '/api/feature-adoption')]",
        "httpMethod": "POST",
        "queryWindowInMin": 1440,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "rateLimitQps": 1,
        "retryCount": 1,
        "timeoutInSeconds": 10,
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "isPostPayloadJson": true,
        "queryParametersTemplate": "{\"metric_key\":\"IDIINT.microsoft_sentinel_epm.integration_executed\",\"number_of_events\":1,\"triggered_by\":\"BE\",\"tags\":{\"vendor_name\":\"Microsoft\",\"integration_version\":\"3.2.1\",\"idira_service\":\"Idira EPM\"}}"
      },
      "response": {
        "eventsJsonPaths": [
          "$.featureAdoptionNoEvents"
        ],
        "format": "json"
      }
    }
  }
]
