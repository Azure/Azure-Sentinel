        "streamName": "Custom-CyberArkEPM"
      },
      "auth": {
        "type": "OAuth2",
        "ClientSecret": "{{clientSecret}}",
        "ClientId": "{{clientId}}",
        "TokenEndpoint": "https://{{IdentityEndpoint}}/oauth2/token/{{WebAppID}}",
        "tokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
