          },
          "response": {
            "eventsJsonPaths": [
              "$.AdminAudits"
            ],
            "format": "json"
          },
          "paging": {
            "pagingType": "Offset",
            "offsetParaName": "offset",
            "pageSize": 100,
            "pageSizeParameterName": "limit"
          }
        }
      },
      "addOnAttributes": {
        "SetId": "$SetId_placeholder$",
        "SetName": "$SetName_placeholder$",
        "ConnectorEventType": "admin_audit"
      }
    }
