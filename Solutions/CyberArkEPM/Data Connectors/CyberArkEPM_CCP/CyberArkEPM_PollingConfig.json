        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.Sets[*]"
        ],
        "format": "json"
      },
      "stepInfo": {
        "stepType": "Nested",
        "nextSteps": [
          {
            "stepId": "adminAudit",
            "stepPlaceholdersParsingKql": "source | project res = parse_json(data) | project SetId_placeholder = tostring(res['Id']), SetName_placeholder = tostring(res['Name'])"
          }
        ]
      },
      "stepCollectorConfigs": {
        "adminAudit": {
          "shouldJoinNestedData": false,
          "request": {
            "apiEndpoint": "https://{{TenantUrl}}/EPM/API/Sets/$SetId_placeholder$/AdminAudit",
            "httpMethod": "GET",
            "queryParameters": {
              "DateFrom": "{_QueryWindowStartTime}",
              "DateTo": "{_QueryWindowEndTime}",
              "limit": 100,
              "offset": 0
            },
            "queryWindowInMin": 60,
            "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
            "rateLimitQps": 10,
            "retryCount": 3,
            "timeoutInSeconds": 60,
            "headers": {
              "Accept": "application/json",
