    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "OfficeActivity \r\n| where OfficeWorkload == 'Exchange' and Operation == 'Set-Mailbox' \r\n| project TimeGenerated , UserId , UserType  \r\n",
        "size": 0,
        "exportToExcelOptions": "visible",
