    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "//Mailbox permissions changes\r\nOfficeActivity\r\n| where OfficeWorkload == 'Exchange' and Operation in ('Add-MailboxPermission', 'UpdateFolderPermissions', 'Remove-MailboxPermission')\r\n| summarize count() by Operation\r\n| sort by count_",
        "size": 0,
        "exportToExcelOptions": "visible",
