            "query": "OfficeActivity\r\n| where OfficeWorkload == 'Exchange' \r\n| summarize Count = count() by Operation\r\n| order by Count desc, Operation asc\r\n| project Value = Operation, Label = strcat(Operation, ' - ', Count)",
