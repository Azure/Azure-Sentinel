{
  "connector": "Workday Email Activity",
  "deployment_method": "terraform",
  "deployment_reason": "Deploys solution skeleton (content package, connector definition, DCE, DCR) via Terraform. Connection is established manually through the Sentinel portal due to OAuth 2.0 authorization code flow requiring browser-based authentication.",
  "workspace_region": "north-europe",
  "tables": [
    "ASimAuditEventLogs"
  ],
  "connector_configuration": {
    "connector_type": "RestApiPoller (CCP)",
    "auth_type": "OAuth 2.0 Authorization Code",
    "data_collection_endpoint": "dce-workday-{env}-ne",
    "data_collection_rule": "dcr-workday-email-{env}-ne",
    "query_window_in_min": 5
  },
  "retention": {
    "analytics_tier": {
      "retention": "3 months",
      "billing": false
    },
    "datalake_tier": {
      "retention": "12 months"
    }
  },
  "scope_collected": {
    "dev": "Workday Implementation Tenant",
    "nonprod": "Workday Production Tenant",
    "prod": "Workday Production Tenant"
  },
  "deployment_history": []
}
