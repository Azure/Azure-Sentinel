{
    "name": "WorkdayEmailDCR",
    "apiVersion": "2022-06-01",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
      "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
      "streamDeclarations": {
        "Custom-WorkdayEmailActivity": {
          "columns": [
            {
              "name": "DateTimeStamp",
              "type": "string"
            },
            {
              "name": "EmailIDAfter",
              "type": "string"
            },
            {
              "name": "EmailIDBefore",
              "type": "string"
            },
            {
              "name": "Employee_ID",
              "type": "string"
            },
            {
              "name": "Login_ID",
              "type": "string"
            },
            {
              "name": "TargetID",
              "type": "string"
            },
            {
              "name": "Worker",
              "type": "string"
            }
          ]
        }
      },
      "destinations": {
        "logAnalytics": [
          {
            "workspaceResourceId": "{{workspaceResourceId}}",
            "name": "workspace"
          }
        ]
      },
      "dataFlows": [
        {
          "streams": [
            "Custom-WorkdayEmailActivity"
          ],
          "destinations": [
            "workspace"
          ],
          "transformKql": "source\n| project TimeGenerated = todatetime(DateTimeStamp), EventStartTime = todatetime(DateTimeStamp), EventEndTime = todatetime(DateTimeStamp), EventCount = toint(1), EventProduct = \"Workday\", EventVendor = \"Workday\", EventSchemaVersion = \"0.1\", EventResult = \"Success\", EventType = \"Set\", Operation = \"Email Activity\", ObjectType = \"Other\", Object = Worker, OldValue = EmailIDBefore, NewValue = EmailIDAfter, ActorUserId = Employee_ID, ActorUsername = Login_ID, EventOriginalUid = TargetID",
          "outputStream": "Microsoft-ASimAuditEventLogs"
        }
      ]
    }
}
