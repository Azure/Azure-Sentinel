[
    {
        "name": "workdayEmailDCR",
        "apiVersion": "2021-09-01-preview",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "properties": {
            "streamDeclarations": {
                "Custom-ASimAuditEventLogs": {
                    "columns": [
                        {
                            "name": "DateTimeStamp",
                            "type": "string"
                        },
                        {
                            "name": "EmailIDAfter",
                            "type": "string"
                        },
                        {
                            "name": "EmailIDBefore",
                            "type": "string"
                        },
                        {
                            "name": "Employee_ID",
                            "type": "string"
                        },
                        {
                            "name": "Login_ID",
                            "type": "string"
                        },
                        {
                            "name": "TargetID",
                            "type": "string"
                        },
                        {
                            "name": "Worker",
                            "type": "string"
                        }
                    ]
                }
            },
            "dataSources": {},
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "clv2ws1"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [
                        "Custom-ASimAuditEventLogs"
                    ],
                    "destinations": [
                        "clv2ws1"
                    ],
                    "transformKql": "source\n| extend TimeGenerated = todatetime(DateTimeStamp), EventStartTime = todatetime(DateTimeStamp), EventEndTime = todatetime(DateTimeStamp)\n| project-rename OldValue = EmailIDBefore, NewValue = EmailIDAfter, ActorUserId = Employee_ID, ActorUsername = Login_ID, EventOriginalUid = TargetID, Object = Worker\n| extend EventCount = toint(1), EventSchema = \"AuditEvent\", EventResult = \"Success\", EventProduct = \"Workday\", EventVendor = \"Workday\", EventSchemaVersion = \"0.1\", ObjectType = \"Other\", EventType = \"Set\", Operation = \"Email Activity\", Dvc = \"Workday\"",
                    "outputStream": "Microsoft-ASimAuditEventLogs"
                }
            ],
            "dataCollectionEndpointId": "[concat('/subscriptions/',variables('subscriptionID'),'/resourceGroups/',resourceGroup().name,'/providers/Microsoft.Insights/dataCollectionEndpoints/',{{dataCollectionEndpointId}}"
        }
    }
]
