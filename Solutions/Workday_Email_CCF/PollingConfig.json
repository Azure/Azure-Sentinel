[
    {
        "name": "WorkdayEmailCCPPolling",
        "apiVersion": "2022-10-01-preview",
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "properties": {
            "connectorDefinitionName":"WorkdayEmailCCPDefinition",
            "dcrConfig": {
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
                "streamName": "Custom-ASimAuditEventLogs"
            },
            "dataType": "Workday Email Activity Logs API",
            "response": {
                "eventsJsonPaths": [
                    "$.Report_Entry"
                ]
            },
            "paging": {
                "pagingType": "Offset",
                "pageSize": 100,
                "PageSizeParaName": "limit",
                "OffsetParaName": "offset"
            },
            "auth": {
                "type": "OAuth2",
                "ClientSecret": "{{clientSecret}}",
                "ClientId": "{{clientId}}",
                "AuthorizationCode": "{{authorizationCode}}",
                "GrantType": "authorization_code",
                "TokenEndpoint": "{{tokenEndpoint}}",
                "tokenEndpointHeaders": {
                    "Accept": "application/json",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "authorizationEndpoint": "{{authorizationEndpoint}}",
                "authorizationEndpointQueryParameters": {
                    "redirect": "n"
                },
                "redirectUri": "{{redirectUri}}"
            },
            "request": {
                "apiEndpoint": "{{apiEndpoint}}",
                "rateLimitQPS": 10,
                "queryWindowInMin": "[[int(parameters('queryWindow')[0])]",
                "httpMethod": "GET",
                "retryCount": 3,
                "timeoutInSeconds": 60,
                "headers": {
                    "Accept": "application/json"
                },
                "StartTimeAttributeName": "After_Date_Time",
                "EndTimeAttributeName": "Before_Date_Time",
                "queryParameters": {
                    "After_Date_Time": "{_QueryWindowStartTime}",
                    "Before_Date_Time": "{_QueryWindowEndTime}",
                    "format": "json"
                }
            },
            "isActive": true
        }
    }
]
