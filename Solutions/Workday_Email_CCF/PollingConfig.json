{
    "name": "[[concat('WorkdayEmail-', uniqueString(parameters('apiEndpoint')))]",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "WorkdayEmailCCPDefinition",
      "dataType": "ASimAuditEventLogs",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-WorkdayEmailActivity"
      },
      "auth": {
        "type": "OAuth2",
        "ClientId": "{{clientId}}",
        "ClientSecret": "{{clientSecret}}",
        "AuthorizationCode": "{{authorizationCode}}",
        "GrantType": "authorization_code",
        "TokenEndpoint": "{{tokenEndpoint}}",
        "AuthorizationEndpoint": "{{authorizationEndpoint}}",
        "RedirectUri": "https://portal.azure.com/TokenAuthorize/ExtensionName/Microsoft_Azure_Security_Insights",
        "Scope": "{{scope}}",
        "TokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "AuthorizationEndpointQueryParameters": {
          "redirect": "n"
        }
      },
      "request": {
        "apiEndpoint": "{{apiEndpoint}}",
        "httpMethod": "GET",
        "rateLimitQPS": 10,
        "queryWindowInMin": 5,
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json"
        },
        "startTimeAttributeName": "After_Date_Time",
        "endTimeAttributeName": "Before_Date_Time",
        "queryParameters": {
          "After_Date_Time": "{_QueryWindowStartTime}",
          "Before_Date_Time": "{_QueryWindowEndTime}",
          "format": "json"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.Report_Entry"
        ],
        "format": "json"
      },
      "addOnAttributes": {
        "apiEndpoint": "{{apiEndpoint}}"
      }
    }
}
