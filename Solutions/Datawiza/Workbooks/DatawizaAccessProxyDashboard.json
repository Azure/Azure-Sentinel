    },
    {
      "type": 1,
      "content": {
        "json": "### 📊 Traffic & Request Analysis"
      },
      "name": "text - 14"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize TotalRequests = count()",
        "size": 1,
        "title": "Total Requests",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "TotalRequests"
          },
          "showBorder": true
        }
      },
      "customWidth": "22",
      "name": "Total Requests"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize Count = count() by Status = tostring(Status_d)\r\n| order by Count desc",
        "size": 0,
        "title": "Requests by Status Code",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "40",
      "name": "Requests by Status Code"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status}) \r\n| summarize Count = count() by RuleAction_s",
        "size": 0,
        "title": "Rule Action Breakdown",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "38",
      "name": "Rule Action Breakdown"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| where RuleAction_s == \"block\"\r\n| project TimeGenerated, ClientIP_s, Method_s, Uri_s, Status_d, OpaStatus_s\r\n| order by TimeGenerated desc",
        "size": 0,
        "title": "Blocked Requests",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table"
      },
      "name": "Blocked Requests"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n### 🌐 Request & Client Analysis"
      },
      "name": "text - 16"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL \r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize Count = count() by Uri_s | top 10 by Count desc",
        "size": 0,
        "title": "Top Requested URIs",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "Top Requested URIs"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL \r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize Count = count() by ClientIP_s | top 10 by Count desc",
        "size": 0,
        "title": "Top Client IPs",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "Top Client IPs"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n### 📈 Trend Analysis"
      },
      "name": "text - 15"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL \r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize AvgResponseTime = avg(RequestTimeInSec_d) by bin(TimeGenerated, 1d)",
        "size": 0,
        "title": "Average Response Time Trend",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "Average Response Time Trend"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n### 🛡️ Security & Access Control"
      },
      "name": "text - 17"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL \r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| where isnotempty(OpaStatus_s) | summarize Count = count() by OpaStatus_s",
        "size": 0,
        "title": "OPA Policy Decision",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "OPA Policy Decision"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| extend AuthState = iff(isempty(UserName_s), \"Unauthenticated\", \"Authenticated\")\r\n| summarize Count = count() by AuthState",
        "size": 0,
        "title": "Authenticated vs Unauthenticated Requests",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "Authenticated vs Unauthenticated Requests"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n### ⚡ Performance Monitoring"
      },
      "name": "text - 18"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| summarize AvgBytes = avg(BytesSent_d) by Uri_s\r\n| order by AvgBytes desc",
        "size": 0,
        "title": "Response Size Distribution",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "Response Size Distribution"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| extend ResultCategory = case(Status_d < 400, \"Success\", Status_d < 500, \"Client Error\", \"Server Error\")\r\n| summarize Count = count() by ResultCategory",
        "size": 0,
        "title": "Success vs Error Rate",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "name": "Success vs Error Rate"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "datawizaserveraccess_CL\r\n| where TimeGenerated {TimeRange}\r\n| where RuleAction_s in ({RuleAction})\r\n| where tostring(Status_d) in ({Status})\r\n| top 10 by RequestTimeInSec_d desc\r\n| project TimeGenerated, ClientIP_s, Uri_s, RequestTimeInSec_d, Status_d",
        "size": 0,
        "title": "Slowest Requests",
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Slowest Requests"
    }
  ],
