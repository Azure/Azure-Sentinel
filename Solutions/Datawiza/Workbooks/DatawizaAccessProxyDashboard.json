            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "datawizaserveraccess_CL\r\n| distinct Status = tostring(Status_d)",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
