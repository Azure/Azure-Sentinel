            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "GCP_IAM_CL\r\n| project EventSeverity = severity_s\r\n| where isnotempty(EventSeverity)\r\n| summarize count() by EventSeverity",
              "size": 3,
              "title": "Events by Severity",
              "timeContext": {
