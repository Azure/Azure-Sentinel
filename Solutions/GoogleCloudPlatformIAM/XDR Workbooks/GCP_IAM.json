                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "GCP_IAM_CL\r\n| project User=column_ifexists('payload_authenticationInfo_principalEmail_s', '')\r\n| where isnotempty(User)\r\n| summarize Users = dcount(User)",
                    "size": 3,
