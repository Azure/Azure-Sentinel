      "content": {
        "version": "KqlItem/1.0",
        "query": "OracleDatabaseAuditEvent\r\n| make-series TotalEvents = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain};",
        "size": 0,
        "title": "Events over time",
