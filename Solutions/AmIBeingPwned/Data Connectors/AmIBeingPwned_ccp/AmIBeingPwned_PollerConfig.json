[
  {
    "name": "AmIBeingPwnedEventsPoller",
    "apiVersion": "2022-10-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "AmIBeingPwnedEventsConnector",
      "dataType": "AIBPEvents_CL",
      "dcrConfig": {
        "streamName": "Custom-AIBPEvents_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apiKey')]",
        "ApiKeyName": "Authorization",
        "ApiKeyIdentifier": "Bearer"
      },
      "request": {
        "apiEndpoint": "https://app.amibeingpwned.com/v1/events/list",
        "httpMethod": "POST",
        "rateLimitQPS": 5,
        "paginatedCallsPerSecond": 5.0,
        "queryWindowInMin": 5,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "isPostPayloadJson": true,
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "User-Agent": "Microsoft-Sentinel-AmIBeingPwned-Connector"
        },
        "queryParametersTemplate": "{\"from\":\"{_QueryWindowStartTime}\",\"to\":\"{_QueryWindowEndTime}\",\"limit\":500}"
      },
      "response": {
        "eventsJsonPaths": ["$.data.events"],
        "format": "json"
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.data.nextCursor",
        "nextPageParaName": "cursor",
        "pagingInfoPlacement": "RequestBody"
      }
    }
  }
]
