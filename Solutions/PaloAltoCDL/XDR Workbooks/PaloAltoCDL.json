        "query": "PaloAltoCDLEvent\r\n| where EventResourceId contains \"THREAT\"\r\n| where isnotempty(Url)\r\n| summarize ThreatEventUrl = count() by Url\r\n| top 10 by ThreatEventUrl desc ",
        "size": 3,
        "title": "Top Threat Event URLs ",
