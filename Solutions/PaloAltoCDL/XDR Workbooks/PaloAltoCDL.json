                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "PaloAltoCDLEvent\r\n| where isnotempty(SrcIpAddr)\r\n| summarize dcount(SrcIpAddr) ",
                    "size": 3,
                    "title": "Unique IP Addresses",
                    "timeContext": {
                      "durationMs": 7776000000
