    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "PaloAltoCDLEvent\r\n| where isnotempty(DstUsername)\r\n| sort by TimeGenerated desc \r\n| project User=DstUsername, ThreatEvent=strcat(iff(EventResourceId contains \"THREAT\", '\u274c', '\u2705')), SourceAddress=SrcIpAddr",
        "size": 0,
        "title": "Latest events",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": "advancedHunting",
        "gridSettings": {
