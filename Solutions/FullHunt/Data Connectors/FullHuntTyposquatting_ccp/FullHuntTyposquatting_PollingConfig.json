[
  {
    "name": "FullHuntTyposquattingPoller",
    "apiVersion": "2025-09-01",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "FullHuntTyposquattingConnector",
      "dataType": "FullHuntTyposquatting_CL",
      "dcrConfig": {
        "streamName": "Custom-FullHuntTyposquatting_API",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "{{apiKey}}",
        "ApiKeyName": "X-API-KEY",
        "IsApiKeyInPostPayload": false
      },
      "request": {
        "apiEndpoint": "https://fullhunt.io/api/v1/enterprise/darkweb/typosquatting",
        "httpMethod": "GET",
        "queryWindowInMin": 15,
        "queryTimeFormat": "dd/MM/yyyy HH:mm:ss",
        "startTimeAttributeName": "from",
        "endTimeAttributeName": "to",
        "rateLimitQPS": 1,
        "paginatedCallsPerSecond": 0.5,
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Microsoft-Sentinel-FullHunt-CCF"
        }
      },
      "paging": {
        "pagingType": "CountBasedPaging",
        "pageNumberParaName": "page",
        "pagingInfoPlacement": "QueryString",
        "pageSize": 10,
        "zeroBasedIndexing": false,
        "totalResultsJsonPath": "$.results.total",
        "pageNumberJsonPath": "$.results.page",
        "pageCountJsonPath": "$.results.pages"
      },
      "response": {
        "eventsJsonPaths": [
          "$.results.items"
        ],
        "format": "json"
      }
    }
  }
]
