[
  {
    "name": "FullHuntVulnerabilitiesPoller",
    "apiVersion": "2025-09-01",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "FullHuntVulnerabilitiesConnector",
      "dataType": "FullHuntVulnerabilities_CL",
      "dcrConfig": {
        "streamName": "Custom-FullHuntVulnerabilities_API",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "{{apiKey}}",
        "ApiKeyName": "X-API-KEY",
        "IsApiKeyInPostPayload": false
      },
      "request": {
        "apiEndpoint": "https://fullhunt.io/api/v1/enterprise/vulnerabilities",
        "httpMethod": "GET",
        "queryWindowInMin": 1440,
        "rateLimitQPS": 1,
        "retryCount": 3,
        "timeoutInSeconds": 300,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Microsoft-Sentinel-FullHunt-CCF"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$"
        ],
        "format": "json"
      }
    }
  }
]
