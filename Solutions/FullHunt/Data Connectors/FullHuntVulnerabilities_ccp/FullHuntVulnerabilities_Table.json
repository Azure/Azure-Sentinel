{
  "name": "FullHuntVulnerabilities_CL",
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "apiVersion": "2025-07-01",
  "tags": {},
  "properties": {
    "schema": {
      "name": "FullHuntVulnerabilities_CL",
      "columns": [
        {
          "name": "TimeGenerated",
          "type": "datetime",
          "description": "Time (UTC) of the daily snapshot that ingested this record"
        },
        {
          "name": "IssueId",
          "type": "long",
          "description": "FullHunt issue ID. Unique per vulnerability; use it to deduplicate across snapshots"
        },
        {
          "name": "VulnerabilityId",
          "type": "string",
          "description": "FullHunt vulnerability check ID"
        },
        {
          "name": "Status",
          "type": "int",
          "description": "Status code: 0 new, 1 triaged, 2 fixed, -1 ignored"
        },
        {
          "name": "StatusName",
          "type": "string",
          "description": "Status: New, Triaged, Fixed or Ignored"
        },
        {
          "name": "Title",
          "type": "string",
          "description": "Vulnerability title"
        },
        {
          "name": "Host",
          "type": "string",
          "description": "Affected host"
        },
        {
          "name": "Domain",
          "type": "string",
          "description": "Domain of the affected host"
        },
        {
          "name": "IdentifiedAt",
          "type": "datetime",
          "description": "Time (UTC) FullHunt first identified the vulnerability"
        },
        {
          "name": "LastSeen",
          "type": "datetime",
          "description": "Time (UTC) FullHunt last observed the vulnerability"
        },
        {
          "name": "Severity",
          "type": "string",
          "description": "Severity, e.g. low, medium, high, critical"
        },
        {
          "name": "CustomSeverity",
          "type": "string",
          "description": "Severity override set in FullHunt, if any"
        },
        {
          "name": "VulnerabilityType",
          "type": "string",
          "description": "Vulnerability type"
        },
        {
          "name": "HostType",
          "type": "string",
          "description": "Type of the affected host"
        },
        {
          "name": "AffectedLocation",
          "type": "string",
          "description": "Affected URL or location"
        },
        {
          "name": "Description",
          "type": "string",
          "description": "Vulnerability description"
        },
        {
          "name": "Recommendation",
          "type": "string",
          "description": "Remediation recommendation"
        },
        {
          "name": "References",
          "type": "string",
          "description": "Reference links"
        },
        {
          "name": "Impact",
          "type": "string",
          "description": "Impact description"
        },
        {
          "name": "AutoValidated",
          "type": "bool",
          "description": "True if FullHunt automatically validated the vulnerability"
        }
      ]
    }
  }
}
