{
  "name": "FullHuntAlertsDCR",
  "apiVersion": "2024-03-11",
  "location": "{{location}}",
  "type": "Microsoft.Insights/dataCollectionRules",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-FullHuntAlerts_API": {
        "columns": [
          {
            "name": "id",
            "type": "long"
          },
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "host",
            "type": "string"
          },
          {
            "name": "timestamp",
            "type": "long"
          },
          {
            "name": "message",
            "type": "string"
          },
          {
            "name": "is_seen",
            "type": "boolean"
          },
          {
            "name": "type",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-FullHuntAlerts_API"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend AlertTime = datetime(1970-01-01) + (tolong(['timestamp']) * 1s) | project TimeGenerated = AlertTime, AlertTime, AlertId = tolong(['id']), AlertType = tostring(['type']), Title = tostring(['title']), Host = tostring(['host']), Message = tostring(['message']), IsSeen = tobool(['is_seen'])",
        "outputStream": "Custom-FullHuntAlerts_CL"
      }
    ]
  }
}
