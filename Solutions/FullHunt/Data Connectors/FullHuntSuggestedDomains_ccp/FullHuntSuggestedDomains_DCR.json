{
  "name": "FullHuntSuggestedDomainsDCR",
  "apiVersion": "2024-03-11",
  "location": "{{location}}",
  "type": "Microsoft.Insights/dataCollectionRules",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-FullHuntSuggestedDomains_API": {
        "columns": [
          {
            "name": "suggested_domain",
            "type": "string"
          },
          {
            "name": "identification_method",
            "type": "string"
          },
          {
            "name": "discovery_data",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-FullHuntSuggestedDomains_API"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend DiscoveredAt = todatetime(['discovery_data']) | project TimeGenerated = iff(isnull(DiscoveredAt), now(), DiscoveredAt), DiscoveredAt, SuggestedDomain = tostring(['suggested_domain']), IdentificationMethod = tostring(['identification_method'])",
        "outputStream": "Custom-FullHuntSuggestedDomains_CL"
      }
    ]
  }
}
