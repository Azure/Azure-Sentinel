{
  "name": "FullHuntPotentialPhishingDCR",
  "apiVersion": "2024-03-11",
  "location": "{{location}}",
  "type": "Microsoft.Insights/dataCollectionRules",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-FullHuntPotentialPhishing_API": {
        "columns": [
          {
            "name": "id",
            "type": "long"
          },
          {
            "name": "domain_name",
            "type": "string"
          },
          {
            "name": "date_added",
            "type": "long"
          },
          {
            "name": "last_seen",
            "type": "long"
          },
          {
            "name": "type",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-FullHuntPotentialPhishing_API"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend DateAdded = datetime(1970-01-01) + (tolong(['date_added']) * 1s), LastSeen = datetime(1970-01-01) + (tolong(['last_seen']) * 1s) | project TimeGenerated = DateAdded, DateAdded, LastSeen, RecordId = tolong(['id']), DomainName = tostring(['domain_name']), RecordType = tostring(['type'])",
        "outputStream": "Custom-FullHuntPotentialPhishing_CL"
      }
    ]
  }
}
