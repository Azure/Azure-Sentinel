{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "FullHunt - Host Enrichment",
    "description": "Enriches a Host entity (host name plus DNS domain) with FullHunt's attack surface record: IP, live status, open ports, ASN, cloud and CDN, tags, TLS certificate and last seen. Adds the results as an incident comment. Uses 2 FullHunt credits per run.",
    "prerequisites": [
      "Deploy the FullHunt custom connector (Playbooks/FullHuntCustomConnector) to the same resource group first.",
      "A FullHunt API key. Each lookup consumes 1 FullHunt credit.",
      "The intel lookup requires the FullHunt Data Intelligence module; without it the comment notes HTTP 403 and the host lookup still runs."
    ],
    "postDeployment": [
      "Authorize the FullHunt API connection: open the Logic App, select API connections, choose the FullHunt connection, select Edit API connection, enter your FullHunt API key and save.",
      "Assign the Microsoft Sentinel Responder role to the playbook's managed identity on the Microsoft Sentinel workspace, so it can read incidents and add comments.",
      "Run the playbook from a Host entity in an incident, or from an automation rule. Host names that are not public DNS names (for example internal machine names) return no FullHunt data."
    ],
    "lastUpdateTime": "2026-10-03T00:00:00.000Z",
    "entities": [
      "host"
    ],
    "tags": [
      "Enrichment",
      "FullHunt"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "FullHunt"
    },
    "releaseNotes": [
      {
        "version": "1.0.0",
        "title": "FullHunt - Host Enrichment",
        "notes": [
          "Initial version"
        ]
      }
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "FullHunt-EnrichHost",
      "type": "string",
      "metadata": {
        "description": "Name of the playbook (Logic App)"
      }
    },
    "FullHuntConnectorName": {
      "defaultValue": "FullHuntCustomConnector",
      "type": "string",
      "metadata": {
        "description": "Name of the deployed FullHunt custom connector"
      }
    }
  },
  "variables": {
    "FullHuntConnectionName": "[concat('FullHunt-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('FullHuntConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('FullHuntConnectionName')]",
        "api": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateVersion": "1.0.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_entity": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/entity/@{encodeURIComponent('Host')}"
              }
            }
          },
          "actions": {
            "Initialize_Host": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Host",
                    "type": "string",
                    "value": "@{toLower(if(empty(coalesce(triggerBody()?['Entity']?['properties']?['DnsDomain'], '')), coalesce(triggerBody()?['Entity']?['properties']?['HostName'], ''), concat(coalesce(triggerBody()?['Entity']?['properties']?['HostName'], ''), '.', coalesce(triggerBody()?['Entity']?['properties']?['DnsDomain'], ''))))}"
                  }
                ]
              },
              "runAfter": {}
            },
            "Call_GetHost": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/host/@{encodeURIComponent(variables('Host'))}",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                }
              },
              "runAfter": {
                "Initialize_Host": [
                  "Succeeded"
                ]
              }
            },
            "Result_GetHost": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_GetHost')?['statusCode'], 0), 200), body('Call_GetHost'), json('{}'))",
              "runAfter": {
                "Call_GetHost": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Call_IntelHost": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/intel/host",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "host": "@variables('Host')"
                }
              },
              "runAfter": {
                "Result_GetHost": [
                  "Succeeded"
                ]
              }
            },
            "Result_IntelHost": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_IntelHost')?['statusCode'], 0), 200), body('Call_IntelHost'), json('{}'))",
              "runAfter": {
                "Call_IntelHost": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Compose_Comment": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Comment",
                    "type": "string",
                    "value": "<h2 class=\"editor-heading-h2\">FullHunt host enrichment: @{variables('Host')}</h2><table><tbody><tr><td>IP address</td><td>@{outputs('Result_GetHost')?['ip_address']}</td></tr><tr><td>Live / HTTP status</td><td>@{outputs('Result_GetHost')?['is_live']} / @{outputs('Result_GetHost')?['http_status_code']} @{outputs('Result_GetHost')?['http_title']}</td></tr><tr><td>Open ports</td><td>@{join(take(coalesce(outputs('Result_GetHost')?['network_ports'], json('[]')), 50), ', ')}</td></tr><tr><td>ASN / Organization / Country</td><td>@{outputs('Result_GetHost')?['ip_metadata']?['asn']} / @{outputs('Result_GetHost')?['ip_metadata']?['organization']} / @{outputs('Result_GetHost')?['ip_metadata']?['country_name']}</td></tr><tr><td>Cloud / CDN</td><td>@{outputs('Result_GetHost')?['cloud']?['provider']} @{outputs('Result_GetHost')?['cloud']?['region']} / @{outputs('Result_GetHost')?['cdn']}</td></tr><tr><td>Tags</td><td>@{join(take(coalesce(outputs('Result_GetHost')?['tags'], json('[]')), 25), ', ')}</td></tr><tr><td>Categories</td><td>@{join(take(coalesce(outputs('Result_GetHost')?['categories'], json('[]')), 25), ', ')}</td></tr><tr><td>URLs observed</td><td>@{length(coalesce(outputs('Result_GetHost')?['urls'], json('[]')))}</td></tr><tr><td>Certificate issuer / expires</td><td>@{outputs('Result_GetHost')?['cert_object']?['issuer_organization']} / @{outputs('Result_GetHost')?['cert_object']?['not_after']}</td></tr><tr><td>Last seen (UTC)</td><td>@{if(greater(int(coalesce(outputs('Result_GetHost')?['last_seen'], 0)), 0), formatDateTime(addSeconds('1970-01-01T00:00:00Z', int(coalesce(outputs('Result_GetHost')?['last_seen'], 0))), 'yyyy-MM-dd HH:mm'), '')}</td></tr><tr><td>Intel ASN / Organization / PTR</td><td>@{first(coalesce(outputs('Result_IntelHost')?['results'], json('[]')))?['asn']} / @{first(coalesce(outputs('Result_IntelHost')?['results'], json('[]')))?['organization']} / @{first(coalesce(outputs('Result_IntelHost')?['results'], json('[]')))?['dns_ptr']}</td></tr></tbody></table>@{if(equals(coalesce(outputs('Call_GetHost')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt host lookup: HTTP ', string(coalesce(outputs('Call_GetHost')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_GetHost'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_GetHost'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_IntelHost')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt intel host: HTTP ', string(coalesce(outputs('Call_IntelHost')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_IntelHost'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_IntelHost'), '')), '<', '&lt;')))), '</i>'))}"
                  }
                ]
              },
              "runAfter": {
                "Result_IntelHost": [
                  "Succeeded"
                ]
              }
            },
            "Condition_Incident": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@triggerBody()?['IncidentArmID']",
                        "@null"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Add_comment_to_incident_(V3)": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/Incidents/Comment",
                    "body": {
                      "incidentArmId": "@triggerBody()?['IncidentArmID']",
                      "message": "@{substring(variables('Comment'), 0, min(length(variables('Comment')), 30000))}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Compose_Comment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "fullhunt": {
                "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]",
                "connectionName": "[variables('FullHuntConnectionName')]"
              }
            }
          }
        }
      }
    }
  ]
}
