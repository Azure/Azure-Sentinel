{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "FullHunt - Incident Enrichment",
    "description": "Enriches the IP, Host, URL and DNS entities of a Microsoft Sentinel incident with FullHunt context and adds one consolidated incident comment: IP network and Tor context, host exposure (IP, live status, open ports, organization), and domain context (apex, known hosts, WHOIS). Uses up to 2 credits per IP and 1 per host, URL or domain, capped by MaxEntitiesPerType.",
    "prerequisites": [
      "Deploy the FullHunt custom connector (Playbooks/FullHuntCustomConnector) to the same resource group first.",
      "A FullHunt API key. Each lookup consumes 1 FullHunt credit."
    ],
    "postDeployment": [
      "Authorize the FullHunt API connection: open the Logic App, select API connections, choose the FullHunt connection, select Edit API connection, enter your FullHunt API key and save.",
      "Assign the Microsoft Sentinel Responder role to the playbook's managed identity on the Microsoft Sentinel workspace, so it can read incidents and add comments.",
      "Create an automation rule that runs this playbook when incidents are created. For deeper single-entity lookups use the FullHunt IP, Host and Domain enrichment playbooks."
    ],
    "lastUpdateTime": "2026-10-03T00:00:00.000Z",
    "entities": [
      "ip",
      "host",
      "dnsresolution",
      "url"
    ],
    "tags": [
      "Enrichment",
      "FullHunt"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "FullHunt"
    },
    "releaseNotes": [
      {
        "version": "1.0.0",
        "title": "FullHunt - Incident Enrichment",
        "notes": [
          "Initial version"
        ]
      }
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "FullHunt-EnrichIncident",
      "type": "string",
      "metadata": {
        "description": "Name of the playbook (Logic App)"
      }
    },
    "FullHuntConnectorName": {
      "defaultValue": "FullHuntCustomConnector",
      "type": "string",
      "metadata": {
        "description": "Name of the deployed FullHunt custom connector"
      }
    },
    "MaxEntitiesPerType": {
      "defaultValue": 5,
      "type": "int",
      "metadata": {
        "description": "Maximum number of entities of each type to look up per incident (limits FullHunt credit use)"
      }
    }
  },
  "variables": {
    "FullHuntConnectionName": "[concat('FullHunt-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('FullHuntConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('FullHuntConnectionName')]",
        "api": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateVersion": "1.0.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_Comment": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Comment",
                    "type": "string",
                    "value": "<h2 class=\"editor-heading-h2\">FullHunt incident enrichment</h2>"
                  }
                ]
              },
              "runAfter": {}
            },
            "Initialize_MaxEntities": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "MaxEntities",
                    "type": "integer",
                    "value": "[parameters('MaxEntitiesPerType')]"
                  }
                ]
              },
              "runAfter": {
                "Initialize_Comment": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_Rows": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Rows",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_MaxEntities": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_Apex": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Apex",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_Rows": [
                  "Succeeded"
                ]
              }
            },
            "Entities_-_Get_IPs": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/ip"
              },
              "runAfter": {
                "Initialize_Apex": [
                  "Succeeded"
                ]
              }
            },
            "Entities_-_Get_Hosts": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/host"
              },
              "runAfter": {
                "Entities_-_Get_IPs": [
                  "Succeeded"
                ]
              }
            },
            "Entities_-_Get_DNS": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/dnsresolution"
              },
              "runAfter": {
                "Entities_-_Get_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "Entities_-_Get_URLs": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/url"
              },
              "runAfter": {
                "Entities_-_Get_DNS": [
                  "Succeeded"
                ]
              }
            },
            "For_each_IP": {
              "type": "Foreach",
              "foreach": "@take(coalesce(body('Entities_-_Get_IPs')?['IPs'], json('[]')), variables('MaxEntities'))",
              "actions": {
                "Call_IP_NexusIpLookup": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/nexus/ip-lookup",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    },
                    "queries": {
                      "query": "@{items('For_each_IP')?['Address']}"
                    }
                  },
                  "runAfter": {}
                },
                "Result_IP_NexusIpLookup": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_IP_NexusIpLookup')?['statusCode'], 0), 200), body('Call_IP_NexusIpLookup'), json('{}'))",
                  "runAfter": {
                    "Call_IP_NexusIpLookup": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Call_IP_TorCheck": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/nexus/tor/check-ip",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    },
                    "queries": {
                      "ip": "@{items('For_each_IP')?['Address']}"
                    }
                  },
                  "runAfter": {
                    "Result_IP_NexusIpLookup": [
                      "Succeeded"
                    ]
                  }
                },
                "Result_IP_TorCheck": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_IP_TorCheck')?['statusCode'], 0), 200), body('Call_IP_TorCheck'), json('{}'))",
                  "runAfter": {
                    "Call_IP_TorCheck": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Append_IP_Row": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Rows",
                    "value": "<tr><td>@{items('For_each_IP')?['Address']}</td><td>@{outputs('Result_IP_NexusIpLookup')?['result']?['asn']} @{outputs('Result_IP_NexusIpLookup')?['result']?['organization']}</td><td>@{outputs('Result_IP_NexusIpLookup')?['result']?['country_name']}</td><td>@{outputs('Result_IP_NexusIpLookup')?['result']?['cloud_provider']} @{outputs('Result_IP_NexusIpLookup')?['result']?['cdn_provider']}</td><td>@{outputs('Result_IP_NexusIpLookup')?['result']?['hosts_count']}</td><td>@{if(equals(outputs('Result_IP_TorCheck')?['status'], 200), 'Yes', if(equals(outputs('Result_IP_TorCheck')?['status'], 404), 'No', 'Unknown'))}</td><td>@{if(not(contains(items('For_each_IP')?['Address'], ':')), '', '<br/><i>IPv6 address: FullHunt IP lookups support IPv4 only.</i>')}@{if(equals(coalesce(outputs('Call_IP_NexusIpLookup')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt IP lookup: HTTP ', string(coalesce(outputs('Call_IP_NexusIpLookup')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_IP_NexusIpLookup'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_IP_NexusIpLookup'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_IP_TorCheck')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt Tor check: HTTP ', string(coalesce(outputs('Call_IP_TorCheck')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_IP_TorCheck'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_IP_TorCheck'), '')), '<', '&lt;')))), '</i>'))}</td></tr>"
                  },
                  "runAfter": {
                    "Result_IP_TorCheck": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Entities_-_Get_URLs": [
                  "Succeeded"
                ]
              }
            },
            "Append_IP_Table": {
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "Comment",
                "value": "@{if(empty(variables('Rows')), '', concat('<h3>IP addresses</h3><table><tbody><tr><th>IP</th><th>ASN / Organization</th><th>Country</th><th>Cloud / CDN</th><th>Hosts on IP</th><th>Tor exit</th><th>Notes</th></tr>', variables('Rows'), '</tbody></table>'))}"
              },
              "runAfter": {
                "For_each_IP": [
                  "Succeeded"
                ]
              }
            },
            "Reset_Rows_Hosts": {
              "type": "SetVariable",
              "inputs": {
                "name": "Rows",
                "value": ""
              },
              "runAfter": {
                "Append_IP_Table": [
                  "Succeeded"
                ]
              }
            },
            "For_each_Host": {
              "type": "Foreach",
              "foreach": "@take(coalesce(body('Entities_-_Get_Hosts')?['Hosts'], json('[]')), variables('MaxEntities'))",
              "actions": {
                "Call_Host_GetHost": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/host/@{encodeURIComponent(toLower(if(empty(coalesce(items('For_each_Host')?['DnsDomain'], '')), coalesce(items('For_each_Host')?['HostName'], ''), concat(coalesce(items('For_each_Host')?['HostName'], ''), '.', coalesce(items('For_each_Host')?['DnsDomain'], '')))))}",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    }
                  },
                  "runAfter": {}
                },
                "Result_Host_GetHost": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_Host_GetHost')?['statusCode'], 0), 200), body('Call_Host_GetHost'), json('{}'))",
                  "runAfter": {
                    "Call_Host_GetHost": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Append_Host_Row": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Rows",
                    "value": "<tr><td>@{toLower(if(empty(coalesce(items('For_each_Host')?['DnsDomain'], '')), coalesce(items('For_each_Host')?['HostName'], ''), concat(coalesce(items('For_each_Host')?['HostName'], ''), '.', coalesce(items('For_each_Host')?['DnsDomain'], ''))))}</td><td>@{outputs('Result_Host_GetHost')?['ip_address']}</td><td>@{outputs('Result_Host_GetHost')?['is_live']}</td><td>@{join(take(coalesce(outputs('Result_Host_GetHost')?['network_ports'], json('[]')), 20), ', ')}</td><td>@{outputs('Result_Host_GetHost')?['ip_metadata']?['organization']}</td><td>@{if(greater(int(coalesce(outputs('Result_Host_GetHost')?['last_seen'], 0)), 0), formatDateTime(addSeconds('1970-01-01T00:00:00Z', int(coalesce(outputs('Result_Host_GetHost')?['last_seen'], 0))), 'yyyy-MM-dd HH:mm'), '')}</td><td>@{if(equals(coalesce(outputs('Call_Host_GetHost')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt host lookup: HTTP ', string(coalesce(outputs('Call_Host_GetHost')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_Host_GetHost'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_Host_GetHost'), '')), '<', '&lt;')))), '</i>'))}</td></tr>"
                  },
                  "runAfter": {
                    "Result_Host_GetHost": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Reset_Rows_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "For_each_URL": {
              "type": "Foreach",
              "foreach": "@take(coalesce(body('Entities_-_Get_URLs')?['URLs'], json('[]')), variables('MaxEntities'))",
              "actions": {
                "Call_URL_GetHost": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/host/@{encodeURIComponent(toLower(first(split(last(split(first(split(first(split(last(split(coalesce(items('For_each_URL')?['Url'], ''), '://')), '/')), '?')), '@')), ':'))))}",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    }
                  },
                  "runAfter": {}
                },
                "Result_URL_GetHost": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_URL_GetHost')?['statusCode'], 0), 200), body('Call_URL_GetHost'), json('{}'))",
                  "runAfter": {
                    "Call_URL_GetHost": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Append_URL_Row": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Rows",
                    "value": "<tr><td>@{toLower(first(split(last(split(first(split(first(split(last(split(coalesce(items('For_each_URL')?['Url'], ''), '://')), '/')), '?')), '@')), ':')))}</td><td>@{outputs('Result_URL_GetHost')?['ip_address']}</td><td>@{outputs('Result_URL_GetHost')?['is_live']}</td><td>@{join(take(coalesce(outputs('Result_URL_GetHost')?['network_ports'], json('[]')), 20), ', ')}</td><td>@{outputs('Result_URL_GetHost')?['ip_metadata']?['organization']}</td><td>@{if(greater(int(coalesce(outputs('Result_URL_GetHost')?['last_seen'], 0)), 0), formatDateTime(addSeconds('1970-01-01T00:00:00Z', int(coalesce(outputs('Result_URL_GetHost')?['last_seen'], 0))), 'yyyy-MM-dd HH:mm'), '')}</td><td>@{if(equals(coalesce(outputs('Call_URL_GetHost')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt host lookup: HTTP ', string(coalesce(outputs('Call_URL_GetHost')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_URL_GetHost'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_URL_GetHost'), '')), '<', '&lt;')))), '</i>'))}</td></tr>"
                  },
                  "runAfter": {
                    "Result_URL_GetHost": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "For_each_Host": [
                  "Succeeded"
                ]
              }
            },
            "Append_Host_Table": {
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "Comment",
                "value": "@{if(empty(variables('Rows')), '', concat('<h3>Hosts (Host and URL entities)</h3><table><tbody><tr><th>Host</th><th>IP</th><th>Live</th><th>Open ports</th><th>Organization</th><th>Last seen (UTC)</th><th>Notes</th></tr>', variables('Rows'), '</tbody></table>'))}"
              },
              "runAfter": {
                "For_each_URL": [
                  "Succeeded"
                ]
              }
            },
            "Reset_Rows_DNS": {
              "type": "SetVariable",
              "inputs": {
                "name": "Rows",
                "value": ""
              },
              "runAfter": {
                "Append_Host_Table": [
                  "Succeeded"
                ]
              }
            },
            "For_each_DNS": {
              "type": "Foreach",
              "foreach": "@take(coalesce(body('Entities_-_Get_DNS')?['Dnsresolutions'], json('[]')), variables('MaxEntities'))",
              "actions": {
                "Set_DNS_Apex": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Apex",
                    "value": "@{toLower(trim(coalesce(items('For_each_DNS')?['DomainName'], '')))}"
                  },
                  "runAfter": {}
                },
                "Until_DNS_Apex": {
                  "type": "Until",
                  "expression": "@or(not(equals(coalesce(outputs('Call_DNS_GetDomainSubdomains')?['statusCode'], 0), 400)), lessOrEquals(length(split(variables('Apex'), '.')), 2))",
                  "limit": {
                    "count": 5,
                    "timeout": "PT10M"
                  },
                  "actions": {
                    "Call_DNS_GetDomainSubdomains": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['fullhunt']['connectionId']"
                          }
                        },
                        "method": "get",
                        "path": "/domain/@{encodeURIComponent(variables('Apex'))}/subdomains",
                        "headers": {
                          "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                        }
                      },
                      "runAfter": {}
                    },
                    "If_DNS_Strip_Label": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@coalesce(outputs('Call_DNS_GetDomainSubdomains')?['statusCode'], 0)",
                              400
                            ]
                          },
                          {
                            "greater": [
                              "@length(split(variables('Apex'), '.'))",
                              2
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Compose_DNS_Parent": {
                          "type": "Compose",
                          "inputs": "@substring(variables('Apex'), add(indexOf(variables('Apex'), '.'), 1))",
                          "runAfter": {}
                        },
                        "Set_DNS_Parent": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "Apex",
                            "value": "@{outputs('Compose_DNS_Parent')}"
                          },
                          "runAfter": {
                            "Compose_DNS_Parent": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "Call_DNS_GetDomainSubdomains": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Set_DNS_Apex": [
                      "Succeeded"
                    ]
                  }
                },
                "Result_DNS_GetDomainSubdomains": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_DNS_GetDomainSubdomains')?['statusCode'], 0), 200), body('Call_DNS_GetDomainSubdomains'), json('{}'))",
                  "runAfter": {
                    "Until_DNS_Apex": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Append_DNS_Row": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Rows",
                    "value": "<tr><td>@{items('For_each_DNS')?['DomainName']}</td><td>@{variables('Apex')}</td><td>@{outputs('Result_DNS_GetDomainSubdomains')?['metadata']?['all_results_count']}</td><td>@{outputs('Result_DNS_GetDomainSubdomains')?['whois_data']?['whois']?['registrar']}</td><td>@{outputs('Result_DNS_GetDomainSubdomains')?['whois_data']?['whois']?['created_at']}</td><td>@{outputs('Result_DNS_GetDomainSubdomains')?['whois_data']?['whois']?['expires_at']}</td><td>@{if(equals(coalesce(outputs('Call_DNS_GetDomainSubdomains')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt subdomains lookup: HTTP ', string(coalesce(outputs('Call_DNS_GetDomainSubdomains')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_DNS_GetDomainSubdomains'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_DNS_GetDomainSubdomains'), '')), '<', '&lt;')))), '</i>'))}</td></tr>"
                  },
                  "runAfter": {
                    "Result_DNS_GetDomainSubdomains": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Reset_Rows_DNS": [
                  "Succeeded"
                ]
              }
            },
            "Append_DNS_Table": {
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "Comment",
                "value": "@{if(empty(variables('Rows')), '', concat('<h3>Domains (DNS entities)</h3><table><tbody><tr><th>Domain</th><th>Apex</th><th>Hosts known to FullHunt</th><th>Registrar</th><th>Created</th><th>Expires</th><th>Notes</th></tr>', variables('Rows'), '</tbody></table>'))}"
              },
              "runAfter": {
                "For_each_DNS": [
                  "Succeeded"
                ]
              }
            },
            "Add_comment_to_incident_(V3)": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "@{substring(variables('Comment'), 0, min(length(variables('Comment')), 30000))}"
                }
              },
              "runAfter": {
                "Append_DNS_Table": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "fullhunt": {
                "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]",
                "connectionName": "[variables('FullHuntConnectionName')]"
              }
            }
          }
        }
      }
    }
  ]
}
