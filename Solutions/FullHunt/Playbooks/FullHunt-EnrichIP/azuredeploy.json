{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "FullHunt - IP Enrichment",
    "description": "Enriches an IP entity with FullHunt context: ASN, organization, geolocation, cloud and CDN provider, hosts observed on the IP, and Tor exit node status. Adds the results as an incident comment. Uses 3 FullHunt credits per run (2 for IPv6).",
    "prerequisites": [
      "Deploy the FullHunt custom connector (Playbooks/FullHuntCustomConnector) to the same resource group first.",
      "A FullHunt API key. Each lookup consumes 1 FullHunt credit.",
      "The intel lookup requires the FullHunt Data Intelligence module; without it the comment notes HTTP 403 and the other lookups still run."
    ],
    "postDeployment": [
      "Authorize the FullHunt API connection: open the Logic App, select API connections, choose the FullHunt connection, select Edit API connection, enter your FullHunt API key and save.",
      "Assign the Microsoft Sentinel Responder role to the playbook's managed identity on the Microsoft Sentinel workspace, so it can read incidents and add comments.",
      "Run the playbook from an IP entity in an incident, or from an automation rule."
    ],
    "lastUpdateTime": "2026-10-03T00:00:00.000Z",
    "entities": [
      "ip"
    ],
    "tags": [
      "Enrichment",
      "FullHunt"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "FullHunt"
    },
    "releaseNotes": [
      {
        "version": "1.0.0",
        "title": "FullHunt - IP Enrichment",
        "notes": [
          "Initial version"
        ]
      }
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "FullHunt-EnrichIP",
      "type": "string",
      "metadata": {
        "description": "Name of the playbook (Logic App)"
      }
    },
    "FullHuntConnectorName": {
      "defaultValue": "FullHuntCustomConnector",
      "type": "string",
      "metadata": {
        "description": "Name of the deployed FullHunt custom connector"
      }
    }
  },
  "variables": {
    "FullHuntConnectionName": "[concat('FullHunt-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('FullHuntConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('FullHuntConnectionName')]",
        "api": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateVersion": "1.0.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_entity": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/entity/@{encodeURIComponent('IP')}"
              }
            }
          },
          "actions": {
            "Initialize_IP": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "IP",
                    "type": "string",
                    "value": "@{triggerBody()?['Entity']?['properties']?['Address']}"
                  }
                ]
              },
              "runAfter": {}
            },
            "Call_NexusIpLookup": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/nexus/ip-lookup",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "query": "@{variables('IP')}"
                }
              },
              "runAfter": {
                "Initialize_IP": [
                  "Succeeded"
                ]
              }
            },
            "Result_NexusIpLookup": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_NexusIpLookup')?['statusCode'], 0), 200), body('Call_NexusIpLookup'), json('{}'))",
              "runAfter": {
                "Call_NexusIpLookup": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Call_TorCheck": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/nexus/tor/check-ip",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "ip": "@{variables('IP')}"
                }
              },
              "runAfter": {
                "Result_NexusIpLookup": [
                  "Succeeded"
                ]
              }
            },
            "Result_TorCheck": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_TorCheck')?['statusCode'], 0), 200), body('Call_TorCheck'), json('{}'))",
              "runAfter": {
                "Call_TorCheck": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Call_IntelIpToHosts": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/intel/ip-to-hosts",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "ip": "@variables('IP')"
                }
              },
              "runAfter": {
                "Result_TorCheck": [
                  "Succeeded"
                ]
              }
            },
            "Result_IntelIpToHosts": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_IntelIpToHosts')?['statusCode'], 0), 200), body('Call_IntelIpToHosts'), json('{}'))",
              "runAfter": {
                "Call_IntelIpToHosts": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Select_Intel_Hosts": {
              "type": "Select",
              "inputs": {
                "from": "@coalesce(outputs('Result_IntelIpToHosts')?['results'], json('[]'))",
                "select": "@item()?['host']"
              },
              "runAfter": {
                "Result_IntelIpToHosts": [
                  "Succeeded"
                ]
              }
            },
            "Compose_Comment": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Comment",
                    "type": "string",
                    "value": "<h2 class=\"editor-heading-h2\">FullHunt IP enrichment: @{variables('IP')}</h2><table><tbody><tr><td>ASN / Organization</td><td>@{outputs('Result_NexusIpLookup')?['result']?['asn']} / @{outputs('Result_NexusIpLookup')?['result']?['organization']}</td></tr><tr><td>ISP</td><td>@{outputs('Result_NexusIpLookup')?['result']?['isp']}</td></tr><tr><td>Location</td><td>@{outputs('Result_NexusIpLookup')?['result']?['city_name']} @{outputs('Result_NexusIpLookup')?['result']?['region']} @{outputs('Result_NexusIpLookup')?['result']?['country_name']}</td></tr><tr><td>Cloud / CDN</td><td>@{outputs('Result_NexusIpLookup')?['result']?['cloud_provider']} @{outputs('Result_NexusIpLookup')?['result']?['cloud_region']} / @{outputs('Result_NexusIpLookup')?['result']?['cdn_provider']}</td></tr><tr><td>Hosts observed on this IP</td><td>@{outputs('Result_NexusIpLookup')?['result']?['hosts_count']}</td></tr><tr><td>Tor exit node</td><td>@{if(equals(outputs('Result_TorCheck')?['status'], 200), concat('Yes (first seen ', string(outputs('Result_TorCheck')?['data']?['first_seen']), ')'), if(equals(outputs('Result_TorCheck')?['status'], 404), 'No', 'Unknown'))}</td></tr><tr><td>Hosts on this IP (intel, first 25)</td><td>@{outputs('Result_IntelIpToHosts')?['total_query_results']}: @{join(take(coalesce(body('Select_Intel_Hosts'), json('[]')), 25), ', ')}</td></tr></tbody></table>@{if(not(contains(variables('IP'), ':')), '', '<br/><i>IPv6 address: FullHunt IP lookups support IPv4 only.</i>')}@{if(equals(coalesce(outputs('Call_NexusIpLookup')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt IP lookup: HTTP ', string(coalesce(outputs('Call_NexusIpLookup')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_NexusIpLookup'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_NexusIpLookup'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_TorCheck')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt Tor check: HTTP ', string(coalesce(outputs('Call_TorCheck')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_TorCheck'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_TorCheck'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_IntelIpToHosts')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt intel IP-to-hosts: HTTP ', string(coalesce(outputs('Call_IntelIpToHosts')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_IntelIpToHosts'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_IntelIpToHosts'), '')), '<', '&lt;')))), '</i>'))}"
                  }
                ]
              },
              "runAfter": {
                "Select_Intel_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "Condition_Incident": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@triggerBody()?['IncidentArmID']",
                        "@null"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Add_comment_to_incident_(V3)": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/Incidents/Comment",
                    "body": {
                      "incidentArmId": "@triggerBody()?['IncidentArmID']",
                      "message": "@{substring(variables('Comment'), 0, min(length(variables('Comment')), 30000))}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Compose_Comment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "fullhunt": {
                "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]",
                "connectionName": "[variables('FullHuntConnectionName')]"
              }
            }
          }
        }
      }
    }
  ]
}
