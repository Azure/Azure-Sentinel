{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "FullHunt - CVE Enrichment",
    "description": "Finds CVE IDs in a Microsoft Sentinel incident (title, description and alert details, including custom details) and enriches each one with FullHunt vulnerability intelligence: CVSS v3 and v4, EPSS score and percentile, CISA KEV status and due date, exploit availability, exploit records and advisories. Adds the results as an incident comment. Uses 3 FullHunt credits per CVE, capped by MaxCVEs. Microsoft Sentinel has no CVE entity type, so CVE IDs are extracted from the incident text.",
    "prerequisites": [
      "Deploy the FullHunt custom connector (Playbooks/FullHuntCustomConnector) to the same resource group first.",
      "A FullHunt API key. Each lookup consumes 1 FullHunt credit."
    ],
    "postDeployment": [
      "Authorize the FullHunt API connection: open the Logic App, select API connections, choose the FullHunt connection, select Edit API connection, enter your FullHunt API key and save.",
      "Assign the Microsoft Sentinel Responder role to the playbook's managed identity on the Microsoft Sentinel workspace, so it can read incidents and add comments.",
      "Create an automation rule that runs this playbook when incidents are created, for example for analytics rules that report vulnerabilities. For best results, map CVE IDs into the analytics rule's custom details."
    ],
    "lastUpdateTime": "2026-10-03T00:00:00.000Z",
    "entities": [],
    "tags": [
      "Enrichment",
      "FullHunt"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "FullHunt"
    },
    "releaseNotes": [
      {
        "version": "1.0.0",
        "title": "FullHunt - CVE Enrichment",
        "notes": [
          "Initial version"
        ]
      }
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "FullHunt-EnrichCVE",
      "type": "string",
      "metadata": {
        "description": "Name of the playbook (Logic App)"
      }
    },
    "FullHuntConnectorName": {
      "defaultValue": "FullHuntCustomConnector",
      "type": "string",
      "metadata": {
        "description": "Name of the deployed FullHunt custom connector"
      }
    },
    "MaxCVEs": {
      "defaultValue": 10,
      "type": "int",
      "metadata": {
        "description": "Maximum number of CVE IDs to look up per incident (limits FullHunt credit use)"
      }
    }
  },
  "variables": {
    "FullHuntConnectionName": "[concat('FullHunt-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('FullHuntConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('FullHuntConnectionName')]",
        "api": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateVersion": "1.0.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_MaxCVEs": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "MaxCVEs",
                    "type": "integer",
                    "value": "[parameters('MaxCVEs')]"
                  }
                ]
              },
              "runAfter": {}
            },
            "Initialize_Rows": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Rows",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_MaxCVEs": [
                  "Succeeded"
                ]
              }
            },
            "Compose_Tokens": {
              "type": "Compose",
              "inputs": "@split(toUpper(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(concat(coalesce(triggerBody()?['object']?['properties']?['title'], ''), ' ', coalesce(triggerBody()?['object']?['properties']?['description'], ''), ' ', string(coalesce(triggerBody()?['object']?['properties']?['Alerts'], json('[]')))), '\"', ' '), ',', ' '), ';', ' '), ':', ' '), '(', ' '), ')', ' '), '[', ' '), ']', ' '), '{', ' '), '}', ' '), '<', ' '), '>', ' '), '/', ' '), '\\', ' '), '|', ' '), '''', ' '), '`', ' '), decodeUriComponent('%0A'), ' '), decodeUriComponent('%0D'), ' '), decodeUriComponent('%09'), ' '), '.', ' ')), ' ')",
              "runAfter": {
                "Initialize_Rows": [
                  "Succeeded"
                ]
              }
            },
            "Filter_CVE_Tokens": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('Compose_Tokens')",
                "where": "@and(contains(item(), 'CVE-'), greaterOrEquals(sub(length(item()), indexOf(item(), 'CVE-')), 13))"
              },
              "runAfter": {
                "Compose_Tokens": [
                  "Succeeded"
                ]
              }
            },
            "Select_CVE_IDs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Filter_CVE_Tokens')",
                "select": "@substring(item(), indexOf(item(), 'CVE-'))"
              },
              "runAfter": {
                "Filter_CVE_Tokens": [
                  "Succeeded"
                ]
              }
            },
            "Compose_Unique_CVEs": {
              "type": "Compose",
              "inputs": "@take(union(body('Select_CVE_IDs'), body('Select_CVE_IDs')), variables('MaxCVEs'))",
              "runAfter": {
                "Select_CVE_IDs": [
                  "Succeeded"
                ]
              }
            },
            "For_each_CVE": {
              "type": "Foreach",
              "foreach": "@outputs('Compose_Unique_CVEs')",
              "actions": {
                "Call_VulnerabilitySearch": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/vulnerability-intelligence/vulnerability-search",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    },
                    "queries": {
                      "query": "@items('For_each_CVE')"
                    }
                  },
                  "runAfter": {}
                },
                "Result_VulnerabilitySearch": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_VulnerabilitySearch')?['statusCode'], 0), 200), body('Call_VulnerabilitySearch'), json('{}'))",
                  "runAfter": {
                    "Call_VulnerabilitySearch": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Call_ExploitsSearch": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/vulnerability-intelligence/exploits-search",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    },
                    "queries": {
                      "query": "@items('For_each_CVE')"
                    }
                  },
                  "runAfter": {
                    "Result_VulnerabilitySearch": [
                      "Succeeded"
                    ]
                  }
                },
                "Result_ExploitsSearch": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_ExploitsSearch')?['statusCode'], 0), 200), body('Call_ExploitsSearch'), json('{}'))",
                  "runAfter": {
                    "Call_ExploitsSearch": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Call_AdvisoriesSearch": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/vulnerability-intelligence/advisories-search",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    },
                    "queries": {
                      "query": "@items('For_each_CVE')"
                    }
                  },
                  "runAfter": {
                    "Result_ExploitsSearch": [
                      "Succeeded"
                    ]
                  }
                },
                "Result_AdvisoriesSearch": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_AdvisoriesSearch')?['statusCode'], 0), 200), body('Call_AdvisoriesSearch'), json('{}'))",
                  "runAfter": {
                    "Call_AdvisoriesSearch": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Filter_Matching_CVE": {
                  "type": "Query",
                  "inputs": {
                    "from": "@coalesce(outputs('Result_VulnerabilitySearch')?['response'], json('[]'))",
                    "where": "@equals(toUpper(coalesce(item()?['cve_id'], '')), items('For_each_CVE'))"
                  },
                  "runAfter": {
                    "Result_AdvisoriesSearch": [
                      "Succeeded"
                    ]
                  }
                },
                "Select_Advisory_IDs": {
                  "type": "Select",
                  "inputs": {
                    "from": "@coalesce(outputs('Result_AdvisoriesSearch')?['response'], json('[]'))",
                    "select": "@item()?['source_id']"
                  },
                  "runAfter": {
                    "Filter_Matching_CVE": [
                      "Succeeded"
                    ]
                  }
                },
                "Append_CVE_Row": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "Rows",
                    "value": "<tr><td><b>@{items('For_each_CVE')}</b></td><td>@{first(body('Filter_Matching_CVE'))?['cvss_v3_score']}</td><td>@{first(body('Filter_Matching_CVE'))?['cvss_v4_score']}</td><td>@{first(body('Filter_Matching_CVE'))?['epss_score']} (@{first(body('Filter_Matching_CVE'))?['epss_percentile']})</td><td>@{if(equals(first(body('Filter_Matching_CVE'))?['is_kev'], true), 'Yes', if(equals(first(body('Filter_Matching_CVE'))?['is_kev'], false), 'No', ''))}</td><td>@{if(equals(first(body('Filter_Matching_CVE'))?['is_exploit_available'], true), 'Yes', if(equals(first(body('Filter_Matching_CVE'))?['is_exploit_available'], false), 'No', ''))}</td><td>@{first(body('Filter_Matching_CVE'))?['cisa_action_due']?['$date']}</td><td>@{length(coalesce(outputs('Result_ExploitsSearch')?['response'], json('[]')))}</td><td>@{join(take(coalesce(body('Select_Advisory_IDs'), json('[]')), 5), ', ')}</td><td>@{first(body('Filter_Matching_CVE'))?['title']}</td><td>@{if(equals(coalesce(outputs('Call_VulnerabilitySearch')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt vulnerability search: HTTP ', string(coalesce(outputs('Call_VulnerabilitySearch')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_VulnerabilitySearch'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_VulnerabilitySearch'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_ExploitsSearch')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt exploits search: HTTP ', string(coalesce(outputs('Call_ExploitsSearch')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_ExploitsSearch'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_ExploitsSearch'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_AdvisoriesSearch')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt advisories search: HTTP ', string(coalesce(outputs('Call_AdvisoriesSearch')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_AdvisoriesSearch'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_AdvisoriesSearch'), '')), '<', '&lt;')))), '</i>'))}@{if(and(equals(coalesce(outputs('Call_VulnerabilitySearch')?['statusCode'], 0), 200), empty(body('Filter_Matching_CVE'))), 'Not found in FullHunt vulnerability intelligence', '')}</td></tr>"
                  },
                  "runAfter": {
                    "Select_Advisory_IDs": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Compose_Unique_CVEs": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_Comment": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Comment",
                    "type": "string",
                    "value": "<h2 class=\"editor-heading-h2\">FullHunt vulnerability intelligence</h2><table><tbody><tr><th>CVE</th><th>CVSS v3</th><th>CVSS v4</th><th>EPSS (percentile)</th><th>CISA KEV</th><th>Exploit available</th><th>CISA due date</th><th>Exploit records</th><th>Advisories</th><th>Title</th><th>Notes</th></tr>@{variables('Rows')}</tbody></table>"
                  }
                ]
              },
              "runAfter": {
                "For_each_CVE": [
                  "Succeeded"
                ]
              }
            },
            "Condition_Found_CVEs": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@length(outputs('Compose_Unique_CVEs'))",
                        0
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Add_comment_to_incident_(V3)": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/Incidents/Comment",
                    "body": {
                      "incidentArmId": "@triggerBody()?['object']?['id']",
                      "message": "@{substring(variables('Comment'), 0, min(length(variables('Comment')), 30000))}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Initialize_Comment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "fullhunt": {
                "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]",
                "connectionName": "[variables('FullHuntConnectionName')]"
              }
            }
          }
        }
      }
    }
  ]
}
