{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "FullHunt - Domain Enrichment",
    "description": "Enriches a DNS (domain) entity with FullHunt context: apex domain, known hosts and subdomains, WHOIS registrar and dates, host exposure summary (live, cloud and CDN hosts), passive DNS, cloud certificates and domain-collection context. Adds the results as an incident comment. Uses 4 FullHunt credits per run, or 5 when domain details are requested.",
    "prerequisites": [
      "Deploy the FullHunt custom connector (Playbooks/FullHuntCustomConnector) to the same resource group first.",
      "A FullHunt API key. Each lookup consumes 1 FullHunt credit."
    ],
    "postDeployment": [
      "Authorize the FullHunt API connection: open the Logic App, select API connections, choose the FullHunt connection, select Edit API connection, enter your FullHunt API key and save.",
      "Assign the Microsoft Sentinel Responder role to the playbook's managed identity on the Microsoft Sentinel workspace, so it can read incidents and add comments.",
      "Run the playbook from a DNS entity in an incident, or from an automation rule. Subdomains are resolved to their registrable (apex) domain automatically."
    ],
    "lastUpdateTime": "2026-10-03T00:00:00.000Z",
    "entities": [
      "dnsresolution"
    ],
    "tags": [
      "Enrichment",
      "FullHunt"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "FullHunt"
    },
    "releaseNotes": [
      {
        "version": "1.0.0",
        "title": "FullHunt - Domain Enrichment",
        "notes": [
          "Initial version"
        ]
      }
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "FullHunt-EnrichDomain",
      "type": "string",
      "metadata": {
        "description": "Name of the playbook (Logic App)"
      }
    },
    "FullHuntConnectorName": {
      "defaultValue": "FullHuntCustomConnector",
      "type": "string",
      "metadata": {
        "description": "Name of the deployed FullHunt custom connector"
      }
    },
    "MaxHostsForDetails": {
      "defaultValue": 500,
      "type": "int",
      "metadata": {
        "description": "Call domain details (full host records) only when the domain has at most this many hosts"
      }
    }
  },
  "variables": {
    "FullHuntConnectionName": "[concat('FullHunt-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('FullHuntConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('FullHuntConnectionName')]",
        "api": {
          "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateVersion": "1.0.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_entity": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/entity/@{encodeURIComponent('DNS')}"
              }
            }
          },
          "actions": {
            "Initialize_Domain": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Domain",
                    "type": "string",
                    "value": "@{toLower(trim(coalesce(triggerBody()?['Entity']?['properties']?['DomainName'], '')))}"
                  }
                ]
              },
              "runAfter": {}
            },
            "Initialize_Apex": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Apex",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_Domain": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_MaxHostsForDetails": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "MaxHostsForDetails",
                    "type": "integer",
                    "value": "[parameters('MaxHostsForDetails')]"
                  }
                ]
              },
              "runAfter": {
                "Initialize_Apex": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_Details": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Details",
                    "type": "object",
                    "value": {}
                  }
                ]
              },
              "runAfter": {
                "Initialize_MaxHostsForDetails": [
                  "Succeeded"
                ]
              }
            },
            "Initialize_DetailsNote": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "DetailsNote",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_Details": [
                  "Succeeded"
                ]
              }
            },
            "Set_Apex": {
              "type": "SetVariable",
              "inputs": {
                "name": "Apex",
                "value": "@{replace(first(split(concat(variables('Domain'), '|'), '.|')), '|', '')}"
              },
              "runAfter": {
                "Initialize_DetailsNote": [
                  "Succeeded"
                ]
              }
            },
            "Until_Apex": {
              "type": "Until",
              "expression": "@or(not(equals(coalesce(outputs('Call_GetDomainSubdomains')?['statusCode'], 0), 400)), lessOrEquals(length(split(variables('Apex'), '.')), 2))",
              "limit": {
                "count": 5,
                "timeout": "PT10M"
              },
              "actions": {
                "Call_GetDomainSubdomains": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/domain/@{encodeURIComponent(variables('Apex'))}/subdomains",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    }
                  },
                  "runAfter": {}
                },
                "If_Strip_Label": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@coalesce(outputs('Call_GetDomainSubdomains')?['statusCode'], 0)",
                          400
                        ]
                      },
                      {
                        "greater": [
                          "@length(split(variables('Apex'), '.'))",
                          2
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Compose_Parent": {
                      "type": "Compose",
                      "inputs": "@substring(variables('Apex'), add(indexOf(variables('Apex'), '.'), 1))",
                      "runAfter": {}
                    },
                    "Set_Parent": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Apex",
                        "value": "@{outputs('Compose_Parent')}"
                      },
                      "runAfter": {
                        "Compose_Parent": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Call_GetDomainSubdomains": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runAfter": {
                "Set_Apex": [
                  "Succeeded"
                ]
              }
            },
            "Result_GetDomainSubdomains": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_GetDomainSubdomains')?['statusCode'], 0), 200), body('Call_GetDomainSubdomains'), json('{}'))",
              "runAfter": {
                "Until_Apex": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "If_Small_Domain": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@int(coalesce(outputs('Result_GetDomainSubdomains')?['metadata']?['all_results_count'], 0))",
                      0
                    ]
                  },
                  {
                    "lessOrEquals": [
                      "@int(coalesce(outputs('Result_GetDomainSubdomains')?['metadata']?['all_results_count'], 0))",
                      "@variables('MaxHostsForDetails')"
                    ]
                  }
                ]
              },
              "actions": {
                "Call_GetDomainDetails": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['fullhunt']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/domain/@{encodeURIComponent(variables('Apex'))}/details",
                    "headers": {
                      "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                    }
                  },
                  "runAfter": {}
                },
                "Result_GetDomainDetails": {
                  "type": "Compose",
                  "inputs": "@if(equals(coalesce(outputs('Call_GetDomainDetails')?['statusCode'], 0), 200), body('Call_GetDomainDetails'), json('{}'))",
                  "runAfter": {
                    "Call_GetDomainDetails": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Set_Details": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Details",
                    "value": "@outputs('Result_GetDomainDetails')"
                  },
                  "runAfter": {
                    "Result_GetDomainDetails": [
                      "Succeeded"
                    ]
                  }
                },
                "Set_DetailsNote": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "DetailsNote",
                    "value": "@{if(equals(coalesce(outputs('Call_GetDomainDetails')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt domain details: HTTP ', string(coalesce(outputs('Call_GetDomainDetails')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_GetDomainDetails'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_GetDomainDetails'), '')), '<', '&lt;')))), '</i>'))}"
                  },
                  "runAfter": {
                    "Set_Details": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Result_GetDomainSubdomains": [
                  "Succeeded"
                ]
              }
            },
            "Filter_Live_Hosts": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(variables('Details')?['hosts'], json('[]'))",
                "where": "@equals(item()?['is_live'], true)"
              },
              "runAfter": {
                "If_Small_Domain": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Filter_Cloud_Hosts": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(variables('Details')?['hosts'], json('[]'))",
                "where": "@equals(item()?['is_cloud'], true)"
              },
              "runAfter": {
                "Filter_Live_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "Filter_CDN_Hosts": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(variables('Details')?['hosts'], json('[]'))",
                "where": "@equals(item()?['is_cdn'], true)"
              },
              "runAfter": {
                "Filter_Cloud_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "Call_PassiveDns": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/nexus/passive-dns/lookup",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "domain": "@variables('Apex')"
                }
              },
              "runAfter": {
                "Filter_CDN_Hosts": [
                  "Succeeded"
                ]
              }
            },
            "Result_PassiveDns": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_PassiveDns')?['statusCode'], 0), 200), body('Call_PassiveDns'), json('{}'))",
              "runAfter": {
                "Call_PassiveDns": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Call_CloudCerts": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/nexus/cloud-certs/dns-search",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "query": "@variables('Apex')"
                }
              },
              "runAfter": {
                "Result_PassiveDns": [
                  "Succeeded"
                ]
              }
            },
            "Result_CloudCerts": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_CloudCerts')?['statusCode'], 0), 200), body('Call_CloudCerts'), json('{}'))",
              "runAfter": {
                "Call_CloudCerts": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Call_DomainCollection": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['fullhunt']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/nexus/domain-collection/lookup",
                "headers": {
                  "User-Agent": "Microsoft-Sentinel-FullHunt-Playbook/1.0"
                },
                "queries": {
                  "domain": "@variables('Apex')"
                }
              },
              "runAfter": {
                "Result_CloudCerts": [
                  "Succeeded"
                ]
              }
            },
            "Result_DomainCollection": {
              "type": "Compose",
              "inputs": "@if(equals(coalesce(outputs('Call_DomainCollection')?['statusCode'], 0), 200), body('Call_DomainCollection'), json('{}'))",
              "runAfter": {
                "Call_DomainCollection": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Compose_Comment": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "Comment",
                    "type": "string",
                    "value": "<h2 class=\"editor-heading-h2\">FullHunt domain enrichment: @{variables('Domain')}</h2><table><tbody><tr><td>Apex domain</td><td>@{variables('Apex')}</td></tr><tr><td>Hosts known to FullHunt</td><td>@{outputs('Result_GetDomainSubdomains')?['metadata']?['all_results_count']}</td></tr><tr><td>Subdomains (first 25)</td><td>@{join(take(coalesce(outputs('Result_GetDomainSubdomains')?['hosts'], json('[]')), 25), ', ')}</td></tr><tr><td>Host exposure (domain details)</td><td>@{if(empty(variables('Details')), concat('Not requested (domain has ', string(int(coalesce(outputs('Result_GetDomainSubdomains')?['metadata']?['all_results_count'], 0))), ' hosts; limit is ', string(variables('MaxHostsForDetails')), ')'), concat(string(length(body('Filter_Live_Hosts'))), ' live, ', string(length(body('Filter_Cloud_Hosts'))), ' cloud-hosted, ', string(length(body('Filter_CDN_Hosts'))), ' behind a CDN'))}</td></tr><tr><td>Registrar</td><td>@{outputs('Result_GetDomainSubdomains')?['whois_data']?['whois']?['registrar']}</td></tr><tr><td>Created / Expires</td><td>@{outputs('Result_GetDomainSubdomains')?['whois_data']?['whois']?['created_at']} / @{outputs('Result_GetDomainSubdomains')?['whois_data']?['whois']?['expires_at']}</td></tr><tr><td>Name servers</td><td>@{join(take(coalesce(outputs('Result_GetDomainSubdomains')?['whois_data']?['whois']?['nameservers'], json('[]')), 10), ', ')}</td></tr><tr><td>Passive DNS host names</td><td>@{outputs('Result_PassiveDns')?['count']}: @{join(take(coalesce(outputs('Result_PassiveDns')?['data'], json('[]')), 25), ', ')}</td></tr><tr><td>Cloud certificates matching</td><td>@{outputs('Result_CloudCerts')?['count']}</td></tr><tr><td>Domain collection: estimated assets</td><td>@{if(equals(outputs('Result_DomainCollection')?['status'], 200), string(outputs('Result_DomainCollection')?['data']?['total_estimated_assets']), 'Not found')}</td></tr></tbody></table>@{if(equals(coalesce(outputs('Call_GetDomainSubdomains')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt subdomains lookup: HTTP ', string(coalesce(outputs('Call_GetDomainSubdomains')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_GetDomainSubdomains'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_GetDomainSubdomains'), '')), '<', '&lt;')))), '</i>'))}@{variables('DetailsNote')}@{if(equals(coalesce(outputs('Call_PassiveDns')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt passive DNS: HTTP ', string(coalesce(outputs('Call_PassiveDns')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_PassiveDns'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_PassiveDns'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_CloudCerts')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt cloud certificates: HTTP ', string(coalesce(outputs('Call_CloudCerts')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_CloudCerts'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_CloudCerts'), '')), '<', '&lt;')))), '</i>'))}@{if(equals(coalesce(outputs('Call_DomainCollection')?['statusCode'], 0), 200), '', concat('<br/><i>FullHunt domain collection: HTTP ', string(coalesce(outputs('Call_DomainCollection')?['statusCode'], 0)), ' ', substring(replace(string(coalesce(body('Call_DomainCollection'), '')), '<', '&lt;'), 0, min(200, length(replace(string(coalesce(body('Call_DomainCollection'), '')), '<', '&lt;')))), '</i>'))}"
                  }
                ]
              },
              "runAfter": {
                "Result_DomainCollection": [
                  "Succeeded"
                ]
              }
            },
            "Condition_Incident": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@triggerBody()?['IncidentArmID']",
                        "@null"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Add_comment_to_incident_(V3)": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/Incidents/Comment",
                    "body": {
                      "incidentArmId": "@triggerBody()?['IncidentArmID']",
                      "message": "@{substring(variables('Comment'), 0, min(length(variables('Comment')), 30000))}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Compose_Comment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "fullhunt": {
                "id": "[concat(resourceGroup().id, '/providers/Microsoft.Web/customApis/', parameters('FullHuntConnectorName'))]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('FullHuntConnectionName'))]",
                "connectionName": "[variables('FullHuntConnectionName')]"
              }
            }
          }
        }
      }
    }
  ]
}
