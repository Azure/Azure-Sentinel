{
    "name": "KELABrandControl_DCR",
    "apiVersion": "2023-04-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-KELA_BrandControl_Incidents_CL": {
                "columns": [
                    { "name": "incidentId", "type": "string" },
                    { "name": "incidentDate", "type": "long" },
                    { "name": "incidentUpdateDate", "type": "long" },
                    { "name": "type", "type": "string" },
                    { "name": "severity", "type": "string" },
                    { "name": "status", "type": "string" },
                    { "name": "description", "type": "string" },
                    { "name": "isTakedownRequested", "type": "string" },
                    { "name": "detectedEntity", "type": "dynamic" },
                    { "name": "analysis", "type": "dynamic" },
                    { "name": "screenshots", "type": "dynamic" },
                    { "name": "reasons", "type": "dynamic" },
                    { "name": "indicators", "type": "dynamic" },
                    { "name": "isDeleted", "type": "boolean" },
                    { "name": "isArchived", "type": "boolean" },
                    { "name": "lastVisited", "type": "long" }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "LogAnalyticsDestination_KELA"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [ "Custom-KELA_BrandControl_Incidents_CL" ],
                "destinations": [ "LogAnalyticsDestination_KELA" ],
                "transformKql": "source | extend incidentType = tostring(type) | extend lastVisitedDate = datetime(1970-01-01) + tolong(lastVisited) * 1ms, registrationDate = datetime(1970-01-01) + tolong(detectedEntity.registrationDate) * 1ms, incidentCreatedDate = datetime(1970-01-01) + tolong(incidentDate) * 1ms, incidentUpdatedDate = datetime(1970-01-01) + tolong(incidentUpdateDate) * 1ms, domainName = tostring(detectedEntity.domain), impersonatedAsset = tostring(analysis.impersonatedAsset.value) | extend TimeGenerated = now()",
                "outputStream": "Custom-KELA_BrandControl_Incidents_CL"
            }
        ]
    }
}
