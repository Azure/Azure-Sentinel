{
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "KELABrandControlPoller",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
        "auth": {
            "type": "APIKey",
            "apiKeyName": "Authorization",
            "apiKey": "[[parameters('Password')]",
            "apiKeyIdentifier": "Bearer"
        },
        "request": {
            "apiEndpoint": "[[concat('https://api.ke-la.com/brand-control/v1/incidents?workspaceId=', parameters('WorkspaceId'))]",
            "httpMethod": "POST",
            "isPostPayloadJson": true,
            "queryTimeFormat": "UnixTimestampInMills",
            "queryWindowInMin": 15,
            "rateLimitQPS": 30,
            "retryCount": 3,
            "timeoutInSeconds": 120,
            "headers": {
                "Accept": "application/json",
                "Content-Type": "application/json"
            },
            "queryParametersTemplate": "{\"filters\":{\"isDeleted\":false,\"isArchived\":false,\"timeRange\":{\"fieldName\":\"incident_date\",\"startDate\":{_QueryWindowStartTime}}}}"
        },
        "response": {
            "eventsJsonPaths": [
                "$.incidents"
            ],
            "format": "json"
        },
        "paging": {
            "pagingType": "Offset",
            "offsetParaName": "offset",
            "pageSize": 1000,
            "pageSizeParameterName": "size",
            "pagingInfoPlacement": "QueryString"
        },
        "connectorDefinitionName": "KELABrandControlCCFConnector",
        "dataType": "KELA_BrandControl_Incidents_CL",
        "dcrConfig": {
            "streamName": "Custom-KELA_BrandControl_Incidents_CL",
            "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
            "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
        }
    }
}