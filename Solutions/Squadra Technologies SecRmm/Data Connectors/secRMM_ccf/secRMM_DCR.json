{
  "name": "secRMMDCR",
  "apiVersion": "2021-09-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "[parameters('workspace-location')]",
  "properties": {
    "streamDeclarations": {
      "Custom-secRMM": {
        "columns": [
          { "name": "TimeGenerated", "type": "datetime" },
          { "name": "Computer", "type": "string" },
          { "name": "RawData", "type": "string" },
          { "name": "Event_s", "type": "string" },
          { "name": "Time_s", "type": "string" },
          { "name": "UserSID_s", "type": "string" },
          { "name": "Drive_s", "type": "string" },
          { "name": "Volume_s", "type": "string" },
          { "name": "DeviceDescription_s", "type": "string" },
          { "name": "SerialNumber_s", "type": "string" },
          { "name": "Model_s", "type": "string" },
          { "name": "InternalID_s", "type": "string" },
          { "name": "TargetFile_s", "type": "string" },
          { "name": "SourceFile_s", "type": "string" },
          { "name": "SourceFileSize_s", "type": "string" },
          { "name": "SourceFileLastWrite_s", "type": "string" },
          { "name": "ProgramPID_s", "type": "string" },
          { "name": "Message_s", "type": "string" },
          { "name": "PropertyName_s", "type": "string" },
          { "name": "PropertyAction_s", "type": "string" },
          { "name": "PropertyValue_s", "type": "string" },
          { "name": "PreviousPropertyValue_s", "type": "string" },
          { "name": "ConfigurationTarget_s", "type": "string" },
          { "name": "PropertyOperationStatus_s", "type": "string" },
          { "name": "AdditionalProgramInfo_s", "type": "string" },
          { "name": "ProgramName_s", "type": "string" },
          { "name": "User_s", "type": "string" }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "[variables('workspaceResourceId')]",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-secRMM"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source",
        "outputStream": "Custom-secRMM_CL"
      }
    ],
    "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
  }
}
