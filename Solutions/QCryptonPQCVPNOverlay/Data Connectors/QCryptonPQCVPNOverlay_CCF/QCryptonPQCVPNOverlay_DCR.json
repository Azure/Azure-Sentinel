{
  "name": "QCryptonPQCVPNOverlayDCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-PQCVPNOverlay_CL": {
        "columns": [
          {
            "name": "TimeGenerated",
            "type": "datetime"
          },
          {
            "name": "PeerID",
            "type": "string"
          },
          {
            "name": "PeerAddress",
            "type": "string"
          },
          {
            "name": "EventType",
            "type": "string"
          },
          {
            "name": "KeyExchange",
            "type": "string"
          },
          {
            "name": "PQCUsed",
            "type": "int"
          },
          {
            "name": "HNDLRisk",
            "type": "int"
          },
          {
            "name": "LatencyMs",
            "type": "real"
          },
          {
            "name": "PolicyMode",
            "type": "string"
          },
          {
            "name": "PolicyAction",
            "type": "string"
          },
          {
            "name": "BytesSent",
            "type": "long"
          },
          {
            "name": "BytesRecv",
            "type": "long"
          },
          {
            "name": "DurationSec",
            "type": "real"
          },
          {
            "name": "ErrorMessage",
            "type": "string"
          },
          {
            "name": "Metadata",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-PQCVPNOverlay_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-PQCVPNOverlay_CL",
        "transformKql": "source | extend TimeGenerated = iff(isnull(TimeGenerated), now(), TimeGenerated) | project TimeGenerated, PeerID, PeerAddress, EventType, KeyExchange, PQCUsed, HNDLRisk, LatencyMs, PolicyMode, PolicyAction, BytesSent, BytesRecv, DurationSec, ErrorMessage, Metadata"
      }
    ]
  }
}
