{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "apiVersion": "2025-03-01",
  "name": "QCryptonPQCVPNOverlayCCP",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "auth": {
      "type": "APIKey",
      "ApiKey": "[[parameters('apiKey')]",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "[[concat(parameters('apiServerUrl'),'/api/v1/vpn/telemetry')]",
      "httpMethod": "GET",
      "rateLimitQPS": 2,
      "queryWindowInMin": 60,
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
      "retryCount": 3,
      "timeoutInSeconds": 120,
      "headers": {
        "Accept": "application/json",
        "User-Agent": "MicrosoftSentinel-QCryptonPQCVPNOverlayCCP"
      },
      "queryParameters": {
        "scanDateAfter": "{_QueryWindowStartTime}",
        "scanDateBefore": "{_QueryWindowEndTime}"
      }
    },
    "response": {
      "eventsJsonPaths": [
        "$.events"
      ],
      "format": "json"
    },
    "paging": {
      "pagingType": "NextPageToken",
      "nextPageTokenJsonPath": "$.nextPageToken",
      "nextPageParaName": "pageToken"
    },
    "connectorDefinitionName": "QCryptonPQCVPNOverlayCCPDefinition",
    "dataType": "PQCVPNOverlay_CL",
    "dcrConfig": {
      "streamName": "Custom-PQCVPNOverlay_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    }
  }
}
