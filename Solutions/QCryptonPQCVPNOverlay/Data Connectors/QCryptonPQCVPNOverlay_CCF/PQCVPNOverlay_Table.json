{
  "name": "PQCVPNOverlay_CL",
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "apiVersion": "2025-02-01",
  "properties": {
    "retentionInDays": 90,
    "schema": {
      "name": "PQCVPNOverlay_CL",
      "description": "Tunnel lifecycle telemetry from QCrypton PQC VPN Overlay. Contains hybrid post-quantum WireGuard tunnel events including key exchanges, policy enforcement decisions, classical fallback warnings, HNDL risk indicators, and bandwidth metrics.",
      "columns": [
        {
          "name": "TimeGenerated",
          "type": "datetime",
          "description": "Timestamp when the event was generated by the PQC VPN Overlay instance."
        },
        {
          "name": "PeerID",
          "type": "string",
          "description": "Base64-encoded peer public key identifier."
        },
        {
          "name": "PeerAddress",
          "type": "string",
          "description": "Peer IP:port."
        },
        {
          "name": "EventType",
          "type": "string",
          "description": "Event type: tunnel_up, tunnel_down, tunnel_rekey, handshake_fail, policy_block, policy_warn, classical_fallback, peer_discovered."
        },
        {
          "name": "KeyExchange",
          "type": "string",
          "description": "Key exchange algorithm: X25519+ML-KEM-768 or X25519."
        },
        {
          "name": "PQCUsed",
          "type": "int",
          "description": "1=PQC hybrid used, 0=classical only."
        },
        {
          "name": "HNDLRisk",
          "type": "int",
          "description": "1=harvest-now-decrypt-later at risk, 0=protected."
        },
        {
          "name": "LatencyMs",
          "type": "real",
          "description": "Handshake latency in milliseconds."
        },
        {
          "name": "PolicyMode",
          "type": "string",
          "description": "Policy mode: require, prefer, allow, disable."
        },
        {
          "name": "PolicyAction",
          "type": "string",
          "description": "Policy action: allow, block, log."
        },
        {
          "name": "BytesSent",
          "type": "long",
          "description": "Bytes sent (tunnel_down events)."
        },
        {
          "name": "BytesRecv",
          "type": "long",
          "description": "Bytes received (tunnel_down events)."
        },
        {
          "name": "DurationSec",
          "type": "real",
          "description": "Tunnel duration in seconds (tunnel_down events)."
        },
        {
          "name": "ErrorMessage",
          "type": "string",
          "description": "Error details for failures."
        },
        {
          "name": "Metadata",
          "type": "string",
          "description": "Additional JSON metadata."
        }
      ]
    }
  }
}
