{
  "name": "MicrosoftEntraIDAssetsCCF",
  "apiVersion": "2025-09-01",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "{{location}}",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "MicrosoftEntraIDAssetsCCF",
      "title": "Microsoft Entra ID Assets (Preview)",
      "logo": "https://raw.githubusercontent.com/Azure/Azure-Sentinel/master/Logos/AADCloudSync.svg",
      "publisher": "Microsoft",
      "descriptionMarkdown": "Microsoft Entra assets include users, groups, applications, service principals and devices, together with their membership and ownership relationships. Collect this inventory in Microsoft Sentinel.",
      "graphQueries": [
        {
          "metricName": "EntraApplications observations",
          "legend": "EntraApplications",
          "baseQuery": "EntraApplications"
        },
        {
          "metricName": "EntraDevices observations",
          "legend": "EntraDevices",
          "baseQuery": "EntraDevices"
        },
        {
          "metricName": "EntraGroups observations",
          "legend": "EntraGroups",
          "baseQuery": "EntraGroups"
        },
        {
          "metricName": "EntraOrgContacts observations",
          "legend": "EntraOrgContacts",
          "baseQuery": "EntraOrgContacts"
        },
        {
          "metricName": "EntraServicePrincipals observations",
          "legend": "EntraServicePrincipals",
          "baseQuery": "EntraServicePrincipals"
        },
        {
          "metricName": "EntraUsers observations",
          "legend": "EntraUsers",
          "baseQuery": "EntraUsers"
        },
        {
          "metricName": "EntraOrganizations observations",
          "legend": "EntraOrganizations",
          "baseQuery": "EntraOrganizations"
        },
        {
          "metricName": "EntraGroupMemberships observations",
          "legend": "EntraGroupMemberships",
          "baseQuery": "EntraGroupMemberships"
        },
        {
          "metricName": "EntraMembers observations",
          "legend": "EntraMembers",
          "baseQuery": "EntraMembers"
        },
        {
          "metricName": "EntraOwners observations",
          "legend": "EntraOwners",
          "baseQuery": "EntraOwners"
        },
        {
          "metricName": "EntraSponsors observations",
          "legend": "EntraSponsors",
          "baseQuery": "EntraSponsors"
        },
        {
          "metricName": "EntraEligibleMembers observations",
          "legend": "EntraEligibleMembers",
          "baseQuery": "EntraEligibleMembers"
        }
      ],
      "sampleQueries": [
        {
          "description": "Recent EntraApplications",
          "query": "EntraApplications | take 100"
        },
        {
          "description": "EntraApplications freshness",
          "query": "EntraApplications | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraDevices",
          "query": "EntraDevices | take 100"
        },
        {
          "description": "EntraDevices freshness",
          "query": "EntraDevices | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraGroups",
          "query": "EntraGroups | take 100"
        },
        {
          "description": "EntraGroups freshness",
          "query": "EntraGroups | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraOrgContacts",
          "query": "EntraOrgContacts | take 100"
        },
        {
          "description": "EntraOrgContacts freshness",
          "query": "EntraOrgContacts | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraServicePrincipals",
          "query": "EntraServicePrincipals | take 100"
        },
        {
          "description": "EntraServicePrincipals freshness",
          "query": "EntraServicePrincipals | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraUsers",
          "query": "EntraUsers | take 100"
        },
        {
          "description": "EntraUsers freshness",
          "query": "EntraUsers | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraOrganizations",
          "query": "EntraOrganizations | take 100"
        },
        {
          "description": "EntraOrganizations freshness",
          "query": "EntraOrganizations | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraGroupMemberships",
          "query": "EntraGroupMemberships | take 100"
        },
        {
          "description": "EntraGroupMemberships freshness",
          "query": "EntraGroupMemberships | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraMembers",
          "query": "EntraMembers | take 100"
        },
        {
          "description": "EntraMembers freshness",
          "query": "EntraMembers | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraOwners",
          "query": "EntraOwners | take 100"
        },
        {
          "description": "EntraOwners freshness",
          "query": "EntraOwners | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraSponsors",
          "query": "EntraSponsors | take 100"
        },
        {
          "description": "EntraSponsors freshness",
          "query": "EntraSponsors | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        },
        {
          "description": "Recent EntraEligibleMembers",
          "query": "EntraEligibleMembers | take 100"
        },
        {
          "description": "EntraEligibleMembers freshness",
          "query": "EntraEligibleMembers | summarize LastObservation=max(TimeGenerated) by AADTenantId"
        }
      ],
      "dataTypes": [
        {
          "name": "EntraApplications",
          "lastDataReceivedQuery": "EntraApplications\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraDevices",
          "lastDataReceivedQuery": "EntraDevices\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraGroups",
          "lastDataReceivedQuery": "EntraGroups\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraOrgContacts",
          "lastDataReceivedQuery": "EntraOrgContacts\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraServicePrincipals",
          "lastDataReceivedQuery": "EntraServicePrincipals\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraUsers",
          "lastDataReceivedQuery": "EntraUsers\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraOrganizations",
          "lastDataReceivedQuery": "EntraOrganizations\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraGroupMemberships",
          "lastDataReceivedQuery": "EntraGroupMemberships\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraMembers",
          "lastDataReceivedQuery": "EntraMembers\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraOwners",
          "lastDataReceivedQuery": "EntraOwners\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraSponsors",
          "lastDataReceivedQuery": "EntraSponsors\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "EntraEligibleMembers",
          "lastDataReceivedQuery": "EntraEligibleMembers\n| where TimeGenerated > ago(192h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "isPreview": true,
        "status": 1
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and write permissions are required on the workspace targeted for this connection.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "write": true,
              "read": true,
              "delete": true,
              "action": false
            }
          }
        ],
        "tenant": [
          "GlobalAdmin",
          "SecurityAdmin"
        ]
      },
      "instructionSteps": [
        {
          "title": "Configuration",
          "description": "Connect Entra asset data.",
          "instructions": [
            {
              "type": "MessageBar",
              "parameters": {
                "text": "Setup selection only: changing the selection alone does not stop existing pollers. Disconnect/delete a table's existing pollers before reconnecting with a reduced selection. Include both snapshot/changefeed pollers and all relationship paths. Stored data is retained.",
                "visible": true,
                "inline": false,
                "type": "warning"
              }
            },
            {
              "type": "DataConnectorsGrid",
              "parameters": {
                "mapping": [
                  {
                    "columnName": "Connection",
                    "columnValue": "properties.addOnAttributes.friendlyName"
                  },
                  {
                    "columnName": "Tenant",
                    "columnValue": "properties.addOnAttributes.aadTenantId"
                  },
                  {
                    "columnName": "Source type",
                    "columnValue": "properties.addOnAttributes.sourceType"
                  },
                  {
                    "columnName": "Stream",
                    "columnValue": "properties.dataType"
                  }
                ],
                "menuItems": [
                  "DeleteConnector"
                ],
                "isMultiSelect": true
              }
            },
            {
              "type": "ContextPane",
              "parameters": {
                "label": "Add connection",
                "title": "Connect Entra assets and relationships",
                "subtitle": "Weekly snapshots and hourly deltas",
                "contextPaneType": "DataConnectorsContextPane",
                "instructionSteps": [
                  {
                    "instructions": [
                      {
                        "type": "Markdown",
                        "parameters": {
                          "content": "### OAuth setup\n- In the [Entra admin center](https://entra.microsoft.com), use the workspace's deployment tenant. Go to **App registrations > New registration** and register a **Single tenant** app. No redirect URI is required.\n- Copy the **Application (client) ID** from Overview. Do not use the Object ID.\n- Under **API permissions > Microsoft Graph > Application permissions** (not Delegated permissions), add the permissions below and select **Grant admin consent**.\n- Under **Certificates & secrets > Client secrets > New client secret**, create a secret and copy its **Value**, not its Secret ID. Store it securely and rotate it before expiration.\n\n**Application permissions:** `Application.Read.All`, `Device.Read.All`, `Group.Read.All`, `GroupMember.Read.All`, `OrgContact.Read.All`, `User.Read.All`, `User-LifeCycleInfo.Read.All`, `Organization.Read.All`, `RoleManagement.Read.Directory`, `RoleEligibilitySchedule.Read.Directory`, `PrivilegedEligibilitySchedule.Read.AzureADGroup`. Add `Member.Read.Hidden` for hidden memberships. PIM requires applicable licensing.\n\n**Preview:** This connector is currently in preview, and uses a Graph preview endpoint. Tables will be updated weekly for this Preview connector.\n\n**Eligibility licensing:** Microsoft Entra ID P2 or Microsoft Entra ID Governance is required for the EligibleMembers table. If eligibility fails, other collectors may still be connected; verify their deployment status."
                        }
                      },
                      {
                        "type": "Dropdown",
                        "parameters": {
                          "label": "Tables to collect",
                          "name": "selectedDataTypes",
                          "options": [
                            {
                              "key": "EntraApplications",
                              "text": "EntraApplications"
                            },
                            {
                              "key": "EntraDevices",
                              "text": "EntraDevices"
                            },
                            {
                              "key": "EntraGroups",
                              "text": "EntraGroups"
                            },
                            {
                              "key": "EntraOrgContacts",
                              "text": "EntraOrgContacts"
                            },
                            {
                              "key": "EntraServicePrincipals",
                              "text": "EntraServicePrincipals"
                            },
                            {
                              "key": "EntraUsers",
                              "text": "EntraUsers"
                            },
                            {
                              "key": "EntraOrganizations",
                              "text": "EntraOrganizations"
                            },
                            {
                              "key": "EntraGroupMemberships",
                              "text": "EntraGroupMemberships"
                            },
                            {
                              "key": "EntraMembers",
                              "text": "EntraMembers"
                            },
                            {
                              "key": "EntraOwners",
                              "text": "EntraOwners"
                            },
                            {
                              "key": "EntraSponsors",
                              "text": "EntraSponsors"
                            },
                            {
                              "key": "EntraEligibleMembers",
                              "text": "EntraEligibleMembers"
                            }
                          ],
                          "placeholder": "Select tables to collect...",
                          "isMultiSelect": true,
                          "defaultAllSelected": true,
                          "required": true
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Connection name",
                          "placeholder": "Unique name",
                          "type": "text",
                          "name": "friendlyName",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Tenant ID",
                          "placeholder": "Tenant GUID",
                          "type": "text",
                          "name": "tenantId",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Application client ID",
                          "placeholder": "Application GUID",
                          "type": "text",
                          "name": "clientId",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Client secret",
                          "placeholder": "Secret value",
                          "type": "password",
                          "name": "clientSecret",
                          "validations": {
                            "required": true
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}