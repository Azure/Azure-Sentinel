[
  {
    "name": "GTIVulnerabilitiesPoller",
    "apiVersion": "2023-02-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "GTIVulnerabilitiesConnector",
      "dataType": "GTI_Vulnerabilities_CL",
      "dcrConfig": {
        "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
        "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]",
        "streamName": "Custom-GTI_Vulnerabilities_CL"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('GTIAPIKey')]",
        "ApiKeyName": "x-apikey"
      },
      "request": {
        "apiEndpoint": "https://www.virustotal.com/api/v3/collections",
        "httpMethod": "GET",
        "queryTimeFormat": "UnixTimestamp",
        "queryWindowInMin": "[[first(parameters('pollingFrequency'))]",
        "queryParameters": {
          "filter": "[[concat('collection_type:vulnerability last_modification_date:{_QueryWindowStartTime}+ ', parameters('VulnerabilityFilter'))]",
          "order": "last_modification_date+",
          "limit": 40
        },
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Sentinel-GTIVulnerabilities"
        },
        "rateLimitQPS": 4,
        "retryCount": 3,
        "timeoutInSeconds": 120
      },
      "response": {
        "eventsJsonPaths": [
          "$.data[*]"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.meta.cursor",
        "nextPageParaName": "cursor"
      },
      "isActive": true
    }
  }
]
