{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "PRODAFT USTA - Backfill Malicious URLs",
    "description": "On-demand historical backfill for the PRODAFT USTA malicious-URL IoC feed. Pages the feed from BackfillDays ago (default 90) up to the present, maps each record to a STIX 2.1 indicator with the same mapping as PRODAFTUstaIoC-ImportMaliciousUrls, and uploads it to Microsoft Sentinel Threat Intelligence via the Upload STIX Objects API under the same SourceSystem 'PRODAFT USTA - Malicious URLs', so backfilled history unifies with the incremental data. Triggered manually (Run Trigger); it does not run on a schedule and is safe to run while the hourly import playbook is active - STIX ids are deterministic, so re-uploads update rather than duplicate, and importing historical records never moves the import playbook's watermark backwards. If the feed is larger than one run can drain, the run fails with the timestamp to resume from.",
    "prerequisites": [
      "1. A PRODAFT USTA long-lived API key with access to the Security Intelligence IoC endpoints.",
      "2. The name of the Microsoft Sentinel (Log Analytics) workspace that indicators are uploaded to.",
      "3. The core 'Threat Intelligence' solution installed from the Content hub (provides the Threat Intelligence blade and the ThreatIntelIndicators table)."
    ],
    "postDeployment": [
      "1. Grant the playbook's system-assigned managed identity the 'Microsoft Sentinel Contributor' role on the Log Analytics workspace (Access control (IAM) -> Add role assignment). This is required for the Upload STIX Objects call. The API connection deployed with the playbook authenticates with that same managed identity, so no interactive connection authorization is needed.",
      "2. Run the backfill once from the Logic App: Overview -> Run Trigger -> manual. Optionally POST a body of {\"startTime\":\"YYYY-MM-DDTHH:MM:SSZ\"} to resume from a specific point instead of BackfillDays ago."
    ],
    "lastUpdateTime": "2026-07-08T00:00:00.000Z",
    "entities": [
      "url",
      "dnsresolution"
    ],
    "tags": [
      "ThreatIntelligence"
    ],
    "author": {
      "name": "PRODAFT"
    },
    "support": {
      "name": "PRODAFT",
      "email": "integration@prodaft.com",
      "tier": "Partner",
      "link": "https://www.prodaft.com"
    }
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "PRODAFTUstaIoC-BackfillMaliciousUrls",
      "type": "string",
      "metadata": {
        "description": "Name of the Logic App playbook."
      }
    },
    "UstaBaseUrl": {
      "type": "string",
      "defaultValue": "https://usta.prodaft.com",
      "metadata": {
        "description": "PRODAFT USTA API base URL."
      }
    },
    "UstaApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "PRODAFT USTA long-lived API key."
      }
    },
    "WorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Microsoft Sentinel (Log Analytics) workspace that indicators are uploaded to."
      }
    },
    "WorkspaceResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of the workspace. Leave as default if it is in the same resource group as this deployment."
      }
    },
    "BackfillDays": {
      "type": "int",
      "defaultValue": 90,
      "metadata": {
        "description": "Number of days of history to load, counted back from now. Ignored when a startTime is supplied in the trigger body."
      }
    }
  },
  "variables": {
    "MicrosoftSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "SentinelWorkspaceResourceId": "[resourceId(parameters('WorkspaceResourceGroup'), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]"
      ],
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "PRODAFTUstaIoC-BackfillMaliciousUrls",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "UstaBaseUrl": {
              "defaultValue": "",
              "type": "String"
            },
            "UstaApiKey": {
              "type": "SecureString"
            },
            "WorkspaceID": {
              "type": "String"
            },
            "BackfillDays": {
              "defaultValue": 90,
              "type": "Int"
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "startTime": {
                      "type": "string",
                      "description": "Optional ISO-8601 UTC timestamp to resume from. Defaults to BackfillDays ago."
                    }
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "runs": 1
                }
              }
            }
          },
          "actions": {
            "Initialize_NextUrl": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "NextUrl",
                    "type": "string",
                    "value": "@{concat(parameters('UstaBaseUrl'), '/api/threat-stream/v4/security-intelligence/ioc/malicious-urls?ordering=created&size=100&start=', encodeUriComponent(coalesce(triggerBody()?['startTime'], addDays(utcNow(), mul(-1, parameters('BackfillDays')), 'yyyy-MM-ddTHH:mm:ssZ'))))}"
                  }
                ]
              }
            },
            "Initialize_FetchFailed": {
              "type": "InitializeVariable",
              "runAfter": {
                "Initialize_NextUrl": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "FetchFailed",
                    "type": "boolean",
                    "value": false
                  }
                ]
              }
            },
            "Until_All_Pages_Processed": {
              "type": "Until",
              "expression": "@empty(variables('NextUrl'))",
              "limit": {
                "count": 5000,
                "timeout": "PT4H"
              },
              "runAfter": {
                "Initialize_LastCreated": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Fetch_USTA_Page": {
                  "type": "Http",
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "inputs": {
                    "method": "GET",
                    "uri": "@variables('NextUrl')",
                    "headers": {
                      "Accept": "application/json",
                      "Authorization": "Bearer @{parameters('UstaApiKey')}",
                      "User-Agent": "Azure-Sentinel-USTA-Integration/1.0"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT20S"
                    }
                  }
                },
                "Check_Fetch_Response": {
                  "type": "If",
                  "runAfter": {
                    "Fetch_USTA_Page": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@coalesce(outputs('Fetch_USTA_Page')?['statusCode'], 0)",
                          200
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Update_NextUrl": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": {
                        "name": "NextUrl",
                        "value": "@coalesce(body('Fetch_USTA_Page')?['next'], '')"
                      }
                    },
                    "If_Page_Has_Records": {
                      "type": "If",
                      "runAfter": {
                        "Update_NextUrl": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "and": [
                          {
                            "greater": [
                              "@length(coalesce(body('Fetch_USTA_Page')?['results'], json('[]')))",
                              0
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Map_To_STIX": {
                          "type": "Select",
                          "runAfter": {},
                          "inputs": {
                            "from": "@body('Fetch_USTA_Page')?['results']",
                            "select": {
                              "type": "indicator",
                              "spec_version": "2.1",
                              "pattern_type": "stix",
                              "id": "@concat('indicator--', item()?['id'])",
                              "name": "@item()?['url']",
                              "description": "@concat('PRODAFT USTA - Malicious URL. Host: ', coalesce(item()?['host'], ''))",
                              "pattern": "@if(or(startsWith(item()?['url'], 'http://'), startsWith(item()?['url'], 'https://')), concat('[url:value = ''', item()?['url'], ''']'), if(equals(item()?['is_domain'], true), concat('[domain-name:value = ''', item()?['host'], ''']'), concat('[url:value = ''http://', item()?['url'], ''']')))",
                              "indicator_types": [
                                "malicious-activity"
                              ],
                              "labels": "@if(empty(item()?['tags']), json('[\"Malicious\"]'), item()?['tags'])",
                              "confidence": 85,
                              "valid_from": "@item()?['valid_from']",
                              "valid_until": "@item()?['valid_until']",
                              "created": "@item()?['created']",
                              "modified": "@utcNow()",
                              "object_marking_refs": [
                                "marking-definition--f88d31f6-486f-44da-b317-01333bde0b82"
                              ]
                            }
                          }
                        },
                        "Upload_STIX_Objects": {
                          "type": "ApiConnection",
                          "runAfter": {
                            "Map_To_STIX": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "post",
                            "body": {
                              "stixobjects": "@body('Map_To_STIX')",
                              "sourcesystem": "PRODAFT USTA - Malicious URLs"
                            },
                            "path": "/ThreatIntelligence/@{encodeURIComponent(uriComponent(parameters('WorkspaceID')))}/UploadStixObjects/",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 3,
                              "interval": "PT20S"
                            }
                          }
                        },
                        "Set_LastCreated": {
                          "type": "SetVariable",
                          "runAfter": {
                            "Upload_STIX_Objects": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "name": "LastCreated",
                            "value": "@{coalesce(last(body('Fetch_USTA_Page')?['results'])?['created'], variables('LastCreated'))}"
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Mark_Fetch_Failed": {
                        "type": "SetVariable",
                        "runAfter": {},
                        "inputs": {
                          "name": "FetchFailed",
                          "value": true
                        }
                      },
                      "Stop_Paging": {
                        "type": "SetVariable",
                        "runAfter": {
                          "Mark_Fetch_Failed": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "name": "NextUrl",
                          "value": ""
                        }
                      }
                    }
                  }
                }
              }
            },
            "Fail_If_Fetch_Failed": {
              "type": "If",
              "runAfter": {
                "Until_All_Pages_Processed": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('FetchFailed')",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Terminate_Run_As_Failed": {
                  "type": "Terminate",
                  "runAfter": {},
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "UstaFetchFailed",
                      "message": "The 'Fetch USTA Page' request did not return HTTP 200 (for example, HTTP 403 when the USTA API key lacks the required Security Intelligence IoC permissions). Failing the run so the error is not silently reported as success. Verify the USTA API key permissions and re-run."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Initialize_LastCreated": {
              "type": "InitializeVariable",
              "runAfter": {
                "Initialize_FetchFailed": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "LastCreated",
                    "type": "string",
                    "value": ""
                  }
                ]
              }
            },
            "Fail_If_Backfill_Incomplete": {
              "type": "If",
              "runAfter": {
                "Fail_If_Fetch_Failed": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@variables('NextUrl')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Terminate_Run_As_Incomplete": {
                  "type": "Terminate",
                  "runAfter": {},
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "UstaBackfillIncomplete",
                      "message": "@{concat('The backfill reached the paging limit (5000 pages / 4 hours) before the feed was exhausted, so the history is only partially loaded. Everything fetched so far has been uploaded. Re-run this playbook with a trigger body of {\"startTime\":\"', variables('LastCreated'), '\"} to continue from where it stopped.')}"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/Azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "UstaBaseUrl": {
            "value": "[parameters('UstaBaseUrl')]"
          },
          "UstaApiKey": {
            "value": "[parameters('UstaApiKey')]"
          },
          "WorkspaceID": {
            "value": "[reference(variables('SentinelWorkspaceResourceId'), '2025-02-01').customerId]"
          },
          "BackfillDays": {
            "value": "[parameters('BackfillDays')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'full').identity.principalId]"
    }
  }
}
