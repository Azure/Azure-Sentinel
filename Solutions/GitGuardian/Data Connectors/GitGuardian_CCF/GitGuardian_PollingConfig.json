{
  "name": "GitGuardianAuditLogsPoller",
  "apiVersion": "2025-07-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "kind": "RestApiPoller",
  "location": "global",
  "properties": {
    "connectorDefinitionName": "GitGuardianAuditLogs",
    "dataType": "GitGuardian_AuditLogs",
    "auth": {
      "type": "APIKey",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Token",
      "ApiKey": "{{apiKey}}"
    },
    "request": {
      "apiEndpoint": "[[first(parameters('BaseUrl'))]",
      "httpMethod": "GET",
      "queryWindowInMin": 5,
      "queryParameters": {
        "per_page": "100",
        "date_after": "{_QueryWindowStartTime}",
        "date_before": "{_QueryWindowEndTime}"
      },
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
      "rateLimitQPS": 1,
      "retryCount": 3,
      "timeoutInSeconds": 30
    },
    "response": {
      "eventsJsonPaths": [
        "$[*]"
      ],
      "format": "json"
    },
    "isActive": true,
    "dcrConfig": {
      "streamName": "Custom-GitGuardian_AuditLogs_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "paging": {
      "pagingType": "LinkHeader",
      "pageSize": 100,
      "pageSizeParameterName": "per_page"
    },
    "addOnAttributes": {
      "friendlyName": "{{friendlyName}}"
    }
  }
}