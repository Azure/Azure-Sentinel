{
  "name": "GitGuardianAuditLogs",
  "apiVersion": "2025-07-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "kind": "Customizable",
  "location": "{{location}}",
  "properties": {
    "connectorUiConfig": {
      "id": "GitGuardianAuditLogs",
      "title": "GitGuardian Audit Logs and Secret Incidents",
      "publisher": "Microsoft",
      "descriptionMarkdown": "Ingests GitGuardian workspace audit logs and secret incidents into Microsoft Sentinel. Secret incidents include lifecycle, severity, validity, risk, assignment, detector, tags, exposure, ticket, and occurrence details.",
      "graphQueriesTableName": "GitGuardianSecretIncidents_CL",
      "graphQueries": [
        {
          "metricName": "Secret incidents received",
          "legend": "GitGuardian Secret Incidents",
          "baseQuery": "GitGuardianSecretIncidents_CL"
        },
        {
          "metricName": "Audit events received",
          "legend": "GitGuardian Audit Logs",
          "baseQuery": "GitGuardian_AuditLogs_CL"
        }
      ],
      "sampleQueries": [
        {
          "description": "Get recent GitGuardian secret incidents",
          "query": "GitGuardianSecretIncidents_CL\n| sort by TimeGenerated desc\n| take 10"
        },
        {
          "description": "Summarize open secret incidents by severity",
          "query": "GitGuardianSecretIncidents_CL\n| where Status == \"TRIGGERED\"\n| summarize IncidentCount = count() by Severity\n| sort by IncidentCount desc"
        },
        {
          "description": "Get recent GitGuardian audit logs",
          "query": "GitGuardian_AuditLogs_CL\n| sort by TimeGenerated desc\n| take 10"
        }
      ],
      "dataTypes": [
        {
          "name": "GitGuardian_AuditLogs_CL",
          "lastDataReceivedQuery": "GitGuardian_AuditLogs_CL\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
        },
        {
          "name": "GitGuardianSecretIncidents_CL",
          "lastDataReceivedQuery": "GitGuardianSecretIncidents_CL\n| where TimeGenerated > ago(12h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "status": 1,
        "isPreview": false
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and Write permissions are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "read": true,
              "write": true,
              "delete": true,
              "action": false
            }
          }
        ],
        "customs": [
          {
            "name": "GitGuardian API token",
            "description": "A GitGuardian API token with the `audit_logs:read` and `incidents:read` scopes is required."
          }
        ]
      },
      "instructionSteps": [
        {
          "title": "Configure GitGuardian connections",
          "description": "Add one connection for each GitGuardian workspace or region. Each connection collects audit logs and secret incidents.",
          "instructions": [
            {
              "type": "DataConnectorsGrid",
              "parameters": {
                "mapping": [
                  {
                    "columnName": "Connection",
                    "columnValue": "properties.addOnAttributes.friendlyName"
                  },
                  {
                    "columnName": "API URL",
                    "columnValue": "properties.request.apiEndpoint"
                  },
                  {
                    "columnName": "Data stream",
                    "columnValue": "properties.dataType"
                  }
                ],
                "menuItems": [
                  "DeleteConnector"
                ]
              }
            },
            {
              "type": "ContextPane",
              "parameters": {
                "label": "Add Connection",
                "title": "Add GitGuardian connection",
                "subtitle": "Collect audit logs and secret incidents",
                "contextPaneType": "DataConnectorsContextPane",
                "instructionSteps": [
                  {
                    "instructions": [
                      {
                        "type": "Markdown",
                        "parameters": {
                          "content": "Enter a name for this connection, select the GitGuardian SaaS region, and provide an API token with the `audit_logs:read` and `incidents:read` scopes."
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Connection name",
                          "placeholder": "e.g. Contoso GitGuardian US",
                          "type": "text",
                          "name": "friendlyName",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "Dropdown",
                        "parameters": {
                          "label": "GitGuardian SaaS region",
                          "name": "BaseUrl",
                          "options": [
                            {
                              "key": "https://api.gitguardian.com/v1/audit_logs",
                              "text": "United States"
                            },
                            {
                              "key": "https://api.eu1.gitguardian.com/v1/audit_logs",
                              "text": "Europe"
                            }
                          ],
                          "isMultiSelect": false,
                          "required": true
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "API token",
                          "placeholder": "Enter your GitGuardian API token",
                          "type": "password",
                          "name": "apiKey",
                          "validations": {
                            "required": true
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}