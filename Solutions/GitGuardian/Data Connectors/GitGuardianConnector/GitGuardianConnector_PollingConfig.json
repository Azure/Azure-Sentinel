[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2025-03-01",
    "name": "[[concat('parameters('workspace')', '/Microsoft.SecurityInsights/','GitGuardianAuditLogsV2' , uniqueString(parameters('friendlyName')) )]",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apiKey')]",
        "ApiKeyName": "Authorization",
        "ApiKeyIdentifier": "Token"
      },
      "request": {
        "apiEndpoint": "[[first(parameters('BaseUrl'))]",
        "httpMethod": "GET",
        "rateLimitQPS": 1,
        "queryWindowInMin": 5,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "queryParameters": {
          "per_page": "100",
          "date_after": "{_QueryWindowStartTime}",
          "date_before": "{_QueryWindowEndTime}"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$[*]"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "LinkHeader",
        "linkHeaderTokenJsonPath": "Link",
        "pageSize": 100,
        "pageSizeParameterName": "per_page"
      },
      "connectorDefinitionName": "GitGuardianConnector",
      "dataType": "GitGuardianAuditLogsV2",
      "dcrConfig": {
        "streamName": "Custom-GitGuardianAuditLogsV2_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "friendlyName": "[[parameters('friendlyName')]"
      }
    },
    "condition": "[[equals(first(parameters('selectedDataType')), 'GitGuardianAuditLogsV2')]"
  },
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2025-03-01",
    "name": "[[concat('parameters('workspace')', '/Microsoft.SecurityInsights/','GitGuardianSecretIncidentsV2' , uniqueString(parameters('friendlyName')) )]",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apiKey')]",
        "ApiKeyName": "Authorization",
        "ApiKeyIdentifier": "Token"
      },
      "request": {
        "apiEndpoint": "[[replace(first(parameters('BaseUrl')), '/v1/audit_logs', '/v1/incidents/secrets')]",
        "httpMethod": "GET",
        "rateLimitQPS": 1,
        "queryWindowInMin": 5,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "queryParameters": {
          "per_page": "100",
          "date_after": "{_QueryWindowStartTime}",
          "date_before": "{_QueryWindowEndTime}",
          "ordering": "date"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$[*]"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "LinkHeader",
        "linkHeaderTokenJsonPath": "Link",
        "pageSize": 100,
        "pageSizeParameterName": "per_page"
      },
      "connectorDefinitionName": "GitGuardianConnector",
      "dataType": "GitGuardianSecretIncidentsV2",
      "dcrConfig": {
        "streamName": "Custom-GitGuardianSecretIncidentsV2_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "friendlyName": "[[parameters('friendlyName')]"
      }
    },
    "condition": "[[equals(first(parameters('selectedDataType')), 'GitGuardianSecretIncidentsV2')]"
  }
]