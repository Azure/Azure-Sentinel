{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "Microsoft - support@microsoft.com",
    "comments": "Solution template for GitGuardian"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "email": "support@microsoft.com",
    "_email": "[variables('email')]",
    "_solutionName": "GitGuardian",
    "_solutionVersion": "3.0.0",
    "solutionId": "azuresentinel.azure-sentinel-solution-gitguardian",
    "_solutionId": "[variables('solutionId')]",
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "dataConnectorCCPVersion": "3.0.0",
    "_dataConnectorContentIdConnectorDefinition1": "GitGuardianAuditLogs",
    "dataConnectorTemplateNameConnectorDefinition1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnectorDefinition1')))]",
    "_dataConnectorContentIdConnections1": "GitGuardianAuditLogsConnections",
    "dataConnectorTemplateNameConnections1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnections1')))]",
    "dataCollectionEndpointId": "[concat('/subscriptions/',subscription().subscriptionId,'/resourceGroups/',resourceGroup().name,'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]",
    "blanks": "[replace('b', 'b', '')]",
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', variables('dataConnectorTemplateNameConnectorDefinition1'), variables('dataConnectorCCPVersion'))]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
        "displayName": "GitGuardian Audit Logs",
        "contentKind": "DataConnector",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorCCPVersion')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
              "apiVersion": "2022-09-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
              "location": "[parameters('workspace-location')]",
              "kind": "Customizable",
              "properties": {
                "connectorUiConfig": {
                  "id": "GitGuardianAuditLogs",
                  "title": "GitGuardian Audit Logs",
                  "publisher": "Microsoft",
                  "descriptionMarkdown": "Ingests GitGuardian workspace audit logs into Microsoft Sentinel for security monitoring and investigation. Supports API key authentication.",
                  "graphQueriesTableName": "GitGuardian_AuditLogs_CL",
                  "graphQueries": [
                    {
                      "metricName": "Total events received",
                      "legend": "GitGuardian Audit Logs",
                      "baseQuery": "{{graphQueriesTableName}}"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "Get sample of GitGuardian Audit Logs",
                      "query": "{{graphQueriesTableName}}\n | take 10"
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "GitGuardian_AuditLogs_CL",
                      "lastDataReceivedQuery": "GitGuardian_AuditLogs_CL\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "HasDataConnectors"
                    }
                  ],
                  "availability": {
                    "status": 1,
                    "isPreview": false
                  },
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "read": true,
                          "write": true,
                          "delete": true,
                          "action": false
                        }
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "Configure GitGuardian Audit Logs connections",
                      "description": "Add one connection for each GitGuardian workspace or region that you want to monitor.",
                      "instructions": [
                        {
                          "type": "DataConnectorsGrid",
                          "parameters": {
                            "mapping": [
                              {
                                "columnName": "Connection",
                                "columnValue": "properties.addOnAttributes.friendlyName"
                              },
                              {
                                "columnName": "API URL",
                                "columnValue": "properties.request.apiEndpoint"
                              }
                            ],
                            "menuItems": [
                              "DeleteConnector"
                            ]
                          }
                        },
                        {
                          "type": "ContextPane",
                          "parameters": {
                            "label": "Add Connection",
                            "title": "Add GitGuardian Audit Logs connection",
                            "subtitle": "Configure a GitGuardian workspace connection",
                            "contextPaneType": "DataConnectorsContextPane",
                            "instructionSteps": [
                              {
                                "instructions": [
                                  {
                                    "type": "Markdown",
                                    "parameters": {
                                      "content": "Enter a name for this connection, select the GitGuardian SaaS region, and provide an API token with the `audit_logs:read` scope."
                                    }
                                  },
                                  {
                                    "type": "Textbox",
                                    "parameters": {
                                      "label": "Connection name",
                                      "placeholder": "e.g. Contoso GitGuardian US",
                                      "type": "text",
                                      "name": "friendlyName",
                                      "validations": {
                                        "required": true
                                      }
                                    }
                                  },
                                  {
                                    "type": "Dropdown",
                                    "parameters": {
                                      "label": "GitGuardian SaaS region",
                                      "name": "BaseUrl",
                                      "options": [
                                        {
                                          "key": "https://api.gitguardian.com/v1/audit_logs",
                                          "text": "United States"
                                        },
                                        {
                                          "key": "https://api.eu1.gitguardian.com/v1/audit_logs",
                                          "text": "Europe"
                                        }
                                      ],
                                      "isMultiSelect": false,
                                      "required": true
                                    }
                                  },
                                  {
                                    "type": "Textbox",
                                    "parameters": {
                                      "label": "API token",
                                      "placeholder": "Enter your GitGuardian API token",
                                      "type": "password",
                                      "name": "apiKey",
                                      "validations": {
                                        "required": true
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', variables('_dataConnectorContentIdConnectorDefinition1')))]",
              "apiVersion": "2022-01-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectorDefinitions', variables('_dataConnectorContentIdConnectorDefinition1'))]",
                "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorCCPVersion')]",
                "source": {
                  "sourceId": "[variables('_solutionId')]",
                  "name": "[variables('_solutionName')]",
                  "kind": "Solution"
                },
                "author": {
                  "name": "Microsoft",
                  "email": "[variables('_email')]"
                },
                "support": {
                  "name": "Microsoft Corporation",
                  "email": "support@microsoft.com",
                  "tier": "Microsoft",
                  "link": "https://support.microsoft.com"
                },
                "dependencies": {
                  "criteria": [
                    {
                      "version": "[variables('dataConnectorCCPVersion')]",
                      "contentId": "[variables('_dataConnectorContentIdConnections1')]",
                      "kind": "ResourcesDataConnector"
                    }
                  ]
                }
              }
            },
            {
              "name": "GitGuardianDCR",
              "apiVersion": "2022-06-01",
              "type": "Microsoft.Insights/dataCollectionRules",
              "location": "[parameters('workspace-location')]",
              "kind": "[variables('blanks')]",
              "properties": {
                "streamDeclarations": {
                  "Custom-GitGuardian_AuditLogs_CL": {
                    "columns": [
                      {
                        "name": "TimeGenerated",
                        "type": "datetime"
                      },
                      {
                        "name": "id",
                        "type": "long"
                      },
                      {
                        "name": "date",
                        "type": "datetime"
                      },
                      {
                        "name": "member_email",
                        "type": "string"
                      },
                      {
                        "name": "member_name",
                        "type": "string"
                      },
                      {
                        "name": "member_id",
                        "type": "long"
                      },
                      {
                        "name": "api_token_id",
                        "type": "string"
                      },
                      {
                        "name": "ip_address",
                        "type": "string"
                      },
                      {
                        "name": "target_ids",
                        "type": "dynamic"
                      },
                      {
                        "name": "action_type",
                        "type": "string"
                      },
                      {
                        "name": "event_name",
                        "type": "string"
                      },
                      {
                        "name": "data",
                        "type": "dynamic"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "logAnalyticsDestination"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-GitGuardian_AuditLogs_CL"
                    ],
                    "destinations": [
                      "logAnalyticsDestination"
                    ],
                    "transformKql": "source | extend TimeGenerated = ['date'] , Id = ['id'] , Date = ['date'] , MemberEmail = ['member_email'] , MemberName = ['member_name'] , MemberId = ['member_id'] , ApiTokenId = toguid(['api_token_id']) , IpAddress = ['ip_address'] , TargetIds = ['target_ids'] , ActionType = ['action_type'] , EventName = ['event_name'] , Data = ['data'] | project TimeGenerated , Id , Date , MemberEmail , MemberName , MemberId , ApiTokenId , IpAddress , TargetIds , ActionType , EventName , Data",
                    "outputStream": "Custom-GitGuardian_AuditLogs_CL"
                  }
                ],
                "dataCollectionEndpointId": "[variables('dataCollectionEndpointId')]"
              }
            },
            {
              "name": "GitGuardian_AuditLogs_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "schema": {
                  "name": "GitGuardian_AuditLogs_CL",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime"
                    },
                    {
                      "name": "Id",
                      "type": "long",
                      "description": ""
                    },
                    {
                      "name": "Date",
                      "type": "datetime",
                      "description": ""
                    },
                    {
                      "name": "MemberEmail",
                      "type": "string",
                      "description": ""
                    },
                    {
                      "name": "MemberName",
                      "type": "string",
                      "description": ""
                    },
                    {
                      "name": "MemberId",
                      "type": "long",
                      "description": ""
                    },
                    {
                      "name": "ApiTokenId",
                      "type": "guid",
                      "description": ""
                    },
                    {
                      "name": "IpAddress",
                      "type": "string",
                      "description": ""
                    },
                    {
                      "name": "TargetIds",
                      "type": "dynamic",
                      "description": ""
                    },
                    {
                      "name": "ActionType",
                      "type": "string",
                      "description": ""
                    },
                    {
                      "name": "EventName",
                      "type": "string",
                      "description": ""
                    },
                    {
                      "name": "Data",
                      "type": "dynamic",
                      "description": ""
                    }
                  ]
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "contentProductId": "[concat(take(variables('_solutionId'), 50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentIdConnectorDefinition1'),'-', variables('dataConnectorCCPVersion'))))]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "version": "[variables('dataConnectorCCPVersion')]"
      }
    },
    {
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
      "apiVersion": "2022-09-01-preview",
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
      "location": "[parameters('workspace-location')]",
      "kind": "Customizable",
      "properties": {
        "connectorUiConfig": {
          "id": "GitGuardianAuditLogs",
          "title": "GitGuardian Audit Logs",
          "publisher": "Microsoft",
          "descriptionMarkdown": "Ingests GitGuardian workspace audit logs into Microsoft Sentinel for security monitoring and investigation. Supports API key authentication.",
          "graphQueriesTableName": "GitGuardian_AuditLogs_CL",
          "graphQueries": [
