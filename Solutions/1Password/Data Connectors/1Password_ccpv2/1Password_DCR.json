{
    "name": "1PasswordDCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-OnePasswordEventLogs_CL": {
                "columns": [
                    {
                        "name": "uuid",
                        "type": "string"
                    },
                    {
                        "name": "session_uuid",
                        "type": "string"
                    },
                    {
                        "name": "timestamp",
                        "type": "datetime"
                    },
                    {
                        "name": "category",
                        "type": "string"
                    },
                    {
                        "name": "type",
                        "type": "string"
                    },
                    {
                        "name": "country",
                        "type": "string"
                    },
                    {
                        "name": "details",
                        "type": "dynamic"
                    },
                    {
                        "name": "target_user",
                        "type": "dynamic"
                    },
                    {
                        "name": "client",
                        "type": "dynamic"
                    },
                    {
                        "name": "location",
                        "type": "dynamic"
                    },
                    {
                        "name": "account_uuid",
                        "type": "string"
                    },
                    {
                        "name": "used_version",
                        "type": "int"
                    },
                    {
                        "name": "vault_uuid",
                        "type": "string"
                    },
                    {
                        "name": "item_uuid",
                        "type": "string"
                    },
                    {
                        "name": "action",
                        "type": "string"
                    },
                    {
                        "name": "user",
                        "type": "dynamic"
                    },
                    {
                        "name": "actor_uuid",
                        "type": "string"
                    },
                    {
                        "name": "actor_details",
                        "type": "dynamic"
                    },
                    {
                        "name": "actor_type",
                        "type": "string"
                    },
                    {
                        "name": "actor_account_uuid",
                        "type": "string"
                    },
                    {
                        "name": "object_type",
                        "type": "string"
                    },
                    {
                        "name": "object_uuid",
                        "type": "string"
                    },
                    {
                        "name": "object_details",
                        "type": "dynamic"
                    },
                    {
                        "name": "aux_id",
                        "type": "int"
                    },
                    {
                        "name": "aux_uuid",
                        "type": "string"
                    },
                    {
                        "name": "aux_details",
                        "type": "dynamic"
                    },
                    {
                        "name": "aux_info",
                        "type": "string"
                    },
                    {
                        "name": "session",
                        "type": "dynamic"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-OnePasswordEventLogs_CL"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "outputStream": "Custom-OnePasswordEventLogs_CL",
                "transformKql": "source | project TimeGenerated = now(), uuid_s = uuid, session_uuid, timestamp, country, category, action_type = type, details, target_user, client, location, actor_uuid, actor_details, actor_type, actor_account_uuid, account_uuid, user_type = tostring(coalesce(target_user.user_type, user.user_type)), user_account_uuid = tostring(coalesce(target_user.user_account_uuid, user.user_account_uuid)), action, object_type, object_uuid, object_details, aux_id, aux_uuid, aux_details, aux_info, session, used_version, vault_uuid, item_uuid, user, log_source = case(isnotempty(used_version) or isnotempty(aux_id), 'itemusages', isnotempty(country), 'signinattempts', isempty(used_version) and isempty(aux_id) and isempty(country), 'auditevents', 'unknown')"
            }
        ]
    }
}