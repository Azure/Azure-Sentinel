{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Microsoft_Sentinel_entity": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "body": {
                        "callback_url": "@{listCallbackUrl()}"
                    },
                    "host": {
                        "connection": {
                            "referenceName": "azuresentinel"
                        }
                    },
                    "path": "/entity/@{encodeURIComponent('IP')}"
                }
            }
        },
        "actions": {
            "Score_IP": {
                "type": "Http",
                "inputs": {
                    "method": "POST",
                    "uri": "https://tap.group-ib.com/api/v2/scoring",
                    "headers": {
                        "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                        "Accept": "application/json",
                        "Content-Type": "application/json",
                        "User-Agent": "GroupIB-MSentinel-Integration/2.0 (score-ip; logic-app)"
                    },
                    "body": {
                        "ips": "@createArray(triggerBody()?['Entity']?['properties']?['Address'])"
                    }
                },
                "runtimeConfiguration": {
                    "secureData": {
                        "properties": [
                            "inputs"
                        ]
                    }
                },
                "runAfter": {}
            },
            "Condition_Has_Incident": {
                "type": "If",
                "expression": {
                    "greater": [
                        "@length(coalesce(triggerBody()?['IncidentArmID'], ''))",
                        0
                    ]
                },
                "actions": {
                    "Add_comment_to_incident": {
                        "type": "ApiConnection",
                        "inputs": {
                            "body": {
                                "incidentArmId": "@triggerBody()?['IncidentArmID']",
                                "message": "<p><b>Group-IB TI &mdash; IP Scoring</b><br><br><b>IP: @{triggerBody()?['Entity']?['properties']?['Address']}</b> &mdash; Group-IB risk score: <b>@{coalesce(body('Score_IP')?['items']?[triggerBody()?['Entity']?['properties']?['Address']]?['riskScore'], 'n/a')}</b>/100</p>"
                            },
                            "host": {
                                "connection": {
                                    "referenceName": "azuresentinel"
                                }
                            },
                            "method": "post",
                            "path": "/Incidents/Comment"
                        },
                        "runAfter": {}
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Score_IP": [
                        "Succeeded",
                        "Failed"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}
