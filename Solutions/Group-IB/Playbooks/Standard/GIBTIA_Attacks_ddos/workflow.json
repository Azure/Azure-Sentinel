{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Hour",
          "interval": 1
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Initialize_seqUpdate": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "seqUpdate",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_IsPortionEmpty": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "IsPortionEmpty",
              "type": "boolean",
              "value": false
            }
          ]
        },
        "runAfter": {
          "Initialize_seqUpdate": [
            "Succeeded"
          ]
        }
      },
      "Query_Last_SeqUpdate": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{concat('https://management.azure.com/subscriptions/', appsetting('WORKFLOWS_SUBSCRIPTION_ID'), '/resourceGroups/', appsetting('WORKFLOWS_RESOURCE_GROUP_NAME'), '/providers/microsoft.operationalinsights/workspaces/', appsetting('WorkspaceName'), '/query?api-version=2017-10-01')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "query": "GIBCollectionTracking_CL | where CollectionName_s == \"attacks/ddos\" | top 1 by TimeGenerated desc | project SeqUpdate_d"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://management.azure.com/"
          }
        },
        "runAfter": {
          "Initialize_IsPortionEmpty": [
            "Succeeded"
          ]
        }
      },
      "Condition_First_Run": {
        "type": "If",
        "expression": {
          "or": [
            {
              "equals": [
                "@actions('Query_Last_SeqUpdate').status",
                "Failed"
              ]
            },
            {
              "equals": [
                "@length(coalesce(body('Query_Last_SeqUpdate')?['tables']?[0]?['rows'], json('[]')))",
                0
              ]
            }
          ]
        },
        "actions": {
          "HTTP_Get_SequenceList": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://tap.group-ib.com/api/v2/sequence_list",
              "queries": {
                "date": "@{appsetting('StartDate')}",
                "collection": "attacks/ddos"
              },
              "headers": {
                "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                "Accept": "application/json",
                "User-Agent": "GroupIB-MSentinel-Integration/2.0 (attacks-ddos; logic-app)"
              }
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs"
                ]
              }
            },
            "runAfter": {}
          },
          "Parse_SequenceList": {
            "type": "ParseJson",
            "inputs": {
              "content": "@body('HTTP_Get_SequenceList')",
              "schema": {
                "type": "object",
                "properties": {
                  "list": {
                    "type": "object"
                  }
                }
              }
            },
            "runAfter": {
              "HTTP_Get_SequenceList": [
                "Succeeded"
              ]
            }
          },
          "Set_seqUpdate_From_SequenceList": {
            "type": "SetVariable",
            "inputs": {
              "name": "seqUpdate",
              "value": "@body('Parse_SequenceList')?['list']?['attacks/ddos']"
            },
            "runAfter": {
              "Parse_SequenceList": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Set_seqUpdate_From_DB": {
              "type": "SetVariable",
              "inputs": {
                "name": "seqUpdate",
                "value": "@int(body('Query_Last_SeqUpdate')?['tables'][0]?['rows'][0]?[0])"
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Query_Last_SeqUpdate": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Until": {
        "type": "Until",
        "expression": "@equals(variables('IsPortionEmpty'), true)",
        "limit": {
          "count": 100,
          "timeout": "PT1H"
        },
        "actions": {
          "Get_next_portion": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{concat('https://tap.group-ib.com/api/v2/attacks/ddos/updated?seqUpdate=', variables('seqUpdate'), '&limit=', min(int(appsetting('LimitPerPortion')), 5000))}",
              "headers": {
                "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                "Accept": "application/json",
                "User-Agent": "GroupIB-MSentinel-Integration/2.0 (attacks-ddos; logic-app)"
              }
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs"
                ]
              }
            },
            "runAfter": {}
          },
          "Parse_Feed_Response": {
            "type": "ParseJson",
            "inputs": {
              "content": "@body('Get_next_portion')",
              "schema": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "seqUpdate": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "items": {
                    "type": "array",
                    "items": {}
                  }
                }
              }
            },
            "runAfter": {
              "Get_next_portion": [
                "Succeeded"
              ]
            }
          },
          "Set_IsPortionEmpty_on_parse_failure": {
            "type": "SetVariable",
            "inputs": {
              "name": "IsPortionEmpty",
              "value": true
            },
            "runAfter": {
              "Parse_Feed_Response": [
                "Failed",
                "TimedOut"
              ]
            }
          },
          "Condition_Set_IsPortionEmpty": {
            "type": "If",
            "expression": {
              "equals": [
                "@body('Parse_Feed_Response')?['count']",
                0
              ]
            },
            "actions": {
              "Set_IsPortionEmpty": {
                "type": "SetVariable",
                "inputs": {
                  "name": "IsPortionEmpty",
                  "value": true
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Set_seqUpdate": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "seqUpdate",
                    "value": "@body('Parse_Feed_Response')?['seqUpdate']"
                  },
                  "runAfter": {}
                },
                "Filter_items_with_domain": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Parse_Feed_Response')?['items']",
                    "where": "@not(equals(item()?['cnc']?['domain'], null))"
                  },
                  "runAfter": {
                    "Set_seqUpdate": [
                      "Succeeded"
                    ]
                  }
                },
                "Filter_items_with_ip": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Parse_Feed_Response')?['items']",
                    "where": "@not(equals(item()?['cnc']?['ipv4']?['ip'], null))"
                  },
                  "runAfter": {
                    "Set_seqUpdate": [
                      "Succeeded"
                    ]
                  }
                },
                "Filter_items_with_url": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Parse_Feed_Response')?['items']",
                    "where": "@not(equals(item()?['cnc']?['url'], null))"
                  },
                  "runAfter": {
                    "Set_seqUpdate": [
                      "Succeeded"
                    ]
                  }
                },
                "For_each_domain_item": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_items_with_domain')",
                  "actions": {
                    "SendToBatch_Domain": {
                      "type": "SendToBatch",
                      "inputs": {
                        "batchName": "GIBIOCBatch",
                        "content": {
                          "type": "indicator",
                          "spec_version": "2.1",
                          "id": "@{concat('indicator--', guid())}",
                          "created": "@{items('For_each_domain_item')?['dateBegin']}",
                          "modified": "@{items('For_each_domain_item')?['dateBegin']}",
                          "name": "@{concat('domain=', items('For_each_domain_item')?['cnc']?['domain'])}",
                          "pattern": "@{concat('[domain-name:value = ''', items('For_each_domain_item')?['cnc']?['domain'], ''']')}",
                          "pattern_type": "stix",
                          "valid_from": "@{items('For_each_domain_item')?['dateBegin']}",
                          "valid_until": "@{addDays(items('For_each_domain_item')?['dateBegin'], 90)}",
                          "confidence": "@int(coalesce(items('For_each_domain_item')?['evaluation']?['credibility'], 50))",
                          "indicator_types": [
                            "malicious-activity"
                          ],
                          "labels": [
                            "Group-IB TI",
                            "attacks/ddos"
                          ]
                        },
                        "host": {
                          "triggerName": "Batch_messages",
                          "workflow": {
                            "id": "GIBTIA_IndicatorProcessor_v2"
                          }
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Filter_items_with_domain": [
                      "Succeeded"
                    ]
                  }
                },
                "For_each_ip_item": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_items_with_ip')",
                  "actions": {
                    "SendToBatch_IP": {
                      "type": "SendToBatch",
                      "inputs": {
                        "batchName": "GIBIOCBatch",
                        "content": {
                          "type": "indicator",
                          "spec_version": "2.1",
                          "id": "@{concat('indicator--', guid())}",
                          "created": "@{items('For_each_ip_item')?['dateBegin']}",
                          "modified": "@{items('For_each_ip_item')?['dateBegin']}",
                          "name": "@{concat('IP=', items('For_each_ip_item')?['cnc']?['ipv4']?['ip'])}",
                          "pattern": "@{concat('[ipv4-addr:value = ''', items('For_each_ip_item')?['cnc']?['ipv4']?['ip'], ''']')}",
                          "pattern_type": "stix",
                          "valid_from": "@{items('For_each_ip_item')?['dateBegin']}",
                          "valid_until": "@{addDays(items('For_each_ip_item')?['dateBegin'], 90)}",
                          "confidence": "@int(coalesce(items('For_each_ip_item')?['evaluation']?['credibility'], 50))",
                          "indicator_types": [
                            "malicious-activity"
                          ],
                          "labels": [
                            "Group-IB TI",
                            "attacks/ddos"
                          ]
                        },
                        "host": {
                          "triggerName": "Batch_messages",
                          "workflow": {
                            "id": "GIBTIA_IndicatorProcessor_v2"
                          }
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Filter_items_with_ip": [
                      "Succeeded"
                    ]
                  }
                },
                "For_each_url_item": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_items_with_url')",
                  "actions": {
                    "SendToBatch_URL": {
                      "type": "SendToBatch",
                      "inputs": {
                        "batchName": "GIBIOCBatch",
                        "content": {
                          "type": "indicator",
                          "spec_version": "2.1",
                          "id": "@{concat('indicator--', guid())}",
                          "created": "@{items('For_each_url_item')?['dateBegin']}",
                          "modified": "@{items('For_each_url_item')?['dateBegin']}",
                          "name": "@{concat('url=', items('For_each_url_item')?['cnc']?['url'])}",
                          "pattern": "@{concat('[url:value = ''', items('For_each_url_item')?['cnc']?['url'], ''']')}",
                          "pattern_type": "stix",
                          "valid_from": "@{items('For_each_url_item')?['dateBegin']}",
                          "valid_until": "@{addDays(items('For_each_url_item')?['dateBegin'], 90)}",
                          "confidence": "@int(coalesce(items('For_each_url_item')?['evaluation']?['credibility'], 50))",
                          "indicator_types": [
                            "malicious-activity"
                          ],
                          "labels": [
                            "Group-IB TI",
                            "attacks/ddos"
                          ]
                        },
                        "host": {
                          "triggerName": "Batch_messages",
                          "workflow": {
                            "id": "GIBTIA_IndicatorProcessor_v2"
                          }
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Filter_items_with_url": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Parse_Feed_Response": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Condition_First_Run": [
            "Succeeded"
          ]
        }
      },
      "Save_tracking_record": {
        "type": "ApiConnection",
        "inputs": {
          "body": "{\"CollectionName\": \"attacks/ddos\", \"SeqUpdate\": @{variables('seqUpdate')}}",
          "headers": {
            "Log-Type": "GIBCollectionTracking",
            "time-generated-field": ""
          },
          "host": {
            "connection": {
              "referenceName": "azureloganalyticsdatacollector"
            }
          },
          "method": "post",
          "path": "/api/logs"
        },
        "runAfter": {
          "Until": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
