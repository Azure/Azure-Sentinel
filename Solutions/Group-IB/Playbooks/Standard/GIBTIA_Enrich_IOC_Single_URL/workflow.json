{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Microsoft_Sentinel_entity": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "body": {
                        "callback_url": "@{listCallbackUrl()}"
                    },
                    "host": {
                        "connection": {
                            "referenceName": "azuresentinel"
                        }
                    },
                    "path": "/entity/@{encodeURIComponent('URL')}"
                }
            }
        },
        "actions": {
            "Initialize_Segments": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Segments",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {}
            },
            "Initialize_Chunks": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Chunks",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Initialize_Segments": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_Chunk": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Chunk",
                            "type": "string",
                            "value": ""
                        }
                    ]
                },
                "runAfter": {
                    "Initialize_Chunks": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_PartNum": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "PartNum",
                            "type": "integer",
                            "value": 0
                        }
                    ]
                },
                "runAfter": {
                    "Initialize_Chunk": [
                        "Succeeded"
                    ]
                }
            },
            "Get_Granted_Collections": {
                "type": "Http",
                "inputs": {
                    "method": "GET",
                    "uri": "https://tap.group-ib.com/api/v2/user/granted_collections",
                    "headers": {
                        "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                        "Accept": "application/json",
                        "User-Agent": "GroupIB-MSentinel-Integration/2.0 (enrich-ioc; logic-app)"
                    }
                },
                "runtimeConfiguration": {
                    "secureData": {
                        "properties": [
                            "inputs"
                        ]
                    }
                },
                "runAfter": {
                    "Initialize_PartNum": [
                        "Succeeded"
                    ]
                }
            },
            "Select_Granted_Set": {
                "type": "Select",
                "inputs": {
                    "from": "@coalesce(body('Get_Granted_Collections'), json('[]'))",
                    "select": "@item()?['collection']"
                },
                "runAfter": {
                    "Get_Granted_Collections": [
                        "Succeeded",
                        "Failed"
                    ]
                }
            },
            "Search_URL": {
                "type": "Http",
                "inputs": {
                    "method": "GET",
                    "uri": "https://tap.group-ib.com/api/v2/search",
                    "queries": {
                        "q": "@{triggerBody()?['Entity']?['properties']?['Url']}"
                    },
                    "headers": {
                        "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                        "Accept": "application/json",
                        "User-Agent": "GroupIB-MSentinel-Integration/2.0 (enrich-ioc; logic-app)"
                    }
                },
                "runtimeConfiguration": {
                    "secureData": {
                        "properties": [
                            "inputs"
                        ]
                    }
                },
                "runAfter": {
                    "Select_Granted_Set": [
                        "Succeeded"
                    ]
                }
            },
            "Filter_Matches_URL": {
                "type": "Query",
                "inputs": {
                    "from": "@coalesce(body('Search_URL'), json('[]'))",
                    "where": "@and(greater(coalesce(item()?['count'], 0), 0), contains(body('Select_Granted_Set'), item()?['apiPath']))"
                },
                "runAfter": {
                    "Search_URL": [
                        "Succeeded",
                        "Failed"
                    ]
                }
            },
            "Append_URL_Header": {
                "type": "AppendToArrayVariable",
                "inputs": {
                    "name": "Segments",
                    "value": "<b>URL: @{triggerBody()?['Entity']?['properties']?['Url']}</b><br>@{if(equals(length(body('Filter_Matches_URL')), 0), 'No matches in collections available to this account.', concat('Matches in ', length(body('Filter_Matches_URL')), ' granted collection(s):'))}<br>"
                },
                "runAfter": {
                    "Filter_Matches_URL": [
                        "Succeeded"
                    ]
                }
            },
            "For_Each_Match_URL": {
                "type": "Foreach",
                "foreach": "@body('Filter_Matches_URL')",
                "operationOptions": "Sequential",
                "actions": {
                    "Fetch_Match_URL": {
                        "type": "Http",
                        "inputs": {
                            "method": "GET",
                            "uri": "@{concat(items('For_Each_Match_URL')?['link'], '&limit=3')}",
                            "headers": {
                                "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                                "Accept": "application/json",
                                "User-Agent": "GroupIB-MSentinel-Integration/2.0 (enrich-ioc; logic-app)"
                            }
                        },
                        "runAfter": {}
                    },
                    "Select_Match_Entries_URL": {
                        "type": "Select",
                        "inputs": {
                            "from": "@coalesce(body('Fetch_Match_URL')?['items'], json('[]'))",
                            "select": "@string(item())"
                        },
                        "runAfter": {
                            "Fetch_Match_URL": [
                                "Succeeded",
                                "Failed"
                            ]
                        }
                    },
                    "Append_Match_URL": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                            "name": "Segments",
                            "value": "&nbsp;&nbsp;&middot; <b>@{items('For_Each_Match_URL')?['label']}</b> &mdash; @{items('For_Each_Match_URL')?['count']} match(es)@{if(greater(length(body('Select_Match_Entries_URL')), 0), concat(':<pre>', join(body('Select_Match_Entries_URL'), '<br>'), '</pre>'), '<br>')}"
                        },
                        "runAfter": {
                            "Select_Match_Entries_URL": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Append_URL_Header": [
                        "Succeeded"
                    ]
                }
            },
            "Pack_Segments": {
                "type": "Foreach",
                "foreach": "@variables('Segments')",
                "operationOptions": "Sequential",
                "actions": {
                    "Condition_Segment_Fits": {
                        "type": "If",
                        "expression": {
                            "lessOrEquals": [
                                "@add(length(variables('Chunk')), length(items('Pack_Segments')))",
                                29000
                            ]
                        },
                        "actions": {
                            "Append_To_Chunk": {
                                "type": "AppendToStringVariable",
                                "inputs": {
                                    "name": "Chunk",
                                    "value": "@items('Pack_Segments')"
                                },
                                "runAfter": {}
                            }
                        },
                        "else": {
                            "actions": {
                                "Condition_Flush_NonEmpty": {
                                    "type": "If",
                                    "expression": {
                                        "greater": [
                                            "@length(variables('Chunk'))",
                                            0
                                        ]
                                    },
                                    "actions": {
                                        "Flush_Chunk": {
                                            "type": "AppendToArrayVariable",
                                            "inputs": {
                                                "name": "Chunks",
                                                "value": "@variables('Chunk')"
                                            },
                                            "runAfter": {}
                                        }
                                    },
                                    "else": {
                                        "actions": {}
                                    },
                                    "runAfter": {}
                                },
                                "Start_New_Chunk": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "Chunk",
                                        "value": "@if(greater(length(items('Pack_Segments')), 29000), concat(substring(items('Pack_Segments'), 0, 28950), '<br>[record truncated — see Group-IB portal]'), items('Pack_Segments'))"
                                    },
                                    "runAfter": {
                                        "Condition_Flush_NonEmpty": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            }
                        },
                        "runAfter": {}
                    }
                },
                "runAfter": {
                    "For_Each_Match_URL": [
                        "Succeeded",
                        "Skipped",
                        "Failed"
                    ]
                }
            },
            "Flush_Final_Chunk": {
                "type": "If",
                "expression": {
                    "greater": [
                        "@length(variables('Chunk'))",
                        0
                    ]
                },
                "actions": {
                    "Append_Final_Chunk": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                            "name": "Chunks",
                            "value": "@variables('Chunk')"
                        },
                        "runAfter": {}
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Pack_Segments": [
                        "Succeeded"
                    ]
                }
            },
            "Condition_Has_Incident": {
                "type": "If",
                "expression": {
                    "greater": [
                        "@length(coalesce(triggerBody()?['IncidentArmID'], ''))",
                        0
                    ]
                },
                "actions": {
                    "Post_Comments": {
                        "type": "Foreach",
                        "foreach": "@variables('Chunks')",
                        "operationOptions": "Sequential",
                        "actions": {
                            "Increment_PartNum": {
                                "type": "IncrementVariable",
                                "inputs": {
                                    "name": "PartNum",
                                    "value": 1
                                },
                                "runAfter": {}
                            },
                            "Add_comment_to_incident": {
                                "type": "ApiConnection",
                                "inputs": {
                                    "body": {
                                        "incidentArmId": "@triggerBody()?['IncidentArmID']",
                                        "message": "<p><b>Group-IB TI &mdash; IOC Cross-Collection Enrichment@{if(greater(length(variables('Chunks')), 1), concat(' (part ', string(variables('PartNum')), ' of ', string(length(variables('Chunks'))), ')'), '')}</b><br><i>(searches across all collections granted to the integration's API key; fetches first 3 records per matched collection)</i><br><br>@{items('Post_Comments')}</p>"
                                    },
                                    "host": {
                                        "connection": {
                                            "referenceName": "azuresentinel"
                                        }
                                    },
                                    "method": "post",
                                    "path": "/Incidents/Comment"
                                },
                                "runAfter": {
                                    "Increment_PartNum": [
                                        "Succeeded"
                                    ]
                                }
                            }
                        },
                        "runAfter": {}
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Flush_Final_Chunk": [
                        "Succeeded"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}
