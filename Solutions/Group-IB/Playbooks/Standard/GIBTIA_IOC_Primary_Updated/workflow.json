                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "seqUpdate": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "type": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dateFirstSeen": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
