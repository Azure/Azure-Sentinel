                          },
                          "host": {
                            "triggerName": "Batch_messages",
                            "workflow": {
                              "id": "GIBTIA_IndicatorProcessor_v2"
                            }
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "runAfter": {}
                  },
                  "For_each_domain": {
                    "type": "Foreach",
                    "foreach": "@items('For_each_network_item')?['domain']",
                    "actions": {
                      "SendToBatch_Domain": {
                        "type": "SendToBatch",
                        "inputs": {
                          "batchName": "GIBIOCBatch",
