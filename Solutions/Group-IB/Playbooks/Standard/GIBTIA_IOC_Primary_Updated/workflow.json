{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Hour",
          "interval": 1
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Initialize_seqUpdate": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "seqUpdate",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_IsPortionEmpty": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "IsPortionEmpty",
              "type": "boolean",
              "value": false
            }
          ]
        },
        "runAfter": {
          "Initialize_seqUpdate": [
            "Succeeded"
          ]
        }
      },
      "Query_Last_SeqUpdate": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{concat('https://management.azure.com/subscriptions/', appsetting('WORKFLOWS_SUBSCRIPTION_ID'), '/resourceGroups/', appsetting('WORKFLOWS_RESOURCE_GROUP_NAME'), '/providers/microsoft.operationalinsights/workspaces/', appsetting('WorkspaceName'), '/query?api-version=2017-10-01')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "query": "GIBCollectionTracking_CL | where CollectionName_s == \"ioc/primary\" | top 1 by TimeGenerated desc | project SeqUpdate_d"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://management.azure.com/"
          }
        },
        "runAfter": {
          "Initialize_IsPortionEmpty": [
            "Succeeded"
          ]
        }
      },
      "Condition_First_Run": {
        "type": "If",
        "expression": {
          "or": [
            {
              "equals": [
                "@actions('Query_Last_SeqUpdate').status",
                "Failed"
              ]
            },
            {
              "equals": [
                "@length(coalesce(body('Query_Last_SeqUpdate')?['tables']?[0]?['rows'], json('[]')))",
                0
              ]
            }
          ]
        },
        "actions": {
          "HTTP_Get_SequenceList": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://tap.group-ib.com/api/v2/sequence_list",
              "queries": {
                "date": "@{appsetting('StartDate')}",
                "collection": "ioc/primary"
              },
              "headers": {
                "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
                "Accept": "application/json",
                "User-Agent": "GroupIB-MSentinel-Integration/2.0 (ioc-primary; logic-app)"
              }
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs"
                ]
              }
            },
            "runAfter": {}
          },
          "Parse_SequenceList": {
            "type": "ParseJson",
            "inputs": {
              "content": "@body('HTTP_Get_SequenceList')",
              "schema": {
                "type": "object",
                "properties": {
                  "list": {
                    "type": "object"
                  }
                }
              }
            },
            "runAfter": {
              "HTTP_Get_SequenceList": [
                "Succeeded"
              ]
            }
          },
          "Set_seqUpdate_From_SequenceList": {
            "type": "SetVariable",
            "inputs": {
              "name": "seqUpdate",
              "value": "@body('Parse_SequenceList')?['list']?['ioc/primary']"
            },
            "runAfter": {
              "Parse_SequenceList": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Set_seqUpdate_From_DB": {
              "type": "SetVariable",
              "inputs": {
                "name": "seqUpdate",
                "value": "@int(body('Query_Last_SeqUpdate')?['tables'][0]?['rows'][0]?[0])"
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Query_Last_SeqUpdate": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Until": {
        "type": "Until",
        "expression": "@equals(variables('IsPortionEmpty'), true)",
        "limit": {
          "count": 100,
          "timeout": "PT1H"
        },
        "actions": {
          "Get_next_portion": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{concat('https://tap.group-ib.com/api/v2/ioc/primary/updated?seqUpdate=', variables('seqUpdate'), '&limit=', min(int(appsetting('LimitPerPortion')), 5000), if(equals(appsetting('IOCTypeFilter'), 'all'), '', concat('&q=', appsetting('IOCTypeFilter'))))}",
              "headers": {
                "Authorization": "@{concat('Basic ', base64(concat(appsetting('GIBUsername'), ':', appsetting('GIBApiKey'))))}",
