                            "confidence": "@if(and(equals(bool(appsetting('UseAdmiraltyConfidence')), true), and(not(equals(items('For_each_network_item')?['evaluation']?['admiraltyCode'], null)), and(equals(length(items('For_each_network_item')?['evaluation']?['admiraltyCode']), 2), and(not(equals(json('{\"A\":100,\"B\":80,\"C\":60,\"D\":40,\"E\":20,\"F\":0}')[substring(items('For_each_network_item')?['evaluation']?['admiraltyCode'], 0, 1)], null)), not(equals(json('{\"1\":100,\"2\":80,\"3\":60,\"4\":40,\"5\":20,\"6\":0}')[substring(items('For_each_network_item')?['evaluation']?['admiraltyCode'], 1, 1)], null)))))), div(add(json('{\"A\":100,\"B\":80,\"C\":60,\"D\":40,\"E\":20,\"F\":0}')[substring(items('For_each_network_item')?['evaluation']?['admiraltyCode'], 0, 1)], json('{\"1\":100,\"2\":80,\"3\":60,\"4\":40,\"5\":20,\"6\":0}')[substring(items('For_each_network_item')?['evaluation']?['admiraltyCode'], 1, 1)]), 2), if(equals(bool(appsetting('UseRiskScoreAsConfidence')), true), items('For_each_url')?['riskScore'], if(not(equals(int(appsetting('FixedConfidence')), -1)), int(appsetting('FixedConfidence')), null)))",
