{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "PlaybookName": {
            "defaultValue": "GIBTIA_OSI_PublicLeak",
            "type": "string"
        },
        "UserName": {
            "defaultValue": "<username>@<domain>",
            "type": "string"
        },
        "GIBUsername": {
            "type": "string",
            "metadata": {
                "description": "GIB TI portal login (email)."
            }
        },
        "GIBApiKey": {
            "type": "securestring",
            "metadata": {
                "description": "GIB TI personal API token."
            }
        },
        "StartDate": {
            "type": "string",
            "metadata": {
                "description": "YYYY-MM-DD. Used only on the first run to look up the initial seqUpdate via sequence_list."
            }
        },
        "LimitPerPortion": {
            "defaultValue": 5,
            "type": "int",
            "minValue": 1,
            "maxValue": 5,
            "metadata": {
                "description": "Records per API call (1-5). Capped at 5, NOT at the osi/public_leak API maximum of 100: public-leak records are full text dumps, and larger pages exceed the Logic Apps 100 MB action payload limit. This ceiling is size-driven, not API-driven — do not raise it to 100."
            }
        },
        "WorkspaceId": {
            "type": "string",
            "metadata": {
                "description": "Log Analytics workspace ID (GUID)."
            }
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "Log Analytics workspace name."
            }
        }
    },
    "variables": {
        "AzureLogAnalyticsDataCollectorConnectionName": "[concat('azureloganalyticsdatacollector-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureLogAnalyticsDataCollectorConnectionName')]",
            "location": "[resourceGroup().location]",
            "properties": {
                "displayName": "[parameters('UserName')]",
                "customParameterValues": {},
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "tags": {
                "hidden-SentinelTemplateName": "GIBTIA_OSI_PublicLeak",
                "hidden-SentinelTemplateVersion": "2.0"
            },
            "metadata": {
                "title": "Group-IB TI - Public leak collector",
                "description": "Polls the Group-IB Threat Intelligence osi/public_leak collection hourly using incremental seqUpdate paging and writes public data leaks to the GIBOSIPublicLeak_CL custom table in Log Analytics for use in analytics rules and hunting queries.",
                "prerequisites": [
                    "A Group-IB Threat Intelligence subscription with API access to the osi/public_leak collection.",
                    "A Log Analytics workspace connected to Microsoft Sentinel."
                ],
                "postDeployment": [
                    "1. Authorize the Azure Monitor Logs and Azure Log Analytics Data Collector API connections.",
                    "2. Assign both the Microsoft Sentinel Contributor and Log Analytics Contributor roles to the playbook's managed identity at workspace scope. Both are required.",
                    "3. Set the GIBUsername, GIBApiKey, StartDate and LimitPerPortion parameters.",
                    "4. Enable the Logic App. It deploys in a Disabled state by design. Records appear in GIBOSIPublicLeak_CL after the first successful run."
                ],
                "lastUpdateTime": "2026-09-02T00:00:00.000Z",
                "entities": [],
                "tags": [
                    "Group-IB",
                    "Threat Intelligence",
                    "Context"
                ],
                "releaseNotes": [
                    {
                        "version": "2.0",
                        "title": "Sentinel threat intelligence upload API",
                        "notes": [
                            "Replaces the deprecated Microsoft Security Graph API implementation. Indicators are submitted with Upload_Indicators_V2 using a managed identity and land in the ThreatIntelIndicators table."
                        ]
                    }
                ],
                "support": {
                    "tier": "community"
                },
                "author": {
                    "name": "Group-IB"
                }
            },
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureLogAnalyticsDataCollectorConnectionName'))]"
            ],
            "properties": {
                "state": "Disabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "GIBUsername": {
                            "defaultValue": "[parameters('GIBUsername')]",
                            "type": "String"
                        },
                        "GIBApiKey": {
                            "defaultValue": "[parameters('GIBApiKey')]",
                            "type": "SecureString"
                        },
                        "StartDate": {
                            "defaultValue": "[parameters('StartDate')]",
                            "type": "String"
                        },
                        "LimitPerPortion": {
                            "defaultValue": "[parameters('LimitPerPortion')]",
                            "type": "Int"
                        },
                        "WorkspaceId": {
                            "defaultValue": "[parameters('WorkspaceId')]",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "type": "Recurrence",
                            "recurrence": {
                                "frequency": "Hour",
                                "interval": 1
                            },
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "runs": 1
                                }
                            }
                        }
                    },
                    "actions": {
                        "Initialize_seqUpdate": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "seqUpdate",
                                        "type": "integer",
                                        "value": 0
                                    }
                                ]
                            },
                            "runAfter": {}
                        },
                        "Initialize_IsPortionEmpty": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "IsPortionEmpty",
                                        "type": "boolean",
                                        "value": false
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_seqUpdate": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Initialize_RecordsArray": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "RecordsArray",
                                        "type": "array",
                                        "value": []
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_IsPortionEmpty": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Query_Last_SeqUpdate": {
                            "type": "Http",
                            "inputs": {
                                "method": "POST",
                                "uri": "[concat('https://management.azure.com/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/microsoft.operationalinsights/workspaces/', parameters('WorkspaceName'), '/query?api-version=2017-10-01')]",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": {
                                    "query": "GIBCollectionTracking_CL | where CollectionName_s == \"osi/public_leak\" | top 1 by TimeGenerated desc | project SeqUpdate_d"
                                },
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://management.azure.com/"
                                }
                            },
                            "runAfter": {
                                "Initialize_RecordsArray": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Condition_First_Run": {
                            "type": "If",
                            "expression": {
                                "or": [
                                    {
                                        "equals": [
                                            "@actions('Query_Last_SeqUpdate').status",
                                            "Failed"
                                        ]
                                    },
                                    {
                                        "equals": [
                                            "@length(coalesce(body('Query_Last_SeqUpdate')?['tables']?[0]?['rows'], json('[]')))",
                                            0
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "HTTP_Get_SequenceList": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "https://tap.group-ib.com/api/v2/sequence_list",
                                        "queries": {
                                            "date": "@{parameters('StartDate')}",
                                            "collection": "osi/public_leak"
                                        },
                                        "headers": {
                                            "Authorization": "@{concat('Basic ', base64(concat(parameters('GIBUsername'), ':', parameters('GIBApiKey'))))}",
                                            "Accept": "application/json",
                                            "User-Agent": "GroupIB-MSentinel-Integration/2.0 (osi-public-leak; logic-app)"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    },
                                    "runAfter": {}
                                },
                                "Parse_SequenceList": {
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('HTTP_Get_SequenceList')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "list": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "HTTP_Get_SequenceList": [
                                            "Succeeded"
                                        ]
                                    }
                                },
                                "Set_seqUpdate_From_SequenceList": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "seqUpdate",
                                        "value": "@body('Parse_SequenceList')?['list']?['osi/public_leak']"
                                    },
                                    "runAfter": {
                                        "Parse_SequenceList": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Set_seqUpdate_From_DB": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "seqUpdate",
                                            "value": "@int(body('Query_Last_SeqUpdate')?['tables'][0]?['rows'][0]?[0])"
                                        },
                                        "runAfter": {}
                                    }
                                }
                            },
                            "runAfter": {
                                "Query_Last_SeqUpdate": [
                                    "Succeeded",
                                    "Failed"
                                ]
                            }
                        },
                        "Until": {
                            "type": "Until",
                            "expression": "@equals(variables('IsPortionEmpty'), true)",
                            "limit": {
                                "count": 500,
                                "timeout": "PT1H"
                            },
                            "actions": {
                                "Get_next_portion": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{concat('https://tap.group-ib.com/api/v2/osi/public_leak/updated?seqUpdate=', variables('seqUpdate'), '&limit=', min(parameters('LimitPerPortion'), 5))}",
                                        "headers": {
                                            "Authorization": "@{concat('Basic ', base64(concat(parameters('GIBUsername'), ':', parameters('GIBApiKey'))))}",
                                            "Accept": "application/json",
                                            "User-Agent": "GroupIB-MSentinel-Integration/2.0 (osi-public-leak; logic-app)"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    },
                                    "runAfter": {}
                                },
                                "Parse_Feed_Response": {
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('Get_next_portion')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "count": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "seqUpdate": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "items": {
                                                    "type": "array",
                                                    "items": {}
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Get_next_portion": [
                                            "Succeeded"
                                        ]
                                    }
                                },
                                "Set_IsPortionEmpty_on_parse_failure": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "IsPortionEmpty",
                                        "value": true
                                    },
                                    "runAfter": {
                                        "Parse_Feed_Response": [
                                            "Failed",
                                            "TimedOut"
                                        ]
                                    }
                                },
                                "Condition_Set_IsPortionEmpty": {
                                    "type": "If",
                                    "expression": {
                                        "equals": [
                                            "@body('Parse_Feed_Response')?['count']",
                                            0
                                        ]
                                    },
                                    "actions": {
                                        "Set_IsPortionEmpty": {
                                            "type": "SetVariable",
                                            "inputs": {
                                                "name": "IsPortionEmpty",
                                                "value": true
                                            },
                                            "runAfter": {}
                                        }
                                    },
                                    "else": {
                                        "actions": {
                                            "Set_seqUpdate": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "seqUpdate",
                                                    "value": "@body('Parse_Feed_Response')?['seqUpdate']"
                                                },
                                                "runAfter": {}
                                            },
                                            "For_each_item": {
                                                "type": "Foreach",
                                                "foreach": "@body('Parse_Feed_Response')?['items']",
                                                "operationOptions": "Sequential",
                                                "actions": {
                                                    "Append_to_RecordsArray": {
                                                        "type": "AppendToArrayVariable",
                                                        "inputs": {
                                                            "name": "RecordsArray",
                                                            "value": "@items('For_each_item')"
                                                        },
                                                        "runAfter": {}
                                                    }
                                                },
                                                "runAfter": {
                                                    "Set_seqUpdate": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "Write_batch_to_table": {
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "body": "@{string(variables('RecordsArray'))}",
                                                    "headers": {
                                                        "Log-Type": "GIBOSIPublicLeak",
                                                        "time-generated-field": ""
                                                    },
                                                    "host": {
                                                        "connection": {
                                                            "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                                                        }
                                                    },
                                                    "method": "post",
                                                    "path": "/api/logs"
                                                },
                                                "runAfter": {
                                                    "For_each_item": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "Reset_RecordsArray": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "RecordsArray",
                                                    "value": []
                                                },
                                                "runAfter": {
                                                    "Write_batch_to_table": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Parse_Feed_Response": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Condition_First_Run": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Save_tracking_record": {
                            "type": "ApiConnection",
                            "inputs": {
                                "body": "{\"CollectionName\": \"osi/public_leak\", \"SeqUpdate\": @{variables('seqUpdate')}}",
                                "headers": {
                                    "Log-Type": "GIBCollectionTracking",
                                    "time-generated-field": ""
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azureloganalyticsdatacollector']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "path": "/api/logs"
                            },
                            "runAfter": {
                                "Until": [
                                    "Succeeded"
                                ]
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azureloganalyticsdatacollector": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureLogAnalyticsDataCollectorConnectionName'))]",
                                "connectionName": "[variables('AzureLogAnalyticsDataCollectorConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azureloganalyticsdatacollector')]"
                            }
                        }
                    }
                }
            },
            "identity": {
                "type": "SystemAssigned"
            }
        }
    ]
}
