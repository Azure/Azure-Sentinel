{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "PlaybookName": {
            "defaultValue": "GIBTIA_APT_ThreatActor",
            "type": "string"
        },
        "GIBUsername": {
            "type": "string",
            "metadata": {
                "description": "GIB TI portal login (email)."
            }
        },
        "GIBApiKey": {
            "type": "securestring",
            "metadata": {
                "description": "GIB TI personal API token."
            }
        },
        "StartDate": {
            "type": "string",
            "metadata": {
                "description": "YYYY-MM-DD. Used only on the first run to look up the initial seqUpdate via sequence_list."
            }
        },
        "LimitPerPortion": {
            "defaultValue": 100,
            "type": "int",
            "minValue": 1,
            "maxValue": 100,
            "metadata": {
                "description": "Records per API call (1-100). Lower default due to larger record size."
            }
        },
        "RecordsPerWrite": {
            "defaultValue": 50,
            "minValue": 1,
            "maxValue": 500,
            "type": "int",
            "metadata": {
                "description": "Records per Logs Ingestion API call (the API accepts at most 1 MB per call). Default 50 is sized from the largest apt/threat_actor records seen. Lower it if Write_chunk_to_table fails with HTTP 413."
            }
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "Log Analytics workspace name. Must be in this resource group: the template creates the GIBCollectionTracking_CL table in it, points the Data Collection Rule at it, and reads the seqUpdate cursor from it."
            }
        },
        "WorkspaceLocation": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string",
            "metadata": {
                "description": "Leave as is unless your Log Analytics workspace is in a different Azure region from this resource group. The Data Collection Rule must be created in the workspace's region; the default is this resource group's region."
            }
        },
        "AssignRoles": {
            "defaultValue": true,
            "type": "bool",
            "metadata": {
                "description": "true (default): the template grants this playbook's managed identity Monitoring Metrics Publisher on its Data Collection Rule and Log Analytics Reader on the workspace, so it works as soon as it is enabled. Requires the deploying account to hold Owner or User Access Administrator on the resource group. Set false if it does not, and assign those two roles by hand after deployment."
            }
        }
    },
    "variables": {
        "DcrName": "[concat('gib-apt-actor-', uniqueString(resourceGroup().id, parameters('PlaybookName')))]",
        "DcrResourceId": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('DcrName'))]",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
        "TrackingTableName": "GIBCollectionTracking_CL",
        "TrackingStreamName": "Custom-GIBCollectionTracking",
        "MonitoringMetricsPublisherRoleId": "3913510d-42f4-4e42-8a64-420c390055eb",
        "LogAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893",
        "ContextTableName": "GIBAPTThreatActor_CL",
        "ContextStreamName": "Custom-GIBAPTThreatActor"
    },
    "resources": [
        {
            "type": "Microsoft.OperationalInsights/workspaces/tables",
            "apiVersion": "2025-07-01",
            "name": "[concat(parameters('WorkspaceName'), '/', variables('TrackingTableName'))]",
            "properties": {
                "schema": {
                    "name": "[variables('TrackingTableName')]",
                    "description": "Group-IB TI seqUpdate cursor, one row per collector write. Shared by all GIBTIA collectors. Do not add columns: it breaks legacy Data Collector ingestion.",
                    "columns": [
                        {
                            "name": "TimeGenerated",
                            "type": "datetime"
                        },
                        {
                            "name": "CollectionName_s",
                            "type": "string"
                        },
                        {
                            "name": "SeqUpdate_d",
                            "type": "real"
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.OperationalInsights/workspaces/tables",
            "apiVersion": "2025-07-01",
            "name": "[concat(parameters('WorkspaceName'), '/', variables('ContextTableName'))]",
            "properties": {
                "schema": {
                    "name": "[variables('ContextTableName')]",
                    "description": "Group-IB TI apt/threat_actor. Record = the full API item; *_s/*_d/*_b/*_t columns are promoted from Record by the DCR transform.",
                    "columns": [
                        {
                            "name": "TimeGenerated",
                            "type": "datetime"
                        },
                        {
                            "name": "Record",
                            "type": "dynamic"
                        },
                        {
                            "name": "id_s",
                            "type": "string"
                        },
                        {
                            "name": "name_s",
                            "type": "string"
                        },
                        {
                            "name": "country_s",
                            "type": "string"
                        },
                        {
                            "name": "aliases_s",
                            "type": "string"
                        },
                        {
                            "name": "isAPT_b",
                            "type": "boolean"
                        },
                        {
                            "name": "updatedAt_t",
                            "type": "datetime"
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2023-03-11",
            "name": "[variables('DcrName')]",
            "location": "[parameters('WorkspaceLocation')]",
            "tags": {
                "GIBTIA-Playbook": "[parameters('PlaybookName')]"
            },
            "kind": "Direct",
            "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('TrackingTableName'))]",
                "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('ContextTableName'))]"
            ],
            "properties": {
                "description": "Group-IB TI: Logs Ingestion destination for this playbook's seqUpdate cursor and its apt/threat_actor context table. kind=Direct; api-version 2023-03-11 is deliberate (see DEV_NOTES).",
                "streamDeclarations": {
                    "Custom-GIBCollectionTracking": {
                        "columns": [
                            {
                                "name": "CollectionName_s",
                                "type": "string"
                            },
                            {
                                "name": "SeqUpdate_d",
                                "type": "real"
                            }
                        ]
                    },
                    "Custom-GIBAPTThreatActor": {
                        "columns": [
                            {
                                "name": "Record",
                                "type": "dynamic"
                            }
                        ]
                    }
                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "workspaceResourceId": "[variables('WorkspaceResourceId')]",
                            "name": "gibWorkspace"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "[variables('TrackingStreamName')]"
                        ],
                        "destinations": [
                            "gibWorkspace"
                        ],
                        "transformKql": "source | extend TimeGenerated = now()",
                        "outputStream": "[concat('Custom-', variables('TrackingTableName'))]"
                    },
                    {
                        "streams": [
                            "[variables('ContextStreamName')]"
                        ],
                        "destinations": [
                            "gibWorkspace"
                        ],
                        "transformKql": "source | extend TimeGenerated = now(), r = parse_json(Record) | extend id_s = tostring(r.id), name_s = tostring(r.name), country_s = tostring(r.country), aliases_s = tostring(r.aliases), isAPT_b = tobool(r.isAPT), updatedAt_t = todatetime(r.updatedAt) | project-away r",
                        "outputStream": "[concat('Custom-', variables('ContextTableName'))]"
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "tags": {
                "hidden-SentinelTemplateName": "GIBTIA_APT_ThreatActor",
                "hidden-SentinelTemplateVersion": "2.1"
            },
            "metadata": {
                "title": "Group-IB TI - APT threat actor collector",
                "description": "Polls the Group-IB Threat Intelligence apt/threat_actor collection hourly using incremental seqUpdate paging and writes APT threat actor profiles to the GIBAPTThreatActor_CL custom table in Log Analytics for use in analytics rules and hunting queries.",
                "prerequisites": [
                    "A Group-IB Threat Intelligence subscription with API access to the apt/threat_actor collection.",
                    "A Log Analytics workspace connected to Microsoft Sentinel.",
                    "The deploying account holds Owner or User Access Administrator on the resource group (the template creates role assignments), or the AssignRoles parameter is set to false.",
                    "The deploying account holds Owner or User Access Administrator on the resource group (the template creates role assignments), or the AssignRoles parameter is set to false."
                ],
                "postDeployment": [
                    "1. Nothing to authorize: the playbook writes to Log Analytics through the Data Collection Rule this template created, using its managed identity. With AssignRoles left at true the template has also assigned the playbook's two roles (Monitoring Metrics Publisher on that rule, Log Analytics Reader on the workspace); with AssignRoles=false, assign them by hand.",
                    "2. Set the GIBUsername, GIBApiKey, StartDate and LimitPerPortion parameters.",
                    "3. Wait 5-15 minutes for the role assignments to propagate, then enable the Logic App. It deploys in a Disabled state by design.",
                    "4. Upgrading from 2.0: convert the workspace's GIB* tables once with migrate-tables.sh before redeploying (see the Playbooks readme)."
                ],
                "lastUpdateTime": "2026-09-21T00:00:00.000Z",
                "entities": [],
                "tags": [
                    "Group-IB",
                    "Threat Intelligence",
                    "Context"
                ],
                "releaseNotes": [
                    {
                        "version": "2.0",
                        "title": "Sentinel threat intelligence upload API",
                        "notes": [
                            "Replaces the deprecated Microsoft Security Graph API implementation. Indicators are submitted with Upload_Indicators_V2 using a managed identity and land in the ThreatIntelIndicators table."
                        ]
                    },
                    {
                        "version": "2.1",
                        "title": "Logs Ingestion API",
                        "notes": [
                            "Log Analytics writes moved from the retired HTTP Data Collector API connector to the Logs Ingestion API. The template now creates a Data Collection Rule and the playbook writes through it with its managed identity: no API connection to authorize and no workspace key.",
                            "The template assigns the playbook's roles (Monitoring Metrics Publisher on its Data Collection Rule, Log Analytics Reader on the workspace); set AssignRoles=false to assign them by hand.",
                            "Context tables now hold the full record in a Record column plus a few promoted fields, written in chunks of RecordsPerWrite records per call.",
                            "The unused WorkspaceId parameter is removed. Upgrading from 2.0 requires a one-time table conversion (migrate-tables.sh) before redeploying; see the Playbooks readme."
                        ]
                    }
                ],
                "support": {
                    "tier": "community"
                },
                "author": {
                    "name": "Group-IB"
                }
            },
            "location": "[resourceGroup().location]",
            "properties": {
                "state": "Disabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "GIBUsername": {
                            "defaultValue": "[parameters('GIBUsername')]",
                            "type": "String"
                        },
                        "GIBApiKey": {
                            "defaultValue": "[parameters('GIBApiKey')]",
                            "type": "SecureString"
                        },
                        "StartDate": {
                            "defaultValue": "[parameters('StartDate')]",
                            "type": "String"
                        },
                        "LimitPerPortion": {
                            "defaultValue": "[parameters('LimitPerPortion')]",
                            "type": "Int"
                        },
                        "RecordsPerWrite": {
                            "type": "Int",
                            "defaultValue": "[parameters('RecordsPerWrite')]"
                        },
                        "DcrEndpoint": {
                            "type": "String",
                            "defaultValue": "[reference(variables('DcrResourceId'), '2023-03-11').endpoints.logsIngestion]"
                        },
                        "DcrImmutableId": {
                            "type": "String",
                            "defaultValue": "[reference(variables('DcrResourceId'), '2023-03-11').immutableId]"
                        }
                    },
                    "triggers": {
                        "Recurrence": {
                            "type": "Recurrence",
                            "recurrence": {
                                "frequency": "Hour",
                                "interval": 1
                            },
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "runs": 1
                                }
                            }
                        }
                    },
                    "actions": {
                        "Initialize_seqUpdate": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "seqUpdate",
                                        "type": "integer",
                                        "value": 0
                                    }
                                ]
                            },
                            "runAfter": {}
                        },
                        "Initialize_IsPortionEmpty": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "IsPortionEmpty",
                                        "type": "boolean",
                                        "value": false
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_seqUpdate": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Initialize_RecordsArray": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "RecordsArray",
                                        "type": "array",
                                        "value": []
                                    }
                                ]
                            },
                            "runAfter": {
                                "Initialize_IsPortionEmpty": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Query_Last_SeqUpdate": {
                            "type": "Http",
                            "inputs": {
                                "method": "POST",
                                "uri": "[concat('https://management.azure.com/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/microsoft.operationalinsights/workspaces/', parameters('WorkspaceName'), '/query?api-version=2017-10-01')]",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": {
                                    "query": "GIBCollectionTracking_CL | where CollectionName_s == \"apt/threat_actor\" | top 1 by TimeGenerated desc | project SeqUpdate_d"
                                },
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://management.azure.com/"
                                }
                            },
                            "runAfter": {
                                "Initialize_RecordsArray": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Condition_First_Run": {
                            "type": "If",
                            "expression": {
                                "or": [
                                    {
                                        "equals": [
                                            "@actions('Query_Last_SeqUpdate').status",
                                            "Failed"
                                        ]
                                    },
                                    {
                                        "equals": [
                                            "@length(coalesce(body('Query_Last_SeqUpdate')?['tables']?[0]?['rows'], json('[]')))",
                                            0
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "HTTP_Get_SequenceList": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "https://tap.group-ib.com/api/v2/sequence_list",
                                        "queries": {
                                            "date": "@{parameters('StartDate')}",
                                            "collection": "apt/threat_actor"
                                        },
                                        "headers": {
                                            "Authorization": "@{concat('Basic ', base64(concat(parameters('GIBUsername'), ':', parameters('GIBApiKey'))))}",
                                            "Accept": "application/json",
                                            "User-Agent": "GroupIB-MSentinel-Integration/2.0 (apt-threat-actor; logic-app)"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    },
                                    "runAfter": {}
                                },
                                "Parse_SequenceList": {
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('HTTP_Get_SequenceList')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "list": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "HTTP_Get_SequenceList": [
                                            "Succeeded"
                                        ]
                                    }
                                },
                                "Set_seqUpdate_From_SequenceList": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "seqUpdate",
                                        "value": "@body('Parse_SequenceList')?['list']?['apt/threat_actor']"
                                    },
                                    "runAfter": {
                                        "Parse_SequenceList": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Set_seqUpdate_From_DB": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "seqUpdate",
                                            "value": "@int(body('Query_Last_SeqUpdate')?['tables'][0]?['rows'][0]?[0])"
                                        },
                                        "runAfter": {}
                                    }
                                }
                            },
                            "runAfter": {
                                "Query_Last_SeqUpdate": [
                                    "Succeeded",
                                    "Failed"
                                ]
                            }
                        },
                        "Until": {
                            "type": "Until",
                            "expression": "@equals(variables('IsPortionEmpty'), true)",
                            "limit": {
                                "count": 500,
                                "timeout": "PT1H"
                            },
                            "actions": {
                                "Get_next_portion": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "@{concat('https://tap.group-ib.com/api/v2/apt/threat_actor/updated?seqUpdate=', variables('seqUpdate'), '&limit=', min(parameters('LimitPerPortion'), 100))}",
                                        "headers": {
                                            "Authorization": "@{concat('Basic ', base64(concat(parameters('GIBUsername'), ':', parameters('GIBApiKey'))))}",
                                            "Accept": "application/json",
                                            "User-Agent": "GroupIB-MSentinel-Integration/2.0 (apt-threat-actor; logic-app)"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    },
                                    "runAfter": {}
                                },
                                "Parse_Feed_Response": {
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('Get_next_portion')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "count": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "seqUpdate": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "items": {
                                                    "type": "array",
                                                    "items": {}
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Get_next_portion": [
                                            "Succeeded"
                                        ]
                                    }
                                },
                                "Set_IsPortionEmpty_on_parse_failure": {
                                    "type": "SetVariable",
                                    "inputs": {
                                        "name": "IsPortionEmpty",
                                        "value": true
                                    },
                                    "runAfter": {
                                        "Parse_Feed_Response": [
                                            "Failed",
                                            "TimedOut"
                                        ]
                                    }
                                },
                                "Condition_Set_IsPortionEmpty": {
                                    "type": "If",
                                    "expression": {
                                        "equals": [
                                            "@body('Parse_Feed_Response')?['count']",
                                            0
                                        ]
                                    },
                                    "actions": {
                                        "Set_IsPortionEmpty": {
                                            "type": "SetVariable",
                                            "inputs": {
                                                "name": "IsPortionEmpty",
                                                "value": true
                                            },
                                            "runAfter": {}
                                        }
                                    },
                                    "else": {
                                        "actions": {
                                            "Set_seqUpdate": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "seqUpdate",
                                                    "value": "@body('Parse_Feed_Response')?['seqUpdate']"
                                                },
                                                "runAfter": {}
                                            },
                                            "For_each_item": {
                                                "type": "Foreach",
                                                "foreach": "@body('Parse_Feed_Response')?['items']",
                                                "operationOptions": "Sequential",
                                                "actions": {
                                                    "Append_to_RecordsArray": {
                                                        "type": "AppendToArrayVariable",
                                                        "inputs": {
                                                            "name": "RecordsArray",
                                                            "value": {
                                                                "Record": "@items('For_each_item')"
                                                            }
                                                        },
                                                        "runAfter": {}
                                                    }
                                                },
                                                "runAfter": {
                                                    "Set_seqUpdate": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "For_each_chunk": {
                                                "type": "Foreach",
                                                "foreach": "@chunk(variables('RecordsArray'), parameters('RecordsPerWrite'))",
                                                "actions": {
                                                    "Write_chunk_to_table": {
                                                        "type": "Http",
                                                        "inputs": {
                                                            "method": "POST",
                                                            "uri": "@{concat(parameters('DcrEndpoint'), '/dataCollectionRules/', parameters('DcrImmutableId'), '/streams/Custom-GIBAPTThreatActor?api-version=2023-01-01')}",
                                                            "headers": {
                                                                "Content-Type": "application/json"
                                                            },
                                                            "body": "@items('For_each_chunk')",
                                                            "authentication": {
                                                                "type": "ManagedServiceIdentity",
                                                                "audience": "https://monitor.azure.com"
                                                            },
                                                            "retryPolicy": {
                                                                "type": "exponential",
                                                                "count": 10,
                                                                "interval": "PT20S",
                                                                "minimumInterval": "PT10S",
                                                                "maximumInterval": "PT1H"
                                                            }
                                                        },
                                                        "runAfter": {}
                                                    }
                                                },
                                                "runAfter": {
                                                    "For_each_item": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "Reset_RecordsArray": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "RecordsArray",
                                                    "value": []
                                                },
                                                "runAfter": {
                                                    "For_each_chunk": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Parse_Feed_Response": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Condition_First_Run": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Save_tracking_record": {
                            "type": "Http",
                            "inputs": {
                                "method": "POST",
                                "uri": "@{concat(parameters('DcrEndpoint'), '/dataCollectionRules/', parameters('DcrImmutableId'), '/streams/Custom-GIBCollectionTracking?api-version=2023-01-01')}",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": [
                                    {
                                        "CollectionName_s": "apt/threat_actor",
                                        "SeqUpdate_d": "@variables('seqUpdate')"
                                    }
                                ],
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://monitor.azure.com"
                                },
                                "retryPolicy": {
                                    "type": "exponential",
                                    "count": 10,
                                    "interval": "PT20S",
                                    "minimumInterval": "PT10S",
                                    "maximumInterval": "PT1H"
                                }
                            },
                            "runAfter": {
                                "Until": [
                                    "Succeeded"
                                ]
                            }
                        }
                    },
                    "outputs": {}
                }
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[variables('DcrResourceId')]"
            ]
        },
        {
            "condition": "[parameters('AssignRoles')]",
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('MonitoringMetricsPublisherRoleId'), variables('DcrResourceId'))]",
            "scope": "[variables('DcrResourceId')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]",
                "[variables('DcrResourceId')]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('MonitoringMetricsPublisherRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "condition": "[parameters('AssignRoles')]",
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('LogAnalyticsReaderRoleId'), variables('WorkspaceResourceId'))]",
            "scope": "[variables('WorkspaceResourceId')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('LogAnalyticsReaderRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        }
    ]
}
