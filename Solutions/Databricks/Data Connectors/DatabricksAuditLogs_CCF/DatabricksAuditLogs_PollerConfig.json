{
  "name": "DatabricksAuditLogsPollingConfig",
  "apiVersion": "2024-09-01",
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "location": "{{location}}",
  "kind": "AmazonWebServicesS3",
  "properties": {
    "connectorDefinitionName": "DatabricksAuditLogs",
    "dataTypes": {
      "logs": {
        "state": "enabled"
      }
    },
    "dcrConfig": {
      "streamName": "Custom-DatabricksAuditRaw",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "destinationTable": "DatabricksAudit_CL",
    "dataFormat": {
      "Format": "JsonLine",
      "IsCompressed": false,
      "compressType": "None"
    },
    "roleArn": "{{roleArn}}",
    "sqsUrls": [
      "{{queueUrl}}"
    ]
  }
}
