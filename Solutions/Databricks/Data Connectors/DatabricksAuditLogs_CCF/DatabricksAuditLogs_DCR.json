{
  "name": "DatabricksAuditLogs-DCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "kind": null,
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-DatabricksAuditRaw": {
        "columns": [
          {
            "name": "version",
            "type": "string"
          },
          {
            "name": "auditLevel",
            "type": "string"
          },
          {
            "name": "timestamp",
            "type": "long"
          },
          {
            "name": "orgId",
            "type": "long"
          },
          {
            "name": "workspaceId",
            "type": "string"
          },
          {
            "name": "shardName",
            "type": "string"
          },
          {
            "name": "accountId",
            "type": "string"
          },
          {
            "name": "sourceIPAddress",
            "type": "string"
          },
          {
            "name": "userAgent",
            "type": "string"
          },
          {
            "name": "sessionId",
            "type": "string"
          },
          {
            "name": "userIdentity",
            "type": "dynamic"
          },
          {
            "name": "serviceName",
            "type": "string"
          },
          {
            "name": "actionName",
            "type": "string"
          },
          {
            "name": "requestId",
            "type": "string"
          },
          {
            "name": "requestParams",
            "type": "dynamic"
          },
          {
            "name": "response",
            "type": "dynamic"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-DatabricksAuditRaw"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend EventTime = datetime(1970-01-01) + tolong(timestamp) * 1ms | extend TimeGenerated = iff(EventTime > now() - 47h and EventTime < now() + 10m, EventTime, now()) | extend ResponseStatusCode = toint(response.statusCode) | project TimeGenerated, EventTime, SchemaVersion = version, AuditLevel = auditLevel, AccountId = accountId, OrgId = tostring(orgId), WorkspaceId = iff(isempty(workspaceId), tostring(orgId), workspaceId), ShardName = shardName, ServiceName = serviceName, ActionName = actionName, RequestId = requestId, SessionId = sessionId, SourceIPAddress = sourceIPAddress, UserAgent = userAgent, UserEmail = tostring(userIdentity.email), UserSubjectName = tostring(userIdentity.subjectName), UserIdentity = userIdentity, RequestParams = requestParams, ResponseStatusCode, ResponseErrorMessage = tostring(response.errorMessage), ResponseResult = response.result",
        "outputStream": "Custom-DatabricksAudit_CL"
      }
    ]
  }
}
