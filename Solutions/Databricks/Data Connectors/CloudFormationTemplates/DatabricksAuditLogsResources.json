{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Microsoft Sentinel Databricks connector, template 2 of 2 (DatabricksAuditLogsResources.json): the IAM role Microsoft Sentinel assumes, the SQS queue and dead-letter queue, and the queue policy. Deploy after OIDCWebIdProvider.json.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "Enter your values"
          },
          "Parameters": [
            "SentinelWorkspaceId",
            "BucketName",
            "DeliveryPathPrefix",
            "KmsKeyArn"
          ]
        },
        {
          "Label": {
            "default": "Keep the defaults"
          },
          "Parameters": [
            "AwsRoleName",
            "SentinelSQSQueueName",
            "CreateNewBucket"
          ]
        }
      ],
      "ParameterLabels": {
        "SentinelWorkspaceId": {
          "default": "Microsoft Sentinel Workspace ID"
        },
        "BucketName": {
          "default": "Databricks S3 bucket name"
        },
        "DeliveryPathPrefix": {
          "default": "Databricks delivery path prefix (empty if none)"
        },
        "KmsKeyArn": {
          "default": "KMS key ARN (SSE-KMS buckets only)"
        },
        "AwsRoleName": {
          "default": "IAM role name"
        },
        "SentinelSQSQueueName": {
          "default": "SQS queue name"
        },
        "CreateNewBucket": {
          "default": "Create a new bucket"
        }
      }
    }
  },
  "Parameters": {
    "SentinelWorkspaceId": {
      "Type": "String",
      "Description": "Workspace ID of the Microsoft Sentinel workspace, from the Databricks connector page in Microsoft Sentinel. A GUID. Not the tenant ID or subscription ID.",
      "AllowedPattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "ConstraintDescription": "Must be a GUID such as 1a2b3c4d-1234-5678-9abc-def012345678."
    },
    "BucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9-.]{1,61}[a-z0-9]$",
      "Description": "Name of the S3 bucket Databricks delivers audit logs to. The name only, without s3:// or an ARN.",
      "ConstraintDescription": "Must be an S3 bucket name only: lower case letters, numbers, dots and hyphens."
    },
    "DeliveryPathPrefix": {
      "Type": "String",
      "Description": "The delivery_path_prefix from the Databricks log delivery configuration: the folder that holds the workspaceId= folders. No leading or trailing slash. Leave empty if the workspaceId= folders are at the top of the bucket (no delivery_path_prefix).",
      "Default": "",
      "AllowedPattern": "^$|^[^/](.*[^/])?$",
      "ConstraintDescription": "Leave empty, or enter the folder without slashes: audit-logs, not /audit-logs/."
    },
    "KmsKeyArn": {
      "Type": "String",
      "Default": "",
      "Description": "Only if the bucket is encrypted with SSE-KMS: the KMS key ARN. Leave empty for the default S3 encryption.",
      "AllowedPattern": "^$|^arn:aws[a-z-]*:kms:[a-z0-9-]+:[0-9]{12}:key/.+$",
      "ConstraintDescription": "Leave empty, or enter a KMS key ARN (arn:aws:kms:<region>:<account>:key/<id>)."
    },
    "AwsRoleName": {
      "Type": "String",
      "Description": "Name of the IAM role Microsoft Sentinel assumes. Keep the default. Must start with OIDC_.",
      "AllowedPattern": "OIDC_[-_a-zA-Z0-9]+",
      "Default": "OIDC_MicrosoftSentinelDatabricksAudit",
      "ConstraintDescription": "Must start with OIDC_ and contain only letters, numbers, hyphens and underscores."
    },
    "SentinelSQSQueueName": {
      "Type": "String",
      "Default": "MicrosoftSentinelDatabricksAuditSqs",
      "Description": "Name of the SQS queue. Keep the default. The dead-letter queue gets the same name with -dlq."
    },
    "CreateNewBucket": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Keep false: the Databricks bucket already exists and you add the S3 event notification afterwards (Data Connectors/README.md). true creates a new bucket with the notification (test use only)."
    }
  },
  "Conditions": {
    "CreateNewBucketCondition": {
      "Fn::Equals": [
        {
          "Ref": "CreateNewBucket"
        },
        "true"
      ]
    },
    "HasKmsKey": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "KmsKeyArn"
            },
            ""
          ]
        }
      ]
    },
    "HasPrefix": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "DeliveryPathPrefix"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "SentinelDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Delete",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${SentinelSQSQueueName}-dlq"
        },
        "MessageRetentionPeriod": 1209600
      }
    },
    "SentinelSQSQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Delete",
      "Properties": {
        "QueueName": {
          "Ref": "SentinelSQSQueueName"
        },
        "VisibilityTimeout": 600,
        "MessageRetentionPeriod": 345600,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "SentinelDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        },
        "Tags": [
          {
            "Key": "Bucket",
            "Value": {
              "Ref": "BucketName"
            }
          }
        ]
      }
    },
    "SentinelWebIdentityBasedRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "AwsRoleName"
        },
        "Description": "Role that lets Microsoft Sentinel read Databricks audit logs from S3 through SQS.",
        "Path": "/",
        "AssumeRolePolicyDocument": {
          "Fn::Sub": "{\"Version\": \"2012-10-17\",\"Statement\": [{\"Effect\": \"Allow\",\"Principal\": {\"Federated\": \"arn:aws:iam::${AWS::AccountId}:oidc-provider/sts.windows.net/33e01921-4d64-4f8c-a055-5bdaffd5e33d/\"},\"Action\": \"sts:AssumeRoleWithWebIdentity\",\"Condition\": {\"StringEquals\": {\"sts.windows.net/33e01921-4d64-4f8c-a055-5bdaffd5e33d/:aud\": \"api://1462b192-27f7-4cb9-8523-0f4ecb54b47e\",\"sts:RoleSessionName\": \"MicrosoftSentinel_${SentinelWorkspaceId}\"}}}]}"
        },
        "Policies": [
          {
            "PolicyName": "DatabricksAuditLogsReadPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes",
                    "sqs:GetQueueUrl"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SentinelSQSQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "ReadDatabricksAuditObjects",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::If": [
                      "HasPrefix",
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}/${DeliveryPathPrefix}/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}/workspaceId=*"
                      }
                    ]
                  }
                },
                {
                  "Sid": "ListDatabricksPrefix",
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}"
                  }
                },
                {
                  "Fn::If": [
                    "HasKmsKey",
                    {
                      "Sid": "DecryptIfSseKms",
                      "Effect": "Allow",
                      "Action": [
                        "kms:Decrypt"
                      ],
                      "Resource": {
                        "Ref": "KmsKeyArn"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "SentinelSQSQueuePolicyForS3": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Sid": "AllowS3ToSendNotifications",
              "Action": [
                "SQS:SendMessage"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SentinelSQSQueue",
                    "Arn"
                  ]
                }
              ],
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Fn::Sub": "${AWS::AccountId}"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:*:*:${BucketName}"
                  }
                }
              }
            },
            {
              "Sid": "AllowSentinelRoleToConsume",
              "Action": [
                "SQS:ChangeMessageVisibility",
                "SQS:DeleteMessage",
                "SQS:ReceiveMessage",
                "SQS:GetQueueUrl"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SentinelSQSQueue",
                    "Arn"
                  ]
                }
              ],
              "Principal": {
                "AWS": [
                  {
                    "Fn::GetAtt": [
                      "SentinelWebIdentityBasedRole",
                      "Arn"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "Queues": [
          {
            "Ref": "SentinelSQSQueue"
          }
        ]
      }
    },
    "S3Bucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "CreateNewBucketCondition",
      "DeletionPolicy": "Retain",
      "DependsOn": [
        "SentinelSQSQueuePolicyForS3"
      ],
      "Properties": {
        "BucketName": {
          "Ref": "BucketName"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "NotificationConfiguration": {
          "QueueConfigurations": [
            {
              "Queue": {
                "Fn::GetAtt": [
                  "SentinelSQSQueue",
                  "Arn"
                ]
              },
              "Event": "s3:ObjectCreated:*",
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": {
                        "Fn::If": [
                          "HasPrefix",
                          {
                            "Fn::Sub": "${DeliveryPathPrefix}/"
                          },
                          "workspaceId%3D"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "SentinelRoleArn": {
      "Description": "Role ARN to paste into the Microsoft Sentinel collector.",
      "Value": {
        "Fn::GetAtt": [
          "SentinelWebIdentityBasedRole",
          "Arn"
        ]
      }
    },
    "SentinelSQSQueueURL": {
      "Description": "Queue URL to paste into the Microsoft Sentinel collector.",
      "Value": {
        "Ref": "SentinelSQSQueue"
      }
    },
    "SentinelSQSQueueArn": {
      "Description": "Queue ARN for the S3 event notification when the bucket already exists.",
      "Value": {
        "Fn::GetAtt": [
          "SentinelSQSQueue",
          "Arn"
        ]
      }
    },
    "NotificationPrefix": {
      "Description": "Prefix filter to use on the S3 event notification: the delivery path prefix with a trailing slash, or workspaceId%3D when the prefix is empty. S3 needs special characters in filter values URL-encoded: = is written %3D. Enter the value exactly as shown.",
      "Value": {
        "Fn::If": [
          "HasPrefix",
          {
            "Fn::Sub": "${DeliveryPathPrefix}/"
          },
          "workspaceId%3D"
        ]
      }
    }
  }
}
