    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CensysRiskEvents\n| where OccurredAt {TimeRange}\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| where ChangeType in (\"opened\", \"resolved\")\n| summarize Events = count() by Day = format_datetime(bin(OccurredAt, 1d), 'yyyy-MM-dd'), ChangeType\n| order by Day asc, ChangeType asc",
        "size": 0,
        "title": "New vs. Resolved Risks",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
