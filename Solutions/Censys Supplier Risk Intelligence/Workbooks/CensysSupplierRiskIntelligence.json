{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## Censys Supplier Risk Intelligence\nOpen supplier risk, built from the Censys risk-events feed. Risk instances are rebuilt from their latest event, so every panel except **New vs. Resolved Risks** shows the *current* open risk regardless of the Time Range. **Time Range** applies to the New vs. Resolved Risks chart. **Severity**, **Supplier** and **Risk Category** apply to every panel."
      },
      "name": "0a3c227f-21b3-55b9-b3d4-6c6d84922765"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "3980b3ca-3e47-5259-ae54-e9cf79f7aa97",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 604800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
