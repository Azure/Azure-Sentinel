        "query": "CensysOpenRisks\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| summarize OpenRisks = count(), CriticalHigh = countif(SeverityRank >= 3), RapidResponse = countif(RapidResponse == true), OldestOpenDays = datetime_diff('day', now(), min(FirstDetectedAt)) by SupplierDisplayName\n| order by CriticalHigh desc, OpenRisks desc",
        "size": 0,
        "title": "Supplier Risk Ranking",
