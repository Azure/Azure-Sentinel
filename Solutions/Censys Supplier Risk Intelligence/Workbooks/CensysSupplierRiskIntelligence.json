    {
      "type": 1,
      "content": {
        "json": "### Risk posture and composition"
      },
      "name": "1a2e6c6a-219b-569b-b8b1-23b33021da6d"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CensysRisks\n| where ('*' in ({Status}) or Status in ({Status}))\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| summarize Risks = count() by Severity, SeverityRank\n| order by SeverityRank desc\n| project Severity, Risks",
        "size": 3,
        "title": "Risk Count (by Severity)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "showRefreshButton": true,
        "showAnalytics": true,
        "showExportToExcel": true,
        "noDataMessage": "No data found for the selected filters.",
        "timeContext": {
          "durationMs": 7776000000
        },
        "visualization": "piechart",
        "exportFieldName": "series",
        "exportParameterName": "P1Severity",
        "exportDefaultValue": "None",
        "chartSettings": {
          "group": "Severity",
          "createOtherGroup": 10,
          "seriesLabelSettings": [
