    {
      "type": 1,
      "content": {
        "json": "### CVEs and suppliers"
      },
      "name": "883b1f4b-0d3e-52ea-aa8b-e28575d45c41"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CensysOpenRisks\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| where isnotempty(CveId)\n| summarize OpenRisks = count(), Assets = dcount(AssetName), Suppliers = dcount(SupplierDisplayName), arg_max(SeverityRank, Severity) by CveId, RiskName\n| project CveId, RiskName, OpenRisks, Assets, Suppliers, HighestSeverity = Severity\n| order by OpenRisks desc",
        "size": 0,
        "title": "CVEs by Open Risk Count",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "showRefreshButton": true,
        "showAnalytics": true,
        "showExportToExcel": true,
