            "name": "Severity",
            "label": "Severity",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "timeContext": {
              "durationMs": 7776000000
