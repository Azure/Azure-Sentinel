    {
      "type": 1,
      "content": {
        "json": "### Risk posture"
      },
      "name": "1a2e6c6a-219b-569b-b8b1-23b33021da6d"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CensysOpenRisks\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| summarize OpenRisks = count() by Severity, SeverityRank\n| order by SeverityRank desc\n| project Severity, OpenRisks",
        "size": 3,
        "title": "Open Risk Count (by Severity)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "showRefreshButton": true,
        "showAnalytics": true,
        "showExportToExcel": true,
        "noDataMessage": "No data found for the selected filters.",
        "timeContext": {
          "durationMs": 7776000000
        },
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Severity",
            "formatter": 18,
            "formatOptions": {
              "thresholdsOptions": "colors",
              "thresholdsGrid": [
                {
                  "operator": "==",
                  "thresholdValue": "CRITICAL",
                  "representation": "red",
                  "text": "{0}{1}"
                },
                {
                  "operator": "==",
                  "thresholdValue": "HIGH",
                  "representation": "orange",
                  "text": "{0}{1}"
                },
                {
                  "operator": "==",
                  "thresholdValue": "MEDIUM",
                  "representation": "yellow",
                  "text": "{0}{1}"
                },
                {
                  "operator": "==",
                  "thresholdValue": "LOW",
                  "representation": "blue",
                  "text": "{0}{1}"
                },
                {
                  "operator": "Default",
                  "thresholdValue": null,
                  "representation": "gray",
                  "text": "{0}{1}"
                }
              ]
            }
          },
          "leftContent": {
            "columnMatch": "OpenRisks",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          },
          "showBorder": true,
          "size": "auto"
        },
        "exportFieldName": "Severity",
        "exportParameterName": "P1Severity",
        "exportDefaultValue": "None"
      },
      "name": "1b6bdd62-e666-568e-ad83-e6466e7d0772",
      "customWidth": "100"
    },
