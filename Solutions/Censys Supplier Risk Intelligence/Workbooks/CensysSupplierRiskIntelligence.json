            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ],
            "jsonData": "[{\"value\": \"CRITICAL\", \"label\": \"CRITICAL\"}, {\"value\": \"HIGH\", \"label\": \"HIGH\"}, {\"value\": \"MEDIUM\", \"label\": \"MEDIUM\"}, {\"value\": \"LOW\", \"label\": \"LOW\"}]"
          },
          {
            "id": "408ed010-0624-5802-be49-0b16ce3b0b55",
            "version": "KqlParameterItem/1.0",
            "name": "Supplier",
            "label": "Supplier",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "CensysRiskEvents\n| where isnotempty(SupplierDisplayName)\n| summarize by SupplierDisplayName\n| project value = SupplierDisplayName, label = SupplierDisplayName\n| order by label asc",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "timeContext": {
              "durationMs": 7776000000
            },
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ]
          },
          {
            "id": "981f1274-a745-5685-9c0a-938042ba7b06",
            "version": "KqlParameterItem/1.0",
            "name": "RiskCategory",
            "label": "Risk Category",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "CensysRiskEvents\n| where isnotempty(RiskCategory)\n| summarize by RiskCategory\n| project value = RiskCategory, label = RiskCategory\n| order by label asc",
            "queryType": 0,
