[
    {
        "_comment": "OPTIONAL split-plan variant of Fivetran_DCR.json. Deploy this INSTEAD of Fivetran_DCR.json only if you have read VOLUME-AND-COST.md, including the required analytics-rule adjustment. The default single-table DCR remains Fivetran_DCR.json.",
        "name": "fivetranDCR1",
        "apiVersion": "2022-06-01",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "kind": "Direct",
        "properties": {
            "streamDeclarations": {
                "Custom-Fivetran_CL": {
                    "columns": [
                        { "name": "Level", "type": "string" },
                        { "name": "CreatedAt", "type": "datetime" },
                        { "name": "Message", "type": "string" }
                    ]
                }
            },
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "clv2ws1"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [ "Custom-Fivetran_CL" ],
                    "destinations": [ "clv2ws1" ],
                    "outputStream": "Custom-Fivetran_CL",
                    "transformKql": "source | where Level in ('WARNING', 'SEVERE') | extend TimeGenerated = CreatedAt"
                },
                {
                    "streams": [ "Custom-Fivetran_CL" ],
                    "destinations": [ "clv2ws1" ],
                    "outputStream": "Custom-FivetranVerbose_CL",
                    "transformKql": "source | where Level !in ('WARNING', 'SEVERE') | extend TimeGenerated = CreatedAt"
                }
            ]
        }
    }
]
