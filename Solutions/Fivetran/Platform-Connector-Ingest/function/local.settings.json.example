    "DCR_RULE_ID": "dcr-0123456789abcdef0123456789abcdef",
    "AUDIT_STREAM": "Custom-Fivetran_AuditTrail_CL",
    "PLATFORM_STREAM": "Custom-Fivetran_Platform_CL",
    "AZURE_CLIENT_ID": "<user-assigned-managed-identity-client-id>"
  }
}
