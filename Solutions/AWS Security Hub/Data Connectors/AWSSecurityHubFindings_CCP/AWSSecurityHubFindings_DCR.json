{
    "name": "AWSSecurityHubFindings-DCR",
    "apiVersion": "2023-03-11",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "kind": null,
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-AWSSecurityHubFindingsStream": {
                "columns": [
                    {
                        "name": "AwsAccountId",
                        "type": "string"
                    },
                    {
                        "name": "AwsRegion",
                        "type": "string"
                    },
                    {
                        "name": "CompanyName",
                        "type": "string"
                    },
                    {
                        "name": "Compliance",
                        "type": "dynamic"
                    },
                    {
                        "name": "CreatedAt",
                        "type": "string"
                    },
                    {
                        "name": "Description",
                        "type": "string"
                    },
                    {
                        "name": "FindingProviderFields",
                        "type": "dynamic"
                    },
                    {
                        "name": "FirstObservedAt",
                        "type": "string"
                    },
                    {
                        "name": "GeneratorId",
                        "type": "string"
                    },
                    {
                        "name": "Id",
                        "type": "string"
                    },
                    {
                        "name": "LastObservedAt",
                        "type": "string"
                    },
                    {
                        "name": "ProductArn",
                        "type": "string"
                    },
                    {
                        "name": "ProductFields",
                        "type": "dynamic"
                    },
                    {
                        "name": "ProductName",
                        "type": "string"
                    },
                    {
                        "name": "RecordState",
                        "type": "string"
                    },
                    {
                        "name": "Region",
                        "type": "string"
                    },
                    {
                        "name": "Remediation",
                        "type": "dynamic"
                    },
                    {
                        "name": "Resources",
                        "type": "dynamic"
                    },
                    {
                        "name": "SchemaVersion",
                        "type": "string"
                    },
                    {
                        "name": "Severity",
                        "type": "dynamic"
                    },
                    {
                        "name": "Title",
                        "type": "string"
                    },
                    {
                        "name": "Types",
                        "type": "dynamic"
                    },
                    {
                        "name": "UpdatedAt",
                        "type": "string"
                    },
                    {
                        "name": "WorkflowState",
                        "type": "string"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-AWSSecurityHubFindingsStream"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend SeverityData = coalesce(Severity, FindingProviderFields.Severity) | extend TypesData = coalesce(Types, FindingProviderFields.Types) | project TimeGenerated = coalesce(todatetime(UpdatedAt), todatetime(LastObservedAt), now()), AwsRegion = coalesce(AwsRegion, Region), AwsAccountId, ComplianceStatus = tostring(Compliance.Status), ComplianceStatusReasons = todynamic(Compliance.StatusReasons), ComplianceSecurityControlId = tostring(Compliance.SecurityControlId), ComplianceSecurityControlParameters = todynamic(Compliance.SecurityControlParameters), ComplianceRelatedRequirements = todynamic(Compliance.RelatedRequirements), ComplianceAssociatedStandards = todynamic(Compliance.AssociatedStandards), AwsSecurityFindingTitle = Title, AwsSecurityFindingId = Id, AwsSecurityFindingDescription = Description, AwsSecurityFindingTypes = TypesData, AwsSecurityFindingCreatedAt = todatetime(CreatedAt), AwsSecurityFindingFirstObservedAt = todatetime(FirstObservedAt), AwsSecurityFindingUpdatedAt = todatetime(UpdatedAt), AwsSecurityFindingLastObservedAt = todatetime(LastObservedAt), AwsSecurityFindingProcessedAt = todatetime(''), AwsSecurityFindingGeneratorId = GeneratorId, AwsSecurityFindingProductArn = ProductArn, AwsSecurityFindingProductName = ProductName, AwsSecurityFindingProductFields = ProductFields, AwsSecurityFindingSeverity = SeverityData, Remediation, SchemaVersion, Resources, RecordState, WorkflowState, RawData = pack_all()",
                "outputStream": "Microsoft-AWSSecurityHubFindings"
            }
        ]
    }
}