{
  "name": "CybereinforceCTE_DCR",
  "apiVersion": "2021-09-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "[parameters('workspace-location')]",
  "properties": {
    "streamDeclarations": {
      "Custom-CybereinforceCTE": {
        "columns": [
          {
            "name": "TimeGenerated",
            "type": "datetime"
          },
          {
            "name": "EventTime",
            "type": "datetime"
          },
          {
            "name": "TenantId",
            "type": "string"
          },
          {
            "name": "EventType",
            "type": "string"
          },
          {
            "name": "Severity",
            "type": "string"
          },
          {
            "name": "Actor",
            "type": "string"
          },
          {
            "name": "Entity",
            "type": "string"
          },
          {
            "name": "EntityId",
            "type": "string"
          },
          {
            "name": "Details",
            "type": "dynamic"
          },
          {
            "name": "Category",
            "type": "string"
          },
          {
            "name": "Product",
            "type": "string"
          },
          {
            "name": "Source",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "[variables('workspaceResourceId')]",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-CybereinforceCTE"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source\n| extend Tid=tostring(TenantId)\n| project TimeGenerated=now(),\n         TenantId=iif(strlen(Tid)==32, toguid(strcat(substring(Tid,0,8),'-',substring(Tid,8,4),'-',substring(Tid,12,4),'-',substring(Tid,16,4),'-',substring(Tid,20,12))), toguid(Tid)),\n         EventType=tostring(EventType),\n         Severity=tostring(Severity),\n         Actor=tostring(Actor),\n         Entity=tostring(Entity),\n         EntityId=tostring(EntityId),\n         Details=tostring(Details),\n         Category=tostring(Category),\n         Source=tostring(Source),\n         EventTime=todatetime(EventTime),\n         CteTenantId=Tid,\n         Product=tostring(Product)",
        "outputStream": "Custom-CybereinforceCTE_CL"
      }
    ],
    "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
  }
}
