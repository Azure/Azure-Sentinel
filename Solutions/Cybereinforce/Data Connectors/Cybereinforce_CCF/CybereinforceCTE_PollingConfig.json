{
  "name": "CybereinforceCTEconnector",
  "apiVersion": "2022-10-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "kind": "RestApiPoller",
  "properties": {
    "connectorDefinitionName": "CybereinforceCTEConnectorDefinition",
    "dcrConfig": {
      "streamName": "Custom-CybereinforceCTE",
      "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
      "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]"
    },
    "dataType": "CybereinforceCTE_CL",
    "auth": {
      "type": "APIKey",
      "ApiKey": "[[parameters('cybereinforceMicrosoftToken')]",
      "ApiKeyName": "Authorization",
      "ApiKeyIdentifier": "Bearer"
    },
    "request": {
      "apiEndpoint": "https://cybereinforce.com/api/sentinelEvents",
      "rateLimitQPS": 10,
      "queryWindowInMin": 5,
      "httpMethod": "GET",
      "queryTimeFormat": "yyyy-MM-dd'T'HH:mm:ss.fffffff'Z'",
      "queryParameters": {
        "startTime": "{_QueryWindowStartTime}",
        "endTime": "{_QueryWindowEndTime}"
      },
      "retryCount": 3,
      "timeoutInSeconds": 60,
      "headers": {
        "Accept": "application/json",
        "User-Agent": "Scuba"
      }
    },
    "paging": {
      "pagingType": "NextPageToken",
      "PageSize": "1000",
      "PageSizeParameterName": "limit",
      "NextPageTokenJsonPath": "$.nextCursor",
      "NextPageParaName": "cursor"
    },
    "response": {
      "eventsJsonPaths": [
        "$.data"
      ],
      "format": "json"
    }
  }
}
