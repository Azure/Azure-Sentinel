{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string",
      "defaultValue": "wlaw"
    },
    "location": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "apiKey": {
      "type": "securestring",
      "metadata": {
        "description": "WhoisFreaks commercial API key (X-API-KEY). Feeds outside your subscription will fail connectivity or log 401/403 for that feed only if forced on."
      }
    },
    "dataCollectionEndpoint": {
      "type": "string",
      "metadata": {
        "description": "The target workspace Data Collection Endpoint URL (required for the selected deployment environment)."
      }
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "metadata": {
        "description": "The target workspace Data Collection Rule immutable ID (required for the selected deployment environment)."
      }
    },
    "enableThreatMalware": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable malware threat feed (v3.4/stream/threat-feed/malware)"
      }
    },
    "enableThreatPhishing": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable phishing threat feed"
      }
    },
    "enableThreatSpam": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable spam threat feed"
      }
    },
    "enableNrdGtldWhois": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable NRD gTLD with WHOIS (requires NRD+WHOIS subscription)"
      }
    },
    "enableNrdGtldNoWhois": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable NRD gTLD without WHOIS (requires NRD subscription)"
      }
    },
    "enableNrdCctldWhois": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable NRD ccTLD with WHOIS (requires NRD+WHOIS subscription)"
      }
    },
    "enableNrdCctldNoWhois": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable NRD ccTLD without WHOIS (requires NRD subscription)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
      "apiVersion": "2023-02-01-preview",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/', 'WhoisFreaksThreat_malware')]",
      "location": "[parameters('location')]",
      "kind": "RestApiPoller",
      "condition": "[parameters('enableThreatMalware')]",
      "properties": {
        "connectorDefinitionName": "WhoisFreaks",
        "dataType": "WhoisFreaksThreat_CL",
        "dcrConfig": {
          "streamName": "Custom-WhoisFreaksThreat_malware",
          "dataCollectionEndpoint": "[parameters('dataCollectionEndpoint')]",
          "dataCollectionRuleImmutableId": "[parameters('dataCollectionRuleImmutableId')]"
        },
        "auth": {
          "type": "APIKey",
          "ApiKey": "[parameters('apiKey')]",
          "ApiKeyName": "X-API-KEY"
        },
        "request": {
          "apiEndpoint": "https://files.whoisfreaks.com/v3.4/status",
          "httpMethod": "GET",
          "headers": {
            "Accept": "application/json"
          },
          "queryWindowInMin": 1440,
          "retryCount": 3,
          "timeoutInSeconds": 180,
          "rateLimitQPS": 2
        },
        "response": {
          "eventsJsonPaths": [
            "$.threat_feed.malware"
          ],
          "format": "json"
        },
        "stepInfo": {
          "stepType": "Nested",
          "nextSteps": [
            {
              "stepId": "fetchThreat_malware",
              "stepPlaceholdersParsingKql": "source | project res = parse_json(data) | project lastUpdate = tostring(res.last_update)"
            }
          ]
        },
        "stepCollectorConfigs": {
          "fetchThreat_malware": {
            "shouldJoinNestedData": false,
            "request": {
              "httpMethod": "GET",
              "apiEndpoint": "https://files.whoisfreaks.com/v3.4/stream/threat-feed/malware",
              "headers": {
                "Accept": "text/csv,text/plain,*/*"
              },
              "queryParameters": {
                "date": "$lastUpdate$"
              },
              "retryCount": 3,
              "timeoutInSeconds": 180,
              "rateLimitQPS": 2
            },
            "auth": {
              "AuthType": "APIKey",
              "APIKey": "[parameters('apiKey')]",
              "APIKeyName": "X-API-KEY"
            },
            "paging": {
              "pagingType": "Offset",
              "offsetParaName": "offset",
              "pageSizeParaName": "limit",
              "pageSize": 10000,
              "pagingInfoPlacement": "QueryString"
            },
            "response": {
              "eventsJsonPaths": [
                "$"
              ],
              "format": "csv",
              "hasCsvHeader": true
            }
          }
        }
      }
    },
