{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', 'WhoisFreaks-ParkedThreatDomain')]",
      "location": "[parameters('workspace-location')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "WhoisFreaks - Parked Threat Domains",
        "description": "Threat-listed domains that are currently parked (often used for staging).",
        "severity": "Medium",
        "enabled": true,
        "query": "WhoisFreaksThreat_CL\n| where tostring(is_parked) =~ \"true\" or tostring(is_parked) == \"1\"\n| summarize arg_max(TimeGenerated, *) by domain\n| project TimeGenerated, domain, threat_type, confidence, parked_reason, matched_pivots",
        "queryFrequency": "PT6H",
        "queryPeriod": "PT6H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "ResourceDevelopment"
        ],
        "techniques": [
          "T1583"
        ],
        "entityMappings": [
          {
            "entityType": "DNS",
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "domain"
              }
            ]
          }
        ]
      }
    }
  ]
}
