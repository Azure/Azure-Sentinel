{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', 'WhoisFreaks-FreshNRD-Burst')]",
      "location": "[parameters('workspace-location')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "WhoisFreaks - Burst of Newly Registered Domains",
        "description": "Detects unusually large NRD ingest volume which may indicate bulk registration campaigns.",
        "severity": "Low",
        "enabled": true,
        "query": "union WhoisFreaksNRD_CL, WhoisFreaksNRDNoWhois_CL\n| where TimeGenerated > ago(1h)\n| summarize DomainCount=dcount(domain_name) by bin(TimeGenerated, 1h)\n| where DomainCount > 5000\n| project TimeGenerated, DomainCount",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "ResourceDevelopment"
        ],
        "techniques": [
          "T1583"
        ]
      }
    }
  ]
}
