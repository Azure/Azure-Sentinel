{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', 'WhoisFreaks-NRD-Also-Threat')]",
      "location": "[parameters('workspace-location')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "WhoisFreaks - Newly Registered Domain seen in Threat Feed",
        "description": "Correlates newly registered domains (NRD) with WhoisFreaks threat indicators.",
        "severity": "High",
        "enabled": true,
        "query": "let nrd = union WhoisFreaksNRD_CL, WhoisFreaksNRDNoWhois_CL\n| where TimeGenerated > ago(7d)\n| distinct domain_name;\nWhoisFreaksThreat_CL\n| where TimeGenerated > ago(1d)\n| join kind=inner (nrd) on $left.domain == $right.domain_name\n| summarize arg_max(TimeGenerated, *) by domain, threat_type\n| project TimeGenerated, domain, threat_type, confidence, domain_name",
        "queryFrequency": "PT1H",
        "queryPeriod": "P1D",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "InitialAccess",
          "ResourceDevelopment"
        ],
        "techniques": [
          "T1583",
          "T1566"
        ],
        "entityMappings": [
          {
            "entityType": "DNS",
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "domain"
              }
            ]
          }
        ]
      }
    }
  ]
}
