{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', 'WhoisFreaks-HighConfidenceThreat')]",
      "location": "[parameters('workspace-location')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "WhoisFreaks - High Confidence Threat Domains",
        "description": "Detects high-confidence malware/phishing/spam domains from WhoisFreaks threat feeds.",
        "severity": "High",
        "enabled": true,
        "query": "WhoisFreaksThreat_CL\n| where toint(confidence) >= 80 or confidence =~ \"high\"\n| summarize arg_max(TimeGenerated, *) by domain, threat_type\n| project TimeGenerated, domain, threat_type, confidence, first_seen, last_seen, is_parked, matched_pivots",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "InitialAccess",
          "CommandAndControl"
        ],
        "techniques": [
          "T1566",
          "T1071"
        ],
        "entityMappings": [
          {
            "entityType": "DNS",
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "domain"
              }
            ]
          }
        ]
      }
    }
  ]
}
