{
  "name": "WhoisFreaks",
  "apiVersion": "2022-09-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "{{location}}",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "WhoisFreaks",
      "title": "WhoisFreaks Threat & NRD Feeds (via Codeless Connector Framework)",
      "publisher": "Whoisfreaks",
      "descriptionMarkdown": "Ingest WhoisFreaks threat feeds and newly registered domain data into Microsoft Sentinel. Threat payload fields retain their API names. WHOIS NRD payload fields retain their API names. No-WHOIS NRD domains are stored in a dedicated table. Both NRD tables include an `nrd_type` column (`gtld` or `cctld`).",
      "graphQueriesTableName": "WhoisFreaksThreat_CL",
      "graphQueries": [
        {
          "metricName": "Threat events",
          "legend": "WhoisFreaksThreat_CL",
          "baseQuery": "WhoisFreaksThreat_CL"
        },
        {
          "metricName": "NRD with WHOIS",
          "legend": "WhoisFreaksNRD_CL",
          "baseQuery": "WhoisFreaksNRD_CL"
        },
        {
          "metricName": "NRD without WHOIS",
          "legend": "WhoisFreaksNRDNoWhois_CL",
          "baseQuery": "WhoisFreaksNRDNoWhois_CL"
        }
      ],
      "sampleQueries": [
        {
          "description": "Recent threat indicators",
          "query": "WhoisFreaksThreat_CL\n| sort by TimeGenerated desc\n| take 20"
        },
        {
          "description": "Recent NRD with WHOIS",
          "query": "WhoisFreaksNRD_CL\n| summarize count() by nrd_type\n| sort by nrd_type asc"
        },
        {
          "description": "Recent NRD without WHOIS",
          "query": "WhoisFreaksNRDNoWhois_CL\n| summarize count() by nrd_type\n| sort by nrd_type asc"
        }
      ],
      "dataTypes": [
        {
          "name": "WhoisFreaksThreat_CL",
          "lastDataReceivedQuery": "WhoisFreaksThreat_CL\n| summarize Time=max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "WhoisFreaksNRD_CL",
          "lastDataReceivedQuery": "WhoisFreaksNRD_CL\n| summarize Time=max(TimeGenerated)\n| where isnotempty(Time)"
        },
        {
          "name": "WhoisFreaksNRDNoWhois_CL",
          "lastDataReceivedQuery": "WhoisFreaksNRDNoWhois_CL\n| summarize Time=max(TimeGenerated)\n| where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "status": 1,
        "isPreview": true
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and write permissions on the workspace are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "read": true,
              "write": true,
              "delete": true
            }
          }
        ],
        "customs": [
          {
            "name": "WhoisFreaks API key",
            "description": "A valid commercial WhoisFreaks API key with access to the threat and NRD stream feeds."
          }
        ]
      },
      "instructionSteps": [
        {
          "title": "Connect WhoisFreaks to Microsoft Sentinel",
          "description": "Enter your commercial API key and select the feeds enabled by your subscription. Each selected feed is independently provisioned.",
          "instructions": [
            {
              "type": "Textbox",
              "parameters": {
                "label": "WhoisFreaks API Key",
                "placeholder": "Enter your WhoisFreaks API key",
                "type": "password",
                "name": "apiKey",
                "validations": {
                  "required": true
                }
              }
            },
            {
              "type": "Dropdown",
              "parameters": {
                "label": "Feeds to enable",
                "name": "feedTypes",
                "isMultiSelect": true,
                "defaultAllSelected": true,
                "options": [
                  {
                    "key": "threat_malware",
                    "text": "threat malware"
                  },
                  {
                    "key": "threat_phishing",
                    "text": "threat phishing"
                  },
                  {
                    "key": "threat_spam",
                    "text": "threat spam"
                  },
                  {
                    "key": "nrd_gtld_whois",
                    "text": "nrd gtld whois"
                  },
                  {
                    "key": "nrd_gtld_nowhois",
                    "text": "nrd gtld nowhois"
                  },
                  {
                    "key": "nrd_cctld_whois",
                    "text": "nrd cctld whois"
                  },
                  {
                    "key": "nrd_cctld_nowhois",
                    "text": "nrd cctld nowhois"
                  }
                ]
              }
            },
            {
              "type": "ConnectionToggleButton",
              "parameters": {
                "connectLabel": "Connect",
                "disconnectLabel": "Disconnect",
                "name": "toggle"
              }
            }
          ]
        }
      ]
    }
  }
}
