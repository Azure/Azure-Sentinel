{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "automationAccounts_ESI_DataCollector_name": {
            "defaultValue": "ESI-DataCollector",
            "type": "String"
        },
        "location": {
          "type": "string",
          "defaultValue": "[resourceGroup().location]",
          "metadata": {
            "description": "Specifies the location in which to create the workspace."
          }
        },
        "JobSchedulerGuid": {
            "defaultValue": "[newGuid()]",
            "type": "String",
            "metadata": {
                "description": "Enter new GUID, you can generate one from Powershell using new-guid or get one from this site: <a target=new href=https://guidgenerator.com/online-guid-generator.aspx>GUID Generator</a>"
              }
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Automation/automationAccounts/variables",
            "apiVersion": "2022-08-08",
            "name": "[concat(parameters('automationAccounts_ESI_DataCollector_name'), '/LastDateTracking-ExchangeOnlineMessageTracking')]",
            "dependsOn": [],
            "properties": {
                "isEncrypted": false,
                "value": ""
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/schedules",
            "apiVersion": "2020-01-13-preview",
            "name": "[concat(parameters('automationAccounts_ESI_DataCollector_name'), '/ESI-OnlineMessageTracking')]",
            "dependsOn": [],
            "properties": {
                "interval": 1,
                "frequency": "Hour",
                "timeZone": "Europe/Paris"
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/jobSchedules",
            "apiVersion": "2021-04-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('automationAccounts_ESI_DataCollector_name'), '/', parameters('JobSchedulerGuid'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts/schedules/', parameters('automationAccounts_ESI_DataCollector_name'), 'ESI-OnlineMessageTracking')]"
            ],
            "properties": {
                "runbook": {
                    "name": "Start-ESICollector"
                },
                "schedule": {
                    "name": "ESI-OnlineMessageTracking"
                },
                "parameters":{
                    "InstanceName": "ExchangeOnlineMessageTracking"
                }
            }
        }
    ]
}