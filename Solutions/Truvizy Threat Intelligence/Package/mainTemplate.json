{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "Truvizy - support@truvizy.app",
    "comments": "Solution template for Truvizy Threat Intelligence"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "email": "support@truvizy.app",
    "_email": "[variables('email')]",
    "_solutionName": "Truvizy Threat Intelligence",
    "_solutionVersion": "3.0.0",
    "solutionId": "truvizy.truvizy-sentinel-solution-threatintelligence",
    "_solutionId": "[variables('solutionId')]",
    "uiConfigId1": "TruvizyThreatIntelligenceTaxii",
    "_uiConfigId1": "[variables('uiConfigId1')]",
    "dataConnectorContentId1": "TruvizyThreatIntelligenceTaxii",
    "_dataConnectorContentId1": "[variables('dataConnectorContentId1')]",
    "dataConnectorId1": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
    "_dataConnectorId1": "[variables('dataConnectorId1')]",
    "dataConnectorTemplateSpecName1": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentId1'))))]",
    "dataConnectorVersion1": "1.0.0",
    "_dataConnectorcontentProductId1": "[concat(take(variables('_solutionId'),50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentId1'),'-', variables('dataConnectorVersion1'))))]",
    "analyticRuleObject1": {
      "analyticRuleVersion1": "1.0.0",
      "_analyticRulecontentId1": "b8566872-80fa-49c0-a593-c17236217ba7",
      "analyticRuleId1": "[resourceId('Microsoft.SecurityInsights/AlertRuleTemplates', 'b8566872-80fa-49c0-a593-c17236217ba7')]",
      "analyticRuleTemplateSpecName1": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-ar-',uniquestring('b8566872-80fa-49c0-a593-c17236217ba7')))]",
      "_analyticRulecontentProductId1": "[concat(take(variables('_solutionId'),50),'-','ar','-', uniqueString(concat(variables('_solutionId'),'-','AnalyticsRule','-','b8566872-80fa-49c0-a593-c17236217ba7','-', '1.0.0')))]"
    },
    "analyticRuleObject2": {
      "analyticRuleVersion2": "1.0.0",
      "_analyticRulecontentId2": "a94f9551-0c4d-44ec-92db-7fdfe5f252b9",
      "analyticRuleId2": "[resourceId('Microsoft.SecurityInsights/AlertRuleTemplates', 'a94f9551-0c4d-44ec-92db-7fdfe5f252b9')]",
      "analyticRuleTemplateSpecName2": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-ar-',uniquestring('a94f9551-0c4d-44ec-92db-7fdfe5f252b9')))]",
      "_analyticRulecontentProductId2": "[concat(take(variables('_solutionId'),50),'-','ar','-', uniqueString(concat(variables('_solutionId'),'-','AnalyticsRule','-','a94f9551-0c4d-44ec-92db-7fdfe5f252b9','-', '1.0.0')))]"
    },
    "huntingQueryObject1": {
      "huntingQueryVersion1": "1.0.0",
      "_huntingQuerycontentId1": "6d3f1a02-9c4b-4e8d-a1f7-3b2c5d8e9f01",
      "huntingQueryTemplateSpecName1": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-hq-',uniquestring('6d3f1a02-9c4b-4e8d-a1f7-3b2c5d8e9f01')))]"
    },
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[variables('dataConnectorTemplateSpecName1')]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "description": "Truvizy Threat Intelligence data connector with template version 3.0.0",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorVersion1')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentId1'))]",
              "apiVersion": "2021-03-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
              "location": "[parameters('workspace-location')]",
              "kind": "GenericUI",
              "properties": {
                "connectorUiConfig": {
                  "id": "[variables('_uiConfigId1')]",
                  "title": "Truvizy Threat Intelligence (TAXII)",
                  "publisher": "Truvizy",
                  "descriptionMarkdown": "The Truvizy Threat Intelligence connector brings scam and phishing indicators confirmed by the Truvizy detection network into Microsoft Sentinel through the built-in TAXII 2.1 data connector. Indicators are curated for safe blocking: only high-confidence indicators are published, shared platforms (such as youtube.com) are never listed at the domain level, and indicators expire automatically when they stop being relevant. To request feed credentials, contact [Truvizy](https://truvizy.app).",
                  "graphQueries": [
                    {
                      "metricName": "Total data received",
                      "legend": "Truvizy indicators",
                      "baseQuery": "ThreatIntelligenceIndicator | where SourceSystem == \"Truvizy\""
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "All active Truvizy indicators",
                      "query": "ThreatIntelligenceIndicator\n| where SourceSystem == \"Truvizy\"\n| where ExpirationDateTime > now() and Active == true\n| summarize arg_max(TimeGenerated, *) by IndicatorId\n| project TimeGenerated, ThreatType, Url, DomainName, ConfidenceScore, ExpirationDateTime"
                    },
                    {
                      "description": "Truvizy indicators received per day",
                      "query": "ThreatIntelligenceIndicator\n| where SourceSystem == \"Truvizy\"\n| summarize count() by bin(TimeGenerated, 1d)"
                    },
                    {
                      "description": "Truvizy domain indicators matched against DNS queries",
                      "query": "let ioc_lookBack = 14d;\nThreatIntelligenceIndicator\n| where TimeGenerated >= ago(ioc_lookBack) and ExpirationDateTime > now()\n| where SourceSystem == \"Truvizy\" and isnotempty(DomainName)\n| summarize arg_max(TimeGenerated, *) by IndicatorId\n| join kind=innerunique (DnsEvents | where TimeGenerated >= ago(1d)) on $left.DomainName == $right.Name\n| project TimeGenerated, DomainName, ClientIP, ConfidenceScore"
                    }
                  ],
                  "connectivityCriterias": [
                    {
                      "type": "SentinelKinds",
                      "value": [
                        "ThreatIntelligenceTaxii"
                      ]
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "ThreatIntelligenceIndicator",
                      "lastDataReceivedQuery": "ThreatIntelligenceIndicator | where SourceSystem == \"Truvizy\"\n            | summarize Time = max(TimeGenerated)\n            | where isnotempty(Time)"
                    }
                  ],
                  "availability": {
                    "status": 1,
                    "isPreview": false
                  },
                  "permissions": {
                    "customs": [
                      {
                        "name": "Truvizy feed credentials",
                        "description": "A Truvizy TAXII username and password, issued by the Truvizy team during onboarding. Contact https://truvizy.app to request access."
                      }
                    ],
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "read and write permissions.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "read": true,
                          "write": true,
                          "delete": true
                        }
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "description": "Configure the built-in TAXII connector with the Truvizy server details below, then select Add.\n\n1. **Friendly name (for server):** Truvizy\n2. **API root URL:** https://taxii.truvizy.app/functions/v1/taxii-server/api/\n3. **Collection ID:** b7c1d2e0-5a4f-4c8e-9d3a-2f6b8c1e7a90\n4. **Username / Password:** issued by the Truvizy team during onboarding\n5. **Import indicators:** At most one hour (recommended polling frequency: once per hour)\n\nUse the friendly name **Truvizy** exactly: the analytics rules and sample queries in this solution filter on it.",
                      "instructions": [
                        {
                          "parameters": {},
                          "type": "ThreatIntelligenceTaxii"
                        }
                      ],
                      "title": "Connect Microsoft Sentinel to the Truvizy TAXII 2.1 feed"
                    }
                  ],
                  "metadata": {
                    "id": "0b1e8266-3f12-432e-968f-5a83124ddd04",
                    "version": "1.0.0",
                    "kind": "dataConnector",
                    "source": {
                      "kind": "solution",
                      "name": "Truvizy Threat Intelligence"
                    },
                    "author": {
                      "name": "Truvizy"
                    },
                    "support": {
                      "name": "Truvizy",
                      "email": "support@truvizy.app",
                      "tier": "Partner",
                      "link": "https://truvizy.app"
                    }
                  }
                }
              }
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "apiVersion": "2023-04-01-preview",
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', last(split(variables('_dataConnectorId1'),'/'))))]",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
                "contentId": "[variables('_dataConnectorContentId1')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorVersion1')]",
                "source": {
                  "kind": "Solution",
                  "name": "Truvizy Threat Intelligence",
                  "sourceId": "[variables('_solutionId')]"
                },
                "author": {
                  "name": "Truvizy",
                  "email": "[variables('_email')]"
                },
                "support": {
                  "name": "Truvizy",
                  "email": "support@truvizy.app",
                  "tier": "Partner",
                  "link": "https://truvizy.app/support"
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "contentId": "[variables('_dataConnectorContentId1')]",
        "contentKind": "DataConnector",
        "displayName": "Truvizy Threat Intelligence (TAXII)",
        "contentProductId": "[variables('_dataConnectorcontentProductId1')]",
        "id": "[variables('_dataConnectorcontentProductId1')]",
        "version": "[variables('dataConnectorVersion1')]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', last(split(variables('_dataConnectorId1'),'/'))))]",
      "dependsOn": [
        "[variables('_dataConnectorId1')]"
      ],
      "location": "[parameters('workspace-location')]",
      "properties": {
        "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
        "contentId": "[variables('_dataConnectorContentId1')]",
        "kind": "DataConnector",
        "version": "[variables('dataConnectorVersion1')]",
        "source": {
          "kind": "Solution",
          "name": "Truvizy Threat Intelligence",
          "sourceId": "[variables('_solutionId')]"
        },
        "author": {
          "name": "Truvizy",
          "email": "[variables('_email')]"
        },
        "support": {
          "name": "Truvizy",
          "email": "support@truvizy.app",
          "tier": "Partner",
          "link": "https://truvizy.app/support"
        }
      }
    },
    {
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentId1'))]",
      "apiVersion": "2021-03-01-preview",
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
      "location": "[parameters('workspace-location')]",
      "kind": "GenericUI",
      "properties": {
        "connectorUiConfig": {
          "title": "Truvizy Threat Intelligence (TAXII)",
          "publisher": "Truvizy",
          "descriptionMarkdown": "The Truvizy Threat Intelligence connector brings scam and phishing indicators confirmed by the Truvizy detection network into Microsoft Sentinel through the built-in TAXII 2.1 data connector. Indicators are curated for safe blocking: only high-confidence indicators are published, shared platforms (such as youtube.com) are never listed at the domain level, and indicators expire automatically when they stop being relevant. To request feed credentials, contact [Truvizy](https://truvizy.app).",
          "graphQueries": [
            {
              "metricName": "Total data received",
