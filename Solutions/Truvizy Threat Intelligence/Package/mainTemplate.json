      ],
      "properties": {
        "description": "TruvizyActiveIndicators_HuntingQueries Hunting Query with template version 3.0.0",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('huntingQueryObject1').huntingQueryVersion1]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/savedSearches",
              "apiVersion": "2025-07-01",
              "name": "Truvizy_Threat_Intelligence_Hunting_Query_1",
              "location": "[parameters('workspace-location')]",
              "properties": {
                "eTag": "*",
                "displayName": "Truvizy active indicator overview",
                "category": "Hunting Queries",
                "query": "ThreatIntelligenceIndicator\n| where SourceSystem == \"Truvizy\"\n| where ExpirationDateTime > now() and Active == true\n| summarize arg_max(TimeGenerated, *) by IndicatorId\n| extend IndicatorValue = coalesce(Url, DomainName)\n| extend ConfidenceBand = case(ConfidenceScore >= 90, \"90+\", ConfidenceScore >= 80, \"80-89\", \"70-79\")\n| summarize Indicators = count(), Sample = any(IndicatorValue) by ThreatType, ConfidenceBand\n| order by Indicators desc\n",
                "version": 2,
                "tags": [
                  {
                    "name": "description",
                    "value": "Summarizes currently active scam and phishing indicators from the Truvizy detection network by threat type and confidence band. Use this to understand the current shape of the feed and to pivot into matches against your own telemetry."
                  },
                  {
                    "name": "tactics",
                    "value": "InitialAccess"
                  },
                  {
                    "name": "techniques",
                    "value": "T1566"
                  }
                ]
              }
            },
