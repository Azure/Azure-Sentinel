{
    "name": "SilentPushFeedsConnectorDefinition",
    "apiVersion": "2022-09-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "SilentPushFeedsConnectorDefinition",
            "title": "SilentPush Feeds",
            "publisher": "Silent Push",
            "descriptionMarkdown": "Native codeless data connector for monitoring Silent Push threat actor feeds. Supports feed exports in CSV format with a header row (e.g. `*_enriched.csv`). Not compatible with headerless plaintext indicator lists (e.g. `*_ips.txt`, `*_domains.txt`) -- use the SilentPush Export Enrichment playbooks for those instead.",
            "graphQueriesTableName": "SLP_Feeds_CL",
            "graphQueries": [
                {
                    "metricName": "events received",
                    "legend": "Silent Push Feeds events",
                    "baseQuery": "{{graphQueriesTableName}}"
                }
            ],
            "sampleQueries": [
                {
                    "description": "Silent Push Feeds events",
                    "query": "{{graphQueriesTableName}} \n | take 10"
                }
            ],
            "dataTypes": [
                {
                    "name": "{{graphQueriesTableName}}",
                    "lastDataReceivedQuery": "{{graphQueriesTableName}} \n | summarize Time = max(TimeGenerated) \n | where isnotempty(Time)"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors"
                }
            ],
            "availability": {
                "status": 1,
                "isPreview": false
            },
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "write": true,
                            "read": true,
                            "delete": true
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "Silent Push API access",
                        "description": "sign up to https://app.silentpush.com"
                    }
                ]
            },
            "instructionSteps": [
                {
                    "title": "Connect to Silent Push and collect feed",
                    "description": "In order to start collecting Silent Push feeds, please provide the required information below. Note: the feed you select must export as a CSV file with a header row (e.g. an *_enriched.csv export) -- headerless plaintext indicator lists (e.g. *_ips.txt, *_domains.txt) are not supported here, use the SilentPush Export Enrichment playbooks for those instead.",
                    "instructions": [
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "API key",
                                "placeholder": "YOUR-SILENT-PUSH-API-KEY",
                                "type": "password",
                                "name": "apikey",
                                "validations": {
                                    "required": true
                                }
                            }
                        },
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "Data source",
                                "placeholder": "organization-exports",
                                "type": "text",
                                "name": "datasource"
                            }
                        },
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "Feed file name",
                                "placeholder": "e.g. 01234567-0123-4567-8901-012345678901_enriched.csv",
                                "type": "text",
                                "name": "feedname",
                                "validations": {
                                    "required": true
                                }
                            }
                        },
                        {
                            "type": "ConnectionToggleButton",
                            "parameters": {
                                "connectLabel": "Connect",
                                "disconnectLabel": "Disconnect",
                                "name": "toggle"
                            }
                        }
                    ]
                }
            ],
            "metadata": {
                "version": "1.0.0",
                "kind": "dataConnector"
            }
        }
    }
}
