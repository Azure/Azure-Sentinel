{
    "name": "SilentPushFeeds",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
        "connectorDefinitionName": "SilentPushFeedsConnectorDefinition",
        "dataType": "SLP_Feeds_CL",
        "dcrConfig": {
            "streamName": "Custom-SLP_Feeds_CL"
        },
        "auth": {
            "type": "APIKey",
            "ApiKeyName": "x-api-key",
            "ApiKey": "{{apikey}}"
        },
        "request": {
            "apiEndpoint": "https://api.silentpush.com/api/v1/export/{{datasource}}/{{feedname}}/",
            "httpMethod": "GET",
            "headers": {
                "User-Agent": "Microsoft/Sentinel (Data Connector)"
            },
            "timeoutInSeconds": 120,
            "retryCount": 2
        },
        "response": {
            "eventsJsonPaths": [
                "$"
            ],
            "format": "csv",
            "hasCsvHeader": true
        },
        "isActive": true
    }
}
