{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "SilentPush-IPExportEnrichment-Full",
    "description": "Silent Push IPs export with enrichment and TI upload",
    "postDeployment": [
      "**Authorize the SilentPush connector connection**",
      "This playbook deploys with a placeholder (empty) API key for the SilentPush connector. Complete the connection before enabling/running the playbook:",
      "1. Go to your Logic App -> API connections -> select the SilentPush-<PlaybookName> connection resource",
      "2. Go to General -> Edit API connection",
      "3. Enter your Silent Push API key (sign up at https://app.silentpush.com)",
      "4. Click Save"
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "SilentPush-IPExportEnrichment-Full",
      "type": "string",
      "metadata": {
        "description": "Silent Push IPs export with enrichment and TI upload"
      }
    },
    "CustomConnectorName": {
      "defaultValue": "SilentPush-API",
      "type": "string",
      "metadata": {
        "description": "The SilentPush API custom connector"
      }
    },
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace name where Microsoft Sentinel is enabled"
      }
    }
  },
  "variables": {
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/workspaces', parameters('workspace'))]",
    "SilentPushConnectionName": "[concat('SilentPush-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "silentPushApiId": "[resourceId('Microsoft.Web/customApis', parameters('CustomConnectorName'))]",
    "_SentinelContributorRoleGuid": "ab8e14d6-4a74-4a29-9ba8-549422addade",
    "SentinelContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('_SentinelContributorRoleGuid'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('SilentPushConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('SilentPushConnectionName')]",
        "api": {
          "id": "[variables('silentPushApiId')]"
        },
        "parameterValues": {
          "api_key": ""
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', reference(resourceId('microsoft.OperationalInsights/workspaces', parameters('workspace')), '2021-06-01', 'Full').location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "name": "[parameters('PlaybookName')]",
      "type": "Microsoft.Logic/workflows",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "apiVersion": "2019-05-01",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "interval": 24,
                "frequency": "Hour"
              }
            }
          },
          "actions": {
            "Export_IOFA": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/api/v1/export/@{encodeURIComponent('iofa-exports')}/@{encodeURIComponent('all_iofas_ips.txt')}/"
              }
            },
            "Extract_Location": {
              "type": "Compose",
              "runAfter": {
                "Export_IOFA": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": "@outputs('Export_IOFA')?['headers']?['Location']"
            },
            "Check_Location_Valid": {
              "type": "If",
              "runAfter": {
                "Extract_Location": [
                  "Succeeded"
                ]
              },
              "expression": "@startsWith(coalesce(outputs('Extract_Location'), ''), 'https://')",
              "actions": {
                "Validate_Redirect_Host": {
                  "type": "If",
                  "runAfter": {},
                  "expression": "@and(equals(uriScheme(outputs('Extract_Location')), 'https'), equals(uriHost(outputs('Extract_Location')), 'silentpush-feeds.s3.amazonaws.com'))",
                  "actions": {
                    "Follow_Redirect": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "uri": "@outputs('Extract_Location')",
                        "method": "GET",
                        "headers": {
                          "Range": "bytes=0-1600000"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Get_Export_Total_Size": {
                      "type": "Compose",
                      "runAfter": {
                        "Follow_Redirect": [
                          "Succeeded"
                        ]
                      },
                      "inputs": "@if(equals(outputs('Follow_Redirect')?['headers']?['Content-Range'], null), length(body('Follow_Redirect')), int(substring(outputs('Follow_Redirect')?['headers']?['Content-Range'], add(lastIndexOf(outputs('Follow_Redirect')?['headers']?['Content-Range'], '/'), 1), sub(length(outputs('Follow_Redirect')?['headers']?['Content-Range']), add(lastIndexOf(outputs('Follow_Redirect')?['headers']?['Content-Range'], '/'), 1)))))"
                    },
                    "Check_Export_Size": {
                      "type": "If",
                      "runAfter": {
                        "Get_Export_Total_Size": [
                          "Succeeded"
                        ]
                      },
                      "expression": "@less(outputs('Get_Export_Total_Size'), 1600001)",
                      "actions": {
                        "Split_Into_Batches": {
                          "type": "Compose",
                          "runAfter": {},
                          "inputs": "@chunk(split(trim(replace(body('Follow_Redirect'), '\r', '')), '\n'), 100)"
                        },
                        "For_Each_Batch": {
                          "type": "Foreach",
                          "foreach": "@outputs('Split_Into_Batches')",
                          "runAfter": {
                            "Split_Into_Batches": [
                              "Succeeded"
                            ]
                          },
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "actions": {
                        "Bulk_Enrich_IPv4s": {
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                              }
                            },
                            "method": "post",
                            "body": {
                              "ipv4s": "@items('For_Each_Batch')"
                            },
                            "path": "/api/v1/enrich/ipv4/bulk/",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 10,
                              "interval": "PT20S",
                              "minimumInterval": "PT10S",
                              "maximumInterval": "PT1H"
                            }
                          }
                        },
                        "Filter_Enriched_Only": {
                          "type": "Query",
                          "runAfter": {
                            "Bulk_Enrich_IPv4s": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@body('Bulk_Enrich_IPv4s')?['response']?['ip2asn']",
                            "where": "@equals(item()?['error'], null)"
                          }
                        },
                        "Build_TI_Indicators": {
                          "type": "Select",
                          "runAfter": {
                            "Filter_Enriched_Only": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@body('Filter_Enriched_Only')",
                            "select": {
                              "created": "@{if(equals(item()?['date'], null), utcNow(), concat(substring(string(item()?['date']), 0, 4), '-', substring(string(item()?['date']), 4, 2), '-', substring(string(item()?['date']), 6, 2), 'T00:00:00Z'))}",
                              "modified": "@{if(equals(item()?['date'], null), utcNow(), concat(substring(string(item()?['date']), 0, 4), '-', substring(string(item()?['date']), 4, 2), '-', substring(string(item()?['date']), 6, 2), 'T00:00:00Z'))}",
                              "type": "indicator",
                              "spec_version": "2.1",
                              "id": "@{concat('indicator--', guid())}",
                              "value": "@{item()?['ip']}",
                              "name": "@{concat('Malicious IP: ', item()?['ip'])}",
                              "description": "Enriched via Silent Push IOFA export",
                              "pattern": "@{concat('[ipv4-addr:value = ''', item()?['ip'], ''']')}",
                              "pattern_type": "stix",
                              "confidence": "@int(coalesce(item()?['sp_risk_score'], 0))",
                              "valid_from": "@{utcNow()}",
                              "valid_until": "@{addDays(utcNow(), 30)}",
                              "extensions": {
                                "sentinel-ext": {
                                  "severity": "@max(0, min(5, div(int(coalesce(item()?['sp_risk_score'], 0)), 20)))",
                                  "confidence": "@int(coalesce(item()?['sp_risk_score'], 0))"
                                },
                                "x-silentpush-ext": {
                                  "extension_type": "property-extension",
                                  "vendor": "Silent Push",
                                  "datasource": "SilentPush IOFA Export",
                                  "asname": "@item()?['asname']",
                                  "asn": "@item()?['asn']",
                                  "asn_allocation_age": "@item()?['asn_allocation_age']",
                                  "asn_allocation_date": "@item()?['asn_allocation_date']",
                                  "asn_rank": "@item()?['asn_rank']",
                                  "asn_rank_score": "@item()?['asn_rank_score']",
                                  "asn_reputation": "@item()?['asn_reputation']",
                                  "asn_reputation_score": "@item()?['asn_reputation_score']",
                                  "asn_reputation_explain": "@item()?['asn_reputation_explain']",
                                  "asn_takedown_reputation": "@item()?['asn_takedown_reputation']",
                                  "asn_takedown_reputation_score": "@item()?['asn_takedown_reputation_score']",
                                  "asn_takedown_reputation_explain": "@item()?['asn_takedown_reputation_explain']",
                                  "date": "@item()?['date']",
                                  "density": "@item()?['density']",
                                  "ip_reputation": "@item()?['ip_reputation']",
                                  "ip_reputation_score": "@item()?['ip_reputation_score']",
                                  "ip_reputation_explain": "@item()?['ip_reputation_explain']",
                                  "ip_ptr": "@item()?['ip_ptr']",
                                  "ip_flags": "@item()?['ip_flags']",
                                  "ip_location": "@item()?['ip_location']",
                                  "ip_has_expired_certificate": "@item()?['ip_has_expired_certificate']",
                                  "ip_has_open_directory": "@item()?['ip_has_open_directory']",
                                  "ip_is_dsl_dynamic": "@item()?['ip_is_dsl_dynamic']",
                                  "ip_is_dsl_dynamic_score": "@item()?['ip_is_dsl_dynamic_score']",
                                  "ip_is_ipfs_node": "@item()?['ip_is_ipfs_node']",
                                  "ip_is_tor_exit_node": "@item()?['ip_is_tor_exit_node']",
                                  "known_benign": "@item()?['benign_info']?['known_benign']",
                                  "benign_info": "@item()?['benign_info']",
                                  "listing_score": "@item()?['listing_score']",
                                  "listing_score_explain": "@item()?['listing_score_explain']",
                                  "listing_score_feeds_explain": "@item()?['listing_score_feeds_explain']",
                                  "malscore": "@item()?['malscore']",
                                  "sinkhole_info": "@item()?['sinkhole_info']",
                                  "sp_risk_score": "@item()?['sp_risk_score']",
                                  "sp_risk_score_explain": "@item()?['sp_risk_score_explain']",
                                  "subnet": "@item()?['subnet']",
                                  "subnet_allocation_age": "@item()?['subnet_allocation_age']",
                                  "subnet_allocation_date": "@item()?['subnet_allocation_date']",
                                  "subnet_reputation": "@item()?['subnet_reputation']",
                                  "subnet_reputation_score": "@item()?['subnet_reputation_score']"
                                }
                              }
                            }
                          }
                        },
                        "Upload_TI_Batch": {
                          "type": "ApiConnection",
                          "runAfter": {
                            "Build_TI_Indicators": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "post",
                            "body": {
                              "sourcesystem": "Silent Push - IOFA Export",
                              "indicators": "@body('Build_TI_Indicators')"
                            },
                            "path": "[concat('/V2/ThreatIntelligence/', reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), '2021-06-01').customerId, '/UploadIndicators/')]",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 10,
                              "interval": "PT20S",
                              "minimumInterval": "PT10S",
                              "maximumInterval": "PT1H"
                            }
                          }
                        }
                      }
                    }
                      },
                      "else": {
                        "actions": {
                          "Terminate_Export_Too_Large": {
                            "type": "Terminate",
                            "inputs": {
                              "runStatus": "Failed",
                              "error": {
                                "code": "ExportTooLarge",
                                "message": "Silent Push IOFA IP export exceeded the maximum supported download size (1,600,000 bytes, approximately 100,000 entries). The export was not processed to avoid excessive run duration/cost."
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Terminate_Untrusted_Redirect": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "error": {
                            "code": "UntrustedRedirect",
                            "message": "Silent Push IOFA IP export returned a redirect Location that does not point to the trusted host silentpush-feeds.s3.amazonaws.com - the response may have been manipulated or is unexpected/untrusted."
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate_Export_Failed": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "error": {
                        "code": "ExportFailed",
                        "message": "@concat('Silent Push IOFA IP export did not return a valid https redirect Location - the export request likely failed (authentication, rate limiting, or a server error). HTTP status: ', string(coalesce(outputs('Export_IOFA')?['statusCode'], 'unknown')), '. Response body (truncated): ', substring(string(coalesce(outputs('Export_IOFA')?['body'], 'n/a')), 0, min(500, length(string(coalesce(outputs('Export_IOFA')?['body'], 'n/a'))))))"
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "SilentPushCustomConnector": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]",
                "connectionName": "[variables('SilentPushConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/customApis/', parameters('CustomConnectorName'))]"
              },
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', reference(resourceId('microsoft.OperationalInsights/workspaces', parameters('workspace')), '2021-06-01', 'Full').location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('workspaceResourceId'), parameters('PlaybookName'), variables('_SentinelContributorRoleGuid'))]",
      "scope": "[variables('workspaceResourceId')]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('SentinelContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
