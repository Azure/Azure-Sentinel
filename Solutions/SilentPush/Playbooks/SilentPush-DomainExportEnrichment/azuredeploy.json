{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "SilentPush-DomainExportEnrichment",
    "description": "Silent Push domains export with enrichment",
    "postDeployment": [
      "**Authorize the SilentPush connector connection**",
      "This playbook deploys with a placeholder (empty) API key for the SilentPush connector. Complete the connection before enabling/running the playbook:",
      "1. Go to your Logic App -> API connections -> select the SilentPush-<PlaybookName> connection resource",
      "2. Go to General -> Edit API connection",
      "3. Enter your Silent Push API key (sign up at https://app.silentpush.com)",
      "4. Click Save"
    ]
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "SilentPush-DomainExportEnrichment",
      "type": "string",
      "metadata": {
        "description": "Silent Push domains export with enrichment"
      }
    },
    "CustomConnectorName": {
      "defaultValue": "SilentPush-API",
      "type": "string",
      "metadata": {
        "description": "The Silent Push custom API connector"
      }
    }
  },
  "variables": {
    "SilentPushConnectionName": "[concat('SilentPush-', parameters('PlaybookName'))]",
    "silentPushApiId": "[resourceId('Microsoft.Web/customApis', parameters('CustomConnectorName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('SilentPushConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('SilentPushConnectionName')]",
        "api": {
          "id": "[variables('silentPushApiId')]"
        },
        "parameterValues": {
          "api_key": ""
        }
      }
    },
    {
      "name": "[parameters('PlaybookName')]",
      "type": "Microsoft.Logic/workflows",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "apiVersion": "2019-05-01",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]"
      ],
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "interval": 24,
                "frequency": "Hour"
              }
            }
          },
          "actions": {
            "Export_Domains": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/api/v1/export/@{encodeURIComponent('iofa-exports')}/@{encodeURIComponent('all_iofas_domains.txt')}/"
              }
            },
            "Extract_Location": {
              "type": "Compose",
              "runAfter": {
                "Export_Domains": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": "@outputs('Export_Domains')?['headers']?['Location']"
            },
            "Check_Location_Valid": {
              "type": "If",
              "runAfter": {
                "Extract_Location": [
                  "Succeeded"
                ]
              },
              "expression": "@startsWith(coalesce(outputs('Extract_Location'), ''), 'https://')",
              "actions": {
                "Validate_Redirect_Host": {
                  "type": "If",
                  "runAfter": {},
                  "expression": "@and(equals(uriScheme(outputs('Extract_Location')), 'https'), equals(uriHost(outputs('Extract_Location')), 'silentpush-feeds.s3.amazonaws.com'))",
                  "actions": {
                    "Follow_Redirect": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "uri": "@outputs('Extract_Location')",
                        "method": "GET",
                        "headers": {
                          "Range": "bytes=0-25600"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Get_Lines": {
                      "type": "Compose",
                      "runAfter": {
                        "Follow_Redirect": [
                          "Succeeded"
                        ]
                      },
                      "inputs": "@if(endsWith(replace(body('Follow_Redirect'), '\r', ''), '\n'), split(trim(replace(body('Follow_Redirect'), '\r', '')), '\n'), take(split(trim(replace(body('Follow_Redirect'), '\r', '')), '\n'), sub(length(split(trim(replace(body('Follow_Redirect'), '\r', '')), '\n')), 1)))"
                    },
                    "Extract_Body_Response": {
                      "type": "Compose",
                      "runAfter": {
                        "Get_Lines": [
                          "Succeeded"
                        ]
                      },
                      "inputs": "@take(outputs('Get_Lines'), 100)"
                    },
                    "Bulk_Enrich_Domains": {
                      "type": "ApiConnection",
                      "runAfter": {
                        "Extract_Body_Response": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                          }
                        },
                        "method": "post",
                        "body": {
                          "domains": "@outputs('Extract_Body_Response')"
                        },
                        "path": "/api/v1/enrich/domain/bulk/",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 10,
                          "interval": "PT20S",
                          "minimumInterval": "PT10S",
                          "maximumInterval": "PT1H"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Terminate_Untrusted_Redirect": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "error": {
                            "code": "UntrustedRedirect",
                            "message": "Silent Push IOFA domain export returned a redirect Location that does not point to the trusted host silentpush-feeds.s3.amazonaws.com - the response may have been manipulated or is unexpected/untrusted."
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate_Export_Failed": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "error": {
                        "code": "ExportFailed",
                        "message": "@concat('Silent Push IOFA domain export did not return a valid https redirect Location - the export request likely failed (authentication, rate limiting, or a server error). HTTP status: ', string(coalesce(outputs('Export_Domains')?['statusCode'], 'unknown')), '. Response body (truncated): ', substring(string(coalesce(outputs('Export_Domains')?['body'], 'n/a')), 0, min(500, length(string(coalesce(outputs('Export_Domains')?['body'], 'n/a'))))))"
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "SilentPushCustomConnector": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]",
                "connectionName": "[variables('SilentPushConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/customApis/', parameters('CustomConnectorName'))]"
              }
            }
          }
        }
      }
    }
  ]
}
