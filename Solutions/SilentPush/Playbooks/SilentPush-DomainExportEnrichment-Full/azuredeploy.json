{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "PlaybookName": {
      "defaultValue": "SilentPush-DomainExportEnrichment-Full",
      "type": "String",
      "metadata": {
        "description": "Silent Push domains export with enrichment and TI upload"
      }
    },
    "CustomConnectorName": {
      "defaultValue": "SilentPush-API",
      "type": "String",
      "metadata": {
        "description": "The SilentPush API custom connector"
      }
    },
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace name where Microsoft Sentinel is enabled"
      }
    }
  },
  "variables": {
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "SilentPushConnectionName": "[concat('SilentPush-', parameters('PlaybookName'))]",
    "MicrosoftSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "silentpushAPI_Id1": "[resourceId('Microsoft.Web/customApis', parameters('CustomConnectorName'))]",
    "_SentinelContributorRoleGuid": "ab8e14d6-4a74-4a29-9ba8-549422addade",
    "SentinelContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('_SentinelContributorRoleGuid'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('SilentPushConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('SilentPushConnectionName')]",
        "api": {
          "id": "[variables('silentpushAPI_Id1')]"
        },
        "parameterValues": {
          "api_key": ""
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('MicrosoftSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('MicrosoftSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', reference(resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace')), '2021-06-01', 'Full').location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "name": "[parameters('PlaybookName')]",
      "type": "Microsoft.Logic/workflows",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "apiVersion": "2019-05-01",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "interval": 24,
                "frequency": "Hour"
              }
            }
          },
          "actions": {
            "Export_Domains": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/api/v1/export/@{encodeURIComponent('iofa-exports')}/@{encodeURIComponent('all_iofas_domains.txt')}/"
              }
            },
            "Extract_Location": {
              "type": "Compose",
              "runAfter": {
                "Export_Domains": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": "@outputs('Export_Domains')['headers']?['Location']"
            },
            "Follow_Redirect": {
              "type": "Http",
              "runAfter": {
                "Extract_Location": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "uri": "@outputs('Extract_Location')",
                "method": "GET"
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Split_Into_Batches": {
              "type": "Compose",
              "runAfter": {
                "Follow_Redirect": [
                  "Succeeded"
                ]
              },
              "inputs": "@chunk(split(trim(body('Follow_Redirect')), '\n'), 100)"
            },
            "For_Each_Batch": {
              "type": "Foreach",
              "foreach": "@outputs('Split_Into_Batches')",
              "runAfter": {
                "Split_Into_Batches": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Bulk_Enrich_Domains": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['SilentPushCustomConnector']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": {
                      "domains": "@items('For_Each_Batch')"
                    },
                    "path": "/api/v1/enrich/domain/bulk/"
                  }
                },
                "Filter_Enriched_Only": {
                  "type": "Query",
                  "runAfter": {
                    "Bulk_Enrich_Domains": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Bulk_Enrich_Domains')?['response']",
                    "where": "@equals(item()?['domaininfo']?['error'], null)"
                  }
                },
                "Build_TI_Indicators": {
                  "type": "Select",
                  "runAfter": {
                    "Filter_Enriched_Only": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Filter_Enriched_Only')",
                    "select": {
                      "created": "@{if(equals(item()?['domaininfo']?['last_seen'], null), utcNow(), concat(substring(string(item()?['domaininfo']?['last_seen']), 0, 4), '-', substring(string(item()?['domaininfo']?['last_seen']), 4, 2), '-', substring(string(item()?['domaininfo']?['last_seen']), 6, 2), 'T00:00:00Z'))}",
                      "modified": "@{if(equals(item()?['domaininfo']?['last_seen'], null), utcNow(), concat(substring(string(item()?['domaininfo']?['last_seen']), 0, 4), '-', substring(string(item()?['domaininfo']?['last_seen']), 4, 2), '-', substring(string(item()?['domaininfo']?['last_seen']), 6, 2), 'T00:00:00Z'))}",
                      "type": "indicator",
                      "spec_version": "2.1",
                      "id": "@{concat('indicator--', guid())}",
                      "value": "@{item()?['domaininfo']?['query']}",
                      "name": "@{concat('Malicious Domain: ', item()?['domaininfo']?['query'])}",
                      "description": "Enriched via Silent Push IOFA export",
                      "pattern": "@{concat('[domain-name:value = ''', item()?['domaininfo']?['query'], ''']')}",
                      "pattern_type": "stix",
                      "confidence": "@int(coalesce(item()?['sp_risk_score'], 0))",
                      "valid_from": "@{utcNow()}",
                      "valid_until": "@{addDays(utcNow(), 30)}",
                      "extensions": {
                        "sentinel-ext": {
                          "severity": "@add(div(int(coalesce(item()?['sp_risk_score'], 0)), 20), 0)",
                          "confidence": "@int(coalesce(item()?['sp_risk_score'], 0))"
                        },
                        "x-silentpush-ext": {
                          "extension_type": "property-extension",
                          "vendor": "Silent Push",
                          "datasource": "SilentPush IOFA Export",
                          "registrar": "@item()?['domaininfo']?['registrar']",
                          "whois_age": "@item()?['domaininfo']?['whois_age']",
                          "ns_reputation_score": "@item()?['ns_reputation']?['ns_reputation_score']",
                          "listing_score": "@item()?['listing_score']"
                        }
                      }
                    }
                  }
                },
                "Upload_TI_Batch": {
                  "type": "ApiConnection",
                  "runAfter": {
                    "Build_TI_Indicators": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": {
                      "sourcesystem": "Silent Push - IOFA Export",
                      "indicators": "@body('Build_TI_Indicators')"
                    },
                    "path": "[concat('/V2/ThreatIntelligence/', reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), '2021-06-01').customerId, '/UploadIndicators/')]"
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "SilentPushCustomConnector": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SilentPushConnectionName'))]",
                "connectionName": "[variables('SilentPushConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/customApis/', parameters('CustomConnectorName'))]"
              },
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('MicrosoftSentinelConnectionName'))]",
                "connectionName": "[variables('MicrosoftSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', reference(resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace')), '2021-06-01', 'Full').location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('workspaceResourceId'), parameters('PlaybookName'), variables('_SentinelContributorRoleGuid'))]",
      "scope": "[variables('workspaceResourceId')]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('SentinelContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
