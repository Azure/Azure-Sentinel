[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "[[concat(parameters('innerWorkspace'), '/Microsoft.SecurityInsights/', 'MulesoftCloudhubAlertsOAuth2_CL', uniqueString(parameters('connectionAlias')))]",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "condition": "[[equals(parameters('cloudHubVersion'), '1.0')]",
    "properties": {
      "auth": {
        "type": "OAuth2",
        "ClientId": "[[parameters('clientId')]",
        "ClientSecret": "[[parameters('clientSecret')]",
        "GrantType": "client_credentials",
        "TokenEndpoint": "[[uri(parameters('mulesoftBaseUrl'), '/accounts/api/v2/oauth2/token')]",
        "TokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "request": {
        "apiEndpoint": "[[uri(parameters('mulesoftBaseUrl'), '/cloudhub/api/v2/alerts')]",
        "httpMethod": "GET",
        "rateLimitQPS": 15,
        "queryWindowInMin": 1440,
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "MS-Sentinel-CCP-Mulesoft",
          "X-ANYPNT-ENV-ID": "[[parameters('environmentId')]"
        },
        "queryParameters": {
          "offset": "0",
          "resource": "[[parameters('applicationName')]"
        }
      },
      "response": {
        "eventsJsonPaths": ["$[*]"],
        "format": "json"
      },
      "paging": {
        "pagingType": "Offset",
        "offsetParaName": "offset",
        "pageSize": 1000,
        "pageSizeParameterName": "limit"
      },
      "connectorDefinitionName": "MulesoftCloudhubConnector",
      "dataType": "MulesoftCloudhubAlerts_CL",
      "dcrConfig": {
        "streamName": "Custom-MulesoftCloudhubAlerts_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "connectionAlias": "[[parameters('connectionAlias')]",
        "streamType": "Alerts",
        "mulesoftBaseUrl": "[[parameters('mulesoftBaseUrl')]",
        "authenticationType": "OAuth2",
        "cloudHubVersion": "1.0",
        "environmentId": "[[parameters('environmentId')]"
      }
    }
  },
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "[[concat(parameters('innerWorkspace'), '/Microsoft.SecurityInsights/', 'MulesoftCloudhub2Alerts-', uniqueString(parameters('connectionAlias'), parameters('mulesoftBaseUrl'), parameters('organizationId'), parameters('environmentId'), parameters('clientId')))]",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "condition": "[[equals(parameters('cloudHubVersion'), '2.0')]",
    "properties": {
      "auth": {
        "type": "OAuth2",
        "ClientId": "[[parameters('clientId')]",
        "ClientSecret": "[[parameters('clientSecret')]",
        "GrantType": "client_credentials",
        "TokenEndpoint": "[[uri(parameters('mulesoftBaseUrl'), '/accounts/api/v2/oauth2/token')]",
        "TokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "TokenEndpointQueryParameters": {}
      },
      "request": {
        "apiEndpoint": "[[uri(parameters('mulesoftBaseUrl'), concat('/amc/application-manager/api/v2/organizations/', parameters('organizationId'), '/environments/', parameters('environmentId'), '/alerts'))]",
        "httpMethod": "GET",
        "rateLimitQPS": 1,
        "paginatedCallsPerSecond": 1,
        "queryWindowInMin": 1440,
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "MS-Sentinel-CCP-Mulesoft",
          "X-ANYPNT-ORG-ID": "[[parameters('organizationId')]",
          "X-ANYPNT-ENV-ID": "[[parameters('environmentId')]"
        },
        "queryParameters": {
          "offset": "0"
        }
      },
      "response": {
        "eventsJsonPaths": ["$.data[*]"],
        "format": "json"
      },
      "paging": {
        "pagingType": "Offset",
        "offsetParaName": "offset",
        "pageSize": 100,
        "pageSizeParameterName": "limit",
        "pagingInfoPlacement": "QueryString",
        "pagingQueryParamOnly": false
      },
      "connectorDefinitionName": "MulesoftCloudhubConnector",
      "dataType": "MulesoftCloudhubAlerts_CL",
      "dcrConfig": {
        "streamName": "Custom-MulesoftCloudhub2Alerts_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "connectionAlias": "[[parameters('connectionAlias')]",
        "streamType": "CloudHub2Alerts",
        "mulesoftBaseUrl": "[[parameters('mulesoftBaseUrl')]",
        "authenticationType": "OAuth2",
        "cloudHubVersion": "2.0",
        "organizationId": "[[parameters('organizationId')]",
        "environmentId": "[[parameters('environmentId')]"
      }
    }
  }
]
