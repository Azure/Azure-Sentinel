{
  "name": "QCryptonPQCEngineDCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-PQCEngine_CL": {
        "columns": [
          {
            "name": "TimeGenerated",
            "type": "datetime"
          },
          {
            "name": "InstanceId",
            "type": "string"
          },
          {
            "name": "Hostname",
            "type": "string"
          },
          {
            "name": "EventType",
            "type": "string"
          },
          {
            "name": "Algorithm",
            "type": "string"
          },
          {
            "name": "Operation",
            "type": "string"
          },
          {
            "name": "PeerGroups",
            "type": "string"
          },
          {
            "name": "NegotiatedGroup",
            "type": "string"
          },
          {
            "name": "CipherSuite",
            "type": "string"
          },
          {
            "name": "ClientClass",
            "type": "string"
          },
          {
            "name": "PQCOffered",
            "type": "int"
          },
          {
            "name": "PQCNegotiated",
            "type": "int"
          },
          {
            "name": "Success",
            "type": "int"
          },
          {
            "name": "Detail",
            "type": "string"
          },
          {
            "name": "Metadata",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-PQCEngine_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-PQCEngine_CL",
        "transformKql": "source | extend TimeGenerated = iff(isnull(TimeGenerated), now(), TimeGenerated) | project TimeGenerated, InstanceId, Hostname, EventType, Algorithm, Operation, PeerGroups, NegotiatedGroup, CipherSuite, ClientClass, PQCOffered, PQCNegotiated, Success, Detail, Metadata"
      }
    ]
  }
}
