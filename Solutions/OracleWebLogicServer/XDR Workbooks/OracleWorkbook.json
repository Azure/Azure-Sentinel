                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "OracleWebLogicServerEvent\r\n| where HttpStatusCode >= 400 and HttpStatusCode <= 499 \r\n| count",
                    "size": 3,
                    "title": "Total Client Errors",
                    "timeContext": {
                      "durationMs": 7776000000
