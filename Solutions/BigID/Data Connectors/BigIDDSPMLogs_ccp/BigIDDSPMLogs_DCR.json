[
  {
    "name": "BigIDDSPMCasesDCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
      "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
      "streamDeclarations": {
        "Custom-BigIDDSPMCases_CL": {
          "columns": [
            {
              "name": "dspmCase",
              "type": "dynamic"
            },
            {
              "name": "expand",
              "type": "dynamic"
            },
            {
              "name": "datasource",
              "type": "dynamic"
            },
            {
              "name": "classifiers",
              "type": "dynamic"
            },
            {
              "name": "bigidFqdn",
              "type": "string"
            }
          ]
        },
        "Custom-BigIDDSPMEvidence_CL": {
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "CaseId",
              "type": "string"
            },
            {
              "name": "DataSourceName",
              "type": "string"
            },
            {
              "name": "PolicyName",
              "type": "string"
            },
            {
              "name": "ObjectName",
              "type": "string"
            },
            {
              "name": "FullyQualifiedName",
              "type": "string"
            },
            {
              "name": "ContainerName",
              "type": "string"
            },
            {
              "name": "ObjectType",
              "type": "string"
            },
            {
              "name": "TotalPiiCount",
              "type": "int"
            },
            {
              "name": "ObjectSizeInBytes",
              "type": "long"
            },
            {
              "name": "Classifications",
              "type": "dynamic"
            },
            {
              "name": "ObjectOwner",
              "type": "dynamic"
            },
            {
              "name": "SharedWith",
              "type": "dynamic"
            },
            {
              "name": "LastScanned",
              "type": "string"
            }
          ]
        },
        "Custom-BigIDDSPMCaseClassifiers_CL": {
          "columns": [
            {
              "name": "dspmCase",
              "type": "dynamic"
            },
            {
              "name": "classifiers",
              "type": "dynamic"
            },
            {
              "name": "bigidFqdn",
              "type": "string"
            }
          ]
        }
      },
      "destinations": {
        "logAnalytics": [
          {
            "workspaceResourceId": "{{workspaceResourceId}}",
            "name": "clv2ws1"
          }
        ]
      },
      "dataFlows": [
        {
          "streams": [
            "Custom-BigIDDSPMCases_CL"
          ],
          "destinations": [
            "clv2ws1"
          ],
          "transformKql": "source | extend TimeGenerated = now(), [\"datasource\"] = pack(\"name\", [\"datasource\"].name, \"type\", [\"datasource\"].[\"type\"], \"vendor\", [\"datasource\"].vendor, \"environments\", [\"datasource\"].environments, \"systemId\", [\"datasource\"].systemId, \"cloudIdentifier\", [\"datasource\"].cloudIdentifier, \"cloudAccount\", [\"datasource\"].cloudAccount, \"cloudRegion\", [\"datasource\"].cloudRegion, \"location\", [\"datasource\"].location, \"security_tier\", [\"datasource\"].security_tier)",
          "outputStream": "Custom-BigIDDSPMCases_CL"
        },
        {
          "streams": [
            "Custom-BigIDDSPMEvidence_CL"
          ],
          "destinations": [
            "clv2ws1"
          ],
          "transformKql": "source",
          "outputStream": "Custom-BigIDDSPMEvidence_CL"
        },
        {
          "streams": [
            "Custom-BigIDDSPMCaseClassifiers_CL"
          ],
          "destinations": [
            "clv2ws1"
          ],
          "transformKql": "source | extend TimeGenerated = now(), CaseId = tostring(dspmCase.caseId) | project TimeGenerated, CaseId, classifiers",
          "outputStream": "Custom-BigIDDSPMCaseClassifiers_CL"
        }
      ]
    }
  }
]
