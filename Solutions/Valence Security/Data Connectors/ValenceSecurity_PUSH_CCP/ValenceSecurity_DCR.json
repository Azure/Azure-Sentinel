{
  "name": "Valence-DCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-ValenceAlerts": {
        "columns": [
          {
            "name": "vuid",
            "type": "string"
          },
          {
            "name": "connectorUids",
            "type": "dynamic"
          },
          {
            "name": "alertType",
            "type": "dynamic"
          },
          {
            "name": "creationTimestamp",
            "type": "long"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "summaryLine",
            "type": "string"
          },
          {
            "name": "events",
            "type": "dynamic"
          }
        ]
      },
      "Custom-ValenceAuditLogs": {
        "columns": [
          {
            "name": "actor",
            "type": "string"
          },
          {
            "name": "action",
            "type": "string"
          },
          {
            "name": "success",
            "type": "boolean"
          },
          {
            "name": "details",
            "type": "string"
          },
          {
            "name": "ipAddress",
            "type": "string"
          },
          {
            "name": "timeEpoch",
            "type": "long"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-ValenceAlerts"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend TimeGenerated = datetime(1970-01-01) + creationTimestamp * 1s, severity = tostring(alertType.severity), sentinelSeverity = iff(tostring(alertType.severity) == \"Critical\", \"High\", tostring(alertType.severity)), alertTypeName = tostring(alertType.name), platform = tostring(alertType.platform) | project TimeGenerated, vuid, alertType = alertTypeName, platform, severity, sentinelSeverity, status, summaryLine, creationTimestamp, connectorUids, events",
        "outputStream": "Custom-ValenceAlerts_CL"
      },
      {
        "streams": [
          "Custom-ValenceAuditLogs"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend TimeGenerated = datetime(1970-01-01) + timeEpoch * 1s",
        "outputStream": "Custom-ValenceAuditLogs_CL"
      }
    ]
  }
}
