            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeDevice | where ('*' in ({Site}) or SiteName in ({Site})) | summarize Devices = count() by IsOnlineText = iff(IsOnline, 'Online', 'Offline')",
              "size": 0,
              "title": "Online vs offline",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart"
            },
            "customWidth": "50",
