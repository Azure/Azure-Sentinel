{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## Claroty xDome\nOperational overview of Claroty xDome alerts, device inventory, vulnerabilities, OT activity and audit events. All tiles use the ASIM parsers and workspace functions installed with this solution (no direct _CL queries). Use the filters below to scope by time, site and device category."
      },
      "name": "title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "b0000000-0000-0000-0000-000000000001",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "value": { "durationMs": 604800000 },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 3600000 },
                { "durationMs": 86400000 },
                { "durationMs": 172800000 },
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 },
                { "durationMs": 7776000000 }
              ]
            }
          },
          {
            "id": "b0000000-0000-0000-0000-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "Site",
            "label": "Site",
            "type": 2,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "ClarotyXDomeDevice | where isnotempty(SiteName) | distinct SiteName | order by SiteName asc",
            "typeSettings": {
              "additionalResourceOptions": [ "value::all" ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "b0000000-0000-0000-0000-000000000003",
            "version": "KqlParameterItem/1.0",
            "name": "DeviceCategory",
            "label": "Device category",
            "type": 2,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "ClarotyXDomeDevice | where isnotempty(DeviceCategory) | distinct DeviceCategory | order by DeviceCategory asc",
            "typeSettings": {
              "additionalResourceOptions": [ "value::all" ],
              "selectAllValue": "*"
            },
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "b0000000-0000-0000-0000-000000000004",
            "version": "KqlParameterItem/1.0",
            "name": "selectedTab",
            "type": 1,
            "isHiddenWhenLocked": true,
            "value": "overview"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 11,
      "content": {
        "version": "LinksItem/1.0",
        "style": "tabs",
        "links": [
          { "id": "11111111-0000-0000-0000-000000000001", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "Overview", "subTarget": "overview", "style": "link" },
          { "id": "11111111-0000-0000-0000-000000000002", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "Alerts", "subTarget": "alerts", "style": "link" },
          { "id": "11111111-0000-0000-0000-000000000003", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "Devices", "subTarget": "devices", "style": "link" },
          { "id": "11111111-0000-0000-0000-000000000004", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "Vulnerabilities", "subTarget": "vulns", "style": "link" },
          { "id": "11111111-0000-0000-0000-000000000005", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "OT Activity", "subTarget": "otactivity", "style": "link" },
          { "id": "11111111-0000-0000-0000-000000000006", "cellValue": "selectedTab", "linkTarget": "parameter", "linkLabel": "Audit", "subTarget": "audit", "style": "link" }
        ]
      },
      "name": "tabs"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true (ClarotyXDomeAlert | summarize Value = count() | extend Metric = 'Total Alerts'), (ClarotyXDomeAlert | summarize Value = sum(UnresolvedDevicesCount) | extend Metric = 'Unresolved Device-Alerts'), (ClarotyXDomeDevice | summarize Value = count() | extend Metric = 'Devices'), (ClarotyXDomeVulnerability | where IsKnownExploited == true | summarize Value = count() | extend Metric = 'Known-Exploited Vulns'), (ASimNetworkSessionClarotyXDome | summarize Value = count() | extend Metric = 'OT Events') | project Metric, Value",
              "size": 3,
              "title": "Summary",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": { "columnMatch": "Metric", "formatter": 1 },
                "leftContent": { "columnMatch": "Value", "formatter": 12, "formatOptions": { "palette": "auto" } },
                "showBorder": true
              }
            },
            "name": "overview-tiles"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeAlert | summarize Alerts = count() by bin(TimeGenerated, 1h) | order by TimeGenerated asc",
              "size": 0,
              "title": "Alert volume over time",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "customWidth": "50",
            "name": "overview-trend"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeDevice | where ('*' in ({Site}) or SiteName in ({Site})) and ('*' in ({DeviceCategory}) or DeviceCategory in ({DeviceCategory})) | summarize Devices = count() by RiskLevel",
              "size": 0,
              "title": "Devices by risk level",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart"
            },
            "customWidth": "50",
            "name": "overview-risk"
          }
        ]
      },
      "conditionalVisibility": { "parameterName": "selectedTab", "comparison": "isEqualTo", "value": "overview" },
      "name": "group-overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeAlert | summarize Alerts = count() by bin(TimeGenerated, 1h), AlertCategory | order by TimeGenerated asc",
              "size": 0,
              "title": "Alerts over time by category",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "timechart"
            },
            "name": "alerts-timechart"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeAlert | summarize Count = count() by Status",
              "size": 0,
              "title": "Alerts by status",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart"
            },
            "customWidth": "50",
            "name": "alerts-status"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeAlert | summarize Count = count() by AlertTypeName | top 10 by Count desc",
              "size": 0,
              "title": "Top alert types",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart"
            },
            "customWidth": "50",
            "name": "alerts-types"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ASimAlertEventClarotyXDome | where isnotempty(AttackTechniques) | mv-expand tech = split(AttackTechniques, ', ') to typeof(string) | where isnotempty(tech) | summarize Count = count() by tostring(tech) | top 15 by Count desc",
              "size": 0,
              "title": "Top MITRE ATT&CK techniques",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart"
            },
            "customWidth": "50",
            "name": "alerts-mitre"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ASimAlertEventClarotyXDome | summarize Alerts = count() by DvcHostname, DvcIpAddr, DeviceCategory, DeviceSiteName | top 15 by Alerts desc",
              "size": 0,
              "title": "Top affected devices",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table"
            },
            "customWidth": "50",
            "name": "alerts-topdevices"
          }
        ]
      },
      "conditionalVisibility": { "parameterName": "selectedTab", "comparison": "isEqualTo", "value": "alerts" },
      "name": "group-alerts"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeDevice | where ('*' in ({Site}) or SiteName in ({Site})) and ('*' in ({DeviceCategory}) or DeviceCategory in ({DeviceCategory})) | summarize Devices = count() by DeviceCategory | order by Devices desc",
              "size": 0,
              "title": "Devices by category",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
