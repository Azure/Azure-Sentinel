          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeDevice | where ('*' in ({Site}) or SiteName in ({Site})) | summarize Devices = count() by PurdueLevel | order by PurdueLevel asc",
              "size": 0,
              "title": "Devices by Purdue level",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
