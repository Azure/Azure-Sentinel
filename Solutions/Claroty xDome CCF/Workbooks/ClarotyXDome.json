            "customWidth": "70",
            "name": "vulns-cvss"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeVulnerability | top 15 by AffectedDevicesCount desc | project Name, CvssScore, CvssSeverity, EpssScore, IsKnownExploited, AffectedDevicesCount, AffectedOTDevicesCount",
              "size": 0,
              "title": "Top vulnerabilities by affected devices",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table"
            },
            "customWidth": "50",
            "name": "vulns-topcve"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ClarotyXDomeDeviceVulnerability | where ('*' in ({Site}) or DeviceSiteName in ({Site})) | summarize Vulns = count(), KnownExploited = countif(VulnerabilityIsKnownExploited == true) by DeviceUid, DeviceCategory, DeviceSiteName | top 20 by Vulns desc",
              "size": 0,
              "title": "Most vulnerable devices",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table"
