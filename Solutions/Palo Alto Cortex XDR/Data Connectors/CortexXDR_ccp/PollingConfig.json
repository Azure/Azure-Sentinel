    {
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "apiVersion": "2023-02-01-preview",
        "name": "[[concat(parameters('innerWorkspace'), '/Microsoft.SecurityInsights/', 'CortexXdrEndpoints', uniqueString(parameters('friendlyName')))]",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "properties": {
            "auth": {
                "type": "APIKey",
                "ApiKey": "[[parameters('apiToken')]",
                "ApiKeyName": "Authorization"
            },
            "shouldJoinNestedData": true,
            "joinedDataStepName": "Summary",
            "request": {
                "apiEndpoint": "[[concat(parameters('apiUrl'), '/public_api/v1/endpoints/get_endpoints')]",
                "httpMethod": "POST",
                "rateLimitQPS": 1,
                "queryWindowInMin": 60,
                "queryTimeFormat": "UnixTimestampInMills",
                "retryCount": 3,
                "timeoutInSeconds": 20,
                "headers": {
                    "Accept": "application/json",
                    "User-Agent": "Scuba",
                    "x-xdr-auth-id": "[[parameters('apiId')]"
                },
                "queryParametersTemplate": "{}"
            },
            "response": {
                "eventsJsonPaths": [
                    "$.reply[*]"
                ],
                "format": "json"
            },
            "stepInfo": {
                "stepType": "Nested",
                "nextSteps": [
                    {
                        "stepId": "getEndpoint",
                        "stepPlaceholdersParsingKql": "source | project record = parse_json(data) | extend record = iff(gettype(record.reply) == 'array', record.reply, record) | extend records = iff(gettype(record) == 'array', record, pack_array(record)) | mvexpand records | where isnotempty(tostring(records.agent_id)) | project endpointIds = tostring(pack_array(tostring(records.agent_id)))"
                    }
                ]
            },
            "stepCollectorConfigs": {
                "getEndpoint": {
                    "shouldJoinNestedData": true,
                    "joinedDataStepName": "Detail",
                    "request": {
                        "apiEndpoint": "[[concat(parameters('apiUrl'), '/public_api/v1/endpoints/get_endpoint')]",
                        "httpMethod": "POST",
                        "rateLimitQPS": 1,
                        "rateLimitConfig": {
                            "evaluation": {
                                "checkMode": "OnlyWhen429"
                            },
                            "extraction": {
                                "source": "DefaultHeaders"
                            },
                            "retryStrategy": {
                                "useResetOrRetryAfterHeaders": true
                            }
                        },
                        "queryWindowInMin": 5,
                        "retryCount": 3,
                        "timeoutInSeconds": 20,
                        "isPostPayloadJson": true,
                        "headers": {
                            "Accept": "application/json",
                            "User-Agent": "Scuba",
                            "Content-Type": "application/json",
                            "x-xdr-auth-id": "[[parameters('apiId')]"
                        },
                        "queryParametersTemplate": "{\"request_data\":{\"filters\":[{\"field\":\"endpoint_id_list\",\"operator\":\"in\",\"value\":$endpointIds$}],\"search_from\":0,\"search_to\":100}}"
                    },
                    "response": {
                        "eventsJsonPaths": [
                            "$.reply.endpoints"
                        ],
                        "format": "json"
                    }
                }
            },
            "connectorDefinitionName": "CortexXDRDataConnector",
            "dataType": "PaloAltoCortexXDR_Endpoints_CL",
            "dcrConfig": {
                "streamName": "Custom-CortexXdrStreamEndpoint",
                "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
                "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]"
            },
            "addOnAttributes": {
                "friendlyName": "[[parameters('friendlyName')]"
            }
        }
    },
