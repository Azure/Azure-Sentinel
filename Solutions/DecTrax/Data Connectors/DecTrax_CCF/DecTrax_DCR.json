[
  {
    "name": "DecTraxDCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
      "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
      "streamDeclarations": {
        "Custom-DECTRAX": {
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "SourceIP_s",
              "type": "string"
            },
            {
              "name": "DestinationPort_d",
              "type": "real"
            },
            {
              "name": "Protocol_s",
              "type": "string"
            },
            {
              "name": "Signature_s",
              "type": "string"
            },
            {
              "name": "Severity_s",
              "type": "string"
            },
            {
              "name": "Severity_d",
              "type": "real"
            },
            {
              "name": "SourceCountry_s",
              "type": "string"
            },
            {
              "name": "SourceCity_s",
              "type": "string"
            },
            {
              "name": "NodeID_s",
              "type": "string"
            },
            {
              "name": "URL_s",
              "type": "string"
            },
            {
              "name": "Method_s",
              "type": "string"
            },
            {
              "name": "Payload_s",
              "type": "string"
            },
            {
              "name": "Platform_s",
              "type": "string"
            },
            {
              "name": "RawEvent_s",
              "type": "string"
            }
          ]
        }
      },
      "destinations": {
        "logAnalytics": [
          {
            "workspaceResourceId": "{{workspaceResourceId}}",
            "name": "clv2loganalytics"
          }
        ]
      },
      "dataFlows": [
        {
          "streams": [
            "Custom-DECTRAX"
          ],
          "destinations": [
            "clv2loganalytics"
          ],
          "transformKql": "source",
          "outputStream": "Custom-DECTRAXThreats_CL"
        }
      ]
    }
  }
]