{
  "name": "DecTraxDefinition",
  "apiVersion": "2022-09-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "{{location}}",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "DecTraxDefinition",
      "title": "DECTRAX Active Deception & Threat Intelligence (via Codeless Connector Framework)",
      "publisher": "DECTRAX Inc.",
      "descriptionMarkdown": "The DECTRAX data connector provides automated ingestion of active deception honeypot telemetry, breach indicators, and zero-trust gateway blocks into Microsoft Sentinel via the Codeless Connector Framework (CCF).\n\nConfigure your DECTRAX API endpoint and API Bearer Token to begin streaming telemetry.",
      "graphQueriesTableName": "DECTRAXThreats_CL",
      "graphQueries": [
        {
          "metricName": "Total threat events received",
          "legend": "DECTRAX telemetry",
          "baseQuery": "{{graphQueriesTableName}}"
        }
      ],
      "sampleQueries": [
        {
          "description": "High Severity DECTRAX Threats",
          "query": "{{graphQueriesTableName}}\n | where toint(Severity_d) >= 7 or toint(Severity_s) >= 7\n | take 10"
        }
      ],
      "dataTypes": [
        {
          "name": "{{graphQueriesTableName}}",
          "lastDataReceivedQuery": "{{graphQueriesTableName}}\n|summarize Time = max(TimeGenerated)\n|where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "status": 1,
        "isPreview": false
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and Write permissions are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "read": true,
              "write": true,
              "delete": true,
              "action": false
            }
          }
        ],
        "customs": [
          {
            "name": "Obtain DECTRAX API Bearer Token",
            "description": "Log in to your DECTRAX Console at [https://dectrax.com](https://dectrax.com), navigate to Settings > API Keys, and generate an API Bearer token for Sentinel ingestion."
          }
        ]
      },
      "instructionSteps": [
        {
          "title": "Configure DECTRAX API Poller",
          "description": "Provide your DECTRAX API Endpoint URL and API Bearer Token to connect the data stream.",
          "instructions": [
            {
              "parameters": {
                "label": "DECTRAX API Endpoint URL",
                "type": "text",
                "name": "apiEndpoint",
                "defaultValue": "https://api.dectrax.com/api/attacks/recent",
                "validations": {
                  "required": true
                }
              },
              "type": "Textbox"
            },
            {
              "parameters": {
                "label": "DECTRAX API Bearer Token",
                "type": "password",
                "name": "apiKey",
                "validations": {
                  "required": true
                }
              },
              "type": "Textbox"
            },
            {
              "parameters": {
                "label": "toggle",
                "name": "toggle"
              },
              "type": "ConnectionToggleButton"
            }
          ]
        }
      ],
      "isConnectivityCriteriasMatchSome": false
    }
  },
  "dependsOn": null
}