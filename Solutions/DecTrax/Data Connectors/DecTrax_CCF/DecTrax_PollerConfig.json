[
  {
    "name": "DecTraxRestApiPoller",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "DecTraxDefinition",
      "dataType": "DECTRAXThreats_CL",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-DECTRAX"
      },
      "auth": {
        "type": "APIKey",
        "apiKeyIdentifier": "Authorization",
        "apiKeyName": "Authorization",
        "apiKeyValue": "Bearer {{apiKey}}"
      },
      "request": {
        "apiEndpoint": "{{apiEndpoint}}",
        "httpMethod": "Get",
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Azure-Sentinel-DECTRAX-CCF/1.0"
        },
        "queryParameters": {
          "limit": "100",
          "format": "json"
        }
      },
      "paging": {
        "pagingType": "None"
      },
      "response": {
        "eventsJsonPaths": [
          "$.attacks[*]"
        ]
      }
    }
  }
]