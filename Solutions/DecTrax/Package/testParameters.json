{
  "location": {
    "type": "string",
    "minLength": 1,
    "defaultValue": "[resourceGroup().location]",
    "metadata": {
      "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`. We instead use the `workspace-location` which is derived from the LA workspace"
    }
  },
  "workspace-location": {
    "type": "string",
    "defaultValue": "",
    "metadata": {
      "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
    }
  },
  "workspace": {
    "defaultValue": "testWorkspace",
    "type": "string",
    "metadata": {
      "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
    }
  },
  "decTraxApiEndpoint": {
    "type": "string",
    "defaultValue": "https://api.dectrax.com/api/attacks/recent"
  },
  "decTraxApiKey": {
    "type": "securestring",
    "defaultValue": "dectrax-dummy-token-for-ttk-test-validation"
  },
  "enableDataConnector": {
    "type": "bool",
    "defaultValue": true
  },
  "enableAnalyticRules": {
    "type": "bool",
    "defaultValue": true
  },
  "enableWorkbooks": {
    "type": "bool",
    "defaultValue": true
  },
  "enableHuntingQueries": {
    "type": "bool",
    "defaultValue": true
  }
}