    {
      "type": 1,
      "content": {
        "json": "**NOTE**: This workbook uses the Cisco Duo CCF tables **DuoAuthentication_CL**, **DuoActivity_CL**, and **DuoTelephony_CL**. Enable the corresponding CCF data connectors to populate each data source."
      },
      "name": "text - 8"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "cd8447d9-b096-4673-92d8-2a1e8291a125",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "description": "Sets the time name for analysis",
            "value": {
              "durationMs": 7776000000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 900000
                },
