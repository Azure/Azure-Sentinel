{
    "name": "DTAttacksV3DCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "streamDeclarations": {
            "Custom-DynatraceAttacksV3": {
                "columns": [
                    {
                        "name": "timestamp",
                        "type": "datetime"
                    },
                    {
                        "name": "event_provider",
                        "type": "string"
                    },
                    {
                        "name": "product_vendor",
                        "type": "string"
                    },
                    {
                        "name": "product_name",
                        "type": "string"
                    },
                    {
                        "name": "event_id",
                        "type": "string"
                    },
                    {
                        "name": "event_type",
                        "type": "string"
                    },
                    {
                        "name": "dt_security_risk_level",
                        "type": "string"
                    },
                    {
                        "name": "dt_security_risk_score",
                        "type": "real"
                    },
                    {
                        "name": "finding_severity",
                        "type": "string"
                    },
                    {
                        "name": "finding_score",
                        "type": "real"
                    },
                    {
                        "name": "finding_time_created",
                        "type": "datetime"
                    },
                    {
                        "name": "finding_id",
                        "type": "string"
                    },
                    {
                        "name": "finding_type",
                        "type": "string"
                    },
                    {
                        "name": "finding_title",
                        "type": "string"
                    },
                    {
                        "name": "finding_description",
                        "type": "string"
                    },
                    {
                        "name": "object_id",
                        "type": "string"
                    },
                    {
                        "name": "object_name",
                        "type": "string"
                    },
                    {
                        "name": "object_type",
                        "type": "string"
                    },
                    {
                        "name": "dt_smartscape_source_type",
                        "type": "string"
                    },
                    {
                        "name": "dt_smartscape_source_id",
                        "type": "string"
                    },
                    {
                        "name": "actor_ips",
                        "type": "dynamic"
                    },
                    {
                        "name": "actor_geo_country_name",
                        "type": "string"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-DynatraceAttacksV3"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = finding_time_created",
                "outputStream": "Custom-DynatraceAttacksV3_CL"
            }
        ],
        "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
    }
}
