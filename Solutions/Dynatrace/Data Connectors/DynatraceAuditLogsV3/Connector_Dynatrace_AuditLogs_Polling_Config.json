{
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2021-10-01-preview",
    "name": "DTAuditLogsV3",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
        "connectorDefinitionName": "DTAuditLogsV3CCPDefinition",
        "dataType": "DynatraceAuditLogsV3_CL",
        "auth": {
            "type": "APIKey",
            "ApiKey": "[[parameters('dynatracePlatformToken')]",
            "ApiKeyIdentifier": "Bearer",
            "ApiKeyName": "Authorization"
        },
        "request": {
            "apiEndpoint": "https://{{dynatraceEnvironmentUrl}}/platform/storage/query/v1/query:execute",
            "httpMethod": "Post",
            "pollingFrequency": 15,
            "rateLimitQPS": 2,
            "retryCount": 3,
            "timeoutInSeconds": 120,
            "headers": {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": "dynatrace-microsoft-sentinel/3.0.4/connectors/auditlogs"
            },
            "isPostPayloadJson": true,
            "queryParametersTemplate": "{\"query\": \"fetch dt.system.events, from:now()-15m\\n| filter event.kind == \\\"AUDIT_EVENT\\\"\\n| fields timestamp, event.id, event.type, event.kind, category, entity.id, environment.id, user, user.type, user.origin, success, patch\\n| fieldsRename\\n    event_id = `event.id`,\\n    event_type = `event.type`,\\n    event_kind = `event.kind`,\\n    entity_id = `entity.id`,\\n    environment_id = `environment.id`,\\n    user_type = `user.type`,\\n    user_origin = `user.origin`\", \"maxResultRecords\": 100000, \"requestTimeoutMilliseconds\": 30000}"
        },
        "response": {
            "eventsJsonPaths": [
                "$.result.records"
            ]
        },
        "dcrConfig": {
            "streamName": "Custom-DynatraceAuditLogsV3",
            "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
            "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
        },
        "paging": {
            "pagingType": "NextPageToken",
            "pagingQueryParamOnly": true,
            "nextPageTokenJsonPath": "$.result.nextPageKey",
            "nextPageParaName": "nextPageKey"
        }
    }
}
