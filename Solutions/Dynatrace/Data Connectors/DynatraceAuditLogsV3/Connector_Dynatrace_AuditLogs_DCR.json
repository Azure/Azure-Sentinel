{
    "name": "DTAuditLogsV3DCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "streamDeclarations": {
            "Custom-DynatraceAuditLogsV3": {
                "columns": [
                    {
                        "name": "timestamp",
                        "type": "datetime"
                    },
                    {
                        "name": "event_id",
                        "type": "string"
                    },
                    {
                        "name": "event_type",
                        "type": "string"
                    },
                    {
                        "name": "event_kind",
                        "type": "string"
                    },
                    {
                        "name": "category",
                        "type": "string"
                    },
                    {
                        "name": "entity_id",
                        "type": "string"
                    },
                    {
                        "name": "environment_id",
                        "type": "string"
                    },
                    {
                        "name": "user",
                        "type": "string"
                    },
                    {
                        "name": "user_type",
                        "type": "string"
                    },
                    {
                        "name": "user_origin",
                        "type": "string"
                    },
                    {
                        "name": "success",
                        "type": "boolean"
                    },
                    {
                        "name": "patch",
                        "type": "dynamic"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-DynatraceAuditLogsV3"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = timestamp | project-away timestamp",
                "outputStream": "Custom-DynatraceAuditLogsV3_CL"
            }
        ],
        "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
    }
}
