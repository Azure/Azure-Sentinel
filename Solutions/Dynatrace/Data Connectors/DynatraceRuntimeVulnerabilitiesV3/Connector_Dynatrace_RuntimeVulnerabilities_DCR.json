{
    "name": "DTSecProbV3DCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "streamDeclarations": {
            "Custom-DynatraceSecurityProblemsV3": {
                "columns": [
                    {
                        "name": "vulnerability_display_id",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_stack",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_type",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_cvss_base_score",
                        "type": "real"
                    },
                    {
                        "name": "vulnerability_title",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_resolution_change_date",
                        "type": "datetime"
                    },
                    {
                        "name": "vulnerability_first_seen",
                        "type": "datetime"
                    },
                    {
                        "name": "vulnerability_references_cve",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_risk_score",
                        "type": "real"
                    },
                    {
                        "name": "vulnerability_risk_level",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_resolution_status",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_mute_status",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_vulnerable_function_status",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_exposure_status",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_exploit_status",
                        "type": "string"
                    },
                    {
                        "name": "vulnerability_data_assets_status",
                        "type": "string"
                    },
                    {
                        "name": "affected_entity_ids",
                        "type": "dynamic"
                    },
                    {
                        "name": "affected_entity_names",
                        "type": "dynamic"
                    },
                    {
                        "name": "affected_entity_vulnerable_component_names",
                        "type": "dynamic"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-DynatraceSecurityProblemsV3"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = now() | project-rename securityProblemTitle = vulnerability_title",
                "outputStream": "Custom-DynatraceSecurityProblemsV3_CL"
            }
        ],
        "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
    }
}
