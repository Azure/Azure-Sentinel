{
    "name": "DTProblemsV3DCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "streamDeclarations": {
            "Custom-DynatraceProblemsV3": {
                "columns": [
                    {
                        "name": "event_start",
                        "type": "datetime"
                    },
                    {
                        "name": "display_id",
                        "type": "string"
                    },
                    {
                        "name": "event_name",
                        "type": "string"
                    },
                    {
                        "name": "event_description",
                        "type": "string"
                    },
                    {
                        "name": "event_status",
                        "type": "string"
                    },
                    {
                        "name": "event_category",
                        "type": "string"
                    },
                    {
                        "name": "event_end",
                        "type": "datetime"
                    },
                    {
                        "name": "root_cause_entity_id",
                        "type": "string"
                    },
                    {
                        "name": "root_cause_entity_name",
                        "type": "string"
                    },
                    {
                        "name": "duration",
                        "type": "long"
                    },
                    {
                        "name": "affected_entities_count",
                        "type": "long"
                    },
                    {
                        "name": "affected_entity_ids",
                        "type": "dynamic"
                    },
                    {
                        "name": "affected_entity_names",
                        "type": "dynamic"
                    },
                    {
                        "name": "smartscape_affected_entity_ids",
                        "type": "dynamic"
                    },
                    {
                        "name": "affected_users_count",
                        "type": "long"
                    },
                    {
                        "name": "problem_id",
                        "type": "string"
                    },
                    {
                        "name": "dt_davis_impact_level",
                        "type": "string"
                    },
                    {
                        "name": "dt_davis_mute_status",
                        "type": "string"
                    },
                    {
                        "name": "dt_davis_mute_user",
                        "type": "string"
                    },
                    {
                        "name": "entity_tags",
                        "type": "dynamic"
                    },
                    {
                        "name": "event_count",
                        "type": "long"
                    },
                    {
                        "name": "event_severity",
                        "type": "string"
                    },
                    {
                        "name": "maintenance_is_under_maintenance",
                        "type": "boolean"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-DynatraceProblemsV3"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = event_start | project-away event_start",
                "outputStream": "Custom-DynatraceProblemsV3_CL"
            }
        ],
        "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
    }
}
