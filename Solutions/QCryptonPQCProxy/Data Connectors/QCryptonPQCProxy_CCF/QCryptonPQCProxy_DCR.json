{
  "name": "QCryptonPQCProxyDCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-PQCProxy_CL": {
        "columns": [
          { "name": "TimeGenerated", "type": "datetime" },
          { "name": "ProxyInstanceId", "type": "string" },
          { "name": "ProxyHost", "type": "string" },
          { "name": "EventType", "type": "string" },
          { "name": "ClientIP", "type": "string" },
          { "name": "NegotiatedGroup", "type": "string" },
          { "name": "OfferedGroups", "type": "string" },
          { "name": "CipherSuite", "type": "string" },
          { "name": "HttpStatus", "type": "int" },
          { "name": "RequestLatencyMs", "type": "real" },
          { "name": "UpstreamTarget", "type": "string" },
          { "name": "QuantumPosture", "type": "string" },
          { "name": "CertPath", "type": "string" },
          { "name": "CertExpiryDays", "type": "real" },
          { "name": "ErrorMessage", "type": "string" },
          { "name": "Metadata", "type": "string" }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": ["Custom-PQCProxy_CL"],
        "destinations": ["clv2ws1"],
        "outputStream": "Custom-PQCProxy_CL",
        "transformKql": "source | extend TimeGenerated = iff(isnull(TimeGenerated), now(), TimeGenerated) | project TimeGenerated, ProxyInstanceId, ProxyHost, EventType, ClientIP, NegotiatedGroup, OfferedGroups, CipherSuite, HttpStatus, RequestLatencyMs, UpstreamTarget, QuantumPosture, CertPath, CertExpiryDays, ErrorMessage, Metadata"
      }
    ]
  }
}
