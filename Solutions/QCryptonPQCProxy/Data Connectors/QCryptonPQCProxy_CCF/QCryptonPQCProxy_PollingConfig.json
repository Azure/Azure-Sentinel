{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "apiVersion": "2025-03-01",
  "name": "QCryptonPQCProxyCCP",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "auth": {
      "type": "APIKey",
      "ApiKey": "[[parameters('apiKey')]",
      "ApiKeyName": "X-API-Key",
      "IsApiKeyInPostPayload": false
    },
    "request": {
      "apiEndpoint": "[[concat(parameters('apiServerUrl'),'/v1/proxy/telemetry')]",
      "httpMethod": "GET",
      "rateLimitQPS": 2,
      "queryWindowInMin": 60,
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
      "retryCount": 3,
      "timeoutInSeconds": 120,
      "headers": {
        "Accept": "application/json",
        "User-Agent": "MicrosoftSentinel-QCryptonPQCProxyCCP"
      },
      "queryParameters": {
        "since": "{_QueryWindowStartTime}",
        "until": "{_QueryWindowEndTime}"
      }
    },
    "response": {
      "eventsJsonPaths": ["$.events"],
      "format": "json"
    },
    "paging": {
      "pagingType": "NextPageToken",
      "nextPageTokenJsonPath": "$.nextPageToken",
      "nextPageParaName": "pageToken"
    },
    "connectorDefinitionName": "QCryptonPQCProxyCCPDefinition",
    "dataType": "PQCProxy_CL",
    "dcrConfig": {
      "streamName": "Custom-PQCProxy_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    }
  }
}
