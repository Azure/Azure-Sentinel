[
  {
    "name": "CyoloActivityConnector",
    "apiVersion": "2023-04-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "CyoloActivityCCFDefinition",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-CyoloActivityLog"
      },
      "dataType": "CyoloActivity_CL",
      "auth": {
        "type": "Basic",
        "UserName": "[[parameters('username')]",
        "Password": "[[parameters('password')]"
      },
      "request": {
        "apiEndpoint": "[[concat(if(startsWith(toLower(trim(parameters('apiUrl'))), 'http'), '', 'https://'), if(endsWith(trim(parameters('apiUrl')), '/'), substring(trim(parameters('apiUrl')), 0, sub(length(trim(parameters('apiUrl'))), 1)), trim(parameters('apiUrl'))), '/v1/activity_log')]",
        "rateLimitQPS": 10,
        "queryWindowInMin": 5,
        "httpMethod": "Get",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json"
        },
        "queryParameters": {
          "timestamp": "range~{_QueryWindowStartTime},{_QueryWindowEndTime}",
          "_sort": "+timestamp",
          "_count": 10000
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.data[*]"
        ]
      },
      "isActive": true
    }
  }
]
