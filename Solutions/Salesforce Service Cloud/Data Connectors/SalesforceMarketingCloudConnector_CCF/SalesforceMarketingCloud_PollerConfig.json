[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2024-09-01",
    "name": "[[concat('parameters('workspace')', '/Microsoft.SecurityInsights/','SalesforceMarketingCloudAuditEvents' , uniqueString(parameters('friendlyName')) )]",
    "location": "[parameters('workspace-location')]",
    "kind": "RestApiPoller",
    "properties": {
      "auth": {
        "type": "OAuth2",
        "ClientId": "[[parameters('clientId')]",
        "ClientSecret": "[[parameters('clientSecret')]",
        "GrantType": "client_credentials",
        "TokenEndpoint": "[[concat(parameters('authBaseUrl'), '/v2/token')]",
        "TokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "request": {
        "apiEndpoint": "[[concat(parameters('salesforceBaseUrl'), '/data/v1/audit/auditEvents')]",
        "httpMethod": "GET",
        "rateLimitQPS": 5,
        "paginatedCallsPerSecond": 5.0,
        "queryWindowInMin": "[[int(parameters('queryWindow')[0])]",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "queryParameters": {
          "startdate": "{_QueryWindowStartTime}",
          "enddate": "{_QueryWindowEndTime}",
          "$orderBy": "createdDate ASC"
        }
      },
      "response": {
        "eventsJsonPaths": ["$.items[*]"],
        "format": "json"
      },
      "paging": {
        "pagingType": "CountBasedPaging",
        "pageNumberParaName": "$page",
        "zeroBasedIndexing": false,
        "pageNumberJsonPath": "$.page",
        "pageSize": 50
      },
      "connectorDefinitionName": "SalesforceMktCloudConnector",
      "dataType": "SalesforceMarketingCloudAuditEvents",
      "dcrConfig": {
        "streamName": "Custom-SalesforceMarketingCloudAuditEvents_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "friendlyName": "[[parameters('friendlyName')]",
        "packageType": "Enhanced",
        "apiUrl": "[[parameters('salesforceBaseUrl')]",
        "dataType": "SalesforceMarketingCloudAuditEvents",
        "logType": "AuditEvents",
        "restApiBaseUrl": "[[parameters('salesforceBaseUrl')]"
      }
    },
    "condition": "[[and(contains(parameters('selectedDataTypes'), 'AuditEvents'), equals(parameters('packageType'), 'enhanced'))]"
  },
