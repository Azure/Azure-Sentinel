    "dataFlows": [
      {
        "streams": [
          "Custom-SalesforceAuditTrailV2_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-SalesforceAuditTrailV2_CL",
        "transformKql": "source  | project TimeGenerated=iff(isnull(['CreatedDate']),now(),todatetime(['CreatedDate'])),Id=tostring(Id),Action=tostring(Action),Section=tostring(Section),Display=tostring(Display),CreatedDate=todatetime(CreatedDate),CreatedById=tostring(CreatedById),CreatedByName=tostring(CreatedBy.CreatedBy_Name),CreatedByEmail=tostring(CreatedBy.CreatedBy_Email),CreatedByUsername=tostring(CreatedBy.CreatedBy_Username),CreatedByContext=tostring(CreatedByContext),CreatedByIssuer=tostring(CreatedByIssuer),DelegateUser=tostring(DelegateUser),SalesforceDomain=tostring(apiUrl)"
      },
      {
        "streams": [
          "Custom-SalesforceLoginHistoryV2_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-SalesforceLoginHistoryV2_CL",
        "transformKql": "source  | project TimeGenerated=iff(isnull(['LoginTime']),now(),todatetime(['LoginTime'])),ApiType=tostring(ApiType),ApiVersion=tostring(ApiVersion),Application=tostring(Application),AuthMethodReference=tostring(AuthMethodReference),AuthenticationServiceId=tostring(AuthenticationServiceId),Browser=tostring(Browser),CipherSuite=tostring(CipherSuite),ClientVersion=tostring(ClientVersion),CountryIso=tostring(CountryIso),ForwardedForIp=tostring(ForwardedForIp),LoginGeoId=tostring(LoginGeoId),LoginSubType=tostring(LoginSubType),LoginTime=todatetime(LoginTime),LoginType=tostring(LoginType),LoginUrl=tostring(LoginUrl),NetworkId=tostring(NetworkId),OptionsIsGet=tobool(OptionsIsGet),OptionsIsPost=tobool(OptionsIsPost),Platform=tostring(Platform),SourceIp=tostring(SourceIp),Status=tostring(Status),TlsProtocol=tostring(TlsProtocol),UserId=tostring(UserId),SalesforceDomain=tostring(apiUrl)"
      }
    ]
  }
