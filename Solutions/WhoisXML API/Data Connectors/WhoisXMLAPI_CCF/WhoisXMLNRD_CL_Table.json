{
  "name": "WhoisXMLNRD_CL",
  "type": "Microsoft.OperationalInsights/workspaces/tables",
  "apiVersion": "2022-10-01",
  "location": "{{location}}",
  "properties": {
    "schema": {
      "name": "WhoisXMLNRD_CL",
      "columns": [
        { "name": "TimeGenerated", "type": "datetime", "description": "Time the row was ingested." },
        { "name": "DomainName", "type": "string", "description": "Newly registered domain, lower-case." },
        { "name": "Reason", "type": "string", "description": "WhoisXML API NRD 2.0 event reason (added)." },
        { "name": "FeedDate", "type": "datetime", "description": "Data day of the WhoisXML API NRD 2.0 file." },
        { "name": "Tier", "type": "string", "description": "NRD 2.0 subscription tier the row was read from." }
      ]
    },
    "retentionInDays": 90,
    "totalRetentionInDays": 90
  }
}
