[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2023-02-01-preview",
    "name": "WhoisXMLNRDPoller",
    "kind": "RestApiPoller",
    "condition": "[[contains(parameters('feedTypes'), 'nrd')]",
    "properties": {
      "connectorDefinitionName": "WhoisXMLAPIFeeds",
      "dataType": "WhoisXMLNRD_CL",
      "dcrConfig": {
        "streamName": "Custom-WhoisXMLNRD",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": { "type": "APIKey", "ApiKey": "{{apiKey}}", "ApiKeyName": "X-Api-Key" },
      "request": {
        "apiEndpoint": "https://feeds-api.whoisxmlapi.com/v1/feeds/nrd",
        "httpMethod": "GET",
        "queryWindowInMin": 60,
        "queryWindowDelayInMin": 10,
        "queryTimeFormat": "UnixTimestamp",
        "startTimeAttributeName": "from",
        "endTimeAttributeName": "to",
        "queryParameters": { "tier": "[[parameters('nrdTier')[0]]", "reasons": "added" },
        "rateLimitQPS": 1,
        "paginatedCallsPerSecond": 5,
        "rateLimitConfig": {
          "evaluation": { "checkMode": "OnlyWhen429" },
          "extraction": { "source": "DefaultHeaders" },
          "retryStrategy": { "useResetOrRetryAfterHeaders": true }
        },
        "retryCount": 3,
        "timeoutInSeconds": 120,
        "headers": { "Accept": "application/json", "User-Agent": "WhoisXMLAPI-Sentinel-CCF/1.0" }
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.next",
        "hasNextFlagJsonPath": "$.hasMore",
        "nextPageParaName": "cursor",
        "pageSize": 10000,
        "pageSizeParameterName": "limit"
      },
      "response": { "eventsJsonPaths": [ "$.items" ], "format": "json" },
      "checkConnectivityRequest": {
        "apiEndpoint": "[[concat('https://feeds-api.whoisxmlapi.com/v1/check?feed=nrd&tier=', parameters('nrdTier')[0])]",
        "httpMethod": "GET",
        "retryCount": 1,
        "timeoutInSeconds": 30,
        "headers": { "Accept": "application/json", "User-Agent": "WhoisXMLAPI-Sentinel-CCF/1.0" }
      },
      "isActive": true
    }
  },
