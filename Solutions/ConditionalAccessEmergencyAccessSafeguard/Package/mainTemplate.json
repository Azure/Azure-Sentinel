{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "Araam Mamali - Araam.Mamali@microsoft.com",
    "comments": "Solution template for ConditionalAccessEmergencyAccessSafeguard"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "email": "Araam.Mamali@microsoft.com",
    "_email": "[variables('email')]",
    "_solutionName": "ConditionalAccessEmergencyAccessSafeguard",
    "_solutionVersion": "3.0.0",
    "solutionId": "azuresentinel.azure-sentinel-solution-caemergencyaccesssafeguard",
    "_solutionId": "[variables('solutionId')]",
    "CA-EmergencyAccessSafeguard": "CA-EmergencyAccessSafeguard",
    "_CA-EmergencyAccessSafeguard": "[variables('CA-EmergencyAccessSafeguard')]",
    "playbookVersion1": "1.0",
    "playbookContentId1": "CA-EmergencyAccessSafeguard",
    "_playbookContentId1": "[variables('playbookContentId1')]",
    "playbookId1": "[resourceId('Microsoft.Logic/workflows', variables('playbookContentId1'))]",
    "playbookTemplateSpecName1": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-pl-',uniquestring(variables('_playbookContentId1'))))]",
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "_playbookcontentProductId1": "[concat(take(variables('_solutionId'),50),'-','pl','-', uniqueString(concat(variables('_solutionId'),'-','Playbook','-',variables('_playbookContentId1'),'-', variables('playbookVersion1'))))]",
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[variables('playbookTemplateSpecName1')]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "description": "CA-EmergencyAccessSafeguard Playbook with template version 3.0.0",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('playbookVersion1')]",
          "parameters": {
            "PlaybookName": {
              "type": "string",
              "defaultValue": "CA-EmergencyAccessSafeguard",
              "metadata": {
                "description": "Name of the Logic App."
              }
            },
            "BreakGlassAccountId1": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the first emergency access (break-glass) account."
              }
            },
            "BreakGlassAccountId2": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the second emergency access (break-glass) account."
              }
            },
            "NotificationEmail": {
              "type": "string",
              "metadata": {
                "description": "Email address that receives remediation verification results."
              }
            },
            "GraphEndpoint": {
              "type": "string",
              "defaultValue": "https://graph.microsoft.com",
              "allowedValues": [
                "https://graph.microsoft.com",
                "https://graph.microsoft.us",
                "https://dod-graph.microsoft.us"
              ],
              "metadata": {
                "description": "Microsoft Graph endpoint for your cloud: Commercial/GCC, GCC High, or DoD."
              }
            }
          },
          "variables": {
            "Office365ConnectionName": "[[concat('Office365-', parameters('PlaybookName'))]",
            "connection-1": "[[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', variables('workspace-location-inline'), '/managedApis/office365')]",
            "_connection-1": "[[variables('connection-1')]",
            "workspace-location-inline": "[concat('[resourceGroup().locatio', 'n]')]",
            "workspace-name": "[parameters('workspace')]",
            "workspaceResourceId": "[[resourceId('microsoft.OperationalInsights/Workspaces', variables('workspace-name'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Web/connections",
              "apiVersion": "2016-06-01",
              "name": "[[variables('Office365ConnectionName')]",
              "location": "[[variables('workspace-location-inline')]",
              "kind": "V1",
              "properties": {
                "displayName": "[[variables('Office365ConnectionName')]",
                "api": {
                  "id": "[[variables('_connection-1')]"
                }
              }
            },
            {
              "type": "Microsoft.Logic/workflows",
              "apiVersion": "2017-07-01",
              "name": "[[parameters('PlaybookName')]",
              "location": "[[variables('workspace-location-inline')]",
              "tags": {
                "hidden-SentinelTemplateName": "CA-EmergencyAccessSafeguard",
                "hidden-SentinelTemplateVersion": "1.0",
                "hidden-SentinelWorkspaceId": "[[variables('workspaceResourceId')]"
              },
              "identity": {
                "type": "SystemAssigned"
              },
              "dependsOn": [
                "[[resourceId('Microsoft.Web/connections', variables('Office365ConnectionName'))]"
              ],
              "properties": {
                "state": "Enabled",
                "definition": {
                  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                  "contentVersion": "1.0.0.0",
                  "triggers": {
                    "Recurrence": {
                      "recurrence": {
                        "interval": 1,
                        "frequency": "Day"
                      },
                      "type": "Recurrence"
                    }
                  },
                  "actions": {
                    "HTTP": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@{parameters('GraphEndpoint')}/v1.0/identity/conditionalAccess/policies",
                        "method": "GET",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "@parameters('GraphEndpoint')"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Parse_JSON": {
                      "runAfter": {
                        "HTTP": [
                          "Succeeded"
                        ]
                      },
                      "type": "ParseJson",
                      "inputs": {
                        "content": "@body('HTTP')",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "displayName": {
                                    "type": "string"
                                  },
                                  "state": {
                                    "type": "string"
                                  },
                                  "conditions": {
                                    "type": "object",
                                    "properties": {
                                      "users": {
                                        "type": "object",
                                        "properties": {
                                          "includeUsers": {
                                            "type": [
                                              "array",
                                              "null"
                                            ],
                                            "items": {
                                              "type": "string"
                                            }
                                          },
                                          "excludeUsers": {
                                            "type": [
                                              "array",
                                              "null"
                                            ],
                                            "items": {
                                              "type": "string"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "required": [
                                  "id",
                                  "displayName",
                                  "state",
                                  "conditions"
                                ]
                              }
                            }
                          },
                          "required": [
                            "value"
                          ]
                        }
                      }
                    },
                    "For_each": {
                      "foreach": "@body('Parse_JSON')['value']",
                      "actions": {
                        "Condition": {
                          "actions": {
                            "Compose": {
                              "type": "Compose",
                              "inputs": "@concat(\n  'NONCOMPLIANT CA POLICY | Name: ',\n  item()?['displayName'],\n  ' | Policy ID: ',\n  item()?['id'],\n  ' | Missing one or more break-glass exclusions'\n)"
                            },
                            "HTTP_1": {
                              "runAfter": {
                                "Compose": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Http",
                              "inputs": {
                                "uri": "@concat(parameters('GraphEndpoint'),'/v1.0/identity/conditionalAccess/policies/',items('For_each')?['id'])",
                                "method": "PATCH",
                                "headers": {
                                  "Content-Type": "application/json"
                                },
                                "body": "@setProperty(\n  json('{}'),\n  'conditions',\n  setProperty(\n    items('For_each')?['conditions'],\n    'users',\n    setProperty(\n      items('For_each')?['conditions']?['users'],\n      'excludeUsers',\n      union(\n        coalesce(\n          items('For_each')?['conditions']?['users']?['excludeUsers'],\n          json('[]')\n        ),\n        createArray(\n          parameters('BreakGlassAccountId1'),\n          parameters('BreakGlassAccountId2')\n        )\n      )\n    )\n  )\n)",
                                "authentication": {
                                  "type": "ManagedServiceIdentity",
                                  "audience": "@parameters('GraphEndpoint')"
                                }
                              },
                              "runtimeConfiguration": {
                                "contentTransfer": {
                                  "transferMode": "Chunked"
                                }
                              }
                            },
                            "HTTP_2": {
                              "runAfter": {
                                "Delay": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Http",
                              "inputs": {
                                "uri": "@concat(parameters('GraphEndpoint'),'/v1.0/identity/conditionalAccess/policies/',items('For_each')?['id'])",
                                "method": "GET",
                                "authentication": {
                                  "type": "ManagedServiceIdentity",
                                  "audience": "@parameters('GraphEndpoint')"
                                }
                              },
                              "runtimeConfiguration": {
                                "contentTransfer": {
                                  "transferMode": "Chunked"
                                }
                              }
                            },
                            "Condition_1": {
                              "actions": {
                                "Compose_1": {
                                  "type": "Compose",
                                  "inputs": "@concat(\n  'REMEDIATION VERIFIED | Name: ',\n  body('HTTP_2')?['displayName'],\n  ' | Policy ID: ',\n  body('HTTP_2')?['id'],\n  ' | Both break-glass accounts are excluded'\n)"
                                },
                                "Send_an_email_(V2)": {
                                  "runAfter": {
                                    "Compose_1": [
                                      "Succeeded"
                                    ]
                                  },
                                  "type": "ApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connection": {
                                        "name": "@parameters('$connections')['office365']['connectionId']"
                                      }
                                    },
                                    "method": "post",
                                    "body": {
                                      "To": "@parameters('NotificationEmail')",
                                      "Subject": "Conditional Access break-glass remediation verified",
                                      "Body": "<p class=\"editor-paragraph\">@{outputs('Compose_1')}</p>",
                                      "Importance": "High"
                                    },
                                    "path": "/v2/Mail"
                                  }
                                }
                              },
                              "runAfter": {
                                "HTTP_2": [
                                  "Succeeded"
                                ]
                              },
                              "else": {
                                "actions": {
                                  "Compose_2": {
                                    "type": "Compose",
                                    "inputs": "@concat(\n  'REMEDIATION VERIFICATION FAILED | Name: ',\n  body('HTTP_2')?['displayName'],\n  ' | Policy ID: ',\n  body('HTTP_2')?['id'],\n  ' | One or both break-glass accounts are still missing'\n)"
                                  },
                                  "Send_an_email_(V2)_1": {
                                    "runAfter": {
                                      "Compose_2": [
                                        "Succeeded"
                                      ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                      "host": {
                                        "connection": {
                                          "name": "@parameters('$connections')['office365']['connectionId']"
                                        }
                                      },
                                      "method": "post",
                                      "body": {
                                        "To": "@parameters('NotificationEmail')",
                                        "Subject": "Conditional Access break-glass remediation verification failed",
                                        "Body": "<p class=\"editor-paragraph\">@{outputs('Compose_2')}</p>",
                                        "Importance": "High"
                                      },
                                      "path": "/v2/Mail"
                                    }
                                  }
                                }
                              },
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@and(\n  contains(\n    coalesce(\n      body('HTTP_2')?['conditions']?['users']?['excludeUsers'],\n      json('[]')\n    ),\n    parameters('BreakGlassAccountId1')\n  ),\n  contains(\n    coalesce(\n      body('HTTP_2')?['conditions']?['users']?['excludeUsers'],\n      json('[]')\n    ),\n    parameters('BreakGlassAccountId2')\n  )\n)",
                                      "@true"
                                    ]
                                  }
                                ]
                              },
                              "type": "If"
                            },
                            "Delay": {
                              "runAfter": {
                                "HTTP_1": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Wait",
                              "inputs": {
                                "interval": {
                                  "count": 15,
                                  "unit": "Second"
                                }
                              }
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@not(\n  and(\n    contains(\n      coalesce(\n        items('For_each')?['conditions']?['users']?['excludeUsers'],\n        json('[]')\n      ),\n      parameters('BreakGlassAccountId1')\n    ),\n    contains(\n      coalesce(\n        items('For_each')?['conditions']?['users']?['excludeUsers'],\n        json('[]')\n      ),\n      parameters('BreakGlassAccountId2')\n    )\n  )\n)",
                                  "@true"
                                ]
                              }
                            ]
                          },
                          "type": "If"
                        }
                      },
                      "runAfter": {
                        "Parse_JSON": [
                          "Succeeded"
                        ]
                      },
                      "type": "Foreach"
                    }
                  },
                  "parameters": {
                    "$connections": {
                      "type": "Object"
                    },
                    "BreakGlassAccountId1": {
                      "type": "String"
                    },
                    "BreakGlassAccountId2": {
                      "type": "String"
                    },
                    "NotificationEmail": {
                      "type": "String"
                    },
                    "GraphEndpoint": {
                      "type": "String"
                    }
                  }
                },
                "parameters": {
                  "$connections": {
                    "value": {
                      "office365": {
                        "connectionId": "[[resourceId('Microsoft.Web/connections', variables('Office365ConnectionName'))]",
                        "connectionName": "[[variables('Office365ConnectionName')]",
                        "id": "[[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', variables('workspace-location-inline'), '/managedApis/office365')]"
                      }
                    }
                  },
                  "BreakGlassAccountId1": {
                    "value": "[[parameters('BreakGlassAccountId1')]"
                  },
                  "BreakGlassAccountId2": {
                    "value": "[[parameters('BreakGlassAccountId2')]"
                  },
                  "NotificationEmail": {
                    "value": "[[parameters('NotificationEmail')]"
                  },
                  "GraphEndpoint": {
                    "value": "[[parameters('GraphEndpoint')]"
                  }
                }
              }
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "apiVersion": "2022-01-01-preview",
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('Playbook-', last(split(variables('playbookId1'),'/'))))]",
              "properties": {
                "parentId": "[variables('playbookId1')]",
                "contentId": "[variables('_playbookContentId1')]",
                "kind": "Playbook",
                "version": "[variables('playbookVersion1')]",
                "source": {
                  "kind": "Solution",
                  "name": "ConditionalAccessEmergencyAccessSafeguard",
                  "sourceId": "[variables('_solutionId')]"
                },
                "author": {
                  "name": "Araam Mamali",
                  "email": "[variables('_email')]"
                },
                "support": {
                  "name": "Community",
                  "tier": "Community",
                  "link": "https://github.com/Azure/Azure-Sentinel/issues"
                }
              }
            }
          ],
          "metadata": {
            "title": "Conditional Access Emergency Access Safeguard",
            "description": "Runs daily and checks every Microsoft Entra Conditional Access policy. If either of the two designated emergency access (break-glass) accounts is not excluded from a policy, the playbook adds the missing exclusion through Microsoft Graph, re-reads the policy to verify the change, and emails a verified or failed result to the designated recipient.",
            "prerequisites": [
              "Two emergency access (break-glass) accounts in Microsoft Entra ID. You need the object ID of each account.",
              "A mailbox to receive verification notifications."
            ],
            "postDeployment": [
              "1. Grant the playbook's system-assigned managed identity the Microsoft Graph application permissions Policy.Read.All and Policy.ReadWrite.ConditionalAccess (admin consent required).",
              "2. Authorize the Office 365 API connection: open the connection resource, select Edit API connection, select Authorize, sign in, and save.",
              "3. Test the playbook against a Report-only or disabled test policy before relying on it in production."
            ],
            "lastUpdateTime": "2026-11-19T00:00:00Z",
            "tags": [
              "Remediation",
              "Conditional Access",
              "Identity"
            ],
            "releaseNotes": [
              {
                "version": "1.0.0",
                "title": "Initial release",
                "notes": [
                  "Initial version"
                ]
              }
            ]
          }
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "contentId": "[variables('_playbookContentId1')]",
        "contentKind": "Playbook",
        "displayName": "CA-EmergencyAccessSafeguard",
        "contentProductId": "[variables('_playbookcontentProductId1')]",
        "id": "[variables('_playbookcontentProductId1')]",
        "version": "[variables('playbookVersion1')]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentPackages",
      "apiVersion": "2023-04-01-preview",
      "location": "[parameters('workspace-location')]",
      "properties": {
        "version": "3.0.0",
        "kind": "Solution",
        "contentSchemaVersion": "3.0.0",
        "displayName": "ConditionalAccessEmergencyAccessSafeguard",
        "publisherDisplayName": "Community",
        "descriptionHtml": "<p><strong>Note:</strong> Please refer to the following before installing the solution:</p>\n<p>• Review the solution <a href=\"https://github.com/Azure/Azure-Sentinel/tree/master/Solutions/ConditionalAccessEmergencyAccessSafeguard/ReleaseNotes.md\">Release Notes</a></p>\n<p>• There may be <a href=\"https://aka.ms/sentinelsolutionsknownissues\">known issues</a> pertaining to this Solution, please refer to them before installing.</p>\n<p>The Conditional Access Emergency Access Safeguard solution provides a Microsoft Sentinel playbook that runs daily, checks every Microsoft Entra Conditional Access policy, and makes sure your two emergency access (break-glass) accounts are excluded. If an exclusion is missing, the playbook adds it through Microsoft Graph, re-reads the policy to verify the change, and emails the result. Supports Commercial, GCC High, and DoD Graph endpoints.</p>\n<p><strong>Playbooks:</strong> 1</p>\n<p><a href=\"https://aka.ms/azuresentinel\">Learn more about Microsoft Sentinel</a> | <a href=\"https://aka.ms/azuresentinelsolutionsdoc\">Learn more about Solutions</a></p>\n",
        "contentKind": "Solution",
        "contentProductId": "[variables('_solutioncontentProductId')]",
        "id": "[variables('_solutioncontentProductId')]",
        "icon": "<img src=\"https://raw.githubusercontent.com/Azure/Azure-Sentinel/master/Logos/Azure_Sentinel.svg\" width=\"75px\" height=\"75px\">",
        "contentId": "[variables('_solutionId')]",
        "parentId": "[variables('_solutionId')]",
        "source": {
          "kind": "Solution",
          "name": "ConditionalAccessEmergencyAccessSafeguard",
          "sourceId": "[variables('_solutionId')]"
        },
        "author": {
          "name": "Araam Mamali",
          "email": "[variables('_email')]"
        },
        "support": {
          "name": "Community",
          "tier": "Community",
          "link": "https://github.com/Azure/Azure-Sentinel/issues"
        },
        "dependencies": {
          "operator": "AND",
          "criteria": [
            {
              "kind": "Playbook",
              "contentId": "[variables('_CA-EmergencyAccessSafeguard')]",
              "version": "[variables('playbookVersion1')]"
            }
          ]
        },
        "firstPublishDate": "2026-11-19",
        "providers": [
          "Microsoft"
        ],
        "categories": {
          "domains": [
            "Security - Identity"
          ]
        }
      },
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', variables('_solutionId'))]"
    }
  ],
  "outputs": {}
}
