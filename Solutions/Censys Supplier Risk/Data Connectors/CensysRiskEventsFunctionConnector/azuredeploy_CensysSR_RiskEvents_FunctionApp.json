{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "Censys SR Function Name": {
      "type": "string",
      "defaultValue": "CensysSR",
      "metadata": {
        "description": "Name prefix of the Function App to create (up to 10 characters, letters and digits)."
      },
      "minLength": 1,
      "maxLength": 10
    },
    "Censys Api Key": {
      "type": "securestring",
      "metadata": {
        "description": "Censys personal access token. Starter, Search and Core plans need the API Access role."
      }
    },
    "Censys Organization Id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "UUID of the Censys organization to collect risk events for, for example 00000000-0000-0000-0000-000000000000."
      }
    },
    "Censys Start Date Time": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. UTC time to start collecting from, in the form 2026-10-01T00:00:00Z. It must not be in the future. Leave empty for full history (all events Censys still retains)."
      }
    },
    "Censys Supplier Names": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 500,
      "metadata": {
        "description": "Optional. Names of the suppliers to collect risk events for, separated by an asterisk (*). For example: OpenAI*Harvey*Acme, Inc. Names are not case-sensitive. Names that are not found among your suppliers are skipped with a warning. Leave empty to collect all suppliers. A change applies from the next run and continues from the current position, so avoid changing it often. Maximum 500 characters."
      }
    },
    "Censys Risk Type Ids": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated Censys risk type IDs (CVE IDs such as CVE-2021-44228, or Censys catalog IDs such as CENSYS-2022-1194). Maximum 100 values and 1000 characters. Leave empty for all risk types."
      },
      "maxLength": 1000
    },
    "Censys Change Types": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated change types: opened, resolved, reopened. Other values stop the run with an error. Leave empty for all."
      }
    },
    "Censys Severity": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated severities: CRITICAL, HIGH, MEDIUM, LOW. Other values stop the run with an error. Leave empty for all."
      }
    },
    "Censys Rapid Response": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. true for rapid response findings only, false to exclude them. Leave empty for both."
      },
      "allowedValues": [
        "",
        "true",
        "false"
      ]
    },
    "Azure_Client_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter the Azure client ID of the Microsoft Entra app that ingests the data. It is the app you created for this connector."
      }
    },
    "Azure_Client_Secret": {
      "type": "securestring",
      "metadata": {
        "description": "Enter the client secret that you created for that Microsoft Entra app."
      }
    },
    "Azure_Tenant_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter the Azure tenant ID of your Microsoft Entra ID."
      }
    },
    "Azure_Entra_Object_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter the object ID of your Microsoft Entra app (Enterprise application). It gets the Monitoring Metrics Publisher role on the data collection rule."
      }
    },
    "WorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Log Analytics workspace of Microsoft Sentinel. Deploy this template in the resource group of that workspace. The template creates the table CensysRiskEvents_CL, a data collection endpoint and a data collection rule in it."
      }
    },
    "Location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the data collection endpoint and rule. It must be the region of the workspace."
      }
    },
    "Censys Table Name": {
      "type": "string",
      "defaultValue": "CensysRiskEvents_CL",
      "minLength": 4,
      "maxLength": 52,
      "metadata": {
        "description": "Name of the table in the workspace that the connector writes the risk events to. The suffix _CL is added, or corrected, when it is missing or in another case. Maximum 52 characters. Warning: the default is CensysRiskEvents_CL, and the parser CensysRiskEvents, the workbook, the analytic rule and the connector status check of this solution read that table. If you use another name, update these resources to read the new table, otherwise they show no data."
      }
    },
    "Censys Risk Events Collection Schedule": {
      "type": "string",
      "defaultValue": "0 */10 * * * *",
      "metadata": {
        "description": "Quartz (NCRONTAB) cron expression for how often the function runs, for example 0 */10 * * * *. Do not run it more often than every 5 minutes. Default is every 10 minutes."
      }
    },
    "Censys Supplier List Refresh Schedule": {
      "type": "string",
      "defaultValue": "0 */30 * * * *",
      "metadata": {
        "description": "Quartz (NCRONTAB) cron expression for how often the function that refreshes the list of supplier names and ids runs, for example 0 */30 * * * *. It also runs once when the app starts. Default is every 30 minutes."
      }
    },
    "AppInsightsWorkspaceResourceID": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics workspace used by Application Insights. Use 'Log Analytics Workspace, Properties' blade, Resource ID."
      }
    },
    "Censys SR Function Log Level": {
      "type": "string",
      "defaultValue": "INFO",
      "metadata": {
        "description": "Log level of the functions: DEBUG, INFO or ERROR."
      },
      "allowedValues": [
        "DEBUG",
        "INFO",
        "ERROR"
      ]
    }
  },
  "variables": {
    "FunctionName": "[concat(toLower(parameters('Censys SR Function Name')), uniqueString(resourceGroup().id))]",
    "deploymentStorageContainerName": "[concat('app-package-', toLower(parameters('Censys SR Function Name')))]",
    "storageBlobDataOwnerRoleId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "monitoringMetricsPublisherRoleId": "3913510d-42f4-4e42-8a64-420c390055eb",
    "scope": "[concat(replace(environment().portal, 'portal', 'monitor'), '/.default')]",
    "suffix": "[uniqueString(resourceGroup().id)]",
    "dceName": "[concat('CensysSRRiskEventsDCE', variables('suffix'))]",
    "dcrName": "[concat('CensysSRRiskEventsDCR', variables('suffix'))]",
    "dcrId": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]",
    "dceId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
    "tableName": "[if(endsWith(toLower(parameters('Censys Table Name')), '_cl'), concat(substring(parameters('Censys Table Name'), 0, sub(length(parameters('Censys Table Name')), 3)), '_CL'), concat(parameters('Censys Table Name'), '_CL'))]",
    "streamName": "[concat('Custom-', variables('tableName'))]",
    "workspaceResId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('WorkspaceName'), '/', variables('tableName'))]",
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "[variables('tableName')]",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "EventId",
              "type": "string"
            },
            {
              "name": "InsertedAt",
              "type": "datetime"
            },
            {
              "name": "OccurredAt",
              "type": "datetime"
            },
            {
              "name": "ChangeType",
              "type": "string"
            },
            {
              "name": "RiskInstanceId",
              "type": "string"
            },
            {
              "name": "SupplyChainId",
              "type": "string"
            },
            {
              "name": "AssetType",
              "type": "string"
            },
            {
              "name": "RiskTypeId",
              "type": "string"
            },
            {
              "name": "CveId",
              "type": "string"
            },
            {
              "name": "RiskCategory",
              "type": "string"
            },
            {
              "name": "RiskName",
              "type": "string"
            },
            {
              "name": "Description",
              "type": "string"
            },
            {
              "name": "Remediations",
              "type": "dynamic"
            },
            {
              "name": "Severity",
              "type": "string"
            },
            {
              "name": "Score",
              "type": "real"
            },
            {
              "name": "Confidence",
              "type": "real"
            },
            {
              "name": "Status",
              "type": "string"
            },
            {
              "name": "ResolveTime",
              "type": "datetime"
            },
            {
              "name": "ResolveReason",
              "type": "string"
            },
            {
              "name": "SupplierId",
              "type": "string"
            },
            {
              "name": "SupplierDisplayName",
              "type": "string"
            },
            {
              "name": "Suppliers",
              "type": "dynamic"
            },
            {
              "name": "AssetIp",
              "type": "string"
            },
            {
              "name": "AssetHostname",
              "type": "string"
            },
            {
              "name": "AssetPort",
              "type": "int"
            },
            {
              "name": "ServiceTransportProtocol",
              "type": "string"
            },
            {
              "name": "ServicePort",
              "type": "int"
            },
            {
              "name": "ServiceProtocol",
              "type": "string"
            },
            {
              "name": "Tags",
              "type": "dynamic"
            },
            {
              "name": "RapidResponse",
              "type": "bool"
            },
            {
              "name": "Evidence",
              "type": "string"
            },
            {
              "name": "FirstDetectedAt",
              "type": "datetime"
            },
            {
              "name": "LastDetectedAt",
              "type": "datetime"
            },
            {
              "name": "CreatedAt",
              "type": "datetime"
            },
            {
              "name": "PlatformUrl",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2022-06-01",
      "name": "[variables('dceName')]",
      "location": "[parameters('Location')]",
      "kind": "Linux",
      "properties": {
        "description": "Data collection endpoint of the Censys SR function connector",
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[variables('dcrName')]",
      "location": "[parameters('Location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('tableName'))]",
        "[variables('dceId')]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[variables('dceId')]",
        "streamDeclarations": {
          "[variables('streamName')]": {
            "columns": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "inserted_at",
                "type": "datetime"
              },
              {
                "name": "occurred_at",
                "type": "datetime"
              },
              {
                "name": "change_type",
                "type": "string"
              },
              {
                "name": "risk_instance",
                "type": "dynamic"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceResId')]",
              "name": "clv2ws1"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('streamName')]"
            ],
            "destinations": [
              "clv2ws1"
            ],
            "transformKql": "source | extend ri = todynamic(risk_instance) | extend TimeGenerated = todatetime(occurred_at), EventId = tostring(id), InsertedAt = todatetime(inserted_at), OccurredAt = todatetime(occurred_at), ChangeType = tostring(change_type), RiskInstanceId = tostring(ri.id), SupplyChainId = tostring(ri.supply_chain_id), AssetType = tostring(ri.asset_type), RiskTypeId = tostring(ri.risk_type_id), CveId = iff(tostring(ri.risk_type_id) matches regex @'^CVE-[0-9]{4}-[0-9]+$', tostring(ri.risk_type_id), ''), RiskCategory = tostring(ri.risk_category), RiskName = tostring(ri.risk_name), Description = tostring(ri.description), Remediations = todynamic(ri.remediations), Severity = tostring(ri.severity), Score = toreal(ri.score), Confidence = toreal(ri.confidence), Status = tostring(ri.status), ResolveTime = todatetime(ri.resolve_time), ResolveReason = tostring(ri.resolve_reason), SupplierId = tostring(ri.suppliers[0].id), SupplierDisplayName = tostring(ri.suppliers[0].display_name), Suppliers = todynamic(ri.suppliers), AssetIp = tostring(ri.host.ip), AssetHostname = tostring(ri.web.hostname), AssetPort = toint(ri.web.port), ServiceTransportProtocol = tostring(ri.service.transport_protocol), ServicePort = toint(ri.service.port), ServiceProtocol = tostring(ri.service.protocol), Tags = todynamic(ri.tags), RapidResponse = tobool(ri.rapid_response), Evidence = tostring(ri.evidence), FirstDetectedAt = todatetime(ri.first_detected_at), LastDetectedAt = todatetime(ri.last_detected_at), CreatedAt = todatetime(ri.created_at), PlatformUrl = tostring(ri.platform_url) | project TimeGenerated, EventId, InsertedAt, OccurredAt, ChangeType, RiskInstanceId, SupplyChainId, AssetType, RiskTypeId, CveId, RiskCategory, RiskName, Description, Remediations, Severity, Score, Confidence, Status, ResolveTime, ResolveReason, SupplierId, SupplierDisplayName, Suppliers, AssetIp, AssetHostname, AssetPort, ServiceTransportProtocol, ServicePort, ServiceProtocol, Tags, RapidResponse, Evidence, FirstDetectedAt, LastDetectedAt, CreatedAt, PlatformUrl",
            "outputStream": "[variables('streamName')]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "ApplicationId": "[variables('FunctionName')]",
        "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceID')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[tolower(variables('FunctionName'))]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "networkAcls": {
          "bypass": "AzureServices",
          "virtualNetworkRules": [],
          "ipRules": [],
          "defaultAction": "Allow"
        },
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "encryption": {
          "services": {
            "file": {
              "keyType": "Account",
              "enabled": true
            },
            "blob": {
              "keyType": "Account",
              "enabled": true
            }
          },
          "keySource": "Microsoft.Storage"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]"
      ],
      "properties": {
        "cors": {
          "corsRules": []
        },
        "deleteRetentionPolicy": {
          "enabled": false
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', variables('deploymentStorageContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', 'azure-webjobs-hosts')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', 'azure-webjobs-secrets')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', tolower(variables('FunctionName')), 'default', variables('deploymentStorageContainerName'))]",
        "[resourceId('Microsoft.Insights/components', variables('FunctionName'))]"
      ],
      "properties": {
        "name": "[variables('FunctionName')]",
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))).primaryEndpoints.blob, variables('deploymentStorageContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 40,
            "instanceMemoryMB": 2048
          },
          "runtime": {
            "name": "python",
            "version": "3.14"
          }
        }
      },
      "resources": [
        {
          "apiVersion": "2023-12-01",
          "type": "config",
          "name": "appsettings",
          "dependsOn": [
            "[concat('Microsoft.Web/sites/', variables('FunctionName'))]",
            "[variables('dcrId')]",
            "[variables('dceId')]"
          ],
          "properties": {
            "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2015-05-01').InstrumentationKey]",
            "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2015-05-01').ConnectionString]",
            "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=', tolower(variables('FunctionName')), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), '2023-01-01').keys[0].value, ';EndpointSuffix=', environment().suffixes.storage)]",
            "CensysApiToken": "[parameters('Censys Api Key')]",
            "OrganizationId": "[parameters('Censys Organization Id')]",
            "InitialStartTime": "[parameters('Censys Start Date Time')]",
            "SupplierNames": "[parameters('Censys Supplier Names')]",
            "RiskTypeIds": "[parameters('Censys Risk Type Ids')]",
            "ChangeTypes": "[parameters('Censys Change Types')]",
            "Severity": "[parameters('Censys Severity')]",
            "RapidResponse": "[parameters('Censys Rapid Response')]",
            "Schedule": "[parameters('Censys Risk Events Collection Schedule')]",
            "SuppliersSchedule": "[parameters('Censys Supplier List Refresh Schedule')]",
            "LogLevel": "[parameters('Censys SR Function Log Level')]",
            "StreamName": "[variables('streamName')]",
            "SCOPE": "[variables('scope')]",
            "AZURE_DATA_COLLECTION_ENDPOINT": "[reference(variables('dceId'), '2022-06-01').logsIngestion.endpoint]",
            "AZURE_DATA_COLLECTION_RULE_ID": "[reference(variables('dcrId'), '2023-03-11').immutableId]",
            "AZURE_CLIENT_ID": "[parameters('Azure_Client_Id')]",
            "AZURE_CLIENT_SECRET": "[parameters('Azure_Client_Secret')]",
            "AZURE_TENANT_ID": "[parameters('Azure_Tenant_Id')]"
          }
        }
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), variables('storageBlobDataOwnerRoleId'), variables('FunctionName'))]",
      "scope": "[concat('Microsoft.Storage/storageAccounts', '/', tolower(variables('FunctionName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]",
        "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataOwnerRoleId'))]",
        "principalType": "ServicePrincipal",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('FunctionName')), '2023-12-01', 'Full').identity.principalId]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('dcrId'), variables('monitoringMetricsPublisherRoleId'), parameters('Azure_Entra_Object_Id'))]",
      "scope": "[variables('dcrId')]",
      "dependsOn": [
        "[variables('dcrId')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisherRoleId'))]",
        "principalType": "ServicePrincipal",
        "principalId": "[parameters('Azure_Entra_Object_Id')]"
      }
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "WaitSection",
      "location": "[resourceGroup().location]",
      "kind": "AzurePowerShell",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]",
        "[guid(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), variables('storageBlobDataOwnerRoleId'), variables('FunctionName'))]"
      ],
      "properties": {
        "azPowerShellVersion": "7.0",
        "scriptContent": "start-sleep -Seconds 30",
        "cleanupPreference": "Always",
        "retentionInterval": "PT1H"
      }
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', variables('FunctionName'), 'onedeploy')]",
      "dependsOn": [
        "WaitSection"
      ],
      "properties": {
        "packageUri": "https://github.com/harsh-maradia/Harsh-Azure-Connectors/raw/refs/heads/main/Censys-SR-RiskEvents-1.0.0/CensysSRRiskEvents.zip",
        "remoteBuild": true
      }
    }
  ],
  "outputs": {
    "FunctionAppName": {
      "type": "string",
      "value": "[variables('FunctionName')]"
    }
  }
}
