    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let TotalHours = (todatetime({TimeRange:end}) - todatetime({TimeRange:start})) / 1h;\n// Time span picked from the Time Range (at most about 100 points): 30 minutes, 1 hour or 1 day\nlet Span = iff(TotalHours <= 50, 30m, iff(TotalHours <= 100, 1h, 1d));\nlet Buckets = range Bucket from bin(todatetime({TimeRange:start}), Span) to todatetime({TimeRange:end}) step Span | extend k = 1;\nlet Statuses = datatable(Series: string)[\"Opened\", \"Closed\"] | extend k = 1;\nlet Counts = CensysRiskEvents\n    | where OccurredAt {TimeRange}\n    | where ('*' in ({Status}) or Status in ({Status}))\n    | where ('*' in ({Severity}) or Severity in ({Severity}))\n    | where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n    | where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n    | extend Series = case(Status == \"open\", \"Opened\", Status == \"closed\", \"Closed\", Status)\n    | summarize Total = count() by Bucket = bin(OccurredAt, Span), Series;\nBuckets\n| join kind=inner Statuses on k\n| join kind=leftouter Counts on Bucket, Series\n| project Time = iff(Span >= 1d, format_datetime(Bucket, 'yyyy-MM-dd'), format_datetime(Bucket, 'yyyy-MM-dd HH:mm')), Series, [\"Risk Count\"] = coalesce(Total, 0)\n| order by Time asc, Series asc",
        "size": 0,
        "title": "Opened vs. Closed Risks",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "showRefreshButton": true,
        "showAnalytics": true,
        "showExportToExcel": true,
        "noDataMessage": "No data found for the selected filters.",
        "timeContext": {
          "durationMs": 7776000000
        },
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "Time",
          "group": "Series",
          "xSettings": {
            "label": "Time"
          },
          "ySettings": {
            "label": "Risk Count"
          }
        },
        "exportedParameters": [
          {
            "fieldName": "x",
            "parameterName": "P2Date",
            "parameterType": 1,
            "defaultValue": "None"
          },
          {
            "fieldName": "series",
            "parameterName": "P2Status",
            "parameterType": 1,
            "defaultValue": "None"
          }
        ]
      },
      "name": "4668c9cb-64a5-581d-b461-d8854d0f2409",
      "customWidth": "100"
    },
    {
      "type": 1,
      "content": {
        "json": "\ud83d\udca1 _Click on a data point in the above 'Opened vs. Closed Risks' chart to view more details_\n\n\ud83d\udcdd _Counts risk events per day by their status (Opened or Closed), by when they occurred._"
