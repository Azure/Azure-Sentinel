    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let TotalHours = (todatetime({TimeRange:end}) - todatetime({TimeRange:start})) / 1h;\n// Time span picked from the Time Range (at most about 100 points): 30 minutes, 1 hour or 1 day\nlet Span = iff(TotalHours <= 50, 30m, iff(TotalHours <= 100, 1h, 1d));\nCensysRiskEvents\n| where OccurredAt {TimeRange}\n| where ('*' in ({Status}) or Status in ({Status}))\n| where ('*' in ({Severity}) or Severity in ({Severity}))\n| where ('*' in ({Supplier}) or SupplierDisplayName in ({Supplier}))\n| where ('*' in ({RiskCategory}) or RiskCategory in ({RiskCategory}))\n| where Status == iff('{P2Status}' == \"Opened\", \"open\", \"closed\")\n| where OccurredAt >= todatetime(substring('{P2Date}', 0, 16)) and OccurredAt < todatetime(substring('{P2Date}', 0, 16)) + Span\n| order by InsertedAt desc\n| project Time = InsertedAt, id = EventId, [\"Risk Name\"] = RiskName, Severity, Supplier = SupplierDisplayName, [\"Platform URL\"] = PlatformUrl\n| take 10000",
