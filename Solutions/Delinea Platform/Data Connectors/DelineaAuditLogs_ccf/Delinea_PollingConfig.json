{
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2023-02-01-preview",
    "name": "DelineaPlatformPolling",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
        "connectorDefinitionName": "DelineaPlatformConnector",
        "dataType": "DelineaAuditEvents_CL",
        "dcrConfig": {
            "streamName": "Custom-DelineaAuditEvents_CL",
            "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
            "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
        },
        "auth": {
            "type": "OAuth2",
            "ClientId": "{{clientId}}",
            "ClientSecret": "{{clientSecret}}",
            "GrantType": "client_credentials",
            "TokenEndpoint": "https://{{DelineaBaseUrl}}/identity/api/oauth2/token/xpmplatform",
            "TokenEndpointHeaders": {
                "Accept": "application/json",
                "Content-Type": "application/x-www-form-urlencoded"
            },
            "Scope": "xpmheadless"
        },
        "request": {
            "apiEndpoint": "https://{{DelineaBaseUrl}}/audit/api/audit-events",
            "httpMethod": "GET",
            "rateLimitQPS": 10,
            "queryWindowInMin": 5,
            "retryCount": 3,
            "timeoutInSeconds": 60,
            "headers": {
                "Accept": "*/*",
                "X-Api-Version": "2.0"
            },
            "StartTimeAttributeName": "StartDateTime",
            "EndTimeAttributeName": "EndDateTime",
            "queryParameters": {
                "api-version": "2.0",
                "PageSize": "200",
                "Page": "1",
                "StartDateTime": "{_QueryWindowStartTime}",
                "EndDateTime": "{_QueryWindowEndTime}",
                "Levels": "[[parameters('auditLevels')]",
                "RiskLevels": "[[parameters('riskLevels')]",
                "EventTypes": "[[parameters('eventTypes')]"
            },
            "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ"
        },
        "response": {
            "eventsJsonPaths": [
                "$.auditEvents"
            ],
            "format": "json"
        },
        "paging": {
            "pagingType": "CountBasedPaging",
            "pageNumberParaName": "Page",
            "pageSize": 200,
            "zeroBasedIndexing": false
        }
    }
}