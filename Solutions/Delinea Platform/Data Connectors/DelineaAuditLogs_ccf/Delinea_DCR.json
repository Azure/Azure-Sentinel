{
    "name": "DelineaAuditEventsDCR",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-DelineaAuditEvents_CL": {
                "columns": [
                    {
                        "name": "TimeGenerated",
                        "type": "datetime"
                    },
                    {
                        "name": "eventMessageId",
                        "type": "string"
                    },
                    {
                        "name": "notes",
                        "type": "string"
                    },
                    {
                        "name": "tenantId",
                        "type": "string"
                    },
                    {
                        "name": "displayMessage",
                        "type": "string"
                    },
                    {
                        "name": "level",
                        "type": "string"
                    },
                    {
                        "name": "eventDateTime",
                        "type": "datetime"
                    },
                    {
                        "name": "processedTime",
                        "type": "datetime"
                    },
                    {
                        "name": "sessionId",
                        "type": "string"
                    },
                    {
                        "name": "isSystem",
                        "type": "boolean"
                    },
                    {
                        "name": "service",
                        "type": "dynamic"
                    },
                    {
                        "name": "actor",
                        "type": "dynamic"
                    },
                    {
                        "name": "target",
                        "type": "dynamic"
                    },
                    {
                        "name": "eventType",
                        "type": "dynamic"
                    },
                    {
                        "name": "source",
                        "type": "dynamic"
                    },
                    {
                        "name": "additionalAttributes",
                        "type": "dynamic"
                    },
                    {
                        "name": "fieldChanges",
                        "type": "dynamic"
                    }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "clv2ws1"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [
                    "Custom-DelineaAuditEvents_CL"
                ],
                "destinations": [
                    "clv2ws1"
                ],
                "transformKql": "source | extend RawData = tostring(pack(\"eventMessageId\", eventMessageId, \"tenantId\", tenantId, \"displayMessage\", displayMessage, \"level\", level, \"eventDateTime\", eventDateTime, \"processedTime\", processedTime, \"sessionId\", sessionId, \"isSystem\", isSystem, \"service\", service, \"actor\", actor, \"target\", target, \"eventType\", eventType, \"source\", source, \"notes\", notes, \"additionalAttributes\", additionalAttributes, \"fieldChanges\", fieldChanges)) | extend TimeGenerated = iif(isnotnull(todatetime(eventDateTime)), todatetime(eventDateTime), now()) | project TimeGenerated, RawData, EventType = tostring(eventType.name), Service = tostring(service.type), Level = tostring(level), User = tostring(actor.name), SecretId = iif(tostring(eventType.name) startswith \"Delinea.Vault.Secret\", tostring(target.displayName), \"\")",
                "outputStream": "Custom-DelineaAuditEvents_CL"
            }
        ]
    }
}
