{
    "name": "DelineaPlatformConnector",
    "apiVersion": "2022-09-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "DelineaPlatformConnector",
            "title": "Delinea Platform Audit Events",
            "logo": "DelineaLogo.svg",
            "publisher": "Delinea",
            "descriptionMarkdown": "Ingests privileged-access audit events from the **Delinea Platform** (`/api/audit-events`) into Microsoft Sentinel. Covers secret access, session recording, user activity, and configuration changes.",
            "graphQueriesTableName": "DelineaAuditEvents_CL",
            "graphQueries": [
                {
                    "metricName": "Total data received",
                    "legend": "Delinea Audit Events",
                    "baseQuery": "{{graphQueriesTableName}}"
                }
            ],
            "sampleQueries": [
                {
                    "description": "All audit events - last 24 hours",
                    "query": "{{graphQueriesTableName}}\n| where TimeGenerated > ago(24h)\n| sort by TimeGenerated desc"
                },
                {
                    "description": "Events by type",
                    "query": "{{graphQueriesTableName}}\n| summarize Count = count() by EventType\n| sort by Count desc"
                },
                {
                    "description": "Events by actor",
                    "query": "{{graphQueriesTableName}}\n| summarize Count = count() by User\n| sort by Count desc"
                }
            ],
            "dataTypes": [
                {
                    "name": "{{graphQueriesTableName}}",
                    "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors"
                }
            ],
            "availability": {
                "isPreview": false
            },
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "write": true,
                            "read": true,
                            "delete": true
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "Delinea Platform API access",
                        "description": "A service user with **Auditor** role is required. Create the user under **Access → Users** and assign it to a group with audit read permissions."
                    }
                ]
            },
            "instructionSteps": [
                {
                    "description": "To enable the Delinea Platform connector, click **Add tenant**, fill in your Delinea base URL and service user credentials, then click **Connect**.\n\nCreate a service user in your Delinea tenant under **Access → Roles / Groups / Users** and assign the **Auditor** role.",
                    "instructions": [
                        {
                            "type": "DataConnectorsGrid",
                            "parameters": {
                                "mapping": [
                                    {
                                        "columnName": "Delinea Base URL",
                                        "columnValue": "properties.request.apiEndpoint"
                                    }
                                ],
                                "menuItems": [
                                    "DeleteConnector"
                                ]
                            }
                        },
                        {
                            "type": "ContextPane",
                            "parameters": {
                                "isPrimary": true,
                                "label": "Add tenant",
                                "title": "Add tenant",
                                "subtitle": "Add Delinea Platform tenant",
                                "contextPaneType": "DataConnectorsContextPane",
                                "instructionSteps": [
                                    {
                                        "instructions": [
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Delinea Tenant Hostname",
                                                    "placeholder": "mycompany.delinea.app",
                                                    "type": "text",
                                                    "name": "DelineaBaseUrl"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Client ID",
                                                    "placeholder": "Service user Client ID",
                                                    "type": "text",
                                                    "name": "clientId"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Client Secret",
                                                    "placeholder": "Service user Client Secret",
                                                    "type": "password",
                                                    "name": "clientSecret"
                                                }
                                            },
                                            {
                                                "type": "Dropdown",
                                                "parameters": {
                                                    "label": "Audit Levels to Ingest",
                                                    "name": "auditLevels",
                                                    "options": [
                                                        {
                                                            "key": "SecurityAudit",
                                                            "text": "Security Audit"
                                                        },
                                                        {
                                                            "key": "PrivilegedActivity",
                                                            "text": "Privileged Activity"
                                                        },
                                                        {
                                                            "key": "SystemActivity",
                                                            "text": "System Activity"
                                                        }
                                                    ],
                                                    "isMultiSelect": true,
                                                    "defaultAllSelected": true,
                                                    "required": false
                                                }
                                            },
                                            {
                                                "type": "Dropdown",
                                                "parameters": {
                                                    "label": "Risk Levels to Ingest",
                                                    "name": "riskLevels",
                                                    "options": [
