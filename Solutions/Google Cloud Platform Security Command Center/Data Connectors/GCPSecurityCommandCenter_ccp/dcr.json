[
  {
    "name": "GCPSecurityCommandCenter",
    "apiVersion": "2021-09-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "properties": {
      "streamDeclarations": {
        "Custom-GoogleCloudSCC": {
          "columns": [
            {
              "name": "notificationConfigName",
              "type": "string"
            },
            {
              "name": "finding",
              "type": "dynamic"
            },
            {
              "name": "resource",
              "type": "dynamic"
            }
          ]
        }
      },
      "destinations": {
        "logAnalytics": [
          {
            "name": "clv2ws1"
          }
        ]
      },
      "dataFlows": [
        {
          "streams": [
            "Custom-GoogleCloudSCC"
          ],
          "destinations": [
            "clv2ws1"
          ],
          "transformKql": "source | extend TimeGenerated = iif(isnotempty(tostring(finding.eventTime)), todatetime(finding.eventTime), now()), Findings = finding, FindingsResource = ['resource'], SourceProperties = finding.sourceProperties | project TimeGenerated, Findings, FindingsResource, SourceProperties",
          "outputStream": "Microsoft-GoogleCloudSCC"
        }
      ]
    }
  }
]