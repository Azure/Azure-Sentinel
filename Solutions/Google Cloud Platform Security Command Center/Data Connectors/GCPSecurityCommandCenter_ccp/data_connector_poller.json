[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "{{workspace}}/Microsoft.SecurityInsights/GCPSecurityCommandCenter",
    "kind": "GCP",
    "properties": {
      "connectorDefinitionName": "GoogleSCCDefinition",
      "dataType": "GoogleCloudSCC",
      "dcrConfig": {
        "streamName": "Custom-GoogleCloudSCC"
      },
      "auth": {
        "serviceAccountEmail": "{{GCPServiceAccountEmail}}",
        "projectNumber": "{{GCPProjectNumber}}",
        "workloadIdentityProviderId": "{{GCPWorkloadIdentityProviderId}}"
      },
      "request": {
        "projectId": "{{GCPProjectId}}",
        "subscriptionNames": [
          "{{GCPSubscriptionName}}"
        ]
      }
    }
  }
]