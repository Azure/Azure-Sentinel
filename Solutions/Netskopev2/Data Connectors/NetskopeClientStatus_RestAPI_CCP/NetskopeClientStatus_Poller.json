[
    {
        "name": "NetskopeClientStatus",
        "apiVersion": "2023-02-01-preview",
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "properties": {
            "connectorDefinitionName": "NetskopeClientStatus",
            "dataType": "NetskopeClientStatus_CL",
            "dcrConfig": {
                "streamName": "Custom-NetskopeClientStatus",
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
            },
            "auth": {
                "type": "APIKey",
                "ApiKeyName": "Netskope-Api-Token",
                "ApiKey": "{{apikey}}"
            },
            "request": {
                "apiEndpoint": "[[concat('https://', parameters('OrganisationURL'), '/api/v2/events/dataexport/iterator/', parameters('IteratorId'), '/events?operation=next')]",
                "httpMethod": "GET",
                "queryWindowInMin": 1,
                "queryTimeFormat": "UnixTimestamp",
                "rateLimitQps": 10,
                "retryCount": 3,
                "timeoutInSeconds": 60,
                "headers": {
                    "Accept": "text/csv",
                    "User-Agent": "Microsoft-Sentinel-NetskopeClientStatus/1.4"
                }
            },
            "response": {
                "eventsJsonPaths": [
                    "$"
                ],
                "format": "csv",
                "csvDelimiter": ",",
                "hasCsvHeader": true,
                "csvEscape": "\""
            }
        }
    }
]