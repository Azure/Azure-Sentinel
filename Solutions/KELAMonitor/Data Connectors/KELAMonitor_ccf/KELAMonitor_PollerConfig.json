[
    {
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "apiVersion": "2022-10-01-preview",
        "name": "KELAMonitorBotnetsPoller",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "condition": "[[contains(parameters('enableBotnets'), 'true')]",
        "properties": {
            "auth": {
                "type": "APIKey",
                "apiKeyName": "Authorization",
                "apiKey": "[[parameters('Password')]",
                "apiKeyIdentifier": "Bearer"
            },
            "request": {
                "apiEndpoint": "[[concat('https://platform.ke-la.com/api/monitor/monitor_id/', parameters('MonitorId'), '/incidents')]",
                "queryParameters": {
                    "incident_type": "botnets"
                },
                "httpMethod": "GET",
                "queryTimeFormat": "UnixTimestamp",
                "startTimeAttributeName": "from_date",
                "queryWindowInMin": 15,
                "rateLimitQPS": 30,
                "retryCount": 3,
                "timeoutInSeconds": 120,
                "headers": {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                }
            },
            "response": {
                "eventsJsonPaths": [
                    "$.data.incidents"
                ],
                "format": "json"
            },
            "paging": {
                "pagingType": "NextPageToken",
                "nextPageParaName": "scrollId",
                "nextPageTokenJsonPath": "$.data.scrollId",
                "pageSizeParameterName": "limit",
                "pageSize": 1000,
                "pagingInfoPlacement": "QueryString",
                "pagingQueryParamOnly": true
            },
            "connectorDefinitionName": "KELAMonitorCCFConnector",
            "dataType": "KELA_Monitor_Incidents_CL",
            "dcrConfig": {
                "streamName": "Custom-KELA_Monitor_Incidents_CL",
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
            }
        }
    },
