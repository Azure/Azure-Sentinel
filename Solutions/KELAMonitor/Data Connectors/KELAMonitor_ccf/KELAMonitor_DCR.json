{
    "name": "KELAMonitor_DCR",
    "apiVersion": "2023-04-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-KELA_Monitor_Incidents_CL": {
                "columns": [
                    { "name": "id", "type": "string" },
                    { "name": "type", "type": "string" },
                    { "name": "sub_type", "type": "string" },
                    { "name": "sub_type_description", "type": "string" },
                    { "name": "severity", "type": "int" },
                    { "name": "text", "type": "string" },
                    { "name": "author", "type": "string" },
                    { "name": "source", "type": "string" },
                    { "name": "source_url", "type": "string" },
                    { "name": "email", "type": "string" },
                    { "name": "domain", "type": "string" },
                    { "name": "password", "type": "string" },
                    { "name": "password_type", "type": "string" },
                    { "name": "service", "type": "string" },
                    { "name": "ip", "type": "string" },
                    { "name": "port", "type": "int" },
                    { "name": "bot_id", "type": "string" },
                    { "name": "username", "type": "string" },
                    { "name": "resource", "type": "string" },
                    { "name": "infection_type", "type": "string" },
                    { "name": "isp", "type": "string" },
                    { "name": "country", "type": "string" },
                    { "name": "feed_property_id", "type": "string" },
                    { "name": "data_id", "type": "string" },
                    { "name": "incident_date", "type": "string" },
                    { "name": "publish_date", "type": "string" },
                    { "name": "posted_date", "type": "string" },
                    { "name": "relevant_date", "type": "string" },
                    { "name": "assets", "type": "dynamic" },
                    { "name": "tags", "type": "dynamic" },
                    { "name": "categories", "type": "dynamic" },
                    { "name": "user_actions", "type": "dynamic" },
                    { "name": "media", "type": "dynamic" },
                    { "name": "available_data", "type": "dynamic" }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "LogAnalyticsDestination_KELA"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [ "Custom-KELA_Monitor_Incidents_CL" ],
                "destinations": [ "LogAnalyticsDestination_KELA" ],
                "transformKql": "source | extend incidentType = tostring(type)| extend incident_date = datetime(1970-01-01) + tolong(incident_date) * 1ms, publish_date = datetime(1970-01-01) + tolong(publish_date) * 1ms, posted_date = datetime(1970-01-01) + tolong(posted_date) * 1ms, relevant_date = datetime(1970-01-01) + tolong(relevant_date) * 1ms | extend TimeGenerated = now()",
                "outputStream": "Custom-KELA_Monitor_Incidents_CL"
            }
        ]
    }
}
