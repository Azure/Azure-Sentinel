{
    "name": "KELAMonitorCCFConnector",
    "apiVersion": "2025-07-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "KELAMonitorCCFConnector",
            "title": "KELA - Monitor Connector",
            "publisher": "KELA Cyber",
            "descriptionMarkdown": "This connector ingests incidents from KELA Monitor using Microsoft Sentinel's Codeless Connector Framework (CCF).",
            "graphQueriesTableName": "KELA_Monitor_Incidents_CL",
            "graphQueries": [
                {
                    "metricName": "Total Actionable Alerts collected",
                    "legend": "All Actionable Alerts",
                    "baseQuery": "KELA_Monitor_Incidents_CL"
                }
            ],
            "sampleQueries": [
                {
                    "description": "Get sample of 20 recent Actionable Alerts",
                    "query": "KELA_Monitor_Incidents_CL\n| take 20"
                }
            ],
            "dataTypes": [
                {
                    "name": "KELA_Monitor_Incidents_CL",
                    "lastDataReceivedQuery": "KELA_Monitor_Incidents_CL \n | summarize Time = max(TimeGenerated)\n"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors"
                }
            ],
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and write permissions required in the Workspace.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "write": true,
                            "read": true,
                            "delete": true
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "KELA Credentials",
                        "description": "You'll need your API key and the source workspace ID."
                    }
                ]
            },
            "instructionSteps": [
                {
                    "title": "1. Configure the API connection",
                    "description": "Please enter the required parameters to authenticate yourself and specify the time period from which to retrieve the data.",
                    "instructions": [
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "Monitor ID",
                                "name": "MonitorId",
                                "type": "text",
                                "placeholder": "E.g. 0001...",
                                "validations": {
                                    "required": true
                                }
                            }
                        },
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "API Key (Token)",
                                "name": "Password",
                                "type": "password",
                                "placeholder": "Enter your KELA API Key",
                                "validations": {
                                    "required": true
                                }
                            }
                        },
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Enable Botnets Incidents",
                                "name": "enableBotnets",
                                "options": [
                                    {
                                        "key": "true",
                                        "text": "Yes"
                                    },
                                    {
                                        "key": "false",
                                        "text": "No"
                                    }
                                ],
                                "placeholder": "Select Yes or No",
                                "required": true
                            }
                        },
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Enable Hacking Discussions Incidents",
                                "name": "enableHackingDiscussions",
                                "options": [
                                    {
                                        "key": "true",
                                        "text": "Yes"
                                    },
                                    {
                                        "key": "false",
                                        "text": "No"
                                    }
                                ],
                                "placeholder": "Select Yes or No",
                                "required": true
                            }
                        },
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Enable Instant Messaging Incidents",
                                "name": "enableInstantMessaging",
                                "options": [
                                    {
                                        "key": "true",
                                        "text": "Yes"
                                    },
                                    {
                                        "key": "false",
                                        "text": "No"
                                    }
                                ],
                                "placeholder": "Select Yes or No",
                                "required": true
                            }
                        },
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Enable Leaked Credentials Incidents",
                                "name": "enableLeakedCredentials",
                                "options": [
                                    {
                                        "key": "true",
                                        "text": "Yes"
                                    },
                                    {
                                        "key": "false",
                                        "text": "No"
                                    }
                                ],
                                "placeholder": "Select Yes or No",
                                "required": true
                            }
                        },
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Enable Network Vulnerabilities Incidents",
                                "name": "enableNetworkVulnerabilities",
                                "options": [
                                    {
                                        "key": "true",
                                        "text": "Yes"
                                    },
                                    {
                                        "key": "false",
                                        "text": "No"
                                    }
                                ],
                                "placeholder": "Select Yes or No",
                                "required": true
                            }
                        },
                        {
                            "type": "ConnectionToggleButton",
                            "parameters": {
                                "connectLabel": "Connect",
                                "name": "toggle"
                            }
                        }
                    ]
                }
            ]
        }
    }
}