          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Bitglass\n| where Action has 'block'\n| summarize count()",
              "size": 3,
              "title": "Transactions Blocked",
              "noDataMessage": "0",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": "advancedHunting",
