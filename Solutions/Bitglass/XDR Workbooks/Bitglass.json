    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Bitglass\r\n| where EventType =~ 'swgweb'\r\n| where isnotempty(WebCategories)\r\n| extend cat = extract(@'WR:(.*?)\"\\]', 1, WebCategories)\r\n| summarize count() by cat\r\n| top 10 by count_",
        "size": 3,
        "title": "Top URL Categories",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": "advancedHunting",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "cat",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "count_",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
