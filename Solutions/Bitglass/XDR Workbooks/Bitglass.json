    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Bitglass\n| where isnotempty(DstDomain)\n| summarize count() by DstDomain\n| top 50 by count_",
        "size": 0,
        "title": "Top visited domains",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": "advancedHunting",
        "visualization": "table",
        "tileSettings": {
          "titleContent": {
