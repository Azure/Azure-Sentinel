        "version": "KqlItem/1.0",
        "query": "Bitglass\n| where isnotempty(SrcIpAddr)\n| summarize count() by SrcIpAddr",
        "size": 3,
        "title": "Source Addresses",
        "timeContext": {
          "durationMs": 0
        },
        "timeContextFromParameter": "TimeRange",
