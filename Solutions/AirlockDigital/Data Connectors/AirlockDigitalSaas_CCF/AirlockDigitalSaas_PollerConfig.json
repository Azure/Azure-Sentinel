    "properties": {
      "connectorDefinitionName": "AirlockDigitalSaas",
      "dataType": "AirlockDigitalServerActivities",
      "addOnAttributes": {
        "friendlyName": "[[parameters('friendlyName')]",
        "dataType": "Server Activities"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "{{apiKey}}",
        "ApiKeyName": "UserApiKey"
      },
      "request": {
        "apiEndpoint": "{{BaseUrl}}/willard/v1/logging/svractivities",
        "httpMethod": "POST",
        "rateLimitQPS": 1,
        "queryWindowInMin": 5,
        "retryCount": 3,
        "timeoutInSeconds": 120,
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "User-Agent": "Microsoft-Sentinel-AirlockDigital-Connector",
          "DirectoryID": "{{directoryId}}",
          "TenantID": "{{tenantId}}"
        },
        "isPostPayloadJson": true,
        "queryParametersTemplate": "{}"
      },
      "response": {
        "eventsJsonPaths": [
          "$.response.svractivities"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "PersistentToken",
        "nextPageParaName": "checkpoint",
        "nextPageTokenJsonPath": "$.response.svractivities[-1:].checkpoint",
        "pagingInfoPlacement": "RequestBody"
      },
      "dcrConfig": {
