[
    {
        "name": "CSEEventsDCR",
        "apiVersion": "2021-09-01-preview",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "properties": {
            "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
            "streamDeclarations": {
                "Custom-CSEEventsInput": {
                    "columns": [
                        {
                            "name": "id",
                            "type": "string"
                        },
                        {
                            "name": "correlation_id",
                            "type": "string"
                        },
                        {
                            "name": "external_id",
                            "type": "string"
                        },
                        {
                            "name": "org_id",
                            "type": "string"
                        },
                        {
                            "name": "org_name",
                            "type": "string"
                        },
                        {
                            "name": "severity",
                            "type": "string"
                        },
                        {
                            "name": "action",
                            "type": "string"
                        },
                        {
                            "name": "type",
                            "type": "string"
                        },
                        {
                            "name": "sub_type",
                            "type": "string"
                        },
                        {
                            "name": "message",
                            "type": "string"
                        },
                        {
                            "name": "result",
                            "type": "string"
                        },
                        {
                            "name": "created_at",
                            "type": "long"
                        },
                        {
                            "name": "created_at_ns",
                            "type": "long"
                        },
                        {
                            "name": "user_principal",
                            "type": "dynamic"
                        },
                        {
                            "name": "workload_principal",
                            "type": "dynamic"
                        },
                        {
                            "name": "reported_by",
                            "type": "dynamic"
                        },
                        {
                            "name": "role",
                            "type": "dynamic"
                        },
                        {
                            "name": "trustscore",
                            "type": "dynamic"
                        },
                        {
                            "name": "service",
                            "type": "dynamic"
                        },
                        {
                            "name": "policy",
                            "type": "dynamic"
                        },
                        {
                            "name": "channel",
                            "type": "dynamic"
                        },
                        {
                            "name": "link",
                            "type": "dynamic"
                        },
                        {
                            "name": "url_filtering",
                            "type": "dynamic"
                        }
                    ]
                }
            },
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "cseLogAnalytics"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [
                        "Custom-CSEEventsInput"
                    ],
                    "destinations": [
                        "cseLogAnalytics"
                    ],
                    "transformKql": "source | extend TimeGenerated = make_datetime(1970,1,1) + created_at * 1ms | project TimeGenerated, EventId = id, EventType = ['type'], EventSubType = sub_type, Severity = severity, Action = action, Result = result, Message = message, OrgId = org_id, CorrelationId = correlation_id, CreatedAtMs = created_at, RawEvent = pack('id', id, 'correlation_id', correlation_id, 'external_id', external_id, 'org_id', org_id, 'org_name', org_name, 'severity', severity, 'action', action, 'type', ['type'], 'sub_type', sub_type, 'message', message, 'result', result, 'created_at', created_at, 'created_at_ns', created_at_ns, 'user_principal', user_principal, 'workload_principal', workload_principal, 'reported_by', reported_by, 'role', role, 'trustscore', trustscore, 'service', service, 'policy', policy, 'channel', channel, 'link', link, 'url_filtering', url_filtering)",
                    "outputStream": "Custom-CSEEvents_CL"
                }
            ]
        }
    }
]
