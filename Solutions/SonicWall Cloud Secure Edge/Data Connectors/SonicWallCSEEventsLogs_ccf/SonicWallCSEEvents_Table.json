[
    {
        "name": "CSEEvents_CL",
        "apiVersion": "2021-03-01-privatepreview",
        "type": "Microsoft.OperationalInsights/workspaces/tables",
        "location": "{{location}}",
        "properties": {
            "schema": {
                "name": "CSEEvents_CL",
                "columns": [
                    {
                        "name": "TimeGenerated",
                        "type": "datetime",
                        "description": "Event time in UTC, converted from created_at."
                    },
                    {
                        "name": "EventId",
                        "type": "string",
                        "description": "CSE event id (unique key)."
                    },
                    {
                        "name": "EventType",
                        "type": "string",
                        "description": "CSE type, for example Access or Identity."
                    },
                    {
                        "name": "EventSubType",
                        "type": "string",
                        "description": "CSE sub_type, for example ServiceTunnel."
                    },
                    {
                        "name": "Severity",
                        "type": "string",
                        "description": "CSE severity: DEBUG, INFO, WARN, or ERROR."
                    },
                    {
                        "name": "Action",
                        "type": "string",
                        "description": "CSE action."
                    },
                    {
                        "name": "Result",
                        "type": "string",
                        "description": "CSE result."
                    },
                    {
                        "name": "Message",
                        "type": "string",
                        "description": "CSE message."
                    },
                    {
                        "name": "OrgId",
                        "type": "string",
                        "description": "CSE organization id."
                    },
                    {
                        "name": "CorrelationId",
                        "type": "string",
                        "description": "CSE correlation_id, when present."
                    },
                    {
                        "name": "CreatedAtMs",
                        "type": "long",
                        "description": "Original created_at in epoch milliseconds."
                    },
                    {
                        "name": "RawEvent",
                        "type": "dynamic",
                        "description": "Full event as returned by the CSE API."
                    }
                ]
            }
        }
    }
]
