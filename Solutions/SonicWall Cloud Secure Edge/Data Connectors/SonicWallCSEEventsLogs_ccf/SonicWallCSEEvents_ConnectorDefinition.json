{
    "name": "SonicWallCSEEvents",
    "apiVersion": "2022-09-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "SonicWallCSEEvents",
            "title": "SonicWall Cloud Secure Edge Events",
            "publisher": "SonicWall",
            "descriptionMarkdown": "The SonicWall Cloud Secure Edge (CSE) connector ingests CSE events (sign-ins, private access, device trust, Internet Access, malware protection, and Command Center sign-ins) from the CSE events API into the `CSEEvents_CL` table, using the Codeless Connector Framework. Events are polled every 5 minutes and usually reach Microsoft Sentinel within 10 minutes.\n\nEvents that occur while the connector is disconnected, being reconnected, or failing (for example after the API key is changed or deleted) are not fetched later. Use the SonicWall CSE backfill tool after any of these to fill the gap.\n\nEach workspace connects to one CSE organization. To collect events from more than one CSE organization, use a separate workspace for each.\n\nQuery the data with the `CSEEvents` function installed with this solution.",
            "graphQueriesTableName": "CSEEvents_CL",
            "graphQueries": [
                {
                    "metricName": "Total events received",
                    "legend": "CSE events",
                    "baseQuery": "{{graphQueriesTableName}}"
                }
            ],
            "sampleQueries": [
                {
                    "description": "Latest CSE events",
                    "query": "{{graphQueriesTableName}}\n| sort by TimeGenerated desc\n| take 10"
                },
                {
                    "description": "Events by type and sub type",
                    "query": "{{graphQueriesTableName}}\n| summarize Count = count() by EventType, EventSubType"
                }
            ],
            "dataTypes": [
                {
                    "name": "{{graphQueriesTableName}}",
                    "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors"
                }
            ],
            "availability": {
                "status": 1,
                "isPreview": true
            },
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "read": true,
                            "write": true,
                            "delete": true
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "CSE API key",
                        "description": "A CSE Command Center API key with read access to events."
                    }
                ]
            },
            "instructionSteps": [
                {
                    "title": "Connect SonicWall Cloud Secure Edge to Microsoft Sentinel",
                    "description": "Select the Command Center region, enter the CSE API key, and select Connect.",
                    "instructions": [
                        {
                            "type": "Dropdown",
                            "parameters": {
                                "label": "Command Center API host (US: net.banyanops.com, EU: eucc.console.banyanops.com)",
                                "name": "apiHost",
                                "options": [
                                    {
                                        "key": "net.banyanops.com",
                                        "text": "net.banyanops.com"
                                    },
                                    {
                                        "key": "eucc.console.banyanops.com",
                                        "text": "eucc.console.banyanops.com"
                                    }
                                ],
                                "placeholder": "Select the API host",
                                "isMultiSelect": false,
                                "required": true
                            }
                        },
                        {
                            "type": "Textbox",
                            "parameters": {
                                "label": "CSE API key",
                                "placeholder": "API key",
                                "type": "password",
                                "name": "apikey"
                            }
                        },
                        {
                            "type": "ConnectionToggleButton",
                            "parameters": {
                                "connectLabel": "Connect",
                                "disconnectLabel": "Disconnect",
                                "name": "toggle"
                            }
                        }
                    ]
                }
            ]
        }
    }
}
