[
    {
        "name": "CSEEventsPoller",
        "apiVersion": "2022-10-01-preview",
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "kind": "RestApiPoller",
        "properties": {
            "connectorDefinitionName": "SonicWallCSEEvents",
            "dataType": "CSEEvents_CL",
            "dcrConfig": {
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
                "streamName": "Custom-CSEEventsInput"
            },
            "auth": {
                "type": "APIKey",
                "ApiKey": "[[parameters('apikey')]",
                "ApiKeyName": "Authorization",
                "ApiKeyIdentifier": "Bearer"
            },
            "request": {
                "apiEndpoint": "[[concat('https://', first(parameters('apiHost')), '/api/v1/events')]",
                "httpMethod": "GET",
                "queryWindowInMin": 5,
                "queryTimeFormat": "UnixTimestampInMills",
                "startTimeAttributeName": "after",
                "endTimeAttributeName": "before",
                "queryParameters": {
                    "order": "ASC",
                    "severity": "DEBUG"
                },
                "headers": {
                    "Accept": "application/json",
                    "User-Agent": "SonicWall-CSE-Sentinel-CCF"
                },
                "rateLimitQPS": 2,
                "paginatedCallsPerSecond": 2,
                "retryCount": 3,
                "timeoutInSeconds": 60
            },
            "paging": {
                "pagingType": "Offset",
                "offsetParaName": "skip",
                "pageSizeParameterName": "limit",
                "pageSize": 1000,
                "zeroBasedIndexing": true
            },
            "response": {
                "eventsJsonPaths": [
                    "$.data"
                ],
                "format": "json"
            },
            "isActive": true
        }
    }
]
