{
  "name": "TheHiveConnector",
  "apiVersion": "2025-09-01",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "{{location}}",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "TheHiveConnector",
      "title": "TheHive (via Codeless Connector Framework)",
      "publisher": "TheHive",
      "descriptionMarkdown": "The TheHive data connector provides the capability to ingest [TheHive](https://thehive-project.org/) security incident response platform data into Microsoft Sentinel through the REST API. Refer to [API documentation](https://docs.thehive-project.org/thehive/legacy/thehive3/api/api-guide/) for more information. The connector provides the ability to get cases, tasks, and alerts from TheHive and visualize them in Azure Sentinel.",
      "graphQueries": [
        {
          "metricName": "Total data received",
          "legend": "The Hive Events",
          "baseQuery": "TheHiveData"
        },
        {
          "metricName": "Cases only",
          "legend": "TheHiveData Cases",
          "baseQuery": "TheHiveData | where ObjectType == \"Case\""
        },
        {
          "metricName": "Alerts only",
          "legend": "TheHiveData Alerts",
          "baseQuery": "TheHiveData | where ObjectType == \"Alert\""
        }
      ],
      "sampleQueries": [
        {
          "description": "All TheHive events",
          "query": "TheHiveData\n| sort by TimeGenerated desc"
        },
        {
          "description": "Get sample of TheHive events",
          "query": "TheHiveData\n| take 10"
        },
        {
          "description": "Summary by entity type",
          "query": "TheHiveData\n| summarize count() by ObjectType"
        }
      ],
      "dataTypes": [
        {
          "name": "TheHiveData",
          "lastDataReceivedQuery": "TheHiveData\n| where TimeGenerated > ago(12h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "isPreview": false,
        "status": 1
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and Write permissions are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "write": true,
              "read": true,
              "delete": true,
              "action": false
            }
          }
        ],
        "customs": [
          {
            "name": "TheHive API access",
            "description": "**TheHive API Version 4 and above** access is required for the TheHive API."
          }
        ]
      },
      "instructionSteps": [
        {
          "title": "TheHive connections",
          "description": "Add independent TheHive connections. Select one or more connections to delete them.",
          "instructions": [
            {
              "type": "DataConnectorsGrid",
              "parameters": {
                "mapping": [
                  {
                    "columnName": "Connection Alias",
                    "columnValue": "properties.addOnAttributes.friendlyName"
                  },
                  {
                    "columnName": "TheHive Base URL",
                    "columnValue": "properties.addOnAttributes.theHiveBaseUrl"
                  }
                ],
                "menuItems": [
                  "DeleteConnector"
                ],
                "isMultiSelect": true
              }
            },
            {
              "type": "ContextPane",
              "parameters": {
                "isPrimary": true,
                "label": "Add Connection",
                "title": "Add TheHive connection",
                "subtitle": "Configure a new connection",
                "contextPaneType": "DataConnectorsContextPane",
                "instructionSteps": [
                  {
                    "title": "Connection settings",
                    "description": "Provide the connection parameters for this data source.",
                    "instructions": [
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "Connection Alias",
                          "placeholder": "Enter a unique alias for this connection",
                          "type": "text",
                          "name": "friendlyName",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "InfoMessage",
                        "parameters": {
                          "text": "Use a different alias for each independent connection, even when connecting to the same TheHive instance. Reusing an alias updates that connection rather than creating a new one.",
                          "visible": true,
                          "inline": true
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "TheHive Base URL",
                          "placeholder": "https://thehive.example.com",
                          "type": "text",
                          "name": "theHiveBaseUrl",
                          "validations": {
                            "required": true
                          }
                        }
                      },
                      {
                        "type": "Markdown",
                        "parameters": {
                          "content": "Get the API key from your TheHive user profile settings (or a dedicated user created for this purpose)."
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "API Key",
                          "placeholder": "API key for TheHive API",
                          "type": "password",
                          "name": "apiKey",
                          "validations": {
                            "required": true
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}