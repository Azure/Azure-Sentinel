[
  {
    "name": "MimecastHumanRiskOrganizationPoller",
    "apiVersion": "2023-02-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "MimecastHumanRiskCCF",
      "dataType": "MimecastHumanRisk_Organization_CL",
      "dcrConfig": {
        "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
        "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]",
        "streamName": "Custom-MimecastHumanRisk_Organization_CL"
      },
      "auth": {
        "type": "OAuth2",
        "ClientId": "[[parameters('clientId')]",
        "ClientSecret": "[[parameters('clientSecret')]",
        "GrantType": "client_credentials",
        "TokenEndpoint": "[[concat(trim(parameters('mimecastBaseUrl')), '/oauth/token')]",
        "TokenEndpointHeaders": {
          "Content-Type": "application/x-www-form-urlencoded",
          "Accept": "application/json"
        }
      },
      "request": {
        "apiEndpoint": "[[concat(trim(parameters('mimecastBaseUrl')), '/human-risk/v1/organization')]",
        "httpMethod": "GET",
        "queryParameters": {
          "monthsBack": "[[if(equals(parameters('monthsBack'), 'monthsBack'), '3', string(parameters('monthsBack')))]",
          "fields": "attackTotal,riskResponses,totals.totalActions,totals.notifications,totals.outboundActions,totals.groupChanges"
        },
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Microsoft-Sentinel-MimecastHumanRisk-CCF"
        },
        "rateLimitQPS": 1,
        "queryWindowInMin": "[[int(first(parameters('pollingInterval')))]",
        "retryCount": 3,
        "timeoutInSeconds": 120
      },
      "response": {
        "eventsJsonPaths": [
          "$.trends[*]",
          "$.totals"
        ],
        "format": "json"
      },
      "isActive": true
    }
  },
