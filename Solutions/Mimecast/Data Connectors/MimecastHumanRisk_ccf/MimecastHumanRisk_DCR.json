{
  "name": "MimecastHumanRiskDCR",
  "apiVersion": "2021-09-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-MimecastHumanRisk_Organization_CL": {
        "columns": [
          {
            "name": "month",
            "type": "string"
          },
          {
            "name": "humanRiskScore",
            "type": "int"
          },
          {
            "name": "humanRiskFactor",
            "type": "string"
          },
          {
            "name": "humanRiskScoreTrend",
            "type": "int"
          },
          {
            "name": "attackScore",
            "type": "int"
          },
          {
            "name": "attackFactor",
            "type": "string"
          },
          {
            "name": "attackTrend",
            "type": "int"
          },
          {
            "name": "attackTotal",
            "type": "int"
          },
          {
            "name": "riskResponses",
            "type": "int"
          },
          {
            "name": "totalActions",
            "type": "int"
          },
          {
            "name": "notifications",
            "type": "int"
          },
          {
            "name": "outboundActions",
            "type": "int"
          },
          {
            "name": "groupChanges",
            "type": "int"
          }
        ]
      },
      "Custom-MimecastHumanRisk_Behaviors_CL": {
        "columns": [
          {
            "name": "type",
            "type": "string"
          },
          {
            "name": "score",
            "type": "int"
          },
          {
            "name": "factor",
            "type": "string"
          },
          {
            "name": "eventCount",
            "type": "int"
          },
          {
            "name": "trend",
            "type": "int"
          },
          {
            "name": "events",
            "type": "dynamic"
          }
        ]
      },
      "Custom-MimecastHumanRisk_Attacks_CL": {
        "columns": [
          {
            "name": "attackScore",
            "type": "int"
          },
          {
            "name": "attackFactor",
            "type": "string"
          },
          {
            "name": "attackTypes",
            "type": "dynamic"
          }
        ]
      },
      "Custom-MimecastHumanRisk_Individuals_CL": {
        "columns": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "displayName",
            "type": "string"
          },
          {
            "name": "emailAddress",
            "type": "string"
          },
          {
            "name": "firstName",
            "type": "string"
          },
          {
            "name": "lastName",
            "type": "string"
          },
          {
            "name": "managerName",
            "type": "string"
          },
          {
            "name": "managerId",
            "type": "string"
          },
          {
            "name": "department",
            "type": "string"
          },
          {
            "name": "location",
            "type": "string"
          },
          {
            "name": "jobTitle",
            "type": "string"
          },
          {
            "name": "tenureMonths",
            "type": "int"
          },
          {
            "name": "tenureStatus",
            "type": "string"
          },
          {
            "name": "startDateTime",
            "type": "string"
          },
          {
            "name": "humanRiskScore",
            "type": "int"
          },
          {
            "name": "humanRiskFactor",
            "type": "string"
          },
          {
            "name": "attackScore",
            "type": "int"
          },
          {
            "name": "attackFactor",
            "type": "string"
          },
          {
            "name": "behaviors",
            "type": "dynamic"
          },
          {
            "name": "attacks",
            "type": "dynamic"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-MimecastHumanRisk_Organization_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | project TimeGenerated = now(), Month = month, HumanRiskScore = humanRiskScore, HumanRiskFactor = humanRiskFactor, HumanRiskScoreTrend = humanRiskScoreTrend, AttackScore = attackScore, AttackFactor = attackFactor, AttackTrend = attackTrend, AttackTotal = attackTotal, RiskResponses = riskResponses, TotalActions = totalActions, Notifications = notifications, OutboundActions = outboundActions, GroupChanges = groupChanges",
        "outputStream": "Custom-MimecastHumanRisk_Organization_CL"
      },
      {
        "streams": [
          "Custom-MimecastHumanRisk_Behaviors_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | project TimeGenerated = now(), BehaviorType = type, Score = score, Factor = factor, EventCount = eventCount, Trend = trend, Events = events",
        "outputStream": "Custom-MimecastHumanRisk_Behaviors_CL"
      },
      {
        "streams": [
          "Custom-MimecastHumanRisk_Attacks_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | project TimeGenerated = now(), AttackScore = attackScore, AttackFactor = attackFactor, AttackTypes = attackTypes",
        "outputStream": "Custom-MimecastHumanRisk_Attacks_CL"
      },
      {
        "streams": [
          "Custom-MimecastHumanRisk_Individuals_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | project TimeGenerated = now(), IndividualId = id, DisplayName = displayName, EmailAddress = emailAddress, FirstName = firstName, LastName = lastName, ManagerName = managerName, ManagerId = managerId, Department = department, Location = location, JobTitle = jobTitle, TenureMonths = tenureMonths, TenureStatus = tenureStatus, StartDateTime = todatetime(startDateTime), HumanRiskScore = humanRiskScore, HumanRiskFactor = humanRiskFactor, AttackScore = attackScore, AttackFactor = attackFactor, Behaviors = behaviors, Attacks = attacks",
        "outputStream": "Custom-MimecastHumanRisk_Individuals_CL"
      }
    ]
  }
}