  {
    "name": "[[concat(parameters('innerWorkspace'),'/Microsoft.SecurityInsights/', 'NetcraftTakedownPoller', parameters('guidValue'))]",
    "apiVersion": "2024-09-01",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "NetcraftIntegrationGatewayDefinition",
      "dataType": "NetcraftTakedown_CL",
      "dcrConfig": {
        "streamName": "Custom-NetcraftTakedown_CL",
        "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
        "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apikey')]",
        "ApiKeyName": "Authorization",
        "ApiKeyIdentifier": "Bearer"
      },
      "request": {
        "apiEndpoint": "[[concat(parameters('apiBaseUrl'),'/events/takedown/takedowns')]",
        "rateLimitQPS": 10,
        "paginatedCallsPerSecond": 10.0,
        "queryWindowInMin": "[[first(parameters('pollingFrequency'))]",
        "httpMethod": "GET",
        "retryCount": 5,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Microsoft-Sentinel-Netcraft-Integration-Gateway-Connector"
        },
        "queryParameters": {
          "connector": "sentinel",
          "limit": 100
        }
      },
      "paging": {
        "pagingType": "PersistentToken",
        "PageSize": "100",
        "PageSizeParameterName": "limit",
        "NextPageTokenJsonPath": "$.next_cursor",
        "NextPageParaName": "cursor"
      },
      "response": {
        "eventsJsonPaths": [
          "$.items"
        ],
        "format": "json"
      }
    }
  },
