[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "[[concat(parameters('innerWorkspace'),'/Microsoft.SecurityInsights/',variables('connectorName'))]",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "SAPCC",
      "dataType": "SentinelHealth",
      "dcrConfig": {
        "streamName": "Microsoft-SentinelHealth"
      },
      "auth": {
        "type": "OAuth2",
        "ClientSecret": "{{ClientSecret}}",
        "ClientId": "{{ClientId}}",
        "GrantType": "client_credentials",
        "TokenEndpoint": "[[concat(replace(parameters('TokenEndpoint'), '/oauth/token', ''), '/oauth/token?grant_type=client_credentials')]",
        "tokenEndpointHeaders": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "TokenEndpointQueryParameters": {}
      },
      "request": {
        "apiEndpoint": "[[concat(parameters('integrationServerUrl'), '/http', parameters('apiPathSuffix'))]",
        "httpMethod": "GET",
        "queryWindowInMin": "[[int(parameters('pollingFrequencyMinutes'))]",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ss.000000+00:00",
        "startTimeAttributeName": "startTimeUTC",
        "endTimeAttributeName": "endTimeUTC",
        "rateLimitQps": 2,
        "retryCount": 1,
        "timeoutInSeconds": 180,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Scuba",
          "rfcDestinationName": "[[parameters('rfcDestinationName')]"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "LinkHeader"
      }
    }
  }
]