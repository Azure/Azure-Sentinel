{
    "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
    "apiVersion": "2022-09-01-preview",
    "name": "SAPCC",
    "location": "{{location}}",
    "kind": "Customizable",
    "properties": {
        "connectorUiConfig": {
            "id": "SAPCC",
            "title": "Microsoft Sentinel for SAP - agentless",
            "publisher": "Microsoft",
            "logo": "SapLogo.svg",
            "descriptionMarkdown": "SAP systems and applications handle massive volumes of business-critical data, hosted on cloud/on-premises infrastructure. <br> Due to the complexity of the SAP ecosystem, security operations (SecOps) teams face the challenge of effectively monitoring and protecting their organization against growing threats.<br>A breach of the SAP system could result in data loss, disruption to business processes, loss of revenue, and major reputation damage.<br>The Agentless Microsoft Sentinel SAP connector, part of the Microsoft Sentinel Solution for SAP, leverages SAP Cloud Connector and SAP Integration Suite to ingest SAP logs into Microsoft Sentinel workspaces with no need for an agent deployment. <br>Microsoft Sentinel solution for SAP is billed as an add-on per production system ID (SID) per hour in addition to the existing Microsoft Sentinel consumption-billing model. <br>For more information, see the [offer page](https://aka.ms/SAPPromo) and [Microsoft Sentinel Solution for SAP documentation](https://docs.microsoft.com/azure/sentinel/sap/preparing-sap?pivots=connection-agentless#configure-sap-cloud-connector-settings).",
            "graphQueriesTableName": "ABAPAuditLog",
            "graphQueries": [
                {
                    "metricName": "Number of log records received",
                    "legend": "SAP Audit Log",
                    "baseQuery": "{{graphQueriesTableName}}"
                }
            ],
            "sampleQueries": [
                {
                    "description": "Get Sample Events",
                    "query": "{{graphQueriesTableName}}\n | take 10"
                }
            ],
            "dataTypes": [
                {
                    "name": "{{graphQueriesTableName}}",
                    "lastDataReceivedQuery": "{{graphQueriesTableName}}\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
                },
                {
                    "name": "ABAPChangeDocsLog",
                    "lastDataReceivedQuery": "ABAPChangeDocsLog\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
                },
                {
                    "name": "ABAPUserDetails",
                    "lastDataReceivedQuery": "ABAPUserDetails\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
                },
                {
                    "name": "ABAPAuthorizationDetails",
                    "lastDataReceivedQuery": "ABAPAuthorizationDetails\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
                }
            ],
            "connectivityCriteria": [
                {
                    "type": "HasDataConnectors",
                    "value": null
                }
            ],
            "availability": {
                "isPreview": false
            },
            "permissions": {
                "resourceProvider": [
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "write": true,
                            "read": true,
                            "delete": true
                        }
                    },
                    {
                        "provider": "Microsoft.OperationalInsights/workspaces/sharedKeys",
                        "permissionsDisplayText": "Read permissions to shared keys for the workspace are required. [See the documentation to learn more about workspace keys](https://docs.microsoft.com/azure/azure-monitor/platform/agent-windows#obtain-workspace-id-and-key)",
                        "providerDisplayName": "Keys",
                        "scope": "Workspace",
                        "requiredPermissions": {
                            "action": true
                        }
                    }
                ],
                "customs": [
                    {
                        "name": "Microsoft Entra",
                        "description": "Permission to create an app registration in Microsoft Entra ID. Typically requires Entra ID Application Developer role or higher."
                    },
                    {
                        "name": "Microsoft Azure",
                        "description": "Permission to assign Monitoring Metrics Publisher role on data collection rules. Typically requires Azure RBAC Owner or User Access Administrator role."
                    },
                    {
                        "name": "SAP Integration Suite",
                        "description": "Connection details including OAuth v2 client credentials and API endpoints used by Integration Suite."
                    }
                ]
            },
            "instructionSteps": [
                {
                    "description": "Deploying the Sentinel solution for SAP Agentless Data Connector requires collaboration between the SOC engineer and the SAP admin personas. The recommended ownership is defined for each of the steps below.",
                    "instructions": [
                        {
                            "type": "Markdown",
                            "parameters": {
                                "content": "### Initial connector configuration - Run the steps below once:"
                            }
                        },
                        {
                            "type": "InstructionStepsGroup",
                            "parameters": {
                                "instructionSteps": [
                                    {
                                        "title": "1. Trigger automatic deployment of required Azure resources / SOC Engineer",
                                        "instructions": [
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": "Select \"Deploy required Azure resources\" below.\n This step automatically deploys the required data collection rule (DCR) and data collection endpoint (DCE) in your Azure subscription. \n It also creates a Microsoft Entra ID app registration and assigns it with required permissions on the DCR. \nOnce the Azure resources are deployed, the values in the following steps are populated automatically."
                                                }
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Deploy required azure resources",
                                                    "applicationDisplayName": "SAP Agentless push to Sentinel"
                                                },
                                                "type": "DeployPushConnectorButton"
                                            }
                                        ]
                                    },
                                    {
                                        "title": "2. Deploy an OAuth2 client credentials artifact in the SAP Integration Suite / SAP Admin",
                                        "instructions": [
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": "The client credentials artifact is used to store the Microsoft Entra ID app registration connection details, which were created in step 1. \nUse the following details to create your SAP Integration Suite client credentials artifact. [Learn more](https://help.sap.com/docs/cloud-integration/sap-cloud-integration/deploying-oauth2-client-credentials-artifact) (SAP Help Portal)"
                                                }
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Name (Do not change):",
                                                    "value": "LogIngestionAPI"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Description:",
                                                    "value": "Oauth2 Client Credentials for the Microsoft Sentinel connector"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Runtimes:",
                                                    "value": "Select all relevant runtimes"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "[concat('Token Service URL, constructed as ', variables('login_target'),  '<TenantId>/oauth2/v2.0/token:')]",
                                                    "fillWith": [
                                                        "TenantId",
                                                        "/oauth2/v2.0/token"
                                                    ],
                                                    "value": "[concat(variables('login_target'), '{0}{1}')]",
                                                    "placeholder": "[concat(variables('login_target'), '<your Microsoft Entra ID tenant ID>/oauth2/v2.0/token')]"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Grant Type:",
                                                    "value": "Send as Part of Body"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Client ID:",
                                                    "fillWith": [
                                                        "ApplicationId"
                                                    ],
                                                    "placeholder": "Client id values cannot be viewed, except for immediately after creation. Be sure to save the client id when created before leaving the page."
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Client Secret:",
                                                    "fillWith": [
                                                        "ApplicationSecret"
                                                    ],
                                                    "placeholder": "Client secret values cannot be viewed, except for immediately after creation. Be sure to save the secret when created before leaving the page."
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Client Authentication:",
                                                    "value": "Send as body parameter"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Scope:",
                                                    "value": "https://monitor.azure.com//.default"
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "Content Type:",
                                                    "value": "application/x-www-form-urlencoded"
                                                },
                                                "type": "CopyableLabel"
                                            }
                                        ]
                                    },
                                    {
                                        "title": "3. Deploy the SAP agentless data connector package to SAP Integration Suite / SAP Admin",
                                        "instructions": [
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": "> a. In the SAP Integration Suite portal, open the **Discover** section. Search for **Microsoft Sentinel Solution** and open it. Click **Copy** to import the integration package into your Cloud Integration tenant. [Learn more](https://help.sap.com/docs/integration-suite/sap-integration-suite/importing-integration-packages) (SAP Help Portal). <br> \n> b. Open the package and go to the **Artifacts** tab, then select the **Data Collector** configuration. [Learn more](https://help.sap.com/docs/integration-suite/sap-integration-suite/importing-integration-packages) (SAP Help Portal). <br> \n> c. Configure the integration flow with the following details:"
                                                }
                                            },
                                            {
                                                "parameters": {
                                                    "label": "LogsIngestionURL:",
                                                    "fillWith": [
                                                        "DataCollectionEndpoint"
                                                    ],
                                                    "placeholder": "Deploy the required azure resources to get the Data Collection Endpoint."
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "parameters": {
                                                    "label": "DCRImmutableId:",
                                                    "fillWith": [
                                                        "DataCollectionRuleId"
                                                    ],
                                                    "placeholder": "Deploy the required azure resources to get the Data Collection Rule immutable ID."
                                                },
                                                "type": "CopyableLabel"
                                            },
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": "> d. Deploy the i-flow using SAP Cloud Integration as the runtime service."
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "instructions": [
                        {
                            "type": "Markdown",
                            "parameters": {
                                "content": "### Add monitored SAP Systems - Run the steps below for each monitored SAP system: <br>\n  For full monitoring coverage, we recommend that you enable monitoring on all client IDs of the monitored SAP systems, including clients 000 and 066."
                            }
                        },
                        {
                            "type": "InstructionStepsGroup",
                            "parameters": {
                                "instructionSteps": [
                                    {
                                        "title": "1. Add monitored SAP system to SAP Cloud Connector / SAP Admin",
                                        "instructions": [
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": ">a. Follow the steps in [Configure SAP Cloud Connector settings](https://aka.ms/SAPAgentlessAddRFCDestination), for each of the SAP systems and clients. Learn more (SAP Help Portal): [Configure Access Control (RFC)](https://help.sap.com/docs/connectivity/sap-btp-connectivity-cf/configure-access-control-rfc) and [Create RFC Destinations](https://help.sap.com/docs/cloud-integration/sap-cloud-integration/creating-rfc-destination). <br> b. Provide the SOC engineer with the RFC destination name(s) you created as well as the Process Integration Runtime service key JSON file you created in [Configure SAP BTP Settings](https://aka.ms/SAPAgentlessConfigureSAPBTPsettings)."
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "title": "2. Connect SAP System to Sentinel / SOC Engineer",
                                        "description": "Add each of the clients of the monitored SAP system:",
                                        "instructions": [
                                            {
                                                "type": "Markdown",
                                                "parameters": {
                                                    "content": " \n "
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "ContextPane",
                            "description": "Fill the below fields with the RFC destination name and the details from Process Integration Runtime service key JSON provided by your SAP Admin.",
                            "parameters": {
                                "contextPaneType": "DataConnectorsContextPane",
                                "label": "Add SAP client",
                                "isPrimary": true,
                                "title": "Connect to an SAP Client",
                                "instructionSteps": [
                                    {
                                        "title": "Destination Details",
                                        "instructions": [
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "RFC destination name (e.g. RFC-PRD-400)",
                                                    "placeholder": "Request this from your SAP admin",
                                                    "type": "text",
                                                    "name": "rfcDestinationName"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "SAP Agentless Client ID",
                                                    "placeholder": "Client ID",
                                                    "type": "text",
                                                    "name": "ClientId"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "SAP Agentless Client Secret",
                                                    "placeholder": "Client Secret",
                                                    "type": "password",
                                                    "name": "ClientSecret"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Authorization server URL (UAA server)",
                                                    "placeholder": "https://azure-private.authentication.myEndpoint.hana.ondemand.com/oauth/token",
                                                    "type": "text",
                                                    "name": "TokenEndpoint"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Integration Suite Endpoint",
                                                    "placeholder": "https://azure-private.myIntegrationSuiteEndpoint.hana.ondemand.com",
                                                    "type": "text",
                                                    "name": "integrationServerUrl"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "title": "Advanced",
                                        "instructions": [
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "API Endpoint Path Suffix (optional)",
                                                    "placeholder": "/microsoft/sentinel/sap-log-trigger",
                                                    "type": "text",
                                                    "description": "Override the URL path suffix (after URL path segment \"/http\") to enable advanced scenarios inspired by community-driven integrations with Microsoft Sentinel for SAP. See https://aka.ms/sentinel-sap-community",
                                                    "name": "apiPathSuffix",
                                                    "defaultValue": "/microsoft/sentinel/sap-log-trigger"
                                                }
                                            },
                                            {
                                                "type": "Textbox",
                                                "parameters": {
                                                    "label": "Polling Frequency (minutes, 1-15)",
                                                    "placeholder": "1",
                                                    "type": "text",
                                                    "description": "Caution! Intervals bigger than 2mins may increase selected SAP audit message size impacting SAP CPI performance, and compromises real-time threat detection! See limits here: https://aka.ms/logingest-api-limits and on SAP documentation: https://help.sap.com/docs/cloud-integration/sap-cloud-integration/optimize-performance#message-size",
                                                    "name": "pollingFrequencyMinutes",
                                                    "defaultValue": "1"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "title": "SAP Connections",
                    "instructions": [
                        {
                            "type": "DataConnectorsGrid",
                            "parameters": {
                                "mapping": [
                                    {
                                        "columnName": "RFC destination name",
                                        "columnValue": "properties.request.headers['rfcDestinationName']"
                                    },
                                    {
                                        "columnName": "Integration Suite Endpoint",
                                        "columnValue": "properties.request.apiEndpoint"
                                    }
                                ],
                                "menuItems": [
                                    "DeleteConnector"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    }
}