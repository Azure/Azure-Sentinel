[
    {
        "name": "{{innerWorkspace}}/Microsoft.SecurityInsights/OktaDCV1_{{domainname}}",
        "apiVersion": "2024-09-01",
        "type": "Microsoft.SecurityInsights/dataConnectors",
        "location": "{{location}}",
        "kind": "RestApiPoller",
        "properties": {
            "connectorDefinitionName":"OktaSSOv2",
            "dcrConfig": {
                "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
                "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
                "streamName": "Custom-OktaSSO_CL"
            },
            "dataType": "Okta System Log API",
            "addOnAttributes": {
                "DomainName": "[[parameters('domainname')]"
            },
            "response": {
                "eventsJsonPaths": [
                    "$"
                ],
                "format": "json"
            },
            "paging": {
                "pagingType": "LinkHeader"
            },
            "auth": {
                "apiKeyName": "Authorization",
                "ApiKey": "{{apikey}}",
                "apiKeyIdentifier": "SSWS",
                "type": "APIKey"
            },
            "request": {
                "apiEndpoint": "https://{{domainname}}/api/v1/logs",
                "rateLimitQPS": 1,
                "paginatedCallsPerSecond": 1.0,
                "queryWindowInMin": 5,
                "httpMethod": "GET",
                "retryCount": 3,
                "timeoutInSeconds": 60,
                "headers": {
                    "Accept": "application/json",
                    "User-Agent": "Scuba"
                },
                "queryParameters": {
                    "limit": "1000"
                },
                "rateLimitConfig": {
                    "evaluation": {
                        "checkMode": "OnlyWhen429"
                    },
                    "extraction": {
                        "source": "DefaultHeaders"
                    },
                    "retryStrategy": {
                        "useResetOrRetryAfterHeaders": true
                    }
                },
                "startTimeAttributeName": "since",
                "endTimeAttributeName": "until"
            },
            "isActive": true
        }
    }
]