        "AppId": "{{appId}}",
        "ServicePrincipalId": "{{servicePrincipalId}}"
      },
      "request": {
        "RetryCount": 1
      },
      "response": {
        "eventsJsonPaths": [
          "$"
        ]
      }
    }
  }
]
