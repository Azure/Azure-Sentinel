[
  {
    "name": "RedRaysSAPSecurityFindingsPush",
    "apiVersion": "2024-09-01",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "kind": "Push",
    "properties": {
      "connectorDefinitionName": "RedRaysSAPSecurityFindings",
      "dataType": "RedRaysExportHealth_CL",
      "dcrConfig": {
        "streamName": "Custom-RedRaysExportHealth_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
