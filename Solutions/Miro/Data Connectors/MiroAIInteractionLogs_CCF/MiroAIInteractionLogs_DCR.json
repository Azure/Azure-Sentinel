[
    {
        "name": "MiroAIInteractionLogsDCR",
        "apiVersion": "2024-03-11",
        "type": "Microsoft.Insights/dataCollectionRules",
        "location": "{{location}}",
        "properties": {
            "streamDeclarations": {
                "Custom-MiroAIInteractionLogs_CL": {
                    "columns": [
                        {
                            "name": "id",
                            "type": "string"
                        },
                        {
                            "name": "createdAt",
                            "type": "string"
                        },
                        {
                            "name": "storedAt",
                            "type": "string"
                        },
                        {
                            "name": "eventType",
                            "type": "string"
                        },
                        {
                            "name": "turnId",
                            "type": "string"
                        },
                        {
                            "name": "surface",
                            "type": "string"
                        },
                        {
                            "name": "actor",
                            "type": "dynamic"
                        },
                        {
                            "name": "object",
                            "type": "dynamic"
                        },
                        {
                            "name": "session",
                            "type": "dynamic"
                        },
                        {
                            "name": "model",
                            "type": "dynamic"
                        },
                        {
                            "name": "tool",
                            "type": "dynamic"
                        },
                        {
                            "name": "details",
                            "type": "dynamic"
                        }
                    ]
                }
            },
            "dataSources": {},
            "destinations": {
                "logAnalytics": [
                    {
                        "workspaceResourceId": "{{workspaceResourceId}}",
                        "name": "clv2ws1"
                    }
                ]
            },
            "dataFlows": [
                {
                    "streams": [
                        "Custom-MiroAIInteractionLogs_CL"
                    ],
                    "destinations": [
                        "clv2ws1"
                    ],
                    "transformKql": "source\n| extend TimeGenerated = todatetime(createdAt)\n| extend createdAt = todatetime(createdAt)\n| extend storedAt = todatetime(storedAt)\n| extend actor_id = iff(isnull(actor), \"\", tostring(actor.id))\n| extend actor_email = iff(isnull(actor), \"\", tostring(actor.email))\n| extend actor_name = iff(isnull(actor), \"\", tostring(actor.name))\n| extend object_id = iff(isnull(object), \"\", tostring(object.id))\n| extend session_id = iff(isnull(session), \"\", tostring(session.id))\n| project TimeGenerated, id, createdAt, storedAt, eventType, turnId, surface, actor_id, actor_email, actor_name, object_id, session_id, actor, object, session, model, tool, details",
                    "outputStream": "Custom-MiroAIInteractionLogs_CL"
                }
            ],
            "dataCollectionEndpointId": "[concat('/subscriptions/',variables('subscriptionID'),'/resourceGroups/',resourceGroup().name,'/providers/Microsoft.Insights/dataCollectionEndpoints/',{{dataCollectionEndpointId}}"
        }
    }
]
