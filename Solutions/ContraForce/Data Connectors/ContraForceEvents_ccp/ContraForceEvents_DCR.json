{
  "name": "ContraForceEventsDCR",
  "apiVersion": "2023-03-11",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-ContraForceEventsInput": {
        "columns": [
          { "name": "id", "type": "string" },
          { "name": "timeGenerated", "type": "datetime" },
          { "name": "workspaceId", "type": "string" },
          { "name": "discriminator", "type": "string" },
          { "name": "activityType", "type": "string" },
          { "name": "activityAction", "type": "string" },
          { "name": "actorId", "type": "string" },
          { "name": "actorName", "type": "string" },
          { "name": "actorEmail", "type": "string" },
          { "name": "targetResourceType", "type": "string" },
          { "name": "targetResourceId", "type": "string" },
          { "name": "targetResourceName", "type": "string" },
          { "name": "metadata", "type": "string" }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": ["Custom-ContraForceEventsInput"],
        "destinations": ["clv2ws1"],
        "transformKql": "source | project TimeGenerated = timeGenerated, EventId = id, CfWorkspaceId = workspaceId, Discriminator = discriminator, ActivityType = activityType, ActivityAction = activityAction, ActorId = actorId, ActorName = actorName, ActorEmail = actorEmail, TargetResourceType = targetResourceType, TargetResourceId = targetResourceId, TargetResourceName = targetResourceName, Metadata = metadata",
        "outputStream": "Custom-ContraForceEvents_CL"
      }
    ]
  }
}
