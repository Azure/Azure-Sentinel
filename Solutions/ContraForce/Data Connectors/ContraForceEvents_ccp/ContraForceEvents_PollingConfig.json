[
  {
    "name": "ContraForceEvents",
    "apiVersion": "2023-02-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "ContraForceEvents",
      "dataType": "ContraForceEvents_CL",
      "dcrConfig": {
        "streamName": "Custom-ContraForceEventsInput",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "Basic",
        "userName": "{{clientId}}",
        "password": "{{clientSecret}}"
      },
      "request": {
        "apiEndpoint": "{{apiBaseUrl}}/api/v2/workspaces/{{cfWorkspaceId}}/export/audit",
        "httpMethod": "GET",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "queryWindowInMin": 5,
        "startTimeAttributeName": "startTime",
        "endTimeAttributeName": "endTime",
        "rateLimitQPS": 2,
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "ContraForce-Sentinel-Connector"
        }
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.nextPageToken",
        "nextPageParaName": "nextPageToken",
        "pageSize": 500,
        "pageSizeParameterName": "pageSize"
      },
      "response": {
        "eventsJsonPaths": ["$.value"],
        "format": "json"
      }
    }
  }
]
