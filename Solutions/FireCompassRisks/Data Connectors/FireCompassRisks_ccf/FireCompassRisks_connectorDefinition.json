{
  "name": "FireCompassRisksConnector",
  "apiVersion": "2023-04-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "[parameters('workspace-location')]",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "FireCompassRisksConnector",
      "title": "FireCompass Risks",
      "publisher": "FireCompass",
      "descriptionMarkdown": "The FireCompass data connector allows ingesting risk and vulnerability data from the FireCompass API into Microsoft Sentinel. The data connector is built on the Microsoft Sentinel Codeless Connector Platform.",
      "graphQueries": [
        {
          "metricName": "Total risk logs received",
          "legend": "FireCompass Risks",
          "baseQuery": "FCRisks_CL"
        }
      ],
      "sampleQueries": [
        {
          "description": "Get a sample of FireCompass risk logs",
          "query": "FCRisks_CL | take 10"
        }
      ],
      "dataTypes": [
        {
          "name": "FCRisks_CL",
          "lastDataReceivedQuery": "FCRisks_CL\n | where TimeGenerated > ago(12h) | summarize Time = max(TimeGenerated)\n | where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "status": 1,
        "isPreview": false
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and Write permissions are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "read": true,
              "write": true,
              "delete": true,
              "action": false
            }
          }
        ]
      },
      "instructionSteps": [
        {
          "instructions": [
            {
              "type": "Markdown",
              "parameters": {
                "content": "#### Configuration steps for the FireCompass API\nGenerate your API Token from the FireCompass platform and paste it below to authenticate the connector."
              }
            },
            {
              "parameters": {
                "label": "FIRECOMPASS Management URL",
                "placeholder": "https://example.FIRECOMPASSTEST.net/",
                "type": "text",
                "name": "managementUrl"
              },
              "type": "Textbox"
            },
            {
              "type": "Textbox",
              "parameters": {
                "label": "API endpoint path",
                "type": "text",
                "name": "apiPath",
                "placeholder": "/internal_risks/v1/risk",
                "description": "Path appended to the host, e.g. /internal_risks/v1/risk"
              }
            },
            {
              "parameters": {
                "label": "FireCompass API Token",
                "placeholder": "Enter API Token",
                "type": "securestring",
                "name": "apitoken"
              },
              "type": "Textbox"
            },
            {
              "parameters": {
                "label": "toggle",
                "name": "toggle"
              },
              "type": "ConnectionToggleButton"
            }
          ]
        }
      ],
      "isConnectivityCriteriasMatchSome": false,
      "graphQueriesTableName": "FCRisks_CL"
    }
  }
}