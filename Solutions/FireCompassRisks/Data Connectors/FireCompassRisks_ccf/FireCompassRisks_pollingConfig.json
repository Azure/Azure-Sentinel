[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2024-09-01",
    "name": "FireCompassRisksPoller",
    "location": "[parameters('workspace-location')]",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "FireCompassRisksConnector",
      "dataType": "FCRisks_CL",
      "dcrConfig": {
        "streamName": "Custom-FCRisks_API",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apitoken')]",
        "ApiKeyName": "X-Api-Token"
      },
      "request": {
        "apiEndpoint": "[[concat(parameters('managementUrl'), parameters('apiPath'))]",
        "httpMethod": "GET",
        "rateLimitQPS": 10,
        "queryWindowInMin": 5,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json"
        },
        "queryParameters": {
          "from_date": "{_QueryWindowStartTime}",
          "to_date": "{_QueryWindowEndTime}",
          "page_size": "50",
          "allow_timestamp": "true"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.results"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "CountBasedPaging",
        "pageNumberParaName": "page",
        "pageSize": 50,
        "zeroBasedIndexing": false,
        "totalResultsJsonPath": "$.count",
        "pageCountJsonPath": "$.total_pages",
        "pageNumberJsonPath": "$.page"
      }
    }
  }
]