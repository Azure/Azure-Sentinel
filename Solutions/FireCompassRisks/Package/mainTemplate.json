{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "FireCompass - support@firecompass.com",
    "comments": "Solution template for FireCompassRisks"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "resource group name where Microsoft Sentinel is setup"
      }
    },
    "subscription": {
      "type": "string",
      "defaultValue": "[last(split(subscription().id, '/'))]",
      "metadata": {
        "description": "subscription id where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "email": "support@firecompass.com",
    "_email": "[variables('email')]",
    "_solutionName": "FireCompassRisks",
    "_solutionVersion": "3.0.0",
    "solutionId": "firecompass.firecompass-risks-push",
    "_solutionId": "[variables('solutionId')]",
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "dataConnectorCCPVersion": "3.0.0",
    "_dataConnectorContentIdConnectorDefinition1": "FireCompassRisksPush",
    "dataConnectorTemplateNameConnectorDefinition1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnectorDefinition1')))]",
    "_dataConnectorContentIdConnections1": "FireCompassRisksPushConnections",
    "dataConnectorTemplateNameConnections1": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnections1')))]",
    "blanks": "[replace('b', 'b', '')]",
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', variables('dataConnectorTemplateNameConnectorDefinition1'), variables('dataConnectorCCPVersion'))]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
        "displayName": "FireCompass Risks (Push)",
        "contentKind": "DataConnector",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorCCPVersion')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
              "apiVersion": "2022-09-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
              "location": "[parameters('workspace-location')]",
              "kind": "Customizable",
              "properties": {
                "connectorUiConfig": {
                  "id": "FireCompassRisksPush",
                  "title": "FireCompass Risks (Push)",
                  "publisher": "FireCompass",
                  "descriptionMarkdown": "The FireCompass Risks (Push) connector enables the FireCompass platform to push risk findings directly into Microsoft Sentinel in real time using the Codeless Connector Framework (CCF) Push pattern. Risk records are ingested into the FCRisks_CL custom table for analysis, alerting, and closed-loop remediation workflows.",
                  "graphQueries": [
                    {
                      "metricName": "Risk records received",
                      "legend": "FCRisks_CL",
                      "baseQuery": "FCRisks_CL"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "Latest state of every risk",
                      "query": "FCRisks_CL\n| summarize arg_max(UpdatedAt, *) by RiskId\n| sort by UpdatedAt desc"
                    },
                    {
                      "description": "Open critical and high severity risks",
                      "query": "FCRisks_CL\n| summarize arg_max(UpdatedAt, *) by RiskId\n| where State == 'OPEN' and Severity in ('CRITICAL', 'HIGH')\n| sort by UpdatedAt desc"
                    },
                    {
                      "description": "Risks by assessment",
                      "query": "FCRisks_CL\n| summarize Risks = dcount(RiskId) by AssessmentName, Severity"
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "FCRisks_CL",
                      "lastDataReceivedQuery": "FCRisks_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "IsConnectedQuery",
                      "value": [
                        "FCRisks_CL\n| summarize LastLogReceived = max(TimeGenerated)\n| project IsConnected = LastLogReceived > ago(7d)"
                      ]
                    }
                  ],
                  "availability": {
                    "status": 1
                  },
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "read and write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "write": true,
                          "read": true,
                          "delete": true
                        }
                      }
                    ],
                    "customs": [
                      {
                        "name": "Microsoft Entra",
                        "description": "Permission to create an app registration in Microsoft Entra ID. Typically requires Entra ID Application Developer role or higher."
                      },
                      {
                        "name": "Microsoft Azure",
                        "description": "Permission to assign Monitoring Metrics Publisher role on the data collection rule (DCR). Typically requires Azure RBAC Owner or User Access Administrator role."
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "1. Create ARM Resources and Provide the Required Permissions",
                      "description": "This connector enables the FireCompass platform to push risk findings directly to Microsoft Sentinel via the Azure Monitor Logs Ingestion API.",
                      "instructions": [
                        {
                          "type": "Markdown",
                          "parameters": {
                            "content": "#### Automated Configuration and Secure Data Ingestion with Entra Application\nClicking on \"Deploy\" will trigger the creation of the FCRisks_CL Log Analytics table and a Data Collection Rule (DCR).\nIt will then create an Entra application, link the DCR to it, and set the generated secret in the application. This setup enables the FireCompass platform to send data securely to the DCR using an Entra token."
                          }
                        },
                        {
                          "type": "DeployPushConnectorButton",
                          "parameters": {
                            "label": "Deploy FireCompass Risks Push connector resources",
                            "applicationDisplayName": "FireCompass Risks Push Connector Application"
                          }
                        }
                      ]
                    },
                    {
                      "title": "2. Configure the FireCompass Platform",
                      "description": "Use the following parameters to configure the FireCompass platform integration to push risk findings to this workspace.",
                      "instructions": [
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Tenant ID (Directory ID)",
                            "fillWith": [
                              "TenantId"
                            ]
                          }
                        },
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Entra App Registration Application ID",
                            "fillWith": [
                              "ApplicationId"
                            ],
                            "placeholder": "Deploy push connector to get the App Registration Application ID"
                          }
                        },
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Entra App Registration Secret",
                            "fillWith": [
                              "ApplicationSecret"
                            ],
                            "placeholder": "Deploy push connector to get the App Registration Secret"
                          }
                        },
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Data Collection Endpoint Uri",
                            "fillWith": [
                              "DataCollectionEndpoint"
                            ],
                            "placeholder": "Deploy push connector to get the Data Collection Endpoint Uri"
                          }
                        },
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Data Collection Rule Immutable ID",
                            "fillWith": [
                              "DataCollectionRuleId"
                            ],
                            "placeholder": "Deploy push connector to get the Data Collection Rule Immutable ID"
                          }
                        },
                        {
                          "type": "CopyableLabel",
                          "parameters": {
                            "label": "Stream Name",
                            "value": "Custom-FCRisks_API"
                          }
                        },
                        {
                          "type": "Markdown",
                          "parameters": {
                            "content": "#### Configure FireCompass Integration\nEnter the above credentials in the FireCompass platform's Microsoft Sentinel integration settings to enable real-time risk push.\n\nThe platform sends risk records in their native API JSON format; field mapping to the FCRisks_CL table is handled by the Data Collection Rule."
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', variables('_dataConnectorContentIdConnectorDefinition1')))]",
              "apiVersion": "2022-01-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectorDefinitions', variables('_dataConnectorContentIdConnectorDefinition1'))]",
                "contentId": "[variables('_dataConnectorContentIdConnectorDefinition1')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorCCPVersion')]",
                "source": {
                  "sourceId": "[variables('_solutionId')]",
                  "name": "[variables('_solutionName')]",
                  "kind": "Solution"
                },
                "author": {
                  "name": "FireCompass",
                  "email": "[variables('_email')]"
                },
                "support": {
                  "name": "FireCompass",
                  "tier": "Partner",
                  "link": "https://www.firecompass.com/"
                },
                "dependencies": {
                  "criteria": [
                    {
                      "version": "[variables('dataConnectorCCPVersion')]",
                      "contentId": "[variables('_dataConnectorContentIdConnections1')]",
                      "kind": "ResourcesDataConnector"
                    }
                  ]
                }
              }
            },
            {
              "name": "FireCompassRisksPushDCR",
              "apiVersion": "2022-06-01",
              "type": "Microsoft.Insights/dataCollectionRules",
              "location": "[parameters('workspace-location')]",
              "kind": "[variables('blanks')]",
              "properties": {
                "streamDeclarations": {
                  "Custom-FCRisks_API": {
                    "columns": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "title",
                        "type": "string"
                      },
                      {
                        "name": "title_alias",
                        "type": "string"
                      },
                      {
                        "name": "description",
                        "type": "string"
                      },
                      {
                        "name": "asset",
                        "type": "string"
                      },
                      {
                        "name": "asset_ref",
                        "type": "string"
                      },
                      {
                        "name": "primary_domain",
                        "type": "string"
                      },
                      {
                        "name": "remediation",
                        "type": "string"
                      },
                      {
                        "name": "type",
                        "type": "string"
                      },
                      {
                        "name": "category",
                        "type": "string"
                      },
                      {
                        "name": "severity",
                        "type": "string"
                      },
                      {
                        "name": "state",
                        "type": "string"
                      },
                      {
                        "name": "impact",
                        "type": "string"
                      },
                      {
                        "name": "created_at",
                        "type": "string"
                      },
                      {
                        "name": "updated_at",
                        "type": "string"
                      },
                      {
                        "name": "error_message",
                        "type": "string"
                      },
                      {
                        "name": "target_details",
                        "type": "dynamic"
                      },
                      {
                        "name": "evidences",
                        "type": "dynamic"
                      },
                      {
                        "name": "evidence_report",
                        "type": "string"
                      },
                      {
                        "name": "comments",
                        "type": "dynamic"
                      },
                      {
                        "name": "tags",
                        "type": "dynamic"
                      },
                      {
                        "name": "asset_groups",
                        "type": "dynamic"
                      },
                      {
                        "name": "assessment_name",
                        "type": "string"
                      },
                      {
                        "name": "assessment_start_date",
                        "type": "string"
                      },
                      {
                        "name": "asset_details",
                        "type": "dynamic"
                      },
                      {
                        "name": "version",
                        "type": "int"
                      },
                      {
                        "name": "organization_unit",
                        "type": "string"
                      },
                      {
                        "name": "organization_unit_alias",
                        "type": "string"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "clv2ws1"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-FCRisks_API"
                    ],
                    "destinations": [
                      "clv2ws1"
                    ],
                    "transformKql": "source | extend TimeGenerated = iff(isnotnull(todatetime(['updated_at'])), todatetime(['updated_at']), iff(isnotnull(todatetime(['created_at'])), todatetime(['created_at']), now())) | extend RiskId = tostring(['id']), Title = tostring(['title']), TitleAlias = tostring(['title_alias']), Description = tostring(['description']), Asset = tostring(['asset']), AssetRef = tostring(['asset_ref']), PrimaryDomain = tostring(['primary_domain']), Remediation = tostring(['remediation']), RiskType = tostring(['type']), Category = tostring(['category']), Severity = tostring(['severity']), State = tostring(['state']), Impact = tostring(['impact']), CreatedAt = todatetime(['created_at']), UpdatedAt = todatetime(['updated_at']), ErrorMessage = tostring(['error_message']), TargetDetails = ['target_details'], Evidences = ['evidences'], EvidenceReport = tostring(['evidence_report']), Comments = ['comments'], Tags = ['tags'], AssetGroups = ['asset_groups'], AssessmentName = tostring(['assessment_name']), AssessmentStartDate = todatetime(['assessment_start_date']), AssetDetails = ['asset_details'], RiskVersion = toint(['version']), OrganizationUnit = tostring(['organization_unit']), OrganizationUnitAlias = tostring(['organization_unit_alias']) | project TimeGenerated, RiskId, Title, TitleAlias, Description, Asset, AssetRef, PrimaryDomain, Remediation, RiskType, Category, Severity, State, Impact, CreatedAt, UpdatedAt, ErrorMessage, TargetDetails, Evidences, EvidenceReport, Comments, Tags, AssetGroups, AssessmentName, AssessmentStartDate, AssetDetails, RiskVersion, OrganizationUnit, OrganizationUnitAlias",
                    "outputStream": "Custom-FCRisks_CL"
                  }
                ],
                "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]"
              }
            },
            {
              "name": "FCRisks_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "schema": {
                  "name": "FCRisks_CL",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime"
                    },
                    {
                      "name": "RiskId",
                      "type": "string"
                    },
                    {
                      "name": "Title",
                      "type": "string"
                    },
                    {
                      "name": "TitleAlias",
                      "type": "string"
                    },
                    {
                      "name": "Description",
                      "type": "string"
                    },
                    {
                      "name": "Asset",
                      "type": "string"
                    },
                    {
                      "name": "AssetRef",
                      "type": "string"
                    },
                    {
                      "name": "PrimaryDomain",
                      "type": "string"
                    },
                    {
                      "name": "Remediation",
                      "type": "string"
                    },
                    {
                      "name": "RiskType",
                      "type": "string"
                    },
                    {
                      "name": "Category",
                      "type": "string"
                    },
                    {
                      "name": "Severity",
                      "type": "string"
                    },
                    {
                      "name": "State",
                      "type": "string"
                    },
                    {
                      "name": "Impact",
                      "type": "string"
                    },
                    {
                      "name": "CreatedAt",
                      "type": "datetime"
                    },
                    {
                      "name": "UpdatedAt",
                      "type": "datetime"
                    },
                    {
                      "name": "ErrorMessage",
                      "type": "string"
                    },
                    {
                      "name": "TargetDetails",
                      "type": "dynamic"
                    },
                    {
                      "name": "Evidences",
                      "type": "dynamic"
                    },
                    {
                      "name": "EvidenceReport",
                      "type": "string"
                    },
                    {
                      "name": "Comments",
                      "type": "dynamic"
                    },
                    {
