            {
              "name": "[[concat(parameters('innerWorkspace'),'/Microsoft.SecurityInsights/', 'FireCompassRisksPoller', parameters('guidValue'))]",
              "apiVersion": "2023-02-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
              "location": "[parameters('workspace-location')]",
              "kind": "RestApiPoller",
              "properties": {
                "connectorDefinitionName": "FireCompassRisksConnector",
                "dataType": "FCRisks_CL",
                "dcrConfig": {
                  "streamName": "Custom-FCRisks_API",
                  "dataCollectionEndpoint": "[[parameters('dcrConfig').dataCollectionEndpoint]",
                  "dataCollectionRuleImmutableId": "[[parameters('dcrConfig').dataCollectionRuleImmutableId]"
                },
                "auth": {
                  "type": "APIKey",
                  "ApiKey": "[[parameters('apitoken')]",
                  "ApiKeyName": "X-Api-Token"
                },
                "request": {
                  "apiEndpoint": "[[concat(parameters('managementUrl'), parameters('apiPath'))]",
                  "httpMethod": "GET",
                  "rateLimitQPS": 10,
                  "queryWindowInMin": 5,
                  "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
                  "retryCount": 3,
                  "timeoutInSeconds": 60,
                  "headers": {
                    "Accept": "application/json"
                  },
                  "queryParameters": {
                    "from_date": "{_QueryWindowStartTime}",
                    "to_date": "{_QueryWindowEndTime}",
