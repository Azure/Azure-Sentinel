              "kind": "[variables('blanks')]",
              "properties": {
                "dataCollectionEndpointId": "[[parameters('dcrConfig').dataCollectionEndpoint]",
                "streamDeclarations": {
                  "Custom-FCRisks_API": {
                    "columns": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "title",
                        "type": "string"
