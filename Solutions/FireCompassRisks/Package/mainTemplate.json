                      {
                        "name": "organization_unit_alias",
                        "type": "string"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "clv2ws1"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-FCRisks_API"
                    ],
                    "destinations": [
                      "clv2ws1"
                    ],
                    "outputStream": "Custom-FCRisks_CL",
                    "transformKql": "source | extend TimeGenerated = iff(isnotnull(todatetime(['updated_at'])), todatetime(['updated_at']), iff(isnotnull(todatetime(['created_at'])), todatetime(['created_at']), now())) | extend RiskId = tostring(['id']), Title = tostring(['title']), TitleAlias = tostring(['title_alias']), Description = tostring(['description']), Asset = tostring(['asset']), AssetRef = tostring(['asset_ref']), PrimaryDomain = tostring(['primary_domain']), Remediation = tostring(['remediation']), RiskType = tostring(['type']), Category = tostring(['category']), Severity = tostring(['severity']), State = tostring(['state']), Impact = tostring(['impact']), CreatedAt = todatetime(['created_at']), UpdatedAt = todatetime(['updated_at']), ErrorMessage = tostring(['error_message']), TargetDetails = ['target_details'], Evidences = ['evidences'], EvidenceReport = tostring(['evidence_report']), Comments = ['comments'], Tags = ['tags'], AssetGroups = ['asset_groups'], AssessmentName = tostring(['assessment_name']), AssessmentStartDate = todatetime(['assessment_start_date']), AssetDetails = ['asset_details'], RiskVersion = toint(['version']), OrganizationUnit = tostring(['organization_unit']), OrganizationUnitAlias = tostring(['organization_unit_alias']) | project TimeGenerated, RiskId, Title, TitleAlias, Description, Asset, AssetRef, PrimaryDomain, Remediation, RiskType, Category, Severity, State, Impact, CreatedAt, UpdatedAt, ErrorMessage, TargetDetails, Evidences, EvidenceReport, Comments, Tags, AssetGroups, AssessmentName, AssessmentStartDate, AssetDetails, RiskVersion, OrganizationUnit, OrganizationUnitAlias"
                  }
                ]
              }
