[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2022-10-01-preview",
    "name": "[[concat('parameters('workspace')', '/Microsoft.SecurityInsights/','DatadogAuditLogs_CL' , uniqueString(parameters('friendlyName')) )]",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apikey')]",
        "ApiKeyName": "DD-API-KEY"
      },
      "request": {
        "apiEndpoint": "[[concat('https://', parameters('datadogsite'), '/api/v2/audit/events')]",
        "httpMethod": "GET",
        "rateLimitQPS": 5,
        "queryWindowInMin": 5,
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "retryCount": 3,
        "timeoutInSeconds": 30,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "MS-Sentinel-CCP-DatadogAuditLogs",
          "DD-APPLICATION-KEY": "[[parameters('appkey')]"
        },
        "queryParameters": {
          "filter[from]": "{_QueryWindowStartTime}",
          "filter[to]": "{_QueryWindowEndTime}",
          "page[limit]": "1000",
          "sort": "timestamp"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.data[*]"
        ],
        "format": "json"
      },
      "paging": {
        "pagingType": "NextPageToken",
        "nextPageTokenJsonPath": "$.meta.page.after",
        "NextPageParaName": "page[cursor]",
        "pageSize": 1000,
        "pageSizeParameterName": "page[limit]"
      },
      "connectorDefinitionName": "DatadogConnector",
      "dataType": "DatadogAuditLogs_CL",
      "dcrConfig": {
        "streamName": "Custom-DatadogAuditLogs_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "addOnAttributes": {
        "friendlyName": "[[parameters('friendlyName')]",
        "dataType": "Audit Events"
      }
    },
    "condition": "[[equals(parameters('selectedDataType')[0], 'DatadogAuditLogs')]"
  },
  {
