{
  "name": "DatadogAuditDCR",
  "apiVersion": "2023-04-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-DatadogAuditV2_CL": {
        "columns": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "type",
            "type": "string"
          },
          {
            "name": "attributes",
            "type": "dynamic"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-DatadogAuditV2_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-DatadogAuditV2_CL",
        "transformKql": "source | extend TimeGenerated = iff(isnotempty(tostring(attributes.timestamp)), todatetime(tostring(attributes.timestamp)), datetime(null)) , EventId = ['id'] , EventType = ['type'] , Attributes = ['attributes'] , EventService = tostring(attributes.service) , EventTimestamp = tostring(attributes.timestamp) | project TimeGenerated , EventId , EventType , Attributes , EventService , EventTimestamp"
      }
    ]
  }
}
