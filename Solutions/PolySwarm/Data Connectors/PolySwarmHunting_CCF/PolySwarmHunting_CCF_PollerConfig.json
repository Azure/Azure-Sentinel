[
  {
    "name": "PolySwarmHuntingCCFPolling",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "PolySwarmHuntingCCFDefinition",
      "dataType": "ThreatIntelIndicators",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-PolySwarmHunting"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "{{apiKey}}",
        "ApiKeyName": "Authorization"
      },
      "request": {
        "apiEndpoint": "https://api.polyswarm.network/v3/hunt/live/list",
        "httpMethod": "GET",
        "queryWindowInMin": "[[int(parameters('queryWindowInMin'))]",
        "rateLimitQPS": 5,
        "queryTimeFormat": "UnixTimestampInMills",
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "PolySwarm-Microsoft-Sentinel/3.0.0 (HuntingConnector)"
        },
        "queryParameters": {
          "community": "[[parameters('community')]",
          "since": "[[string(add(int(parameters('queryWindowInMin')), 10))]",
          "limit": "50"
        }
      },
      "response": {
        "eventsJsonPaths": ["$.result[*]"],
        "format": "json"
      },
      "paging": {
        "pagingType": "NextPageUrl",
        "nextPageUrl": "https://api.polyswarm.network/v3/hunt/live/list",
        "nextPageTokenJsonPath": "$.offset",
        "nextPageParaName": "offset",
        "hasNextFlagJsonPath": "$.has_more"
      },
      "isActive": true
    }
  }
]
