{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "PolySwarm - Sandbox Results Data Connector",
        "description": "Deploys the shared infrastructure the PolySwarm sandbox playbooks use to write detonation results to Microsoft Sentinel via the Azure Monitor Logs Ingestion API: a Data Collection Endpoint (DCE), the PolySwarmSandbox_CL Log Analytics table, and a Data Collection Rule (DCR) with stream Custom-PolySwarmSandboxResults. Modeled on the Recorded Future Data Connectors Log Ingestion pattern (Solutions/Recorded Future/Data Connectors/azuredeploy.json).",
        "lastUpdateTime": "2026-09-23T00:00:00.000Z",
        "support": {
            "tier": "Partner"
        },
        "author": {
            "name": "PolySwarm"
        },
        "releaseNotes": [
            {
                "version": "1.0",
                "title": "Initial version",
                "notes": [
                    "DCE and DCR for the PolySwarm sandbox playbooks (URL, Outlook attachment, Storage blob, Defender file).",
                    "Creates the PolySwarmSandbox_CL Log Analytics table.",
                    "Replaces the PolySwarmSandbox_CCF poller connector: PolySwarm's /v3/sandbox/sandboxtask/my-tasks API does not return verdict, malware family, ATT&CK techniques or a completion time for any task, so a CCF poller reading that endpoint cannot populate this table correctly. The sandbox playbooks already poll each task to completion and hold that data directly, so they write it here through the Logs Ingestion API instead."
                ]
            }
        ]
    },
    "parameters": {
        "log_analytics_workspace_name": {
            "type": "string",
            "metadata": {
                "description": "Required. Name of the Log Analytics Workspace where the table will be created. Must be in the same resource group as this deployment."
            }
        },
        "log_analytics_workspace_location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location of the Log Analytics Workspace. Defaults to the resource group location."
            }
        }
    },
    "variables": {
        "DceName": "polyswarm-dce",
        "DcrName": "polyswarm-dcr-sandbox-results",
        "TableName": "PolySwarmSandbox_CL",
        "StreamName": "Custom-PolySwarmSandboxResults",
        "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('log_analytics_workspace_name'))]",
        "dceResourceId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
        "dcrResourceId": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('DcrName'))]",
        "tableResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('log_analytics_workspace_name'), variables('TableName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Insights/dataCollectionEndpoints",
            "apiVersion": "2024-03-11",
            "name": "[variables('DceName')]",
            "location": "[resourceGroup().location]",
            "properties": {}
        },
        {
            "type": "Microsoft.OperationalInsights/workspaces/tables",
            "apiVersion": "2022-10-01",
            "name": "[concat(parameters('log_analytics_workspace_name'), '/', variables('TableName'))]",
            "properties": {
                "schema": {
                    "name": "[variables('TableName')]",
                    "columns": [
                        {
                            "name": "TimeGenerated",
                            "type": "datetime",
                            "description": "Ingestion time of this row."
                        },
                        {
                            "name": "TaskId",
                            "type": "string",
                            "description": "PolySwarm sandbox task id."
                        },
                        {
                            "name": "ArtifactType",
                            "type": "string",
                            "description": "FILE or URL."
                        },
                        {
                            "name": "Sha256",
                            "type": "string",
                            "description": "SHA-256 of the submitted artifact, when known."
                        },
                        {
                            "name": "Url",
                            "type": "string",
                            "description": "Submitted URL for ArtifactType URL tasks."
                        },
                        {
                            "name": "FileName",
                            "type": "string",
                            "description": "Original filename for ArtifactType FILE tasks (attachment name, blob name, or the name Defender's GetFile returned)."
                        },
                        {
                            "name": "Source",
                            "type": "string",
                            "description": "Which playbook submitted the task: Url, OutlookAttachment, StorageBlob, or DefenderFile."
                        },
                        {
                            "name": "Provider",
                            "type": "string",
                            "description": "Sandbox provider that ran the task: cape or triage."
                        },
                        {
                            "name": "Community",
                            "type": "string",
                            "description": "PolySwarm community the task ran in."
                        },
                        {
                            "name": "Verdict",
                            "type": "string",
                            "description": "Malicious/suspicious/benign verdict, as determined by the playbook after polling the task to completion."
                        },
                        {
                            "name": "Score",
                            "type": "real",
                            "description": "Provider-specific score the playbook read from the completed task."
                        },
                        {
                            "name": "Family",
                            "type": "string",
                            "description": "Malware family, when the sandbox report names one."
                        },
                        {
                            "name": "Techniques",
                            "type": "dynamic",
                            "description": "MITRE ATT&CK technique ids the sandbox report observed."
                        },
                        {
                            "name": "ReportUrl",
                            "type": "string",
                            "description": "PolySwarm scan result permalink for this task's artifact."
                        },
                        {
                            "name": "CreatedAt",
                            "type": "datetime",
                            "description": "Task creation time."
                        },
                        {
                            "name": "CompletedAt",
                            "type": "datetime",
                            "description": "Time the playbook observed the task reach a completed status."
                        },
                        {
                            "name": "IncidentArmId",
                            "type": "string",
                            "description": "ARM resource id of the Microsoft Sentinel incident this detonation was run from, for playbooks triggered from an incident. Empty for a standalone submission."
                        }
                    ]
                },
                "retentionInDays": 90,
                "plan": "Analytics"
            }
        },
        {
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2024-03-11",
            "name": "[variables('DcrName')]",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[variables('dceResourceId')]",
                "[variables('tableResourceId')]"
            ],
            "properties": {
                "dataCollectionEndpointId": "[variables('dceResourceId')]",
                "streamDeclarations": {
                    "[variables('StreamName')]": {
                        "columns": [
                            {
                                "name": "TimeGenerated",
                                "type": "datetime"
                            },
                            {
                                "name": "TaskId",
                                "type": "string"
                            },
                            {
                                "name": "ArtifactType",
                                "type": "string"
                            },
                            {
                                "name": "Sha256",
                                "type": "string"
                            },
                            {
                                "name": "Url",
                                "type": "string"
                            },
                            {
                                "name": "FileName",
                                "type": "string"
                            },
                            {
                                "name": "Source",
                                "type": "string"
                            },
                            {
                                "name": "Provider",
                                "type": "string"
                            },
                            {
                                "name": "Community",
                                "type": "string"
                            },
                            {
                                "name": "Verdict",
                                "type": "string"
                            },
                            {
                                "name": "Score",
                                "type": "real"
                            },
                            {
                                "name": "Family",
                                "type": "string"
                            },
                            {
                                "name": "Techniques",
                                "type": "dynamic"
                            },
                            {
                                "name": "ReportUrl",
                                "type": "string"
                            },
                            {
                                "name": "CreatedAt",
                                "type": "datetime"
                            },
                            {
                                "name": "CompletedAt",
                                "type": "datetime"
                            },
                            {
                                "name": "IncidentArmId",
                                "type": "string"
                            }
                        ]
                    }
                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "workspaceResourceId": "[variables('workspaceResourceId')]",
                            "name": "workspace"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "[variables('StreamName')]"
                        ],
                        "destinations": [
                            "workspace"
                        ],
                        "transformKql": "source | project TimeGenerated = todatetime(TimeGenerated), TaskId = tostring(TaskId), ArtifactType = tostring(ArtifactType), Sha256 = tostring(Sha256), Url = tostring(Url), FileName = tostring(FileName), Source = tostring(Source), Provider = tostring(Provider), Community = tostring(Community), Verdict = tostring(Verdict), Score = toreal(Score), Family = tostring(Family), Techniques = parse_json(tostring(Techniques)), ReportUrl = tostring(ReportUrl), CreatedAt = todatetime(CreatedAt), CompletedAt = todatetime(CompletedAt), IncidentArmId = tostring(IncidentArmId)",
                        "outputStream": "[concat('Custom-', variables('TableName'))]"
                    }
                ]
            }
        }
    ],
    "outputs": {
        "dceLogsIngestionEndpoint": {
            "type": "string",
            "value": "[reference(variables('dceResourceId'), '2024-03-11').logsIngestion.endpoint]"
        },
        "dcrImmutableId": {
            "type": "string",
            "value": "[reference(variables('dcrResourceId'), '2024-03-11').immutableId]"
        },
        "streamName": {
            "type": "string",
            "value": "[variables('StreamName')]"
        },
        "dcrResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('DcrName'))]"
        }
    }
}
