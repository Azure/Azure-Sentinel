[
  {
    "name": "PolySwarmFeedCCFPolling",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "PolySwarmFeedCCFDefinition",
      "dataType": "ThreatIntelIndicators",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-PolySwarmFeed"
      },
      "auth": {
        "type": "Basic",
        "UserName": "[[parameters('accountNumber')]",
        "Password": "[[parameters('apiKey')]"
      },
      "request": {
        "apiEndpoint": "[[concat('https://api.polyswarm.network/v3/stix/', first(parameters('feedRoot')), '/objects/')]",
        "httpMethod": "GET",
        "queryWindowInMin": "[[int(parameters('queryWindowInMin'))]",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "rateLimitQPS": 2,
        "retryCount": 3,
        "timeoutInSeconds": 90,
        "headers": {
          "Accept": "application/taxii+json;version=2.1",
          "User-Agent": "PolySwarm-Microsoft-Sentinel/3.0.0 (FeedConnector)"
        },
        "queryParameters": {
          "added_after": "{_QueryWindowStartTime}",
          "limit": "50"
        }
      },
      "response": {
        "eventsJsonPaths": ["$.objects[*].objects[*]"],
        "format": "json"
      },
      "paging": {
        "pagingType": "NextPageUrl",
        "nextPageUrl": "[[concat('https://api.polyswarm.network/v3/stix/', first(parameters('feedRoot')), '/objects/')]",
        "nextPageTokenJsonPath": "$.next",
        "nextPageParaName": "next",
        "hasNextFlagJsonPath": "$.more"
      },
      "isActive": true
    }
  }
]
