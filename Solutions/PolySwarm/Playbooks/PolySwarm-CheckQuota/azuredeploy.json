{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "PolySwarm - Check Quota",
    "description": "Reads PolySwarm account features and remaining API and sandbox uses from GET /v3/public/accounts and always comments on the incident with used, limit, remaining and percent remaining for API calls and sandbox detonations, adding a marked warning when either is below the configured threshold. Modelled on ReversingLabs-CheckQuota.",
    "prerequisites": [
      "A PolySwarm API key stored as a secret in an Azure Key Vault. Get a key at https://polyswarm.network/account/api-keys"
    ],
    "postDeployment": [
      "1. Grant this playbook's system-assigned managed identity the 'Key Vault Secrets User' role on the Key Vault named in KeyVaultName.",
      "2. Assign the 'Microsoft Sentinel Responder' role on the resource group (or workspace) to this playbook's system-assigned managed identity.",
      "3. Authorize the Microsoft Sentinel and Key Vault API connections if they show as unauthorized.",
      "4. Attach the playbook to an automation rule, or run it on a recurring schedule against a synthetic incident, so quota is checked regularly rather than only when another incident happens to be created."
    ],
    "lastUpdateTime": "2026-09-23T00:00:00.000Z",
    "entities": [],
    "tags": [
      "Enrichment"
    ],
    "support": {
      "tier": "Partner"
    },
    "author": {
      "name": "PolySwarm"
    }
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "PolySwarm-CheckQuota",
      "metadata": {
        "description": "Name of the Logic App playbook resource."
      }
    },
    "SolutionVersion": {
      "type": "string",
      "defaultValue": "3.0.0",
      "metadata": {
        "description": "Version string sent in the User-Agent header on every call to the PolySwarm API. Bump this when the solution version changes."
      }
    },
    "KeyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Azure Key Vault holding the PolySwarm API key."
      }
    },
    "KeyVaultSecretName": {
      "type": "string",
      "defaultValue": "PolySwarmApiKey",
      "metadata": {
        "description": "Name of the secret in KeyVaultName that holds the PolySwarm API key."
      }
    },
    "PolySwarmApiBaseUrl": {
      "type": "string",
      "defaultValue": "https://api.polyswarm.network/v3",
      "metadata": {
        "description": "PolySwarm REST API v3 base URL."
      }
    },
    "ApiQuotaWarningThresholdPercent": {
      "type": "int",
      "defaultValue": 20,
      "minValue": 1,
      "maxValue": 99,
      "metadata": {
        "description": "Comment a warning when daily API uses remaining fall to this percentage of the daily limit or below. Accounts with an unlimited daily API allowance (daily_api_limit of 0, or daily_api_remaining of -1) are never flagged."
      }
    },
    "SandboxQuotaWarningThresholdPercent": {
      "type": "int",
      "defaultValue": 20,
      "minValue": 1,
      "maxValue": 99,
      "metadata": {
        "description": "Comment a warning when remaining uses of a metered sandbox feature fall to this percentage of its base allocation or below."
      }
    },
    "SandboxFeatureTagFilter": {
      "type": "string",
      "defaultValue": "sandbox",
      "metadata": {
        "description": "Substring matched (case-insensitively) against each account feature's tag to decide which features count as sandbox quota, for example 'sandbox' matches sandbox_download and sandbox_request. Only features with a positive base_uses are evaluated; boolean entitlement features with no metered allocation are skipped."
      }
    }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]",
    "KeyVaultConnectionName": "[concat('keyvault-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('KeyVaultConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('KeyVaultConnectionName')]",
        "parameterValueType": "Alternative",
        "alternativeParameterValues": {
          "vaultName": "[parameters('KeyVaultName')]"
        },
        "customParameterValues": {},
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "PolySwarm-CheckQuota",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "PolySwarmApiBaseUrl": {
              "type": "string",
              "defaultValue": "https://api.polyswarm.network/v3"
            },
            "ApiQuotaWarningThresholdPercent": {
              "type": "int",
              "defaultValue": 20
            },
            "SandboxQuotaWarningThresholdPercent": {
              "type": "int",
              "defaultValue": 20
            },
            "SandboxFeatureTagFilter": {
              "type": "string",
              "defaultValue": "sandbox"
            },
            "SolutionVersion": {
              "type": "string",
              "defaultValue": "3.0.0"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Get_PolySwarm_API_Key": {
              "type": "ApiConnection",
              "description": "Reads the PolySwarm API key from Azure Key Vault through this playbook's system-assigned managed identity. The identity needs the 'Key Vault Secrets User' role on the vault named in KeyVaultName.",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keyvault']['connectionId']"
                  }
                },
                "method": "get",
                "path": "[concat('/secrets/@{encodeURIComponent(''', parameters('KeyVaultSecretName'), ''')}/value')]"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {}
            },
            "If_PolySwarm_API_key_retrieved": {
              "type": "If",
              "expression": {
                "equals": [
                  "@outputs('Get_PolySwarm_API_Key')?['statusCode']",
                  200
                ]
              },
              "runAfter": {
                "Get_PolySwarm_API_Key": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "actions": {
                "Get_PolySwarm_account": {
                  "type": "Http",
                  "description": "Reads account features and remaining daily API and metered sandbox uses.",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('PolySwarmApiBaseUrl')}/public/accounts",
                    "headers": {
                      "Authorization": "@body('Get_PolySwarm_API_Key')?['value']",
                      "Accept": "application/json",
                      "User-Agent": "@concat('PolySwarm-Microsoft-Sentinel/', parameters('SolutionVersion'), ' (CheckQuota)')"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT10S"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                },
                "If_account_lookup_succeeded": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@outputs('Get_PolySwarm_account')?['statusCode']",
                      200
                    ]
                  },
                  "runAfter": {
                    "Get_PolySwarm_account": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "actions": {
                    "Select_account_record": {
                      "type": "Compose",
                      "inputs": "@body('Get_PolySwarm_account')?['result']",
                      "runAfter": {}
                    },
                    "Filter_sandbox_features": {
                      "type": "Query",
                      "description": "Account features whose tag matches SandboxFeatureTagFilter, for example sandbox_download or sandbox_request.",
                      "inputs": {
                        "from": "@coalesce(outputs('Select_account_record')?['features'], json('[]'))",
                        "where": "@contains(toLower(coalesce(item()?['tag'], '')), toLower(parameters('SandboxFeatureTagFilter')))"
                      },
                      "runAfter": {
                        "Select_account_record": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Filter_low_sandbox_quota": {
                      "type": "Query",
                      "description": "Of the matched sandbox features, those with a metered allocation (base_uses > 0) whose remaining_uses has fallen to SandboxQuotaWarningThresholdPercent or below. Cross-multiplied to avoid integer-division rounding.",
                      "inputs": {
                        "from": "@body('Filter_sandbox_features')",
                        "where": "@and(greater(coalesce(item()?['base_uses'], 0), 0), lessOrEquals(mul(coalesce(item()?['remaining_uses'], 0), 100), mul(item()?['base_uses'], parameters('SandboxQuotaWarningThresholdPercent'))))"
                      },
                      "runAfter": {
                        "Filter_sandbox_features": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Select_low_sandbox_quota_lines": {
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Filter_low_sandbox_quota')",
                        "select": "@concat(replace(replace(replace(replace(string(coalesce(item()?['name'], item()?['tag'])), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '\"', '&quot;'), ': ', string(item()?['remaining_uses']), ' of ', string(item()?['base_uses']), ' remaining')"
                      },
                      "runAfter": {
                        "Filter_low_sandbox_quota": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Select_sandbox_usage_lines": {
                      "type": "Select",
                      "description": "One line per metered sandbox feature (base_uses > 0): used, limit, remaining and percent remaining. Used is base_uses minus remaining_uses, never below zero.",
                      "inputs": {
                        "from": "@body('Filter_metered_sandbox_features')",
                        "select": "@concat(replace(replace(replace(replace(string(coalesce(item()?['name'], item()?['tag'])), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '\"', '&quot;'), ': ', string(max(createArray(0, sub(item()?['base_uses'], coalesce(item()?['remaining_uses'], 0))))), ' used of ', string(item()?['base_uses']), ', ', string(coalesce(item()?['remaining_uses'], 0)), ' remaining (', string(div(mul(coalesce(item()?['remaining_uses'], 0), 100), item()?['base_uses'])), '% remaining)')"
                      },
                      "runAfter": {
                        "Filter_metered_sandbox_features": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Compose_api_usage_line": {
                      "type": "Compose",
                      "description": "Daily API calls: used, limit, remaining and percent remaining. An account with daily_api_limit of 0 (or remaining of -1) has no daily limit and is reported as unlimited.",
                      "inputs": "@if(and(greater(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0), 0), greaterOrEquals(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1), 0)), concat('API calls: ', string(sub(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0), coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1))), ' used of ', string(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0)), ', ', string(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1)), ' remaining (', string(div(mul(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1), 100), coalesce(outputs('Select_account_record')?['daily_api_limit'], 0))), '% remaining).'), 'API calls: unmetered on this plan (no limit reported).')",
                      "runAfter": {
                        "Select_sandbox_usage_lines": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Compose_sandbox_usage_line": {
                      "type": "Compose",
                      "inputs": "@if(greater(length(body('Select_sandbox_usage_lines')), 0), concat('Sandbox detonations: ', join(body('Select_sandbox_usage_lines'), '; '), '.'), 'Sandbox detonations: unmetered on this plan (no limit reported).')",
                      "runAfter": {
                        "Compose_api_usage_line": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Compose_quota_window_line": {
                      "type": "Compose",
                      "description": "window_start and window_end are the account's current usage window as returned by GET /v3/public/accounts.",
                      "inputs": "@if(empty(coalesce(outputs('Select_account_record')?['window_end'], '')), '', concat('<br>\nUsage window: ', coalesce(outputs('Select_account_record')?['window_start'], ''), ' to ', outputs('Select_account_record')?['window_end'], ' (UTC).'))",
                      "runAfter": {
                        "Compose_sandbox_usage_line": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Compose_quota_warning_text": {
                      "type": "Compose",
                      "description": "Low-quota warning, empty unless API or a metered sandbox feature is at or below its threshold.",
                      "inputs": "@concat(if(and(and(greater(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0), 0), greaterOrEquals(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1), 0)), lessOrEquals(mul(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1), 100), mul(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0), parameters('ApiQuotaWarningThresholdPercent')))), concat('<br>\n<strong>WARNING: daily API quota is low (', string(coalesce(outputs('Select_account_record')?['daily_api_remaining'], -1)), ' of ', string(coalesce(outputs('Select_account_record')?['daily_api_limit'], 0)), ' calls remaining).</strong>'), ''), if(greater(length(body('Select_low_sandbox_quota_lines')), 0), concat('<br>\n<strong>WARNING: sandbox quota is low: ', join(body('Select_low_sandbox_quota_lines'), '; '), '.</strong>'), ''))",
                      "runAfter": {
                        "Compose_quota_window_line": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Add_quota_comment_to_incident": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/Incidents/Comment",
                        "body": {
                          "incidentArmId": "@triggerBody()?['object']?['id']",
                          "message": "<p><strong>PolySwarm quota check</strong><br>\n@{outputs('Compose_api_usage_line')}<br>\n@{outputs('Compose_sandbox_usage_line')}@{outputs('Compose_quota_window_line')}@{outputs('Compose_quota_warning_text')}</p>"
                        }
                      },
                      "runAfter": {
                        "Compose_quota_warning_text": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Add_quota_comment_to_incident_unless_conflict": {
                      "type": "If",
                      "description": "Microsoft Sentinel can answer 409 when several playbooks comment on one incident at once, even though the comment was saved. A 409 is left alone; any other failure posts the comment once more.",
                      "runAfter": {
                        "Add_quota_comment_to_incident": [
                          "Failed"
                        ]
                      },
                      "expression": {
                        "and": [
                          {
                            "not": {
                              "equals": [
                                "@outputs('Add_quota_comment_to_incident')?['statusCode']",
                                409
                              ]
                            }
                          }
                        ]
                      },
                      "actions": {
                        "Add_quota_comment_to_incident_retry": {
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/Incidents/Comment",
                            "body": {
                              "incidentArmId": "@triggerBody()?['object']?['id']",
                              "message": "<p><strong>PolySwarm quota check</strong><br>\n@{outputs('Compose_api_usage_line')}<br>\n@{outputs('Compose_sandbox_usage_line')}@{outputs('Compose_quota_window_line')}@{outputs('Compose_quota_warning_text')}</p>"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    },
                    "Filter_metered_sandbox_features": {
                      "type": "Query",
                      "description": "Matched sandbox features that have a metered allocation (base_uses > 0).",
                      "inputs": {
                        "from": "@body('Filter_sandbox_features')",
                        "where": "@greater(coalesce(item()?['base_uses'], 0), 0)"
                      },
                      "runAfter": {
                        "Select_low_sandbox_quota_lines": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Add_quota_check_failed_comment_to_incident": {
                        "type": "ApiConnection",
                        "inputs": {
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/Incidents/Comment",
                          "body": {
                            "incidentArmId": "@triggerBody()?['object']?['id']",
                            "message": "<p><strong>PolySwarm quota check</strong><br>\n@{if(equals(outputs('Get_PolySwarm_account')?['statusCode'], 204), 'No PolySwarm account record was returned (HTTP status 204). Check that the API key belongs to an active account.', if(equals(outputs('Get_PolySwarm_account')?['statusCode'], 401), 'PolySwarm rejected the API key.', concat('PolySwarm unreachable (HTTP status ', string(coalesce(outputs('Get_PolySwarm_account')?['statusCode'], 'no response')), ').')))}</p>"
                          }
                        },
                        "runAfter": {}
                      },
                      "Add_quota_check_failed_comment_to_incident_unless_conflict": {
                        "type": "If",
                        "description": "Microsoft Sentinel can answer 409 when several playbooks comment on one incident at once, even though the comment was saved. A 409 is left alone; any other failure posts the comment once more.",
                        "runAfter": {
                          "Add_quota_check_failed_comment_to_incident": [
                            "Failed"
                          ]
                        },
                        "expression": {
                          "and": [
                            {
                              "not": {
                                "equals": [
                                  "@outputs('Add_quota_check_failed_comment_to_incident')?['statusCode']",
                                  409
                                ]
                              }
                            }
                          ]
                        },
                        "actions": {
                          "Add_quota_check_failed_comment_to_incident_retry": {
                            "type": "ApiConnection",
                            "inputs": {
                              "host": {
                                "connection": {
                                  "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                }
                              },
                              "method": "post",
                              "path": "/Incidents/Comment",
                              "body": {
                                "incidentArmId": "@triggerBody()?['object']?['id']",
                                "message": "<p><strong>PolySwarm quota check</strong><br>\n@{if(equals(outputs('Get_PolySwarm_account')?['statusCode'], 204), 'No PolySwarm account record was returned (HTTP status 204). Check that the API key belongs to an active account.', if(equals(outputs('Get_PolySwarm_account')?['statusCode'], 401), 'PolySwarm rejected the API key.', concat('PolySwarm unreachable (HTTP status ', string(coalesce(outputs('Get_PolySwarm_account')?['statusCode'], 'no response')), ').')))}</p>"
                              }
                            },
                            "runAfter": {}
                          }
                        },
                        "else": {
                          "actions": {}
                        }
                      }
                    }
                  },
                  "description": "HTTP 204 with an empty body means PolySwarm has no account record for the key; it is reported explicitly and never parsed."
                }
              },
              "else": {
                "actions": {
                  "Add_key_retrieval_failed_comment_to_incident": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/Incidents/Comment",
                      "body": {
                        "incidentArmId": "@triggerBody()?['object']?['id']",
                        "message": "<p><strong>PolySwarm quota enrichment</strong><br>\nCould not retrieve the PolySwarm API key from Azure Key Vault. Check the KeyVaultName and KeyVaultSecretName parameters, and confirm this playbook's managed identity has been granted the 'Key Vault Secrets User' role on the vault.</p>"
                      }
                    },
                    "runAfter": {}
                  },
                  "Add_key_retrieval_failed_comment_to_incident_unless_conflict": {
                    "type": "If",
                    "description": "Microsoft Sentinel can answer 409 when several playbooks comment on one incident at once, even though the comment was saved. A 409 is left alone; any other failure posts the comment once more.",
                    "runAfter": {
                      "Add_key_retrieval_failed_comment_to_incident": [
                        "Failed"
                      ]
                    },
                    "expression": {
                      "and": [
                        {
                          "not": {
                            "equals": [
                              "@outputs('Add_key_retrieval_failed_comment_to_incident')?['statusCode']",
                              409
                            ]
                          }
                        }
                      ]
                    },
                    "actions": {
                      "Add_key_retrieval_failed_comment_to_incident_retry": {
                        "type": "ApiConnection",
                        "inputs": {
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/Incidents/Comment",
                          "body": {
                            "incidentArmId": "@triggerBody()?['object']?['id']",
                            "message": "<p><strong>PolySwarm quota enrichment</strong><br>\nCould not retrieve the PolySwarm API key from Azure Key Vault. Check the KeyVaultName and KeyVaultSecretName parameters, and confirm this playbook's managed identity has been granted the 'Key Vault Secrets User' role on the vault.</p>"
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {}
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "keyvault": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]",
                "connectionName": "[variables('KeyVaultConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "PolySwarmApiBaseUrl": {
            "value": "[parameters('PolySwarmApiBaseUrl')]"
          },
          "ApiQuotaWarningThresholdPercent": {
            "value": "[parameters('ApiQuotaWarningThresholdPercent')]"
          },
          "SandboxQuotaWarningThresholdPercent": {
            "value": "[parameters('SandboxQuotaWarningThresholdPercent')]"
          },
          "SandboxFeatureTagFilter": {
            "value": "[parameters('SandboxFeatureTagFilter')]"
          },
          "SolutionVersion": {
            "value": "[parameters('SolutionVersion')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookResourceId": {
