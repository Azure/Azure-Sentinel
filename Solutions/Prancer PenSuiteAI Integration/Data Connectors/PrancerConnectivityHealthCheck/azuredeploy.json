{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "FunctionName": {
      "type": "string",
      "defaultValue": "PrancerHealth",
      "minLength": 1,
      "maxLength": 11,
      "metadata": {
        "description": "Name prefix for the Function App and related resources (Storage Account, App Service plan, Application Insights). A uniqueString suffix is appended automatically to avoid global name collisions."
      }
    },
    "WorkspaceId": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "GUID of the Log Analytics workspace that hosts PrancerFindings_CL, used to build the Log Analytics Query API URL (https://api.loganalytics.io/v1/workspaces/{WorkspaceId}/query)."
      }
    },
    "WorkspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional human-readable label for the workspace, used in webhook notification text. Falls back to WorkspaceId if left blank."
      }
    },
    "CustomerId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Prancer-side customer identifier, written into the CustomerId column of each PrancerConnectivityHealth_CL row (mirrors the CustomerId column already present on PrancerFindings_CL)."
      }
    },
    "TenantId": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Azure Active Directory Tenant ID."
      }
    },
    "ClientId": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "App Registration (Service Principal) Client ID used for both the Log Analytics Query API and the Logs Ingestion API. This is the same service principal pattern used elsewhere in the Prancer Sentinel solution."
      }
    },
    "ClientSecret": {
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "App Registration Client Secret."
      }
    },
    "StalenessThresholdHours": {
      "type": "int",
      "defaultValue": 48,
      "minValue": 1,
      "metadata": {
        "description": "Number of hours after the most recent PrancerFindings_CL row that connectivity is considered unhealthy. Default of 48h assumes scan cadence is not near-real-time; lower this if your organization scans more frequently."
      }
    },
    "HealthCheckWebhookUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional but strongly recommended. A Microsoft Teams incoming webhook URL, Slack incoming webhook URL, or generic HTTPS endpoint that receives the health status payload on every run. This channel is independent of the PrancerFindings_CL DCR/table and is the primary way to learn about an ingestion outage. Leave blank to disable."
      }
    },
    "HealthDceEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Logs ingestion endpoint of the SEPARATE, minimal Data Collection Endpoint (DCE) provisioned for PrancerConnectivityHealth_CL. This must NOT be the same DCE used for PrancerFindings_CL - see the readme for why. Leave blank to disable the PrancerConnectivityHealth_CL row write (the webhook is unaffected)."
      }
    },
    "HealthDcrImmutableId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "immutableId of the SEPARATE, minimal Data Collection Rule (DCR) provisioned for PrancerConnectivityHealth_CL. Must NOT be the DCR used for PrancerFindings_CL. Leave blank to disable the PrancerConnectivityHealth_CL row write."
      }
    },
    "HealthStreamName": {
      "type": "string",
      "defaultValue": "Custom-PrancerConnectivityHealth_CL",
      "metadata": {
        "description": "DCR stream name that maps to the PrancerConnectivityHealth_CL table. Only change this if you named the stream declaration differently when you created the health DCR."
      }
    },
    "AppInsightsWorkspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Full resource ID of the Log Analytics workspace to back the workspace-based Application Insights resource, e.g. /subscriptions/{subscriptionId}/resourceGroups/{rg}/providers/Microsoft.OperationalInsights/workspaces/{workspaceName}. Can be the same workspace that hosts PrancerFindings_CL, or a different one used for operational telemetry."
      }
    },
    "FunctionAppLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Function App, plan, storage account, and Application Insights."
      }
    }
  },
  "variables": {
    "FunctionAppName": "[concat(toLower(parameters('FunctionName')), uniqueString(resourceGroup().id))]",
    "StorageAccountName": "[take(toLower(variables('FunctionAppName')), 24)]",
    "StorageSuffix": "[environment().suffixes.storage]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('FunctionAppName')]",
      "location": "[parameters('FunctionAppLocation')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "ApplicationId": "[variables('FunctionAppName')]",
        "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceId')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2019-06-01",
      "name": "[variables('StorageAccountName')]",
      "location": "[parameters('FunctionAppLocation')]",
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "networkAcls": {
          "bypass": "AzureServices",
          "virtualNetworkRules": [],
          "ipRules": [],
          "defaultAction": "Allow"
        },
        "supportsHttpsTrafficOnly": true,
        "encryption": {
          "services": {
            "file": {
              "keyType": "Account",
              "enabled": true
            },
            "blob": {
              "keyType": "Account",
              "enabled": true
            }
          },
          "keySource": "Microsoft.Storage"
        },
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default/azure-webjobs-hosts')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('StorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default/azure-webjobs-secrets')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('StorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default/', variables('StorageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('StorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2018-02-01",
      "name": "[variables('FunctionAppName')]",
      "location": "[parameters('FunctionAppLocation')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "kind": "linux",
      "properties": {
        "name": "[variables('FunctionAppName')]",
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[variables('FunctionAppName')]",
      "location": "[parameters('FunctionAppLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('FunctionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]",
        "[resourceId('Microsoft.Insights/components', variables('FunctionAppName'))]"
      ],
      "kind": "functionapp,linux",
      "properties": {
        "name": "[variables('FunctionAppName')]",
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('FunctionAppName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": true,
        "reserved": true,
        "siteConfig": {
          "linuxFxVersion": "python|3.11"
        }
      },
      "resources": [
        {
          "apiVersion": "2018-11-01",
          "type": "config",
          "name": "appsettings",
          "dependsOn": [
            "[concat('Microsoft.Web/sites/', variables('FunctionAppName'))]"
          ],
          "properties": {
            "FUNCTIONS_EXTENSION_VERSION": "~4",
            "FUNCTIONS_WORKER_RUNTIME": "python",
            "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionAppName')), '2015-05-01').InstrumentationKey]",
            "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionAppName')), '2015-05-01').ConnectionString]",
            "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('StorageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName')), '2019-06-01').keys[0].value, ';EndpointSuffix=', toLower(variables('StorageSuffix')))]",
            "WORKSPACE_ID": "[parameters('WorkspaceId')]",
            "WORKSPACE_NAME": "[parameters('WorkspaceName')]",
            "CUSTOMER_ID": "[parameters('CustomerId')]",
            "TENANT_ID": "[parameters('TenantId')]",
            "CLIENT_ID": "[parameters('ClientId')]",
            "CLIENT_SECRET": "[parameters('ClientSecret')]",
            "STALENESS_THRESHOLD_HOURS": "[string(parameters('StalenessThresholdHours'))]",
            "HEALTH_CHECK_WEBHOOK_URL": "[parameters('HealthCheckWebhookUrl')]",
            "HEALTH_DCE_ENDPOINT": "[parameters('HealthDceEndpoint')]",
            "HEALTH_DCR_IMMUTABLE_ID": "[parameters('HealthDcrImmutableId')]",
            "HEALTH_STREAM_NAME": "[parameters('HealthStreamName')]"
          }
        }
      ]
    }
  ],
  "outputs": {
    "FunctionAppName": {
      "type": "string",
      "value": "[variables('FunctionAppName')]"
    },
    "FunctionAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('FunctionAppName'))]"
    },
    "FunctionAppPrincipalHint": {
      "type": "string",
      "value": "This Function App authenticates outbound calls using the CLIENT_ID/CLIENT_SECRET app settings (a standalone App Registration), not a managed identity. No managed-identity role assignment is required for this deployment."
    }
  }
}
