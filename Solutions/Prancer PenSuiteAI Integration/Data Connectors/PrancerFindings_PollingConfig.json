[
  {
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "apiVersion": "2023-02-01-preview",
    "name": "PrancerLogDataConnection",
    "location": "{{location}}",
    "kind": "Push",
    "properties": {
      "connectorDefinitionName": "PrancerLogData",
      "auth": {
        "type": "Push",
        "appId": "{{appId}}",
        "servicePrincipalId": "{{servicePrincipalId}}"
      },
      "request": {
        "retryCount": 1
      },
      "response": {
        "eventsJsonPaths": [
          "$"
        ]
      },
      "dataType": "PrancerFindings_CL",
      "dcrConfig": {
        "streamName": "Custom-PrancerFindings",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      }
    }
  }
]
