{
  "name": "XposedOrNotDCR",
  "apiVersion": "2023-04-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-XposedOrNotExposures_CL": {
        "columns": [
          {
            "name": "email",
            "type": "string"
          },
          {
            "name": "domain",
            "type": "string"
          },
          {
            "name": "breach",
            "type": "string"
          }
        ]
      },
      "Custom-XposedOrNotBreachCatalog_CL": {
        "columns": [
          {
            "name": "breachID",
            "type": "string"
          },
          {
            "name": "breachedDate",
            "type": "datetime"
          },
          {
            "name": "addedDate",
            "type": "datetime"
          },
          {
            "name": "domain",
            "type": "string"
          },
          {
            "name": "industry",
            "type": "string"
          },
          {
            "name": "breachType",
            "type": "string"
          },
          {
            "name": "passwordRisk",
            "type": "string"
          },
          {
            "name": "exposedData",
            "type": "dynamic"
          },
          {
            "name": "exposedRecords",
            "type": "long"
          },
          {
            "name": "exposureDescription",
            "type": "string"
          },
          {
            "name": "searchable",
            "type": "boolean"
          },
          {
            "name": "sensitive",
            "type": "boolean"
          },
          {
            "name": "verified",
            "type": "boolean"
          },
          {
            "name": "referenceURL",
            "type": "string"
          },
          {
            "name": "logo",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-XposedOrNotExposures_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend TimeGenerated = now(), Email = tolower(tostring(email)), Domain = tolower(tostring(domain)), BreachName = tostring(breach) | extend EmailDomain = tostring(split(Email, '@')[1]) | project TimeGenerated, Email, EmailDomain, Domain, BreachName",
        "outputStream": "Custom-XposedOrNotExposures_CL"
      },
      {
        "streams": [
          "Custom-XposedOrNotBreachCatalog_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "transformKql": "source | extend TimeGenerated = now() | project TimeGenerated, BreachName = tostring(breachID), BreachedDate = todatetime(breachedDate), AddedDate = todatetime(addedDate), BreachDomain = tolower(tostring(domain)), Industry = tostring(industry), BreachType = tostring(breachType), PasswordRisk = tolower(tostring(passwordRisk)), ExposedData = exposedData, ExposedRecords = tolong(exposedRecords), BreachDescription = tostring(exposureDescription), IsSearchable = tobool(searchable), IsSensitive = tobool(sensitive), IsVerified = tobool(verified), ReferenceUrl = tostring(referenceURL), LogoUrl = tostring(logo)",
        "outputStream": "Custom-XposedOrNotBreachCatalog_CL"
      }
    ]
  }
}
