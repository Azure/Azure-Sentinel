[
  {
    "name": "XposedOrNotExposuresPoller",
    "apiVersion": "2023-02-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "XposedOrNot",
      "dataType": "XposedOrNotExposures_CL",
      "dcrConfig": {
        "streamName": "Custom-XposedOrNotExposures_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apikey')]",
        "ApiKeyName": "x-api-key"
      },
      "request": {
        "apiEndpoint": "https://api.xposedornot.com/v1/domain-breaches/",
        "httpMethod": "POST",
        "queryWindowInMin": "[[first(parameters('pollingFrequency'))]",
        "rateLimitQPS": 1,
        "retryCount": 3,
        "timeoutInSeconds": 120,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "MicrosoftSentinel-XposedOrNot/3.0"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.metrics.Breaches_Details"
        ],
        "format": "json"
      },
      "isActive": true
    }
  },
  {
    "name": "XposedOrNotBreachCatalogPoller",
    "apiVersion": "2023-02-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "XposedOrNot",
      "dataType": "XposedOrNotBreachCatalog_CL",
      "dcrConfig": {
        "streamName": "Custom-XposedOrNotBreachCatalog_CL",
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
      },
      "auth": {
        "type": "APIKey",
        "ApiKey": "[[parameters('apikey')]",
        "ApiKeyName": "x-api-key"
      },
      "request": {
        "apiEndpoint": "https://api.xposedornot.com/v1/breaches",
        "httpMethod": "GET",
        "queryWindowInMin": 1440,
        "rateLimitQPS": 1,
        "retryCount": 3,
        "timeoutInSeconds": 120,
        "headers": {
          "Accept": "application/json",
          "User-Agent": "MicrosoftSentinel-XposedOrNot/3.0"
        }
      },
      "response": {
        "eventsJsonPaths": [
          "$.exposedBreaches"
        ],
        "format": "json"
      },
      "isActive": true
    }
  }
]
