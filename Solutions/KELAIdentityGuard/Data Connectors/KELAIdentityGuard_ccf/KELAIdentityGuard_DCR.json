{
    "name": "KELAIdentityGuard_DCR",
    "apiVersion": "2023-04-01-preview",
    "type": "Microsoft.Insights/dataCollectionRules",
    "location": "{{location}}",
    "properties": {
        "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
        "streamDeclarations": {
            "Custom-KELA_IdentityGuard_Incidents_CL": {
                "columns": [
                    { "name": "incidentId", "type": "string" },
                    { "name": "createdDate", "type": "datetime" },
                    { "name": "updatedDate", "type": "datetime" },
                    { "name": "sourceDate", "type": "datetime" },
                    { "name": "severity", "type": "string" },
                    { "name": "status", "type": "string" },
                    { "name": "accountServiceName", "type": "string" },
                    { "name": "accountUserName", "type": "string" },
                    { "name": "accountServiceHostname", "type": "string" },
                    { "name": "accountUsernameEmailDomain", "type": "string" },
                    { "name": "isArchived", "type": "boolean" },
                    { "name": "isDeleted", "type": "boolean" },
                    { "name": "link", "type": "string" },
                    { "name": "workspaceId", "type": "string" },
                    { "name": "userClassification", "type": "string" },
                    { "name": "passwordPolicy", "type": "string" },
                    { "name": "detection", "type": "string" },
                    { "name": "sourceType", "type": "string" },
                    { "name": "sourceCategory", "type": "string" },
                    { "name": "sourceName", "type": "string" },
                    { "name": "fileName", "type": "string" },
                    { "name": "hasCookies", "type": "boolean" }
                ]
            }
        },
        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "{{workspaceResourceId}}",
                    "name": "LogAnalyticsDestination_KELA"
                }
            ]
        },
        "dataFlows": [
            {
                "streams": [ "Custom-KELA_IdentityGuard_Incidents_CL" ],
                "destinations": [ "LogAnalyticsDestination_KELA" ],
                "transformKql": "source | extend TimeGenerated = now()",
                "outputStream": "Custom-KELA_IdentityGuard_Incidents_CL"
            }
        ]
    }
}
