{
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "apiVersion": "2022-10-01-preview",
  "name": "KELAIdentityGuardPoller",
  "location": "{{location}}",
  "kind": "RestApiPoller",
  "properties": {
    "auth": {
      "type": "APIKey",
      "apiKeyName": "Authorization",
      "apiKey": "[[parameters('Password')]",
      "apiKeyIdentifier": "Bearer"
    },
    "request": {
      "apiEndpoint": "https://api.ke-la.com/bots-client-api/v1/search-incidents",
      "httpMethod": "POST",
      "isPostPayloadJson": true,
      "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
      "queryWindowInMin": 15,
      "rateLimitQPS": 30,
      "retryCount": 3,
      "timeoutInSeconds": 120,
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "queryParametersTemplate": "[[concat('{\"workspaceId\":\"', parameters('WorkspaceId'), '\",\"payload\":{\"filters\":{\"dateFilters\":{\"createdDate\":{\"startDate\":\"{_QueryWindowStartTime}\"}}}}}')]"
    },
    "response": {
      "eventsJsonPaths": [
        "$.results"
      ],
      "format": "json"
    },
    "paging": {
      "pagingType": "Offset",
      "offsetParaName": "offset",
      "pageSize": 1000,
      "pageSizeParameterName": "size",
      "pagingInfoPlacement": "QueryString",
      "pagingQueryParamOnly": true
    },
    "connectorDefinitionName": "KELAIdentityGuardCCFConnector",
    "dataType": "KELA_IdentityGuard_Incidents_CL",
    "dcrConfig": {
      "streamName": "Custom-KELA_IdentityGuard_Incidents_CL",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    }
  }
}