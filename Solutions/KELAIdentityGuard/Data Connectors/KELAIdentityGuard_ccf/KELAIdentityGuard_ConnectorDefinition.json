{
  "name": "KELAIdentityGuardCCFConnector",
  "apiVersion": "2025-07-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
  "location": "{{location}}",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "id": "KELAIdentityGuardCCFConnector",
      "title": "KELA - Identity Guard Connector",
      "publisher": "KELA Cyber",
      "descriptionMarkdown": "This connector ingests incidents from KELA Identity Guard using Microsoft Sentinel's Codeless Connector Framework (CCF).",
      "graphQueriesTableName": "KELA_IdentityGuard_Incidents_CL",
      "graphQueries": [
        {
          "metricName": "Total Actionable Alerts collected",
          "legend": "All Actionable Alerts",
          "baseQuery": "KELA_IdentityGuard_Incidents_CL"
        }
      ],
      "sampleQueries": [
        {
          "description": "Get sample of 20 recent Actionable Alerts",
          "query": "KELA_IdentityGuard_Incidents_CL\n| take 20"
        }
      ],
      "dataTypes": [
        {
          "name": "KELA_IdentityGuard_Incidents_CL",
          "lastDataReceivedQuery": "KELA_IdentityGuard_Incidents_CL \n | summarize Time = max(TimeGenerated)\n"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and write permissions required in the Workspace.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "write": true,
              "read": true,
              "delete": true
            }
          }
        ],
        "customs": [
          {
            "name": "KELA Credentials",
            "description": "You'll need your API key and the source workspace ID."
          }
        ]
      },
      "instructionSteps": [
        {
          "title": "1. Configure the API connection",
          "description": "Please enter the required parameters to authenticate yourself and specify the time period from which to retrieve the data.",
          "instructions": [
            {
              "type": "Textbox",
              "parameters": {
                "label": "Workspace ID",
                "name": "WorkspaceId",
                "type": "text",
                "placeholder": "E.g. cb38eabb0e..."
              }
            },
            {
              "type": "Textbox",
              "parameters": {
                "label": "API Key (Token)",
                "name": "Password",
                "type": "password",
                "placeholder": "Enter your KELA API Key",
                "validations": {
                  "required": true
                }
              }
            },
            {
              "type": "ConnectionToggleButton",
              "parameters": {
                "connectLabel": "Connect",
                "name": "toggle"
              }
            }
          ]
        }
      ]
    }
  }
}