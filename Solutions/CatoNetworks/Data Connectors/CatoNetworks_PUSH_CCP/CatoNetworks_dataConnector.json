{
  "name": "CatoNetworksEventsPushConnector",
  "apiVersion": "2023-02-01-preview",
  "type": "Microsoft.SecurityInsights/dataConnectors",
  "location": "{{location}}",
  "kind": "Push",
  "properties": {
    "connectorDefinitionName": "CatoNetworksEventsPush",
    "dcrConfig": {
      "streamName": "Custom-CatoNetworksEvents",
      "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
      "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
    },
    "auth": {
      "type": "Push",
      "appId": "{{appId}}",
      "servicePrincipalId": "{{servicePrincipalId}}"
    },
    "request": {
      "RetryCount": 1
    },
    "response": {
      "eventsJsonPaths": [
        "$"
      ]
    }
  }
}
