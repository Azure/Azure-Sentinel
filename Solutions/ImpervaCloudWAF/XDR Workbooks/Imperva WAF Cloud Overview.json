    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "ImpervaWAFCloud\n| where isnotempty(SrcIpAddr)\n| summarize by SrcIpAddr, SrcGeoLatitude, SrcGeoLongitude",
        "size": 3,
        "title": "Attack Map",
        "color": "redBright",
        "timeContext": {
          "durationMs": 0
