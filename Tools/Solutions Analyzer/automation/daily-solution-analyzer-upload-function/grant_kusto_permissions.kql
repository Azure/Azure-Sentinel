// Run these commands on the target Kusto database.
// Replace placeholders before execution.

// Required for queued ingestion
.add database ['<KUSTO_DATABASE>'] ingestors ('aadapp=<FUNCTION_PRINCIPAL_ID>;')

// Required because upload_to_kusto.py drops/recreates tables and mappings.
// Grant minimal practical admin scope for table DDL in this database.
.add database ['<KUSTO_DATABASE>'] admins ('aadapp=<FUNCTION_PRINCIPAL_ID>;')

// Optional: verify grants
.show database ['<KUSTO_DATABASE>'] principals
