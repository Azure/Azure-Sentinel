{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/Azure-Sentinel/Tools/AzureMonitorLogsIngestion/ingestion-contract.schema.json",
  "title": "Azure Monitor Logs Ingestion Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "workspace",
    "inputStream",
    "inputColumns",
    "transformKql",
    "destination"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "inputStream": {
      "type": "string",
      "pattern": "^Custom-"
    },
    "inputColumns": {
      "$ref": "#/$defs/inputColumns"
    },
    "transformKql": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "table", "outputStream", "columns"],
          "properties": {
            "kind": {
              "const": "custom"
            },
            "table": {
              "type": "string",
              "pattern": "_CL$"
            },
            "outputStream": {
              "type": "string",
              "pattern": "^Custom-"
            },
            "columns": {
              "$ref": "#/$defs/columns"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "table", "outputStream"],
          "properties": {
            "kind": {
              "const": "standard"
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "outputStream": {
              "type": "string",
              "pattern": "^Microsoft-"
            },
            "columns": {
              "$ref": "#/$defs/columns"
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dce": {
          "type": "string",
          "minLength": 1
        },
        "dcr": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "inputColumns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "type": {
            "enum": [
              "boolean",
              "datetime",
              "dynamic",
              "int",
              "long",
              "real",
              "string"
            ]
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "boolean",
              "datetime",
              "dynamic",
              "int",
              "long",
              "real",
              "string"
            ]
          }
        }
      }
    }
  }
}
