{
  "version": "Notebook/1.0",
  "context": {"ownerId": "/subscriptions/example/resourceGroups/example/providers/Microsoft.OperationalInsights/workspaces/example"},
  "fallbackResourceIds": ["{Workspace}"],
  "isLocked": true,
  "styleSettings": {"padding": "4px"},
  "items": [
    {
      "type": 9,
      "name": "filters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": ["{Workspace}"],
        "parameters": [
          {"name": "Subscription", "type": 6, "queryType": 1},
          {"name": "Workspace", "type": 5, "typeSettings": {"resourceTypeFilter": {"microsoft.operationalinsights/workspaces": true}}, "crossComponentResources": ["{Subscription}"]},
          {"name": "TimeRange", "type": 4, "value": {"durationMs": 7200000}},
          {"name": "Computer", "type": 5, "query": "Syslog | summarize Events=count() by Computer | order by Events desc, Computer asc | project Computer", "queryType": 0, "multiSelect": true, "quote": "'", "delimiter": ",", "value": ["value::all"]},
          {"name": "Severity", "type": 2, "value": ["warning"]}
        ]
      }
    },
    {
      "type": 12,
      "name": "group",
      "content": {
        "version": "NotebookGroup/1.0",
        "items": [
          {
            "type": 3,
            "name": "counts",
            "customWidth": "50",
            "content": {
              "queryType": 0,
              "query": "Syslog\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where '*' in ({Computer}) or Computer in ({Computer})\n| where '*' in ({Severity}) or SeverityLevel in ({Severity})\n| summarize Events=count() by Computer, Hour=bin(TimeGenerated, 1h)\n| order by Computer asc, Hour asc",
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": ["{Workspace}"],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "exportFieldName": "Computer",
              "exportParameterName": "SelectedComputer",
              "gridSettings": {"rowLimit": 50}
            }
          },
          {
            "type": 3,
            "name": "drilldown",
            "conditionalVisibility": {"parameterName": "SelectedComputer", "comparison": "isNotEqualTo", "value": ""},
            "content": {
              "queryType": 0,
              "query": "Syslog | where Computer == '{SelectedComputer}' | project Computer, SeverityLevel",
              "visualization": "table"
            }
          }
        ]
      }
    },
    {"type": 1, "name": "explanation", "content": {"json": "Synthetic conversion fixture, not security detection content."}}
  ]
}
