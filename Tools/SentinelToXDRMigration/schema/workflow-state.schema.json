{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel to XDR workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solution",
    "workflowStatus",
    "createdAt",
    "updatedAt",
    "context",
    "stages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "solution": {
      "type": "string",
      "minLength": 1
    },
    "workflowStatus": {
      "enum": [
        "inProgress",
        "blocked",
        "failed",
        "completed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceResourceId",
        "versionBump",
        "workflowProfile"
      ],
      "properties": {
        "workspaceResourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionBump": {
          "enum": [
            "patch",
            "minor",
            "major",
            "none",
            null
          ]
        },
        "workflowProfile": {
          "enum": [
            "authoring",
            "qualification"
          ]
        },
        "profileSelectionConfirmed": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "conversion",
        "validation",
        "packaging",
        "deployment",
        "mockIngestion",
        "alertParity",
        "report"
      ],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/stage"
        },
        "conversion": {
          "$ref": "#/$defs/stage"
        },
        "validation": {
          "$ref": "#/$defs/stage"
        },
        "packaging": {
          "$ref": "#/$defs/stage"
        },
        "deployment": {
          "$ref": "#/$defs/stage"
        },
        "mockIngestion": {
          "$ref": "#/$defs/stage"
        },
        "alertParity": {
          "$ref": "#/$defs/stage"
        },
        "report": {
          "$ref": "#/$defs/stage"
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "attempts",
        "startedAt",
        "completedAt",
        "message",
        "artifacts",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "passed",
            "failed",
            "blocked",
            "notRequired"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
